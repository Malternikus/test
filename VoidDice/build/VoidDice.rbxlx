        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CosmeticConfig</string>
            <string name="Source"><![CDATA[--!strict
-- CosmeticConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > CosmeticConfig
--
-- Rein optische Belohnungen. Kein Gameplay-Vorteil.
-- Kinds:
--   Title          Text über dem Kopf (und im Leaderboard)
--   Nameplate      Stil des Overhead-Schilds
--   Aura           Partikel am Spieler-Avatar
--   Trail          Trail am Spieler-Avatar
--   BaseTheme      Farben der Kommunikations-Lichter in der Base
--   RollEffect     Farbton der Reveal-Animation
--   FishingEffect  Farbe des Fang-Splashs am Rift Pond
--   RiftEffect     Effekt beim Teleport/Rebirth
--
-- Source sagt, wo es herkommt (nur Info für UI): Achievement, Fishing, Season,
-- Rebirth, VIP, Default.

export type CosmeticDef = {
	Id: string,
	Kind: string,
	DisplayName: string,
	Source: string,
	Color: Color3?,
	Color2: Color3?,
	Text: string?,
	Colors: { Color3 }?,
}

local CosmeticConfig = {}

CosmeticConfig.Kinds = { "Title", "Nameplate", "Aura", "Trail", "BaseTheme", "RollEffect", "FishingEffect", "RiftEffect" }

CosmeticConfig.List = {
	-- Titles
	{ Id = "TitleRookie", Kind = "Title", DisplayName = "ROOKIE", Text = "ROOKIE", Source = "Default", Color = Color3.fromRGB(180, 190, 210) },
	{ Id = "MysteryHunter", Kind = "Title", DisplayName = "MYSTERY HUNTER", Text = "MYSTERY HUNTER", Source = "Achievement", Color = Color3.fromRGB(255, 160, 80) },
	{ Id = "RiftWalker", Kind = "Title", DisplayName = "RIFT WALKER", Text = "RIFT WALKER", Source = "Rebirth", Color = Color3.fromRGB(150, 90, 255) },
	{ Id = "VoidSeeker", Kind = "Title", DisplayName = "VOID SEEKER", Text = "VOID SEEKER", Source = "Rebirth", Color = Color3.fromRGB(120, 50, 255) },
	{ Id = "AnomalyHunter", Kind = "Title", DisplayName = "ANOMALY HUNTER", Text = "ANOMALY HUNTER", Source = "Achievement", Color = Color3.fromRGB(0, 255, 200) },
	{ Id = "TheSurvivor", Kind = "Title", DisplayName = "THE SURVIVOR", Text = "THE SURVIVOR", Source = "Rebirth", Color = Color3.fromRGB(255, 60, 60) },
	{ Id = "Collector", Kind = "Title", DisplayName = "ARCHIVIST", Text = "ARCHIVIST", Source = "Achievement", Color = Color3.fromRGB(90, 220, 255) },
	{ Id = "DeepAngler", Kind = "Title", DisplayName = "DEEP ANGLER", Text = "DEEP ANGLER", Source = "Achievement", Color = Color3.fromRGB(60, 230, 200) },
	{ Id = "TitleAbyssAngler", Kind = "Title", DisplayName = "ABYSS ANGLER", Text = "ABYSS ANGLER", Source = "Fishing", Color = Color3.fromRGB(130, 50, 255) },
	{ Id = "MaxedOut", Kind = "Title", DisplayName = "MAXED OUT", Text = "MAXED OUT", Source = "Achievement", Color = Color3.fromRGB(255, 210, 60) },
	{ Id = "TitleVIP", Kind = "Title", DisplayName = "VIP", Text = "★ VIP", Source = "VIP", Color = Color3.fromRGB(255, 200, 60) },
	{ Id = "TitleSignalLost", Kind = "Title", DisplayName = "SIGNAL LOST", Text = "SIGNAL LOST", Source = "Season", Color = Color3.fromRGB(255, 70, 90) },

	-- Nameplates
	{ Id = "PlateDefault", Kind = "Nameplate", DisplayName = "STANDARD", Source = "Default", Color = Color3.fromRGB(14, 16, 34), Color2 = Color3.fromRGB(90, 110, 255) },
	{ Id = "PlateCRT", Kind = "Nameplate", DisplayName = "CRT GREEN", Source = "Season", Color = Color3.fromRGB(4, 20, 8), Color2 = Color3.fromRGB(60, 255, 120) },
	{ Id = "PlateVIP", Kind = "Nameplate", DisplayName = "VIP GOLD", Source = "VIP", Color = Color3.fromRGB(40, 28, 4), Color2 = Color3.fromRGB(255, 200, 60) },

	-- Auras (Spieler)
	{ Id = "AuraLabGlow", Kind = "Aura", DisplayName = "LAB GLOW", Source = "Fishing", Color = Color3.fromRGB(80, 230, 255) },
	{ Id = "AuraMirror", Kind = "Aura", DisplayName = "MIRROR SHIMMER", Source = "Fishing", Color = Color3.fromRGB(40, 230, 190) },
	{ Id = "AuraVIP", Kind = "Aura", DisplayName = "VIP SPARKLE", Source = "VIP", Color = Color3.fromRGB(255, 200, 60) },
	{ Id = "AuraSeasonRift", Kind = "Aura", DisplayName = "SIGNAL STORM", Source = "Season", Color = Color3.fromRGB(255, 70, 90) },

	-- Trails
	{ Id = "TrailStatic", Kind = "Trail", DisplayName = "STATIC TRAIL", Source = "Fishing", Color = Color3.fromRGB(200, 210, 230), Color2 = Color3.fromRGB(80, 90, 120) },
	{ Id = "TrailNeon", Kind = "Trail", DisplayName = "NEON ARCADE", Source = "Season", Color = Color3.fromRGB(255, 60, 200), Color2 = Color3.fromRGB(60, 200, 255) },

	-- Base Themes (Lichterketten)
	{ Id = "ThemeClassic", Kind = "BaseTheme", DisplayName = "CLASSIC LIGHTS", Source = "Default",
		Colors = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 200, 60), Color3.fromRGB(80, 220, 120), Color3.fromRGB(80, 160, 255) } },
	{ Id = "ThemeRift", Kind = "BaseTheme", DisplayName = "RIFT PULSE", Source = "Rebirth",
		Colors = { Color3.fromRGB(150, 80, 255), Color3.fromRGB(60, 220, 255) } },
	{ Id = "ThemeVIP", Kind = "BaseTheme", DisplayName = "VIP GOLD", Source = "VIP",
		Colors = { Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 255, 220) } },
	{ Id = "ThemeRedAlert", Kind = "BaseTheme", DisplayName = "RED ALERT", Source = "Season",
		Colors = { Color3.fromRGB(255, 40, 40), Color3.fromRGB(80, 0, 0) } },

	-- Roll / Fishing / Rift Effects
	{ Id = "RollDefault", Kind = "RollEffect", DisplayName = "STANDARD", Source = "Default", Color = Color3.fromRGB(90, 110, 255) },
	{ Id = "RollCRT", Kind = "RollEffect", DisplayName = "CRT SCANLINES", Source = "Season", Color = Color3.fromRGB(60, 255, 120) },
	{ Id = "FishingSporeSplash", Kind = "FishingEffect", DisplayName = "SPORE SPLASH", Source = "Fishing", Color = Color3.fromRGB(120, 255, 140) },
	{ Id = "RiftEffectFracture", Kind = "RiftEffect", DisplayName = "FRACTURE", Source = "Fishing", Color = Color3.fromRGB(170, 90, 255) },
} :: { CosmeticDef }

CosmeticConfig.ById = {} :: { [string]: CosmeticDef }
for _, def in CosmeticConfig.List do
	CosmeticConfig.ById[def.Id] = def
end

-- Standardmäßig besessen und ausgerüstet
CosmeticConfig.Defaults = {
	Title = "TitleRookie",
	Nameplate = "PlateDefault",
	BaseTheme = "ThemeClassic",
	RollEffect = "RollDefault",
}

function CosmeticConfig.Get(id: string): CosmeticDef?
	return CosmeticConfig.ById[id]
end

return CosmeticConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DiceConfig</string>
            <string name="Source"><![CDATA[--!strict
-- DiceConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > DiceConfig
--
-- Dice sind dauerhafte Freischaltungen (bleiben bei Rebirth erhalten).
-- Voraussetzung: Gebiet (Area) freigeschaltet. Dann einmalig mit Cash kaufen.
-- Der Spieler rollt immer mit dem ausgerüsteten Dice.
--
--   Luck        Multiplikator auf die Grund-Luck (siehe Logic > Modifiers)
--   RollSpeed   Multiplikator auf die Roll-Geschwindigkeit (1 = normal)
--   Cost        Cash-Preis (wird nach Economy-Simulation angepasst)

export type DiceDef = {
	Id: string,
	DisplayName: string,
	Order: number,
	Area: string,
	Luck: number,
	RollSpeed: number,
	Cost: number,
	Color: Color3,
	Color2: Color3,
	Description: string,
}

local DiceConfig = {}

DiceConfig.Default = "Basic"

DiceConfig.List = {
	{
		Id = "Basic", DisplayName = "BASIC DICE", Order = 1, Area = "Suburb",
		Luck = 1, RollSpeed = 1, Cost = 0,
		Color = Color3.fromRGB(230, 230, 240), Color2 = Color3.fromRGB(120, 120, 140),
		Description = "A scratched game-night die. Everyone starts somewhere.",
	},
	{
		Id = "Strange", DisplayName = "STRANGE DICE", Order = 2, Area = "DarkForest",
		Luck = 2, RollSpeed = 1, Cost = 130000,
		Color = Color3.fromRGB(80, 220, 120), Color2 = Color3.fromRGB(20, 80, 40),
		Description = "Found in the forest. It is always warm.",
	},
	{
		Id = "Rift", DisplayName = "RIFT DICE", Order = 3, Area = "SecretLab",
		Luck = 3, RollSpeed = 1.05, Cost = 19000000,
		Color = Color3.fromRGB(80, 200, 255), Color2 = Color3.fromRGB(30, 60, 160),
		Description = "Lab property. Do not roll near the containment field.",
	},
	{
		Id = "Psychic", DisplayName = "PSYCHIC DICE", Order = 4, Area = "RiftZone",
		Luck = 5, RollSpeed = 1.1, Cost = 170000000,
		Color = Color3.fromRGB(170, 90, 255), Color2 = Color3.fromRGB(60, 20, 140),
		Description = "Lands on the face you were thinking of. Usually.",
	},
	{
		Id = "Void", DisplayName = "VOID DICE", Order = 5, Area = "Otherworld",
		Luck = 8, RollSpeed = 1.15, Cost = 1400000000,
		Color = Color3.fromRGB(110, 40, 230), Color2 = Color3.fromRGB(8, 0, 20),
		Description = "It has more faces than it should.",
	},
	{
		Id = "Anomaly", DisplayName = "ANOMALY DICE", Order = 6, Area = "Void",
		Luck = 12, RollSpeed = 1.2, Cost = 90000000000,
		Color = Color3.fromRGB(255, 255, 255), Color2 = Color3.fromRGB(0, 255, 200),
		Description = "Nobody remembers who made it. It remembers you.",
	},
} :: { DiceDef }

DiceConfig.ById = {} :: { [string]: DiceDef }
for _, def in DiceConfig.List do
	DiceConfig.ById[def.Id] = def
end

function DiceConfig.Get(id: string): DiceDef?
	return DiceConfig.ById[id]
end

return DiceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
-- EconomyConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > EconomyConfig
--
-- Das "Spreadsheet" der Economy. Alle Formeln stehen in Util > Stats, alle
-- Zahlen hier. Die Simulation (tools/simulate.luau) spielt mit genau diesen
-- Werten und der echten Server-Logik durch und schreibt docs/ECONOMY.md.
--
-- Grundidee: Upgrade-Kosten sind in "Sekunden Basis-Einkommen" angegeben.
-- Dadurch ist die Amortisationszeit eines Upgrades für jeden Character gleich,
-- egal wie selten er ist. Seltene Characters sind trotzdem besser, weil sie
-- absolut viel mehr bringen.

local EconomyConfig = {}

-- Multiplikator auf $/s je Level (Index = Level). Linear-ish, max 5x.
-- Kein exponentielles Scaling.
EconomyConfig.LevelIncomeMultiplier = {
	1.0, 1.2, 1.4, 1.6, 1.8, -- 1–5
	2.0, 2.25, 2.5, 2.75, 3.0, -- 6–10
	3.3, 3.6, 4.0, 4.4, 5.0, -- 11–15
}

-- Kosten für Level L -> L+1 in Sekunden Basis-$/s (Level 1, ohne Mutation).
-- 1–5 sehr günstig, 6–10 mittel, 11–15 teuer.
EconomyConfig.UpgradeCostSeconds = {
	6, 8, 10, 13, 16, -- 1->2 … 5->6
	30, 40, 50, 65, 85, -- 6->7 … 10->11
	140, 190, 260, 360, -- 11->12 … 14->15
}
EconomyConfig.MinUpgradeCost = 10

-- Fishing Power und Power wachsen nur leicht mit dem Level
EconomyConfig.FishingPowerPerLevel = 0.04 -- +4 % pro Level
EconomyConfig.PowerPerLevel = 0.10 -- +10 % pro Level

-- Verkaufswert = Basis-$/s * SellSeconds (aus RarityConfig) * Level-Faktor
EconomyConfig.SellLevelBonus = 0.5 -- Level 15 verkauft sich für +50 % * (Level-1)/14

-- Vault: Einkommen sammelt sich hier, bis der Spieler einsammelt.
-- Ab Rebirth 1 gibt es Auto-Collect.
EconomyConfig.VaultCapacitySeconds = 900
EconomyConfig.VaultMinCapacity = 2000

-- Belohnungen in "Sekunden aktuelles Einkommen" + Mindestbetrag.
-- So bleiben Quests/Fishing/Produkte in jeder Phase relevant, ohne zu eskalieren.
EconomyConfig.ScaledReward = {
	MinIncomePerSecond = 5, -- falls der Spieler fast nichts verdient
}

-- Globale Grenzen für Boni (Schutz vor Stacking-Exploits)
EconomyConfig.MaxCashMultiplier = 50
EconomyConfig.MaxLuck = 500
EconomyConfig.MaxGearLuckPct = 100 -- Summe Gear-Luck aller platzierten Characters
EconomyConfig.MaxGearCashPctPerCharacter = 150

-- Index-Bonus: dauerhafte Luck für entdeckte Characters
EconomyConfig.IndexLuckPctPerDiscovery = 0.25 -- +0.25 % Luck pro entdecktem Character (max +25 %)

-- Base Value (Flex-Anzeige): Summe Power der platzierten Characters
-- Leaderboard "Rarest Collection": Summe Punkte der entdeckten Characters
EconomyConfig.CollectionPoints = {
	Common = 1, Uncommon = 2, Rare = 5, Epic = 15, Legendary = 50, Mythic = 200,
	Supernatural = 800, Void = 4000, Secret = 25000, Anomaly = 150000,
}

-- Simulations-Zielwerte (Minuten seit Spielstart) für den Economy-Report
EconomyConfig.RebirthTargetsMinutes = { 5, 15, 30, 50, 75, 105, 140, 180 }

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">FishingConfig</string>
            <string name="Source"><![CDATA[--!strict
-- FishingConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > FishingConfig
--
-- RIFT FISHING: Jede Base hat einen Rift Pond. Characters, die nicht in der
-- Base stehen, können dort "fischen" und ziehen bizarre Dinge aus dem Riss.
-- Fischende Characters verdienen KEIN Cash (sie belegen aber auch keinen
-- Base-Slot). Der Pond kann auf jedes freigeschaltete Gewässer "getunt" werden.
--
-- Fang-Intervall pro Character:
--   Sekunden = BaseCatchSeconds / (1 + FishingPower / PowerScale)
--   (geteilt durch (1 + FishingSpeed-Boni)), mindestens MinCatchSeconds
--
-- Loot nutzt dieselbe Mathematik wie das Rollen (Util > RollMath):
--   Chance = "1 in X". Einträge mit Rarity "Common" sind Restwahrscheinlichkeit,
--   alle anderen werden mit der Fishing Luck multipliziert.
--
-- Loot-Arten:
--   Cash      Seconds = so viele Sekunden des aktuellen Base-Einkommens
--   Potion    Id aus PotionConfig
--   Gear      Id aus GearConfig
--   Relic     Id aus FishingConfig.Relics (Sammelobjekte, verkaufbar)
--   Cosmetic  Id aus CosmeticConfig

export type LootEntry = {
	Kind: string,
	Id: string?,
	Seconds: number?,
	Chance: number,
	Rarity: string,
}

export type WatersDef = {
	Id: string,
	DisplayName: string,
	Area: string,
	Description: string,
	Color: Color3,
	Loot: { LootEntry },
}

local FishingConfig = {}

FishingConfig.BaseCatchSeconds = 30
FishingConfig.MinCatchSeconds = 5
FishingConfig.PowerScale = 20
FishingConfig.MaxRecentCatches = 12 -- für die UI-Liste

-- Sammel-Relikte ("rare items")
FishingConfig.Relics = {
	{ Id = "BentSpoon", DisplayName = "BENT SPOON", Rarity = "Common", SellSeconds = 3, Description = "Someone thought really hard at it." },
	{ Id = "MeltedCassette", DisplayName = "MELTED CASSETTE", Rarity = "Common", SellSeconds = 3, Description = "Still plays. Only static." },
	{ Id = "GlowingPebble", DisplayName = "GLOWING PEBBLE", Rarity = "Uncommon", SellSeconds = 6, Description = "Warm. Pulses at 3:33 AM." },
	{ Id = "MissingPoster", DisplayName = "MISSING POSTER", Rarity = "Uncommon", SellSeconds = 6, Description = "The face changes every time you look." },
	{ Id = "RiftShard", DisplayName = "RIFT SHARD", Rarity = "Rare", SellSeconds = 12, Description = "A splinter of a broken dimension." },
	{ Id = "LabBadge", DisplayName = "LAB BADGE #000", Rarity = "Rare", SellSeconds = 12, Description = "Clearance level: none of your business." },
	{ Id = "StaticJar", DisplayName = "JAR OF STATIC", Rarity = "Epic", SellSeconds = 25, Description = "Do not open during thunderstorms." },
	{ Id = "OtherworldCompass", DisplayName = "MIRROR COMPASS", Rarity = "Legendary", SellSeconds = 60, Description = "Points away from home." },
	{ Id = "VoidPearl", DisplayName = "VOID PEARL", Rarity = "Mythic", SellSeconds = 180, Description = "Darker than the space around it." },
	{ Id = "EndlessKey", DisplayName = "THE ENDLESS KEY", Rarity = "Void", SellSeconds = 600, Description = "Opens a door that is not there yet." },
}
FishingConfig.RelicById = {}
for _, r in FishingConfig.Relics do
	FishingConfig.RelicById[r.Id] = r
end

local function L(kind: string, id: string?, chance: number, rarity: string, seconds: number?): LootEntry
	return { Kind = kind, Id = id, Chance = chance, Rarity = rarity, Seconds = seconds }
end

FishingConfig.Waters = {
	{
		Id = "SuburbPond", DisplayName = "MILBROOK RIFT POND", Area = "Suburb",
		Description = "A shallow tear behind the base. Mostly junk. Mostly.",
		Color = Color3.fromRGB(90, 120, 255),
		Loot = {
			L("Cash", nil, 3, "Common", 1),
			L("Relic", "BentSpoon", 6, "Common"),
			L("Relic", "MeltedCassette", 6, "Common"),
			L("Potion", "Luck", 7, "Uncommon"),
			L("Potion", "Cash", 9, "Uncommon"),
			L("Potion", "Bait", 10, "Uncommon"),
			L("Gear", "WalkieTalkie", 25, "Uncommon"),
			L("Gear", "PocketFlashlight", 30, "Uncommon"),
			L("Gear", "BaitTin", 35, "Uncommon"),
			L("Gear", "LuckyArcadeToken", 40, "Uncommon"),
			L("Relic", "GlowingPebble", 25, "Uncommon"),
			L("Potion", "RollSpeed", 25, "Uncommon"),
			L("Cash", nil, 40, "Rare", 5),
			L("Potion", "SuperLuck", 60, "Rare"),
			L("Gear", "StrangeBattery", 200, "Rare"),
			L("Gear", "MoodRing", 250, "Rare"),
			L("Relic", "RiftShard", 150, "Rare"),
			L("Cosmetic", "TrailStatic", 600, "Epic"),
			L("Gear", "PsychicAmplifier", 2250, "Epic"),
		},
	},
	{
		Id = "BlackPinesLake", DisplayName = "BLACK PINES LAKE", Area = "DarkForest",
		Description = "The lake the town stopped swimming in.",
		Color = Color3.fromRGB(70, 200, 120),
		Loot = {
			L("Cash", nil, 3, "Common", 1),
			L("Relic", "MeltedCassette", 7, "Common"),
			L("Potion", "Luck", 6, "Uncommon"),
			L("Potion", "Cash", 8, "Uncommon"),
			L("Potion", "Bait", 9, "Uncommon"),
			L("Gear", "PocketFlashlight", 30, "Uncommon"),
			L("Gear", "BaitTin", 30, "Uncommon"),
			L("Relic", "MissingPoster", 18, "Uncommon"),
			L("Potion", "FishingLuck", 20, "Uncommon"),
			L("Gear", "StrangeBattery", 75, "Rare"),
			L("Gear", "RiftDetector", 87, "Rare"),
			L("Gear", "SignalBooster", 100, "Rare"),
			L("Potion", "SuperLuck", 40, "Rare"),
			L("Cash", nil, 45, "Rare", 6),
			L("Relic", "RiftShard", 80, "Rare"),
			L("Gear", "CreatureLure", 750, "Epic"),
			L("Gear", "TapeRecorder", 875, "Epic"),
			L("Cosmetic", "FishingSporeSplash", 500, "Epic"),
			L("Potion", "Mutagen", 700, "Epic"),
		},
	},
	{
		Id = "CoolantPool", DisplayName = "LAB COOLANT POOL", Area = "SecretLab",
		Description = "Glows. Should not glow.",
		Color = Color3.fromRGB(80, 230, 255),
		Loot = {
			L("Cash", nil, 3, "Common", 2),
			L("Relic", "LabBadge", 9, "Common"),
			L("Potion", "Luck", 6, "Uncommon"),
			L("Potion", "RollSpeed", 9, "Uncommon"),
			L("Potion", "FishingLuck", 12, "Uncommon"),
			L("Gear", "SignalBooster", 37, "Uncommon"),
			L("Gear", "RiftDetector", 37, "Uncommon"),
			L("Gear", "StrangeBattery", 37, "Uncommon"),
			L("Potion", "SuperLuck", 25, "Rare"),
			L("Gear", "PsychicAmplifier", 150, "Rare"),
			L("Gear", "TapeRecorder", 175, "Rare"),
			L("Relic", "StaticJar", 90, "Rare"),
			L("Cash", nil, 50, "Rare", 7),
			L("Potion", "Mutagen", 250, "Epic"),
			L("Gear", "ContainmentRod", 2250, "Legendary"),
			L("Gear", "VoidCompass", 3000, "Legendary"),
			L("Cosmetic", "AuraLabGlow", 1500, "Legendary"),
		},
	},
	{
		Id = "RiftTear", DisplayName = "THE TEAR", Area = "RiftZone",
		Description = "Fishing directly in a hole in the sky.",
		Color = Color3.fromRGB(160, 90, 255),
		Loot = {
			L("Cash", nil, 3, "Common", 2),
			L("Relic", "RiftShard", 6, "Common"),
			L("Potion", "SuperLuck", 8, "Uncommon"),
			L("Potion", "FishingLuck", 8, "Uncommon"),
			L("Potion", "Bait", 8, "Uncommon"),
			L("Gear", "PsychicAmplifier", 50, "Uncommon"),
			L("Gear", "CreatureLure", 55, "Uncommon"),
			L("Gear", "TapeRecorder", 55, "Uncommon"),
			L("Relic", "StaticJar", 40, "Rare"),
			L("Cash", nil, 50, "Rare", 8),
			L("Potion", "Mutagen", 90, "Rare"),
			L("Gear", "VoidCompass", 750, "Epic"),
			L("Gear", "ContainmentRod", 750, "Epic"),
			L("Gear", "GoldenCassette", 875, "Epic"),
			L("Relic", "OtherworldCompass", 800, "Legendary"),
			L("Potion", "VoidElixir", 900, "Legendary"),
			L("Cosmetic", "RiftEffectFracture", 2000, "Legendary"),
		},
	},
	{
		Id = "MirrorLake", DisplayName = "OTHERWORLD LAKE", Area = "Otherworld",
		Description = "Your reflection fishes back.",
		Color = Color3.fromRGB(40, 230, 190),
		Loot = {
			L("Cash", nil, 3, "Common", 2),
			L("Relic", "StaticJar", 8, "Common"),
			L("Potion", "SuperLuck", 6, "Uncommon"),
			L("Potion", "Mutagen", 20, "Uncommon"),
			L("Gear", "VoidCompass", 100, "Rare"),
			L("Gear", "ContainmentRod", 100, "Rare"),
			L("Gear", "GoldenCassette", 100, "Rare"),
			L("Relic", "OtherworldCompass", 120, "Rare"),
			L("Cash", nil, 60, "Rare", 9),
			L("Potion", "VoidElixir", 200, "Epic"),
			L("Gear", "RiftLantern", 2250, "Mythic"),
			L("Gear", "SignalCrown", 2750, "Mythic"),
			L("Relic", "VoidPearl", 2500, "Mythic"),
			L("Cosmetic", "AuraMirror", 3000, "Mythic"),
		},
	},
	{
		Id = "AbyssWell", DisplayName = "THE ABYSS WELL", Area = "Void",
		Description = "There is no bottom. There is something at the bottom.",
		Color = Color3.fromRGB(130, 50, 255),
		Loot = {
			L("Cash", nil, 3, "Common", 2),
			L("Relic", "VoidPearl", 30, "Uncommon"),
			L("Potion", "VoidElixir", 12, "Uncommon"),
			L("Potion", "Mutagen", 12, "Uncommon"),
			L("Gear", "RiftLantern", 300, "Rare"),
			L("Gear", "SignalCrown", 300, "Rare"),
			L("Cash", nil, 60, "Rare", 10),
			L("Gear", "NullEngine", 6250, "Void"),
			L("Gear", "AbyssHook", 6250, "Void"),
			L("Relic", "EndlessKey", 10000, "Void"),
			L("Cosmetic", "TitleAbyssAngler", 5000, "Void"),
		},
	},
} :: { WatersDef }

FishingConfig.WatersById = {} :: { [string]: WatersDef }
FishingConfig.WatersByArea = {} :: { [string]: WatersDef }
for _, w in FishingConfig.Waters do
	FishingConfig.WatersById[w.Id] = w
	FishingConfig.WatersByArea[w.Area] = w
end

FishingConfig.DefaultWaters = "SuburbPond"

-- Rarities mit Server-Ansage bei einem Fang ("riesiger Fishing Drop")
FishingConfig.AnnounceRarities = { Legendary = true, Mythic = true, Void = true }

return FishingConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
-- GameConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > GameConfig
--
-- Allgemeine Spielregeln und Limits, die zu keinem einzelnen System gehören.

local GameConfig = {}

GameConfig.Title = "VOID DICE"
GameConfig.Subtitle = "ROLL. COLLECT. SURVIVE."
GameConfig.Pitch = {
	"ROLL CHARACTERS.",
	"BUILD YOUR COLLECTION.",
	"GET RICH.",
	"FIND THE RAREST ENTITY.",
}

-- Server: 6–8 Spieler (in den Place-Einstellungen setzen, hier nur Info/Plots)
GameConfig.MaxPlayers = 8

-- Rolling --------------------------------------------------------------------
GameConfig.RollCooldown = 1.0 -- Sekunden zwischen zwei Rolls bei Roll Speed 1
GameConfig.MinRollCooldown = 0.3 -- harte Untergrenze, egal wie viele Boni
GameConfig.RollCooldownTolerance = 0.12 -- Netzwerk-Toleranz für manuelle Rolls
GameConfig.AutoRollUnlocked = true -- Auto Roll von Anfang an verfügbar

-- Base -------------------------------------------------------------------------
GameConfig.StartBaseSlots = 6
GameConfig.MaxBaseSlots = 25 -- physische Pads pro Plot (WorldConfig 5x5)
GameConfig.StartFishingSlots = 1
GameConfig.MaxFishingSlots = 4
GameConfig.StartGearSlots = 2
GameConfig.MaxGearSlots = 3

-- Inventar --------------------------------------------------------------------
-- Soft Cap: darüber werden neue Rolls automatisch verkauft, außer sie sind neu
-- im Index oder Legendary+. Hard Cap gilt immer (DataStore-Größe).
GameConfig.InventorySoftCap = 250
GameConfig.InventoryHardCap = 320
GameConfig.GearInventoryCap = 120
GameConfig.KeepRarityOverCap = "Legendary"

-- Neue Characters automatisch in die Base stellen, wenn sie mehr bringen als
-- der schwächste platzierte (Standard an, im Settings-Menü abschaltbar)
GameConfig.DefaultAutoPlace = true

-- Fishing wird freigeschaltet, sobald insgesamt so viel Cash verdient wurde
-- (Ziel laut Design: ca. Minute 3)
GameConfig.FishingUnlockCashEarned = 30000

-- Ticks -------------------------------------------------------------------------
GameConfig.EconomyTickInterval = 1
GameConfig.AutosaveInterval = 75
GameConfig.LeaderboardRefreshInterval = 120

-- Tutorial ------------------------------------------------------------------------
GameConfig.TutorialSteps = {
	{ Id = "Roll", Text = "Press ROLL to roll your first character!" },
	{ Id = "Reveal", Text = "Nice! Every character has a rarity. Rarer = more cash." },
	{ Id = "Place", Text = "Your character stands in your base and makes cash every second." },
	{ Id = "Collect", Text = "Cash piles up in your vault. Press COLLECT (or step on the green pad)." },
	{ Id = "Upgrade", Text = "Open a character and press UPGRADE to boost its $/s." },
	{ Id = "Fishing", Text = "Later you can send spare characters to your Rift Pond to fish for loot." },
}

-- Announcements -------------------------------------------------------------------
GameConfig.CrossServerAnnouncements = true -- MessagingService für Secret/Anomaly

-- Debug ---------------------------------------------------------------------------
-- In Studio: Debug-Befehle (Cash geben, Luck setzen …) über das Settings-Menü
GameConfig.StudioDebugTools = true

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">GearConfig</string>
            <string name="Source"><![CDATA[--!strict
-- GearConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > GearConfig
--
-- Gear wird auf Characters ausgerüstet (2 Slots, ab Rebirth 4 drei).
-- Gear droppt vom Fishing, aus Quests und aus dem Season Pass.
--
-- Stats:
--   CashPct         +% $/s für DIESEN Character
--   FishingPower    +flat Fishing Power für diesen Character
--   FishingLuckPct  +% Fishing Luck, wenn dieser Character fischt
--   LuckPct         +% Roll-Luck GLOBAL, solange der Character in der Base steht
--                   (gedeckelt durch EconomyConfig.MaxGearLuckPct)

export type GearDef = {
	Id: string,
	DisplayName: string,
	Rarity: string,
	CashPct: number?,
	FishingPower: number?,
	FishingLuckPct: number?,
	LuckPct: number?,
	SellValueSeconds: number,
	Color: Color3,
	Description: string,
}

local GearConfig = {}

-- Gear-Rarities (eigene, kürzere Liste als bei Characters)
GearConfig.Rarities = {
	{ Id = "Common", Order = 1, Color = Color3.fromRGB(176, 184, 196) },
	{ Id = "Rare", Order = 2, Color = Color3.fromRGB(64, 156, 255) },
	{ Id = "Epic", Order = 3, Color = Color3.fromRGB(176, 92, 255) },
	{ Id = "Legendary", Order = 4, Color = Color3.fromRGB(255, 188, 52) },
	{ Id = "Mythic", Order = 5, Color = Color3.fromRGB(255, 72, 120) },
	{ Id = "Void", Order = 6, Color = Color3.fromRGB(140, 60, 255) },
}
GearConfig.RarityById = {}
for _, r in GearConfig.Rarities do
	GearConfig.RarityById[r.Id] = r
end

GearConfig.List = {
	-- Common
	{ Id = "WalkieTalkie", DisplayName = "WALKIE-TALKIE", Rarity = "Common", FishingPower = 3, SellValueSeconds = 2,
		Color = Color3.fromRGB(60, 60, 60), Description = "Channel 7. Somebody keeps breathing on it." },
	{ Id = "PocketFlashlight", DisplayName = "POCKET FLASHLIGHT", Rarity = "Common", CashPct = 8, SellValueSeconds = 2,
		Color = Color3.fromRGB(240, 220, 120), Description = "Batteries included. Courage not." },
	{ Id = "LuckyArcadeToken", DisplayName = "LUCKY ARCADE TOKEN", Rarity = "Common", LuckPct = 2, SellValueSeconds = 2,
		Color = Color3.fromRGB(220, 180, 60), Description = "From the machine nobody could beat." },
	{ Id = "BaitTin", DisplayName = "BAIT TIN", Rarity = "Common", FishingLuckPct = 8, SellValueSeconds = 2,
		Color = Color3.fromRGB(150, 150, 160), Description = "It wriggles. The tin, not the bait." },
	-- Rare
	{ Id = "StrangeBattery", DisplayName = "STRANGE BATTERY", Rarity = "Rare", CashPct = 18, SellValueSeconds = 4,
		Color = Color3.fromRGB(80, 220, 120), Description = "Never runs out. Hums at night." },
	{ Id = "RiftDetector", DisplayName = "RIFT DETECTOR", Rarity = "Rare", FishingLuckPct = 18, FishingPower = 2, SellValueSeconds = 4,
		Color = Color3.fromRGB(80, 200, 255), Description = "Clicks faster near tears in reality." },
	{ Id = "SignalBooster", DisplayName = "SIGNAL BOOSTER", Rarity = "Rare", FishingPower = 7, SellValueSeconds = 4,
		Color = Color3.fromRGB(200, 200, 210), Description = "Picks up stations that went off air in 1983." },
	{ Id = "MoodRing", DisplayName = "MOOD RING", Rarity = "Rare", LuckPct = 4, SellValueSeconds = 4,
		Color = Color3.fromRGB(120, 80, 255), Description = "Always the same color: uneasy." },
	-- Epic
	{ Id = "PsychicAmplifier", DisplayName = "PSYCHIC AMPLIFIER", Rarity = "Epic", LuckPct = 7, CashPct = 10, SellValueSeconds = 8,
		Color = Color3.fromRGB(140, 160, 255), Description = "Headset prototype. Side effects: yes." },
	{ Id = "CreatureLure", DisplayName = "CREATURE LURE", Rarity = "Epic", FishingLuckPct = 30, FishingPower = 5, SellValueSeconds = 8,
		Color = Color3.fromRGB(255, 120, 60), Description = "Smells like the Otherworld. Unfortunately." },
	{ Id = "TapeRecorder", DisplayName = "EVIDENCE TAPE DECK", Rarity = "Epic", CashPct = 30, SellValueSeconds = 8,
		Color = Color3.fromRGB(90, 70, 60), Description = "Plays the tape backwards. Pays forwards." },
	-- Legendary
	{ Id = "VoidCompass", DisplayName = "VOID COMPASS", Rarity = "Legendary", LuckPct = 12, SellValueSeconds = 15,
		Color = Color3.fromRGB(140, 60, 255), Description = "Points to whatever you will roll next." },
	{ Id = "ContainmentRod", DisplayName = "CONTAINMENT ROD", Rarity = "Legendary", FishingPower = 14, FishingLuckPct = 25, SellValueSeconds = 15,
		Color = Color3.fromRGB(230, 236, 255), Description = "Lab-grade fishing rod. Rated for things with teeth." },
	{ Id = "GoldenCassette", DisplayName = "GOLDEN CASSETTE", Rarity = "Legendary", CashPct = 50, SellValueSeconds = 15,
		Color = Color3.fromRGB(255, 200, 50), Description = "Side B is just money sounds." },
	-- Mythic
	{ Id = "RiftLantern", DisplayName = "RIFT LANTERN", Rarity = "Mythic", LuckPct = 15, FishingLuckPct = 30, SellValueSeconds = 25,
		Color = Color3.fromRGB(170, 90, 255), Description = "Burns with light from the other side." },
	{ Id = "SignalCrown", DisplayName = "SIGNAL CROWN", Rarity = "Mythic", CashPct = 75, SellValueSeconds = 25,
		Color = Color3.fromRGB(255, 72, 120), Description = "Every radio in Milbrook tunes to its wearer." },
	-- Void
	{ Id = "NullEngine", DisplayName = "NULL ENGINE", Rarity = "Void", CashPct = 100, LuckPct = 10, SellValueSeconds = 40,
		Color = Color3.fromRGB(110, 30, 255), Description = "Runs on nothing. Produces everything." },
	{ Id = "AbyssHook", DisplayName = "ABYSS HOOK", Rarity = "Void", FishingPower = 30, FishingLuckPct = 60, SellValueSeconds = 40,
		Color = Color3.fromRGB(20, 0, 40), Description = "It has caught things that caught it back." },
} :: { GearDef }

GearConfig.ById = {} :: { [string]: GearDef }
for _, def in GearConfig.List do
	GearConfig.ById[def.Id] = def
end

function GearConfig.Get(id: string): GearDef?
	return GearConfig.ById[id]
end

return GearConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--!strict
-- MonetizationConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > MonetizationConfig
--
-- Grundsätze:
--   * Kein Pay-to-Win nötig. Alles Spielrelevante ist erspielbar.
--   * KEINE bezahlten zufälligen Characters, keine Robux-Lootboxen,
--     keine Mystery Crates, keine bezahlten Random-Mutationen.
--   * Produkte geben immer einen festen, vorher angezeigten Inhalt.
--
-- Die Ids sind 0, bis du im Creator Dashboard echte Gamepasses/Produkte
-- anlegst und die Ids hier einträgst. Mit Id 0 zeigt der Shop "Coming soon".
-- In Studio kann man mit StudioTestPurchases = true über den Shop testen,
-- ohne Robux auszugeben (Server prüft RunService:IsStudio()).

local MonetizationConfig = {}

MonetizationConfig.StudioTestPurchases = true

MonetizationConfig.Gamepasses = {
	DoubleCash = {
		Id = 0, DisplayName = "2X CASH", PriceHint = 199,
		Description = "Permanently double all cash from your base.",
	},
	DoubleLuck = {
		Id = 0, DisplayName = "2X LUCK", PriceHint = 249,
		Description = "Permanently double your roll luck.",
	},
	FastRoll = {
		Id = 0, DisplayName = "FAST ROLL", PriceHint = 99,
		Description = "Roll 40% faster, forever.",
	},
	ExtraSlots = {
		Id = 0, DisplayName = "+3 BASE SLOTS", PriceHint = 149,
		Description = "Three extra character slots in your base.",
	},
	VIP = {
		Id = 0, DisplayName = "VIP", PriceHint = 299,
		Description = "+10% Cash, +10% Luck, VIP tag, gold base lights and VIP aura.",
	},
	SeasonPremium = {
		Id = 0, DisplayName = "SEASON PASS PREMIUM", PriceHint = 349,
		Description = "Unlocks the premium track of the current season.",
	},
}

-- Werte der Gamepasses (Logic > Modifiers liest diese)
MonetizationConfig.PassEffects = {
	DoubleCash = { CashMultiplier = 2 },
	DoubleLuck = { LuckMultiplier = 2 },
	FastRoll = { RollSpeedPct = 40 },
	ExtraSlots = { BaseSlots = 3 },
	VIP = { CashPct = 10, LuckPct = 10, Cosmetics = { "TitleVIP", "PlateVIP", "AuraVIP", "ThemeVIP" } },
	SeasonPremium = {},
}

-- Developer Products: fester Inhalt, keine Zufallsbelohnungen
--   Kind "Potion": gibt Potions (feste Anzahl)
--   Kind "Cash":   Sekunden aktuelles Base-Einkommen (mit Mindestbetrag)
MonetizationConfig.Products = {
	LuckBoost = {
		Id = 0, DisplayName = "LUCK BOOST (15 MIN)", PriceHint = 39, Kind = "Potion",
		Potions = { SuperLuck = 1, Luck = 1 }, Description = "+75% Luck for ~10 minutes (2 potions).",
	},
	CashPackSmall = {
		Id = 0, DisplayName = "CASH PACK", PriceHint = 25, Kind = "Cash",
		Seconds = 600, Minimum = 5000, Description = "10 minutes of your current base income.",
	},
	CashPackLarge = {
		Id = 0, DisplayName = "CASH VAULT", PriceHint = 99, Kind = "Cash",
		Seconds = 3600, Minimum = 50000, Description = "1 hour of your current base income.",
	},
	PotionPack = {
		Id = 0, DisplayName = "POTION PACK", PriceHint = 49, Kind = "Potion",
		Potions = { Luck = 3, Cash = 3, RollSpeed = 2, FishingLuck = 2 },
		Description = "3 Luck, 3 Cash, 2 Roll Speed, 2 Fishing Luck potions.",
	},
}

return MonetizationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">MutationConfig</string>
            <string name="Source"><![CDATA[--!strict
-- MutationConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > MutationConfig
--
-- Nach jedem Roll würfelt der Server zusätzlich, ob der Character eine Mutation
-- bekommt. Mutationen sind NUR erspielbar (Roll, später Events). Sie werden
-- nicht gegen Robux verkauft.
--
--   Chance          "1 in X" pro Roll (unabhängig vom Character)
--   MoneyMultiplier multipliziert $/s
--   PowerMultiplier multipliziert Power
--   Tint            Farbe, mit der ModelFactory Kleidung/Körper einfärbt
--   TintStrength    0..1 (wie stark gemischt wird)
--   Material        optionales Material für Kleidung
--   Effect          Partikel-Effekt-Id (Visual > AuraLibrary)
--   LuckScaling     Anteil der Roll-Luck, der auf die Mutation wirkt
--                   (0 = gar nicht, 1 = voll). Klein halten, sonst werden
--                   Mutationen im Late Game Standard.

export type MutationDef = {
	Id: string,
	DisplayName: string,
	Order: number,
	Chance: number,
	MoneyMultiplier: number,
	PowerMultiplier: number,
	Color: Color3,
	Tint: Color3?,
	TintStrength: number,
	Material: Enum.Material?,
	Effect: string?,
	LuckScaling: number,
	Announce: boolean,
}

local MutationConfig = {}

MutationConfig.None = "Normal"

MutationConfig.List = {
	{
		Id = "Normal", DisplayName = "NORMAL", Order = 0, Chance = 1,
		MoneyMultiplier = 1, PowerMultiplier = 1,
		Color = Color3.fromRGB(200, 200, 210), Tint = nil, TintStrength = 0,
		Material = nil, Effect = nil, LuckScaling = 0, Announce = false,
	},
	{
		Id = "Electric", DisplayName = "ELECTRIC", Order = 1, Chance = 40,
		MoneyMultiplier = 1.5, PowerMultiplier = 1.25,
		Color = Color3.fromRGB(90, 200, 255), Tint = Color3.fromRGB(90, 200, 255), TintStrength = 0.35,
		Material = nil, Effect = "ElectricSparks", LuckScaling = 0.15, Announce = false,
	},
	{
		Id = "Shadow", DisplayName = "SHADOW", Order = 2, Chance = 80,
		MoneyMultiplier = 2, PowerMultiplier = 1.5,
		Color = Color3.fromRGB(70, 60, 90), Tint = Color3.fromRGB(20, 16, 30), TintStrength = 0.6,
		Material = nil, Effect = "ShadowSmoke", LuckScaling = 0.15, Announce = false,
	},
	{
		Id = "BloodMoon", DisplayName = "BLOOD MOON", Order = 3, Chance = 200,
		MoneyMultiplier = 3, PowerMultiplier = 2,
		Color = Color3.fromRGB(220, 30, 40), Tint = Color3.fromRGB(170, 20, 30), TintStrength = 0.5,
		Material = nil, Effect = "BloodMist", LuckScaling = 0.15, Announce = false,
	},
	{
		Id = "Rift", DisplayName = "RIFT", Order = 4, Chance = 400,
		MoneyMultiplier = 4, PowerMultiplier = 2.5,
		Color = Color3.fromRGB(150, 80, 255), Tint = Color3.fromRGB(120, 60, 230), TintStrength = 0.45,
		Material = Enum.Material.Glass, Effect = "RiftCracks", LuckScaling = 0.15, Announce = false,
	},
	{
		Id = "Golden", DisplayName = "GOLDEN", Order = 5, Chance = 1000,
		MoneyMultiplier = 6, PowerMultiplier = 3,
		Color = Color3.fromRGB(255, 205, 60), Tint = Color3.fromRGB(255, 196, 40), TintStrength = 0.75,
		Material = Enum.Material.Metal, Effect = "GoldSparkle", LuckScaling = 0.15, Announce = true,
	},
	{
		Id = "Void", DisplayName = "VOID", Order = 6, Chance = 5000,
		MoneyMultiplier = 10, PowerMultiplier = 5,
		Color = Color3.fromRGB(110, 30, 255), Tint = Color3.fromRGB(8, 2, 20), TintStrength = 0.85,
		Material = Enum.Material.Neon, Effect = "VoidVortex", LuckScaling = 0.15, Announce = true,
	},
} :: { MutationDef }

MutationConfig.ById = {} :: { [string]: MutationDef }
for _, def in MutationConfig.List do
	MutationConfig.ById[def.Id] = def
end

function MutationConfig.Get(id: string?): MutationDef
	return MutationConfig.ById[id or "Normal"] or MutationConfig.ById.Normal
end

return MutationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">PotionConfig</string>
            <string name="Source"><![CDATA[--!strict
-- PotionConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > PotionConfig
--
-- Potions sind zeitlich begrenzte Boosts. Die Zeit läuft nur, solange der
-- Spieler online ist (wird im Profil als Restsekunden gespeichert).
-- Gleiche Potion nochmal benutzen = Dauer wird addiert (bis MaxDuration).
-- Verschiedene Potions mit gleichem Effekt addieren ihre Amounts.
--
--   Effect: "Luck" | "Cash" | "RollSpeed" | "FishingLuck" | "FishingSpeed" | "MutationLuck"
--   Amount: +Anteil (0.25 = +25 %)

export type PotionDef = {
	Id: string,
	DisplayName: string,
	Effect: string,
	Amount: number,
	Duration: number,
	Rarity: string,
	Color: Color3,
	Description: string,
}

local PotionConfig = {}

PotionConfig.MaxDuration = 3600

PotionConfig.List = {
	{
		Id = "Luck", DisplayName = "LUCK POTION", Effect = "Luck", Amount = 0.25, Duration = 600,
		Rarity = "Common", Color = Color3.fromRGB(90, 220, 120),
		Description = "+25% Luck for 10 minutes.",
	},
	{
		Id = "SuperLuck", DisplayName = "SUPER LUCK POTION", Effect = "Luck", Amount = 0.5, Duration = 600,
		Rarity = "Rare", Color = Color3.fromRGB(60, 255, 160),
		Description = "+50% Luck for 10 minutes.",
	},
	{
		Id = "Cash", DisplayName = "CASH POTION", Effect = "Cash", Amount = 0.5, Duration = 600,
		Rarity = "Common", Color = Color3.fromRGB(255, 210, 60),
		Description = "+50% Cash for 10 minutes.",
	},
	{
		Id = "RollSpeed", DisplayName = "ROLL SPEED POTION", Effect = "RollSpeed", Amount = 0.25, Duration = 300,
		Rarity = "Common", Color = Color3.fromRGB(80, 190, 255),
		Description = "Roll 25% faster for 5 minutes.",
	},
	{
		Id = "FishingLuck", DisplayName = "FISHING LUCK POTION", Effect = "FishingLuck", Amount = 0.5, Duration = 600,
		Rarity = "Rare", Color = Color3.fromRGB(60, 230, 230),
		Description = "+50% Fishing Luck for 10 minutes.",
	},
	{
		Id = "Bait", DisplayName = "RIFT BAIT", Effect = "FishingSpeed", Amount = 0.3, Duration = 600,
		Rarity = "Common", Color = Color3.fromRGB(200, 120, 255),
		Description = "Characters catch 30% faster for 10 minutes.",
	},
	{
		Id = "Mutagen", DisplayName = "STATIC MUTAGEN", Effect = "MutationLuck", Amount = 1.0, Duration = 300,
		Rarity = "Epic", Color = Color3.fromRGB(255, 80, 200),
		Description = "Doubles mutation chances for 5 minutes. Only found, never sold.",
	},
	{
		Id = "VoidElixir", DisplayName = "VOID ELIXIR", Effect = "Luck", Amount = 1.0, Duration = 300,
		Rarity = "Legendary", Color = Color3.fromRGB(140, 60, 255),
		Description = "+100% Luck for 5 minutes.",
	},
} :: { PotionDef }

PotionConfig.ById = {} :: { [string]: PotionDef }
for _, def in PotionConfig.List do
	PotionConfig.ById[def.Id] = def
end

function PotionConfig.Get(id: string): PotionDef?
	return PotionConfig.ById[id]
end

return PotionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">QuestConfig</string>
            <string name="Source"><![CDATA[--!strict
-- QuestConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > QuestConfig
--
-- Daily Quests: Jeden Tag (UTC) werden DailyCount Quests aus dem Pool gezogen.
-- Die Auswahl ist pro Spieler und Tag deterministisch (Seed = UserId + Tag),
-- damit ein Rejoin keine neuen Quests würfelt.
--
--   Counter  Name des Zählers, den die Logik hochzählt (siehe Logic > Quests)
--   Target   benötigte Menge
--   Rewards  CashSeconds (Sekunden aktuelles Einkommen), Potions, SeasonXp, Gear

export type QuestDef = {
	Id: string,
	Text: string,
	Counter: string,
	Target: number,
	Rewards: {
		CashSeconds: number?,
		Potions: { [string]: number }?,
		Gear: string?,
		SeasonXp: number?,
	},
	Weight: number,
}

local QuestConfig = {}

QuestConfig.DailyCount = 5

-- Gültige Zähler (Logic zählt nur diese)
QuestConfig.Counters = {
	Rolls = true,
	RareRolls = true, -- Rare oder besser
	EpicRolls = true, -- Epic oder besser
	Upgrades = true,
	FishingCatches = true,
	Rebirths = true,
	GearEquips = true,
	CashCollected = true,
	PotionsUsed = true,
	Mutations = true,
}

QuestConfig.Pool = {
	{ Id = "Roll50", Text = "Roll 50 times", Counter = "Rolls", Target = 50,
		Rewards = { CashSeconds = 15, SeasonXp = 20 }, Weight = 10 },
	{ Id = "Roll200", Text = "Roll 200 times", Counter = "Rolls", Target = 200,
		Rewards = { CashSeconds = 30, Potions = { Luck = 1 }, SeasonXp = 40 }, Weight = 10 },
	{ Id = "Roll1000", Text = "Roll 1,000 times", Counter = "Rolls", Target = 1000,
		Rewards = { CashSeconds = 75, Potions = { SuperLuck = 1 }, SeasonXp = 80 }, Weight = 4 },
	{ Id = "ObtainRare", Text = "Obtain a Rare+ character", Counter = "RareRolls", Target = 1,
		Rewards = { CashSeconds = 15, SeasonXp = 20 }, Weight = 10 },
	{ Id = "ObtainRare10", Text = "Obtain 10 Rare+ characters", Counter = "RareRolls", Target = 10,
		Rewards = { CashSeconds = 30, Potions = { Cash = 1 }, SeasonXp = 40 }, Weight = 6 },
	{ Id = "ObtainEpic", Text = "Obtain an Epic+ character", Counter = "EpicRolls", Target = 1,
		Rewards = { CashSeconds = 30, Potions = { Luck = 1 }, SeasonXp = 40 }, Weight = 6 },
	{ Id = "Upgrade5", Text = "Upgrade characters 5 times", Counter = "Upgrades", Target = 5,
		Rewards = { CashSeconds = 15, SeasonXp = 20 }, Weight = 10 },
	{ Id = "Upgrade25", Text = "Upgrade characters 25 times", Counter = "Upgrades", Target = 25,
		Rewards = { CashSeconds = 45, Potions = { Cash = 1 }, SeasonXp = 40 }, Weight = 6 },
	{ Id = "Catch10", Text = "Catch 10 fishing items", Counter = "FishingCatches", Target = 10,
		Rewards = { CashSeconds = 22, Potions = { Bait = 1 }, SeasonXp = 30 }, Weight = 8 },
	{ Id = "Catch40", Text = "Catch 40 fishing items", Counter = "FishingCatches", Target = 40,
		Rewards = { CashSeconds = 60, Potions = { FishingLuck = 1 }, SeasonXp = 60 }, Weight = 4 },
	{ Id = "Rebirth1", Text = "Complete a Rebirth", Counter = "Rebirths", Target = 1,
		Rewards = { CashSeconds = 45, Potions = { SuperLuck = 1 }, SeasonXp = 80 }, Weight = 6 },
	{ Id = "EquipGear", Text = "Equip gear on a character", Counter = "GearEquips", Target = 1,
		Rewards = { CashSeconds = 15, SeasonXp = 20 }, Weight = 6 },
	{ Id = "UsePotion", Text = "Use 2 potions", Counter = "PotionsUsed", Target = 2,
		Rewards = { CashSeconds = 15, Potions = { RollSpeed = 1 }, SeasonXp = 20 }, Weight = 5 },
	{ Id = "Mutation", Text = "Roll a mutated character", Counter = "Mutations", Target = 1,
		Rewards = { CashSeconds = 30, Potions = { Luck = 1 }, SeasonXp = 40 }, Weight = 5 },
} :: { QuestDef }

QuestConfig.ById = {} :: { [string]: QuestDef }
for _, q in QuestConfig.Pool do
	QuestConfig.ById[q.Id] = q
end

-- Für neue Spieler: diese Quests sind am ersten Tag garantiert dabei
QuestConfig.FirstDayQuests = { "Roll50", "ObtainRare", "Upgrade5", "Catch10", "Rebirth1" }

return QuestConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RarityConfig</string>
            <string name="Source"><![CDATA[--!strict
-- RarityConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > RarityConfig
--
-- Alle Rarities in aufsteigender Reihenfolge. Die eigentlichen Roll-Chancen
-- stehen pro Character in CharacterConfig (Chance = "1 in X"). Hier stehen nur
-- Darstellung, Reveal-Verhalten und Ökonomie-Faktoren pro Rarity.
--
--   Order            Sortierung (1 = häufigste)
--   TierTarget       Ziel-Wahrscheinlichkeit der gesamten Rarity (nur zur Kontrolle,
--                    der Test "rarity_tiers" prüft, dass die Characters sie treffen)
--   LuckAffected     false = "Rest"-Tier: bekommt, was übrig bleibt (Common)
--   IncomeRange      Ziel-Bereich für BaseMoneyPerSecond der Characters dieser Rarity
--   UpgradeCostFactor  Rarere Characters sind beim Upgraden etwas teurer pro $/s
--   RevealTier       Welche Reveal-Animation der Client spielt (siehe UIConfig.Reveal)
--   RevealSeconds    Server-Pause für Auto-Roll nach diesem Ergebnis (große Reveals
--                    sollen nicht vom nächsten Roll überdeckt werden)
--   Announce         "None" | "Server" | "Global"

export type RarityDef = {
	Id: string,
	DisplayName: string,
	Order: number,
	TierTarget: number,
	LuckAffected: boolean,
	Color: Color3,
	Color2: Color3,
	IncomeRange: { number },
	UpgradeCostFactor: number,
	SellSeconds: number,
	RevealTier: number,
	RevealSeconds: number,
	Announce: string,
	PowerMultiplier: number,
}

local RarityConfig = {}

RarityConfig.List = {
	{
		Id = "Common", DisplayName = "COMMON", Order = 1, TierTarget = 0.7375,
		LuckAffected = false,
		Color = Color3.fromRGB(176, 184, 196), Color2 = Color3.fromRGB(110, 118, 132),
		IncomeRange = { 1, 3 }, UpgradeCostFactor = 1.0, SellSeconds = 20,
		RevealTier = 0, RevealSeconds = 0, Announce = "None", PowerMultiplier = 1,
	},
	{
		Id = "Uncommon", DisplayName = "UNCOMMON", Order = 2, TierTarget = 1 / 5,
		LuckAffected = true,
		Color = Color3.fromRGB(92, 214, 124), Color2 = Color3.fromRGB(34, 140, 74),
		IncomeRange = { 4, 7 }, UpgradeCostFactor = 1.0, SellSeconds = 20,
		RevealTier = 0, RevealSeconds = 0, Announce = "None", PowerMultiplier = 1,
	},
	{
		Id = "Rare", DisplayName = "RARE", Order = 3, TierTarget = 1 / 20,
		LuckAffected = true,
		Color = Color3.fromRGB(64, 156, 255), Color2 = Color3.fromRGB(28, 82, 196),
		IncomeRange = { 14, 24 }, UpgradeCostFactor = 1.05, SellSeconds = 25,
		RevealTier = 1, RevealSeconds = 0, Announce = "None", PowerMultiplier = 1,
	},
	{
		Id = "Epic", DisplayName = "EPIC", Order = 4, TierTarget = 1 / 100,
		LuckAffected = true,
		Color = Color3.fromRGB(176, 92, 255), Color2 = Color3.fromRGB(104, 34, 196),
		IncomeRange = { 50, 80 }, UpgradeCostFactor = 1.1, SellSeconds = 30,
		RevealTier = 2, RevealSeconds = 0.6, Announce = "None", PowerMultiplier = 1,
	},
	{
		Id = "Legendary", DisplayName = "LEGENDARY", Order = 5, TierTarget = 1 / 500,
		LuckAffected = true,
		Color = Color3.fromRGB(255, 188, 52), Color2 = Color3.fromRGB(214, 112, 20),
		IncomeRange = { 180, 300 }, UpgradeCostFactor = 1.15, SellSeconds = 40,
		RevealTier = 3, RevealSeconds = 1.6, Announce = "None", PowerMultiplier = 1,
	},
	{
		Id = "Mythic", DisplayName = "MYTHIC", Order = 6, TierTarget = 1 / 2500,
		LuckAffected = true,
		Color = Color3.fromRGB(255, 72, 120), Color2 = Color3.fromRGB(180, 20, 70),
		IncomeRange = { 700, 1100 }, UpgradeCostFactor = 1.2, SellSeconds = 45,
		RevealTier = 4, RevealSeconds = 2.2, Announce = "Server", PowerMultiplier = 1,
	},
	{
		Id = "Supernatural", DisplayName = "SUPERNATURAL", Order = 7, TierTarget = 1 / 10000,
		LuckAffected = true,
		Color = Color3.fromRGB(64, 236, 236), Color2 = Color3.fromRGB(20, 120, 170),
		IncomeRange = { 2600, 4200 }, UpgradeCostFactor = 1.25, SellSeconds = 50,
		RevealTier = 5, RevealSeconds = 3, Announce = "Server", PowerMultiplier = 1,
	},
	{
		Id = "Void", DisplayName = "VOID", Order = 8, TierTarget = 1 / 50000,
		LuckAffected = true,
		Color = Color3.fromRGB(140, 60, 255), Color2 = Color3.fromRGB(16, 6, 40),
		IncomeRange = { 10000, 16000 }, UpgradeCostFactor = 1.3, SellSeconds = 60,
		RevealTier = 6, RevealSeconds = 3.5, Announce = "Server", PowerMultiplier = 1,
	},
	{
		Id = "Secret", DisplayName = "SECRET", Order = 9, TierTarget = 1 / 250000,
		LuckAffected = true,
		Color = Color3.fromRGB(255, 40, 40), Color2 = Color3.fromRGB(20, 0, 0),
		IncomeRange = { 45000, 70000 }, UpgradeCostFactor = 1.35, SellSeconds = 60,
		RevealTier = 7, RevealSeconds = 4.5, Announce = "Global", PowerMultiplier = 1,
	},
	{
		Id = "Anomaly", DisplayName = "ANOMALY", Order = 10, TierTarget = 7e-7, -- 1/2.5M + 1/5M + 1/10M
		LuckAffected = true,
		Color = Color3.fromRGB(255, 255, 255), Color2 = Color3.fromRGB(0, 255, 200),
		IncomeRange = { 220000, 400000 }, UpgradeCostFactor = 1.4, SellSeconds = 60,
		RevealTier = 8, RevealSeconds = 5.5, Announce = "Global", PowerMultiplier = 1,
	},
} :: { RarityDef }

RarityConfig.ById = {} :: { [string]: RarityDef }
for _, def in RarityConfig.List do
	RarityConfig.ById[def.Id] = def
end

function RarityConfig.Get(id: string): RarityDef
	local def = RarityConfig.ById[id]
	assert(def, "Unbekannte Rarity: " .. tostring(id))
	return def
end

function RarityConfig.Order(id: string): number
	local def = RarityConfig.ById[id]
	return if def then def.Order else 0
end

-- Für UI-Gradients: "Anomaly" bekommt einen animierten Regenbogen, den Rest
-- macht der Client über Color/Color2.
RarityConfig.RainbowRarities = { Anomaly = true, Secret = false }

return RarityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">RebirthConfig</string>
            <string name="Source"><![CDATA[--!strict
-- RebirthConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > RebirthConfig
--
-- Rebirth setzt NUR die Cash-Progression zurück:
--   * Cash und Vault -> 0
--   * Character-Level -> 1
-- Bleibt erhalten: alle Characters, Mutationen, Gear, Potions, Dice, Gebiete,
-- Index, Cosmetics, Titel, Käufe, Stats.
--
-- Jede Stufe hat Kosten (Cash, wird verbraucht) und Belohnungen. Belohnungen
-- sind kumulativ (Rebirth 3 hat auch alles von 1 und 2).
-- Nach der Tabelle geht es per Formel weiter (Cost * Growth, kleine Boni).

export type RebirthReward = {
	CashPct: number?,
	LuckPct: number?,
	BaseSlots: number?,
	FishingSlots: number?,
	GearSlots: number?,
	AutoCollect: boolean?,
	Title: string?,
}

export type RebirthStep = {
	Cost: number,
	Rewards: RebirthReward,
}

local RebirthConfig = {}

RebirthConfig.Steps = {
	[1] = { Cost = 220000, Rewards = { CashPct = 10, BaseSlots = 2, AutoCollect = true } },
	[2] = { Cost = 5700000, Rewards = { LuckPct = 10, FishingSlots = 1 } },
	[3] = { Cost = 32000000, Rewards = { CashPct = 15, BaseSlots = 2 } },
	[4] = { Cost = 69000000, Rewards = { LuckPct = 10, GearSlots = 1 } },
	[5] = { Cost = 280000000, Rewards = { CashPct = 15, BaseSlots = 2, Title = "RiftWalker" } },
	[6] = { Cost = 450000000, Rewards = { LuckPct = 15, FishingSlots = 1 } },
	[7] = { Cost = 1100000000, Rewards = { CashPct = 20, BaseSlots = 3 } },
	[8] = { Cost = 2400000000, Rewards = { LuckPct = 15 } },
	[9] = { Cost = 6700000000, Rewards = { CashPct = 20, FishingSlots = 1 } },
	[10] = { Cost = 19000000000, Rewards = { LuckPct = 20, BaseSlots = 4, Title = "VoidSeeker" } },
	[11] = { Cost = 53000000000, Rewards = { CashPct = 20 } },
	[12] = { Cost = 150000000000, Rewards = { LuckPct = 20, Title = "TheSurvivor" } },
} :: { [number]: RebirthStep }

RebirthConfig.TableSize = #RebirthConfig.Steps

-- Nach der Tabelle:
RebirthConfig.AfterTable = {
	CostGrowth = 2.8,
	Rewards = { CashPct = 10, LuckPct = 5 },
}

function RebirthConfig.GetStep(rebirthNumber: number): RebirthStep
	local step = RebirthConfig.Steps[rebirthNumber]
	if step then
		return step
	end
	local last = RebirthConfig.Steps[RebirthConfig.TableSize]
	local extra = rebirthNumber - RebirthConfig.TableSize
	return {
		Cost = math.floor(last.Cost * RebirthConfig.AfterTable.CostGrowth ^ extra),
		Rewards = RebirthConfig.AfterTable.Rewards,
	}
end

-- Summe aller Belohnungen bis einschließlich `rebirths`
function RebirthConfig.Accumulate(rebirths: number)
	local total = { CashPct = 0, LuckPct = 0, BaseSlots = 0, FishingSlots = 0, GearSlots = 0, AutoCollect = false, Titles = {} }
	for i = 1, rebirths do
		local r = RebirthConfig.GetStep(i).Rewards
		total.CashPct += r.CashPct or 0
		total.LuckPct += r.LuckPct or 0
		total.BaseSlots += r.BaseSlots or 0
		total.FishingSlots += r.FishingSlots or 0
		total.GearSlots += r.GearSlots or 0
		if r.AutoCollect then
			total.AutoCollect = true
		end
		if r.Title then
			table.insert(total.Titles, r.Title)
		end
	end
	return total
end

return RebirthConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">SeasonConfig</string>
            <string name="Source"><![CDATA[--!strict
-- SeasonConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > SeasonConfig
--
-- Season Pass: Free Track + Premium Track. XP kommt aus Quests und
-- Achievements. Premium wird über den Gamepass "SeasonPremium" freigeschaltet
-- (MonetizationConfig). Premium-Belohnungen sind nur Cosmetics, Potions und
-- Cash, nie Characters.
--
-- Neue Season: Id ändern, Tiers austauschen. Fortschritt einer alten Season
-- wird beim Join automatisch zurückgesetzt (Logic > Season).

local SeasonConfig = {}

SeasonConfig.Id = "S1"
SeasonConfig.DisplayName = "SEASON 1: SIGNAL LOST"
SeasonConfig.XpPerTier = 100
SeasonConfig.Enabled = true

-- Reward: { Kind = "Cash", Seconds = n } | { Kind = "Potion", Id, Amount }
--         { Kind = "Cosmetic", Id } | { Kind = "Gear", Id }
local function cash(seconds: number)
	return { Kind = "Cash", Seconds = seconds }
end
local function potion(id: string, amount: number)
	return { Kind = "Potion", Id = id, Amount = amount }
end
local function cosmetic(id: string)
	return { Kind = "Cosmetic", Id = id }
end
local function gear(id: string)
	return { Kind = "Gear", Id = id }
end

SeasonConfig.Tiers = {
	{ Free = cash(60), Premium = potion("Luck", 2) },
	{ Free = potion("Luck", 1), Premium = cash(180) },
	{ Free = cash(90), Premium = cosmetic("PlateCRT") },
	{ Free = potion("Bait", 2), Premium = potion("SuperLuck", 1) },
	{ Free = gear("SignalBooster"), Premium = cosmetic("TrailNeon") },
	{ Free = cash(120), Premium = potion("Cash", 3) },
	{ Free = potion("RollSpeed", 2), Premium = cosmetic("RollCRT") },
	{ Free = cash(150), Premium = gear("PsychicAmplifier") },
	{ Free = potion("SuperLuck", 1), Premium = cosmetic("ThemeRedAlert") },
	{ Free = cosmetic("TitleSignalLost"), Premium = cosmetic("AuraSeasonRift") },
	{ Free = cash(240), Premium = potion("VoidElixir", 1) },
	{ Free = potion("FishingLuck", 2), Premium = gear("GoldenCassette") },
} :: { { Free: any, Premium: any } }

return SeasonConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--!strict
-- SoundConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > SoundConfig
--
-- Alle Sounds an einer Stelle. Die Platzhalter nutzen Sounds, die in jedem
-- Roblox-Client eingebaut sind (rbxasset://sounds/...), variiert über Pitch.
-- Für das Release eigene oder lizenzierte Sounds hochladen und hier die
-- rbxassetid://... eintragen. KEINE Musik aus Stranger Things o. ä. verwenden.
--
-- Ambience/Musik: leer lassen = kein Loop. Eigene Tracks eintragen, der
-- AmbienceController blendet pro Gebiet über.

export type SoundDef = {
	Id: string,
	Volume: number,
	Pitch: number?,
	-- mehrere Layer gleichzeitig (z. B. Bass + Whoosh für Void)
	Layers: { { Id: string, Volume: number, Pitch: number?, Delay: number? } }?,
}

local SoundConfig = {}

local CLICK = "rbxasset://sounds/clickfast.wav"
local BUTTON = "rbxasset://sounds/button.wav"
local SWOOSH = "rbxasset://sounds/swoosh.wav"
local PING = "rbxasset://sounds/electronicpingshort.wav"
local SPLASH = "rbxasset://sounds/impact_water.mp3"
local SNAP = "rbxasset://sounds/snap.mp3"

SoundConfig.Sounds = {
	UIClick = { Id = BUTTON, Volume = 0.35, Pitch = 1.1 },
	UIOpen = { Id = SWOOSH, Volume = 0.25, Pitch = 1.4 },
	UIError = { Id = CLICK, Volume = 0.4, Pitch = 0.6 },
	Collect = { Id = PING, Volume = 0.4, Pitch = 1.3 },
	Upgrade = { Id = PING, Volume = 0.45, Pitch = 1.6 },
	Purchase = { Id = PING, Volume = 0.5, Pitch = 1.0 },
	Rebirth = { Id = SWOOSH, Volume = 0.7, Pitch = 0.5, Layers = { { Id = PING, Volume = 0.5, Pitch = 0.6, Delay = 0.2 } } },
	FishingCatch = { Id = SPLASH, Volume = 0.5, Pitch = 1.1 },
	FishingBigCatch = { Id = SPLASH, Volume = 0.7, Pitch = 0.7, Layers = { { Id = PING, Volume = 0.5, Pitch = 0.9, Delay = 0.15 } } },
	Quest = { Id = PING, Volume = 0.5, Pitch = 1.2 },
	Achievement = { Id = PING, Volume = 0.6, Pitch = 0.9, Layers = { { Id = PING, Volume = 0.4, Pitch = 1.35, Delay = 0.12 } } },
	Announcement = { Id = PING, Volume = 0.6, Pitch = 0.75 },

	-- Roll: pro Reveal-Stufe (RarityConfig.RevealTier)
	RollTick = { Id = CLICK, Volume = 0.25, Pitch = 1.5 },
	Reveal0 = { Id = SWOOSH, Volume = 0.25, Pitch = 1.6 },
	Reveal1 = { Id = SWOOSH, Volume = 0.35, Pitch = 1.3, Layers = { { Id = PING, Volume = 0.25, Pitch = 1.5 } } },
	Reveal2 = { Id = SWOOSH, Volume = 0.45, Pitch = 1.0, Layers = { { Id = PING, Volume = 0.35, Pitch = 1.2 } } },
	Reveal3 = { Id = SWOOSH, Volume = 0.6, Pitch = 0.8, Layers = { { Id = PING, Volume = 0.45, Pitch = 1.0 }, { Id = PING, Volume = 0.35, Pitch = 1.5, Delay = 0.18 } } },
	Reveal4 = { Id = SWOOSH, Volume = 0.7, Pitch = 0.6, Layers = { { Id = PING, Volume = 0.5, Pitch = 0.8 }, { Id = PING, Volume = 0.4, Pitch = 1.2, Delay = 0.2 } } },
	Reveal5 = { Id = SWOOSH, Volume = 0.8, Pitch = 0.45, Layers = { { Id = PING, Volume = 0.55, Pitch = 0.6 }, { Id = SNAP, Volume = 0.4, Pitch = 0.5, Delay = 0.3 } } },
	Reveal6 = { Id = SWOOSH, Volume = 0.9, Pitch = 0.3, Layers = { { Id = PING, Volume = 0.6, Pitch = 0.4 }, { Id = SNAP, Volume = 0.5, Pitch = 0.3, Delay = 0.4 } } },
	Reveal7 = { Id = SWOOSH, Volume = 1, Pitch = 0.25, Layers = { { Id = PING, Volume = 0.7, Pitch = 0.3 }, { Id = PING, Volume = 0.5, Pitch = 0.6, Delay = 0.5 }, { Id = SNAP, Volume = 0.6, Pitch = 0.25, Delay = 0.9 } } },
	Reveal8 = { Id = SWOOSH, Volume = 1, Pitch = 0.2, Layers = { { Id = PING, Volume = 0.8, Pitch = 0.25 }, { Id = PING, Volume = 0.6, Pitch = 0.5, Delay = 0.6 }, { Id = PING, Volume = 0.6, Pitch = 1.0, Delay = 1.2 }, { Id = SNAP, Volume = 0.7, Pitch = 0.2, Delay = 1.5 } } },
} :: { [string]: SoundDef }

-- Ambience pro Gebiet (AreaConfig.Ambience). Leer = aus.
SoundConfig.Ambience = {
	Suburb = { Id = "", Volume = 0.35 }, -- 80s Mystery Synth (eigene Komposition einsetzen)
	Forest = { Id = "", Volume = 0.4 }, -- Wind / Insekten
	Lab = { Id = "", Volume = 0.35 }, -- elektrisches Brummen
	Rift = { Id = "", Volume = 0.4 },
	Otherworld = { Id = "", Volume = 0.4 }, -- dunkle Atmosphäre
	Void = { Id = "", Volume = 0.45 }, -- sehr tiefes, seltsames Dröhnen
}

return SoundConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">UIConfig</string>
            <string name="Source"><![CDATA[--!strict
-- UIConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > UIConfig
--
-- Farben, Schriften, Größen und Reveal-Timings. Moderne Roblox-UI mit
-- 80s/CRT-Details: dunkles Navy/Schwarz, Lila, Electric Blue, rote Akzente.

local UIConfig = {}

UIConfig.Colors = {
	Background = Color3.fromRGB(8, 9, 22),
	Panel = Color3.fromRGB(14, 16, 36),
	PanelLight = Color3.fromRGB(24, 27, 58),
	Stroke = Color3.fromRGB(70, 60, 160),
	Text = Color3.fromRGB(236, 238, 255),
	SubText = Color3.fromRGB(150, 156, 200),
	Purple = Color3.fromRGB(140, 70, 255),
	Blue = Color3.fromRGB(50, 160, 255),
	Red = Color3.fromRGB(255, 56, 72),
	Green = Color3.fromRGB(70, 230, 120),
	Gold = Color3.fromRGB(255, 200, 60),
	Cash = Color3.fromRGB(110, 255, 140),
	Luck = Color3.fromRGB(110, 230, 255),
	Disabled = Color3.fromRGB(60, 62, 84),
	CRTGreen = Color3.fromRGB(80, 255, 140),
}

UIConfig.Fonts = {
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamBold,
	Mono = Enum.Font.Code,
}

UIConfig.CornerRadius = 12
UIConfig.StrokeThickness = 2

-- Mobile: Mindestgröße für Touch-Ziele (Pixel bei UIScale 1)
UIConfig.MinTouchSize = 48
-- Referenzauflösung für UIScale (kleinere Bildschirme werden skaliert)
UIConfig.ReferenceResolution = Vector2.new(1000, 560)
UIConfig.MinScale = 0.65
UIConfig.MaxScale = 1.25

-- Reveal-Stufen (RarityConfig.RevealTier). Duration = gesamte Zeit, die das
-- Reveal auf dem Schirm ist. Commons sind fast instant.
UIConfig.Reveal = {
	[0] = { Duration = 0.55, Spin = 0.18, Flash = 0, Shake = 0, Zoom = 0, Banner = false },
	[1] = { Duration = 0.8, Spin = 0.3, Flash = 0.15, Shake = 0, Zoom = 0, Banner = false },
	[2] = { Duration = 1.1, Spin = 0.4, Flash = 0.35, Shake = 0, Zoom = 0, Banner = false },
	[3] = { Duration = 1.9, Spin = 0.7, Flash = 0.6, Shake = 0.2, Zoom = 4, Banner = true },
	[4] = { Duration = 2.5, Spin = 0.9, Flash = 0.75, Shake = 0.35, Zoom = 8, Banner = true },
	[5] = { Duration = 3.2, Spin = 1.2, Flash = 0.85, Shake = 0.5, Zoom = 12, Banner = true },
	[6] = { Duration = 3.8, Spin = 1.5, Flash = 1, Shake = 0.7, Zoom = 15, Banner = true, Blackout = true },
	[7] = { Duration = 4.8, Spin = 2.0, Flash = 1, Shake = 0.9, Zoom = 18, Banner = true, Blackout = true, Glitch = true },
	[8] = { Duration = 5.8, Spin = 2.4, Flash = 1, Shake = 1, Zoom = 22, Banner = true, Blackout = true, Glitch = true, Rainbow = true },
}

-- Idle-Animationssets (BaseAnimator). Werte sind Amplituden/Frequenzen.
UIConfig.AnimationSets = {
	Default = { Bob = 0.08, BobSpeed = 1.6, HeadTurn = 15, ArmSwing = 6 },
	Flashlight = { Bob = 0.06, BobSpeed = 1.4, HeadTurn = 25, ArmSwing = 4, ArmRaise = 70, Sweep = 35 },
	Walkie = { Bob = 0.06, BobSpeed = 1.5, HeadTurn = 10, ArmSwing = 2, ArmRaise = 110, Talk = true },
	LookAround = { Bob = 0.05, BobSpeed = 1.2, HeadTurn = 45, ArmSwing = 3 },
	Sit = { Bob = 0.02, BobSpeed = 0.8, HeadTurn = 20, ArmSwing = 2, Sit = true },
	Investigate = { Bob = 0.04, BobSpeed = 1.0, HeadTurn = 20, ArmSwing = 3, HeadTilt = 25, ArmRaise = 40 },
	Talk = { Bob = 0.07, BobSpeed = 2.2, HeadTurn = 18, ArmSwing = 25 },
	Psychic = { Bob = 0.35, BobSpeed = 1.0, HeadTurn = 8, ArmSwing = 0, ArmRaise = 80, Hover = 0.8, BothArms = true },
	Float = { Bob = 0.6, BobSpeed = 0.7, HeadTurn = 12, ArmSwing = 10, Hover = 1.5, Spin = 0 },
	Creature = { Bob = 0.12, BobSpeed = 2.4, HeadTurn = 35, ArmSwing = 12, Breathe = 0.06 },
	Crawler = { Bob = 0.05, BobSpeed = 4.0, HeadTurn = 25, ArmSwing = 0, Jitter = 0.08 },
	Hover = { Bob = 0.5, BobSpeed = 1.2, HeadTurn = 20, ArmSwing = 0, Hover = 2, WingFlap = 40 },
	Pulse = { Bob = 0.2, BobSpeed = 0.9, HeadTurn = 0, ArmSwing = 0, Pulse = 0.08, Spin = 12 },
	Serpent = { Bob = 0.1, BobSpeed = 1.6, HeadTurn = 30, ArmSwing = 0, Sway = 12 },
	Heavy = { Bob = 0.04, BobSpeed = 0.6, HeadTurn = 15, ArmSwing = 5, Breathe = 0.04 },
}

-- Performance
UIConfig.AnimateDistance = 140 -- Studs: weiter weg werden Base-Models nicht animiert
UIConfig.MaxAnimatedModels = 70
UIConfig.ViewportCacheSize = 40

-- Zahlformat
UIConfig.NumberSuffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

return UIConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">WorldConfig</string>
            <string name="Source"><![CDATA[--!strict
-- WorldConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > WorldConfig
--
-- Layout-Konstanten für die Map. Map und Services lesen beide von hier, damit
-- Positionen nicht doppelt gepflegt werden.
--
-- Draufsicht (Norden = -Z):
--
--             [ VOID ]          z = -1590
--           [ OTHERWORLD ]      z = -1310
--           [ RIFT ZONE ]       z = -1030
--           [ SECRET LAB ]      z =  -750
--           [ DARK FOREST ]     z =  -470
--                 |  Signal Road
--          P8     |     P1          Ring aus 8 Plots (Radius 225) um den Hub,
--   P7   Fishing (PLAZA) Arcade  P2  davor eine achteckige Ringstraße
--   P6      Shop         Rebirth P3
--          Index          Quests
--          P5  [LEADERBOARDS]  P4

local WorldConfig = {}

WorldConfig.WorldFolderName = "VoidDiceWorld"
WorldConfig.GroundY = 0

-- Hub / Roll Plaza
WorldConfig.HubCenter = Vector3.new(0, 0, 0)
WorldConfig.PlazaRadius = 42
WorldConfig.SpawnOffset = Vector3.new(0, 3, 18)

-- Plots (Player Bases)
WorldConfig.PlotCount = 8
-- 225 statt 190: Bei 190 ragten die Vorderecken von Plot 1/8 bis x = ±10 in die
-- Signal Road (Breite 34). Mit 225 bleiben ~6 Studs Abstand zur Straße.
WorldConfig.PlotRingRadius = 225
WorldConfig.PlotSize = Vector3.new(96, 1, 96)
-- Winkel des ersten Plots (Grad, 0 = Norden). 22.5 lässt Norden für die
-- Signal Road frei.
WorldConfig.PlotAngleOffset = 22.5

-- Slot-Raster in Plot-Koordinaten (X = rechts, Z = nach hinten/weg vom Hub)
WorldConfig.SlotColumns = 5
WorldConfig.SlotRows = 5
WorldConfig.SlotSpacing = 12
WorldConfig.SlotPadSize = Vector3.new(9, 1, 9)
WorldConfig.SlotGridOrigin = Vector3.new(-40, 0, -10) -- Mitte des ersten Pads (linke Hälfte)

-- Rift Pond in jeder Base
WorldConfig.MaxFishingSeats = 4
WorldConfig.PondCenter = Vector3.new(30, 0, 16)
WorldConfig.PondRadius = 11

-- Sonstiges in der Base
WorldConfig.CollectorOffset = Vector3.new(30, 0, -26)
-- Hinten rechts: die "Investigation Station" (CRTs, Antenne, Mystery Board)
WorldConfig.StationOffset = Vector3.new(30, 0, 40)
WorldConfig.PlotSpawnOffset = Vector3.new(0, 3, -40)
WorldConfig.SignOffset = Vector3.new(-30, 0, -45)

-- Stationen im Hub (Weltkoordinaten)
-- Alle Stationen schauen zur Plaza-Mitte. Zwischen Index und Quests bleibt eine
-- freie Sichtachse von der Plaza zur Leaderboard-Wand im Süden.
WorldConfig.Stations = {
	Shop = Vector3.new(-60, 0, 30),
	Rebirth = Vector3.new(60, 0, 30),
	Index = Vector3.new(-66, 0, 78),
	Quests = Vector3.new(66, 0, 78),
	Fishing = Vector3.new(-86, 0, 0),
	Leaderboards = Vector3.new(0, 0, 120),
}

-- Signal Road und Tore zwischen den Gebieten
WorldConfig.RoadWidth = 34
WorldConfig.GateWidth = 34
WorldConfig.GateHeight = 26

-- Wie oft (Sekunden) der Client die aktuelle Zone prüft
WorldConfig.AreaCheckInterval = 0.5

function WorldConfig.PlotCFrame(index: number): CFrame
	local angle = math.rad(WorldConfig.PlotAngleOffset + (index - 1) * (360 / WorldConfig.PlotCount))
	-- Winkel 0 = Norden (-Z), im Uhrzeigersinn
	local dir = Vector3.new(math.sin(angle), 0, -math.cos(angle))
	local pos = WorldConfig.HubCenter + dir * WorldConfig.PlotRingRadius
	-- Plot "schaut" zum Hub: LookVector zeigt zur Mitte (= -dir).
	-- Bewusst über CFrame.Angles statt CFrame.lookAt: lookAt ist im Lune-Test-
	-- Emulator (0.8.9) fehlerhaft (Z-Komponente gespiegelt). Angles(0, a, 0)
	-- dreht (0,0,-1) auf (-sin a, 0, -cos a); mit a = pi - angle ergibt das -dir.
	return CFrame.new(pos) * CFrame.Angles(0, math.pi - angle, 0)
end

-- Lokale Plot-Koordinate: X nach rechts, Z nach hinten (weg vom Hub).
function WorldConfig.PlotLocal(plotCFrame: CFrame, offset: Vector3): CFrame
	return plotCFrame * CFrame.new(offset.X, offset.Y, offset.Z)
end

function WorldConfig.SlotLocalPosition(slotIndex: number): Vector3
	local i = slotIndex - 1
	local col = i % WorldConfig.SlotColumns
	local row = math.floor(i / WorldConfig.SlotColumns)
	return WorldConfig.SlotGridOrigin + Vector3.new(col * WorldConfig.SlotSpacing, 0, row * WorldConfig.SlotSpacing)
end

return WorldConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Net (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Net
--
-- Drei Remotes reichen für das ganze Spiel:
--   Action  (Client -> Server)  Action(name, ...)  – jede Spieleraktion
--   Sync    (Server -> Client)  Sync(patch)        – Zustand (Profil-Ansicht)
--   Event   (Server -> Client)  Event(kind, data)  – Roll-Ergebnisse, Toasts, Ansagen
--
-- Der Client schickt NUR Wünsche ("Roll", "Upgrade c12"). Ergebnisse, Kosten
-- und Zufall entscheidet immer der Server.

local RunService = game:GetService("RunService")

local Net = {}

Net.FolderName = "Remotes"
Net.Names = { "Action", "Sync", "Event" }

-- Alle erlaubten Actions mit Argument-Typen. Der Server lehnt alles andere ab.
-- Typen: "string", "number", "boolean", "uid" (kurzer String), "id" (Config-Id)
Net.Actions = {
	Roll = {},
	SetAutoRoll = { "boolean" },
	EquipDice = { "id" },
	BuyDice = { "id" },
	UnlockArea = { "id" },
	Teleport = { "id" },
	PlaceCharacter = { "uid" },
	RemoveCharacter = { "uid" },
	PlaceBest = {},
	UpgradeCharacter = { "uid", "number" },
	SellCharacter = { "uid" },
	SellRarity = { "id" },
	LockCharacter = { "uid", "boolean" },
	SendFishing = { "uid" },
	RecallFishing = { "uid" },
	SetWaters = { "id" },
	EquipGear = { "uid", "uid" },
	UnequipGear = { "uid" },
	SellGear = { "uid" },
	SellRelic = { "id" },
	UsePotion = { "id" },
	Collect = {},
	Rebirth = {},
	SetSetting = { "id", "any" },
	SetAutoDelete = { "id", "boolean" },
	ClaimQuest = { "id" },
	ClaimSeason = { "id", "number" },
	EquipCosmetic = { "id", "id" },
	TutorialStep = { "id" },
	SkipTutorial = {},
	ReplayTutorial = {},
	InspectBase = { "number" },
	TestPurchase = { "id", "id" }, -- nur Studio (MonetizationConfig.StudioTestPurchases)
	Debug = { "id", "any" }, -- nur Studio (GameConfig.StudioDebugTools)
}

local remotes: { [string]: RemoteEvent } = {}

local function folder(): Folder
	local parent = script.Parent
	if RunService:IsServer() then
		local f = parent:FindFirstChild(Net.FolderName)
		if not f then
			f = Instance.new("Folder")
			f.Name = Net.FolderName
			f.Parent = parent
		end
		return f :: Folder
	end
	return parent:WaitForChild(Net.FolderName) :: Folder
end

function Net.get(name: string): RemoteEvent
	local existing = remotes[name]
	if existing then
		return existing
	end
	local f = folder()
	local remote: RemoteEvent
	if RunService:IsServer() then
		remote = (f:FindFirstChild(name) :: RemoteEvent?) or Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = f
	else
		remote = f:WaitForChild(name) :: RemoteEvent
	end
	remotes[name] = remote
	return remote
end

-- Server: alle Remotes anlegen
function Net.setup()
	for _, name in Net.Names do
		Net.get(name)
	end
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Format (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Util > Format
--
-- Zahlen und Zeiten lesbar machen: $1.25M, 1 in 2.5M, 4m 05s.

local UIConfig = require(script.Parent.Parent:WaitForChild("Config"):WaitForChild("UIConfig"))

local Format = {}

local SUFFIXES = UIConfig.NumberSuffixes

-- 1234 -> "1,234"
function Format.commas(n: number): string
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if negative then "-" else "") .. out
end

-- 1234567 -> "1.23M"
function Format.short(n: number, decimals: number?): string
	if n ~= n then
		return "0"
	end
	if n == math.huge then
		return "∞"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = if n == math.floor(n) or n >= 100 then tostring(math.floor(n)) else string.format("%.1f", n)
		return (if negative then "-" else "") .. s
	end
	local exponent = math.min(#SUFFIXES - 1, math.floor(math.log10(n) / 3))
	local value = n / 10 ^ (exponent * 3)
	local d = decimals or (if value < 10 then 2 elseif value < 100 then 1 else 0)
	local s = string.format("%." .. d .. "f", value)
	-- "1.50" -> "1.5", "2.00" -> "2"
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	if exponent >= #SUFFIXES - 1 and n >= 1e36 then
		return (if negative then "-" else "") .. string.format("%.2e", n)
	end
	return (if negative then "-" else "") .. s .. SUFFIXES[exponent + 1]
end

function Format.cash(n: number): string
	return "$" .. Format.short(n)
end

function Format.perSecond(n: number): string
	return "$" .. Format.short(n) .. "/s"
end

-- Wahrscheinlichkeit p -> "1 in 2.5M"
function Format.chance(p: number): string
	if p <= 0 then
		return "1 in ∞"
	end
	local x = 1 / p
	if x < 10 then
		return "1 in " .. string.format("%.1f", x):gsub("%.0$", "")
	end
	if x < 100000 then
		return "1 in " .. Format.commas(math.floor(x + 0.5))
	end
	return "1 in " .. Format.short(x)
end

-- "1 in X" direkt
function Format.oneIn(x: number): string
	if x < 100000 then
		return "1 in " .. Format.commas(math.floor(x + 0.5))
	end
	return "1 in " .. Format.short(x)
end

function Format.percent(p: number, decimals: number?): string
	return string.format("%." .. (decimals or 1) .. "f%%", p * 100)
end

-- 305 -> "5m 05s"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

function Format.multiplier(x: number): string
	if x >= 100 then
		return "x" .. Format.short(x)
	end
	local s = string.format("%.2f", x):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. s
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Odds</string>
            <string name="Source"><![CDATA[--!strict
-- Odds (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Util > Odds
--
-- Baut aus den Configs die RollMath-Tabellen (einmal, dann gecacht).
-- Server nutzt sie zum Ziehen, Client für die Anzeige im Index/HUD.

local Config = script.Parent.Parent:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local RollMath = require(script.Parent:WaitForChild("RollMath"))

local Odds = {}

local characterTable: RollMath.Table? = nil
local characterIndex: { [string]: number } = {}
local watersTables: { [string]: RollMath.Table } = {}

function Odds.characterTable(): RollMath.Table
	if characterTable then
		return characterTable
	end
	local entries = {}
	for _, def in CharacterConfig.List do
		if def.ReleaseEnabled then
			local rarity = RarityConfig.Get(def.Rarity)
			table.insert(entries, { Key = def.Id, Chance = def.RollChance, Boosted = rarity.LuckAffected })
			characterIndex[def.Id] = #entries
		end
	end
	local tbl = RollMath.newTable(entries)
	characterTable = tbl
	return tbl
end

-- Echte Wahrscheinlichkeit eines Characters bei `luck` (0 wenn nicht rollbar)
function Odds.characterProbability(id: string, luck: number): number
	local tbl = Odds.characterTable()
	local i = characterIndex[id]
	if not i then
		return 0
	end
	return RollMath.probabilities(tbl, luck)[i]
end

-- { [RarityId] = Wahrscheinlichkeit } bei `luck`
function Odds.rarityProbabilities(luck: number): { [string]: number }
	local tbl = Odds.characterTable()
	local probs = RollMath.probabilities(tbl, luck)
	local out = {}
	for _, r in RarityConfig.List do
		out[r.Id] = 0
	end
	for i, e in tbl.Entries do
		local def = CharacterConfig.ById[e.Key]
		out[def.Rarity] += probs[i]
	end
	return out
end

function Odds.watersTable(watersId: string): RollMath.Table?
	local cached = watersTables[watersId]
	if cached then
		return cached
	end
	local waters = FishingConfig.WatersById[watersId]
	if not waters then
		return nil
	end
	local entries = {}
	for _, loot in waters.Loot do
		-- Fishing Luck wirkt erst ab Rare (Common/Uncommon sind der "Rest")
		local order = RarityConfig.Order(loot.Rarity)
		table.insert(entries, { Key = loot, Chance = loot.Chance, Boosted = order >= 3 })
	end
	local tbl = RollMath.newTable(entries)
	watersTables[watersId] = tbl
	return tbl
end

return Odds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RollMath</string>
            <string name="Source"><![CDATA[--!strict
-- RollMath (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Util > RollMath
--
-- Die gesamte Zufalls-Mathematik für Character-Rolls und Fishing-Loot.
-- Server UND Client nutzen dasselbe Modul: Der Server zieht, der Client zeigt
-- exakt dieselben Wahrscheinlichkeiten an. Keine Fake-Luck.
--
-- Modell:
--   Jeder Eintrag hat eine Basis-Chance "1 in X" (p = 1/X).
--   "Boosted"-Einträge (alles ab Uncommon) bekommen p = Luck / X.
--   Vergeben wird von der seltensten Stufe abwärts. Reicht die Restmasse
--   nicht mehr, bekommt der Eintrag nur den Rest (Deckelung bei sehr hoher Luck).
--   Nicht-Boosted-Einträge (Commons) teilen sich die Restmasse im Verhältnis
--   ihrer Gewichte 1/X.
--
-- Eigenschaften:
--   * Bei Luck 1 entsprechen alle Boosted-Chancen exakt dem Config-Wert.
--   * Luck L macht jede seltene Chance exakt L-mal wahrscheinlicher,
--     solange insgesamt noch Commons übrig bleiben.
--   * Die Summe ist immer genau 1.

export type Entry = {
	Key: any,
	Chance: number, -- "1 in X"
	Boosted: boolean,
}

export type Table = {
	Entries: { Entry },
	_order: { number }, -- Indizes: Boosted seltenste zuerst, dann Unboosted
	_boostedCount: number,
	_unboostedWeight: number,
	_cache: { [number]: { number } },
	_cacheSize: number,
}

local RollMath = {}

local MAX_CACHE = 64

function RollMath.newTable(entries: { Entry }): Table
	assert(#entries > 0, "RollMath: leere Tabelle")
	local boosted, unboosted = {}, {}
	local unboostedWeight = 0
	for i, e in entries do
		assert(type(e.Chance) == "number" and e.Chance >= 1, "RollMath: Chance muss >= 1 sein")
		if e.Boosted then
			table.insert(boosted, i)
		else
			table.insert(unboosted, i)
			unboostedWeight += 1 / e.Chance
		end
	end
	-- seltenste zuerst (größtes X)
	table.sort(boosted, function(a, b)
		if entries[a].Chance == entries[b].Chance then
			return a < b
		end
		return entries[a].Chance > entries[b].Chance
	end)
	local order = table.clone(boosted)
	for _, i in unboosted do
		table.insert(order, i)
	end
	return {
		Entries = entries,
		_order = order,
		_boostedCount = #boosted,
		_unboostedWeight = unboostedWeight,
		_cache = {},
		_cacheSize = 0,
	}
end

-- Wahrscheinlichkeit jedes Eintrags (gleicher Index wie Entries) bei `luck`.
function RollMath.probabilities(tbl: Table, luck: number): { number }
	luck = math.max(1, luck)
	-- Cache auf 4 Nachkommastellen (Luck ändert sich selten)
	local key = math.floor(luck * 10000 + 0.5)
	local cached = tbl._cache[key]
	if cached then
		return cached
	end

	local entries = tbl.Entries
	local probs = table.create(#entries, 0)
	local remaining = 1
	for n = 1, tbl._boostedCount do
		local i = tbl._order[n]
		local p = math.min(remaining, luck / entries[i].Chance)
		probs[i] = p
		remaining -= p
	end
	remaining = math.max(0, remaining)

	if tbl._unboostedWeight > 0 then
		for n = tbl._boostedCount + 1, #tbl._order do
			local i = tbl._order[n]
			probs[i] = remaining * (1 / entries[i].Chance) / tbl._unboostedWeight
		end
	elseif remaining > 0 then
		-- Keine Rest-Einträge: Rest proportional auf alle verteilen
		local total = 1 - remaining
		for i = 1, #entries do
			probs[i] = if total > 0 then probs[i] / total else 1 / #entries
		end
	end

	if tbl._cacheSize >= MAX_CACHE then
		tbl._cache = {}
		tbl._cacheSize = 0
	end
	tbl._cache[key] = probs
	tbl._cacheSize += 1
	return probs
end

-- Zieht einen Eintrag. `u` ist eine Zufallszahl in [0, 1).
-- Gibt Eintrag, Index und die echte Wahrscheinlichkeit zurück.
function RollMath.pick(tbl: Table, luck: number, u: number): (Entry, number, number)
	local probs = RollMath.probabilities(tbl, luck)
	local acc = 0
	for _, i in tbl._order do
		acc += probs[i]
		if u < acc then
			return tbl.Entries[i], i, probs[i]
		end
	end
	-- Rundungsfehler: häufigster Eintrag
	local last = tbl._order[#tbl._order]
	return tbl.Entries[last], last, probs[last]
end

-- "1 in X" für die Anzeige (X gerundet, inf bei p = 0)
function RollMath.oneIn(p: number): number
	if p <= 0 then
		return math.huge
	end
	return 1 / p
end

-- Summe der Wahrscheinlichkeiten aller Einträge, für die `predicate` gilt
function RollMath.sumWhere(tbl: Table, luck: number, predicate: (Entry) -> boolean): number
	local probs = RollMath.probabilities(tbl, luck)
	local sum = 0
	for i, e in tbl.Entries do
		if predicate(e) then
			sum += probs[i]
		end
	end
	return sum
end

-- Mutationen: jede Mutation hat ihren eigenen Luck-Faktor. Seltenste zuerst,
-- Rest = "Normal". entries: { { Key, Chance, Luck } }, Key des Rests = fallback
function RollMath.pickIndependent(entries: { { Key: any, Chance: number, Luck: number } }, fallback: any, u: number): (any, number)
	local sorted = table.clone(entries)
	table.sort(sorted, function(a, b)
		return a.Chance > b.Chance
	end)
	local acc = 0
	for _, e in sorted do
		local p = math.min(1 - acc, math.max(1, e.Luck) / e.Chance)
		acc += p
		if u < acc then
			return e.Key, p
		end
	end
	return fallback, 1 - acc
end

return RollMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[--!strict
-- Stats (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Util > Stats
--
-- Alle Formeln für Character-Werte an EINER Stelle (Server, Client, Simulation).
-- Die Zahlen kommen aus EconomyConfig / RarityConfig / MutationConfig.

local Config = script.Parent.Parent:WaitForChild("Config")
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))

local Stats = {}

function Stats.levelMultiplier(level: number): number
	local list = EconomyConfig.LevelIncomeMultiplier
	return list[math.clamp(level, 1, #list)]
end

-- $/s eines Characters ohne globale Multiplikatoren und ohne Gear
function Stats.income(def: any, level: number, mutationId: string?): number
	local mutation = MutationConfig.Get(mutationId)
	return def.BaseMoneyPerSecond * Stats.levelMultiplier(level) * mutation.MoneyMultiplier
end

-- Kosten für das nächste Level, nil = schon Max-Level
function Stats.upgradeCost(def: any, level: number, mutationId: string?): number?
	if level >= def.MaxLevel then
		return nil
	end
	local seconds = EconomyConfig.UpgradeCostSeconds[level]
	if not seconds then
		return nil
	end
	local mutation = MutationConfig.Get(mutationId)
	local rarity = RarityConfig.Get(def.Rarity)
	local cost = def.BaseMoneyPerSecond * mutation.MoneyMultiplier * seconds * rarity.UpgradeCostFactor
	return math.max(EconomyConfig.MinUpgradeCost, math.floor(cost))
end

function Stats.power(def: any, level: number, mutationId: string?): number
	local mutation = MutationConfig.Get(mutationId)
	local rarity = RarityConfig.Get(def.Rarity)
	return math.floor(def.BasePower * (1 + EconomyConfig.PowerPerLevel * (level - 1)) * mutation.PowerMultiplier * rarity.PowerMultiplier)
end

function Stats.fishingPower(def: any, level: number): number
	return def.BaseFishingPower * (1 + EconomyConfig.FishingPowerPerLevel * (level - 1))
end

function Stats.sellValue(def: any, level: number, mutationId: string?): number
	local rarity = RarityConfig.Get(def.Rarity)
	local levelBonus = 1 + EconomyConfig.SellLevelBonus * (level - 1) / math.max(1, def.MaxLevel - 1)
	return math.floor(Stats.income(def, 1, mutationId) * rarity.SellSeconds * levelBonus)
end

-- Sekunden pro Fang
function Stats.catchInterval(fishingPower: number, speedMultiplier: number): number
	local seconds = FishingConfig.BaseCatchSeconds / (1 + fishingPower / FishingConfig.PowerScale)
	seconds /= math.max(0.1, speedMultiplier)
	return math.max(FishingConfig.MinCatchSeconds, seconds)
end

return Stats
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Visual</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">AuraLibrary</string>
            <string name="Source"><![CDATA[--!strict
-- AuraLibrary (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Visual > AuraLibrary
--
-- Alle Aura-/Partikel-Effekte an einer Stelle. Wird benutzt von:
--   * CharacterConfig.AuraReference      (Character-Aura, z. B. "PsychicBlue")
--   * MutationConfig.Effect              (z. B. "ElectricSparks", "VoidVortex")
--   * ModelFactory.ApplyLevelVisual      ("LevelGlow1", "LevelGlow2", "LevelMax")
--
-- Keine externen Assets: nur die eingebauten rbxasset-Texturen.
--
-- Felder pro Eintrag:
--   Color / Color2   Farbverlauf der Partikel (Start -> Ende)
--   Light            nil = kein Licht, sonst { Brightness, Range } (Range in Studs
--                    bei einem 5-Studs-Character, wird mit der Model-Größe skaliert)
--   Particles        nil = keine Partikel, sonst:
--                      Texture        rbxasset-Pfad (nil = Roblox-Standard)
--                      Rate           Partikel/Sekunde bei Stärke 1 (max. 20)
--                      Lifetime       { min, max } Sekunden
--                      Speed          { min, max } Studs/Sekunde
--                      Size           Startgröße (Studs bei 5-Studs-Character)
--                      Size2          Endgröße (nil = Size * 0.3)
--                      LightEmission  0..1
--                      Transparency   Start-Transparenz (Ende immer 1)
--                      Spread         SpreadAngle in Grad (beide Achsen)
--                      Rise           Beschleunigung nach oben (negativ = fällt)
--                      Drag           Luftwiderstand
--                      RotSpeed       Drehung in Grad/Sekunde (+/-)
--                      Height         Höhe des Emitters relativ zur Model-Höhe (0 = Füße, 1 = Kopf)
--   Ring             true = ModelFactory legt eine leuchtende Bodenscheibe unter den Character
--
-- AuraLibrary.Apply(target, auraId, strength, options) hängt Partikel + Licht an
-- ein Attachment (target = Attachment) oder legt unter einem BasePart ein neues
-- Attachment an. Mit options.LowDetail = true wird NICHTS erzeugt.

export type ParticleSpec = {
	Texture: string?,
	Rate: number,
	Lifetime: { number },
	Speed: { number },
	Size: number,
	Size2: number?,
	LightEmission: number,
	Transparency: number?,
	Spread: number?,
	Rise: number?,
	Drag: number?,
	RotSpeed: number?,
	Height: number?,
}

export type AuraDef = {
	Id: string,
	Color: Color3,
	Color2: Color3,
	Light: { Brightness: number, Range: number }?,
	Particles: ParticleSpec?,
	Ring: boolean?,
}

export type ApplyOptions = {
	Color: Color3?,
	Color2: Color3?,
	Scale: number?,
	LowDetail: boolean?,
	Name: string?,
	Offset: Vector3?,
}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local MAX_RATE = 20

local rgb = Color3.fromRGB

local AuraLibrary = {}

AuraLibrary.Textures = { Sparkle = SPARKLE, Smoke = SMOKE, Fire = FIRE }

local defs: { [string]: AuraDef } = {
	---------------------------------------------------------------------------
	-- Level-Visuals (Farbe wird von ModelFactory mit der Rarity-Farbe überschrieben)
	---------------------------------------------------------------------------
	LevelGlow1 = {
		Id = "LevelGlow1", Color = rgb(255, 255, 255), Color2 = rgb(200, 220, 255),
		Light = nil,
		Particles = { Texture = SPARKLE, Rate = 4, Lifetime = { 1, 1.6 }, Speed = { 0.5, 1 }, Size = 0.35,
			LightEmission = 0.8, Transparency = 0.2, Spread = 60, Rise = 1.5, Height = 0.05 },
	},
	LevelGlow2 = {
		Id = "LevelGlow2", Color = rgb(255, 255, 255), Color2 = rgb(200, 220, 255),
		Light = { Brightness = 0.8, Range = 8 },
		Particles = { Texture = SPARKLE, Rate = 8, Lifetime = { 1.2, 1.8 }, Speed = { 0.6, 1.4 }, Size = 0.45,
			LightEmission = 1, Transparency = 0.1, Spread = 70, Rise = 2, Height = 0.05 },
	},
	LevelMax = {
		Id = "LevelMax", Color = rgb(255, 255, 255), Color2 = rgb(255, 230, 140),
		Light = { Brightness = 1.4, Range = 12 },
		Particles = { Texture = SPARKLE, Rate = 14, Lifetime = { 1.4, 2.2 }, Speed = { 0.8, 1.8 }, Size = 0.6,
			LightEmission = 1, Transparency = 0, Spread = 80, Rise = 2.5, RotSpeed = 90, Height = 0.05 },
		Ring = true,
	},

	---------------------------------------------------------------------------
	-- Mutationen (MutationConfig.Effect)
	---------------------------------------------------------------------------
	ElectricSparks = {
		Id = "ElectricSparks", Color = rgb(150, 230, 255), Color2 = rgb(60, 140, 255),
		Light = { Brightness = 1, Range = 9 },
		Particles = { Texture = SPARKLE, Rate = 12, Lifetime = { 0.15, 0.35 }, Speed = { 4, 8 }, Size = 0.4,
			Size2 = 0.05, LightEmission = 1, Transparency = 0, Spread = 180, Drag = 4, RotSpeed = 400, Height = 0.55 },
	},
	ShadowSmoke = {
		Id = "ShadowSmoke", Color = rgb(40, 30, 60), Color2 = rgb(5, 0, 10),
		Light = nil,
		Particles = { Texture = SMOKE, Rate = 8, Lifetime = { 1.5, 2.5 }, Speed = { 0.3, 0.8 }, Size = 1.6,
			Size2 = 2.6, LightEmission = 0, Transparency = 0.45, Spread = 180, Rise = 0.6, RotSpeed = 30, Height = 0.15 },
	},
	BloodMist = {
		Id = "BloodMist", Color = rgb(200, 20, 30), Color2 = rgb(80, 0, 10),
		Light = { Brightness = 0.6, Range = 8 },
		Particles = { Texture = SMOKE, Rate = 8, Lifetime = { 1.5, 2.4 }, Speed = { 0.3, 0.7 }, Size = 1.2,
			Size2 = 2.2, LightEmission = 0.3, Transparency = 0.5, Spread = 180, Rise = 0.4, RotSpeed = 20, Height = 0.2 },
	},
	RiftCracks = {
		Id = "RiftCracks", Color = rgb(190, 120, 255), Color2 = rgb(60, 220, 255),
		Light = { Brightness = 0.9, Range = 9 },
		Particles = { Texture = SPARKLE, Rate = 10, Lifetime = { 0.6, 1.1 }, Speed = { 1, 2.5 }, Size = 0.55,
			Size2 = 0.1, LightEmission = 1, Transparency = 0.05, Spread = 180, Drag = 2, RotSpeed = 180, Height = 0.5 },
	},
	GoldSparkle = {
		Id = "GoldSparkle", Color = rgb(255, 230, 120), Color2 = rgb(255, 170, 30),
		Light = { Brightness = 1, Range = 10 },
		Particles = { Texture = SPARKLE, Rate = 12, Lifetime = { 1, 1.6 }, Speed = { 0.5, 1.5 }, Size = 0.5,
			Size2 = 0.1, LightEmission = 1, Transparency = 0, Spread = 180, Rise = 0.8, RotSpeed = 120, Height = 0.6 },
	},
	VoidVortex = {
		Id = "VoidVortex", Color = rgb(150, 60, 255), Color2 = rgb(10, 0, 30),
		Light = { Brightness = 1.2, Range = 11 },
		Particles = { Texture = SMOKE, Rate = 14, Lifetime = { 1.2, 2 }, Speed = { 1, 2 }, Size = 1.1,
			Size2 = 0.2, LightEmission = 0.6, Transparency = 0.2, Spread = 180, Rise = 1.2, Drag = 1, RotSpeed = 220, Height = 0.4 },
		Ring = true,
	},

	---------------------------------------------------------------------------
	-- Character-Auren
	---------------------------------------------------------------------------
	PsychicBlue = {
		Id = "PsychicBlue", Color = rgb(120, 200, 255), Color2 = rgb(60, 90, 255),
		Light = { Brightness = 0.7, Range = 8 },
		Particles = { Texture = SPARKLE, Rate = 6, Lifetime = { 1, 1.6 }, Speed = { 0.4, 1 }, Size = 0.45,
			LightEmission = 1, Transparency = 0.2, Spread = 180, Rise = 0.5, RotSpeed = 60, Height = 0.75 },
	},
	PsionicSurge = {
		Id = "PsionicSurge", Color = rgb(220, 240, 255), Color2 = rgb(90, 120, 255),
		Light = { Brightness = 1.2, Range = 11 },
		Particles = { Texture = SPARKLE, Rate = 12, Lifetime = { 0.8, 1.4 }, Speed = { 1.5, 3 }, Size = 0.6,
			Size2 = 0.1, LightEmission = 1, Transparency = 0, Spread = 180, Drag = 2, RotSpeed = 160, Height = 0.7 },
		Ring = true,
	},
	RiftViolet = {
		Id = "RiftViolet", Color = rgb(170, 90, 255), Color2 = rgb(70, 160, 255),
		Light = { Brightness = 0.8, Range = 9 },
		Particles = { Texture = SPARKLE, Rate = 8, Lifetime = { 1, 1.8 }, Speed = { 0.5, 1.2 }, Size = 0.55,
			LightEmission = 1, Transparency = 0.15, Spread = 180, Rise = 0.8, RotSpeed = 90, Height = 0.5 },
	},
	Static = {
		Id = "Static", Color = rgb(235, 235, 245), Color2 = rgb(120, 130, 150),
		Light = nil,
		Particles = { Texture = SPARKLE, Rate = 10, Lifetime = { 0.1, 0.3 }, Speed = { 2, 5 }, Size = 0.3,
			Size2 = 0.05, LightEmission = 0.7, Transparency = 0.1, Spread = 180, Drag = 6, RotSpeed = 500, Height = 0.6 },
	},
	Ember = {
		Id = "Ember", Color = rgb(255, 200, 80), Color2 = rgb(255, 60, 20),
		Light = { Brightness = 0.9, Range = 9 },
		Particles = { Texture = FIRE, Rate = 9, Lifetime = { 0.8, 1.4 }, Speed = { 0.5, 1.5 }, Size = 0.55,
			Size2 = 0.05, LightEmission = 1, Transparency = 0.2, Spread = 40, Rise = 3, RotSpeed = 60, Height = 0.1 },
	},
	Frost = {
		Id = "Frost", Color = rgb(220, 245, 255), Color2 = rgb(120, 190, 255),
		Light = { Brightness = 0.6, Range = 8 },
		Particles = { Texture = SPARKLE, Rate = 8, Lifetime = { 1.5, 2.5 }, Speed = { 0.2, 0.6 }, Size = 0.35,
			LightEmission = 0.6, Transparency = 0.2, Spread = 180, Rise = -0.6, RotSpeed = 40, Height = 0.9 },
	},
	Spores = {
		Id = "Spores", Color = rgb(170, 255, 120), Color2 = rgb(60, 140, 60),
		Light = { Brightness = 0.4, Range = 7 },
		Particles = { Texture = SPARKLE, Rate = 7, Lifetime = { 2, 3 }, Speed = { 0.2, 0.6 }, Size = 0.3,
			LightEmission = 0.5, Transparency = 0.3, Spread = 180, Rise = 0.3, Drag = 0.5, Height = 0.5 },
	},
	Fireflies = {
		Id = "Fireflies", Color = rgb(255, 250, 140), Color2 = rgb(170, 255, 90),
		Light = { Brightness = 0.5, Range = 7 },
		Particles = { Texture = SPARKLE, Rate = 6, Lifetime = { 2, 3.5 }, Speed = { 0.3, 0.9 }, Size = 0.25,
			LightEmission = 1, Transparency = 0, Spread = 180, Drag = 0.4, Height = 0.6 },
	},
	LakeMist = {
		Id = "LakeMist", Color = rgb(180, 230, 255), Color2 = rgb(60, 120, 170),
		Light = nil,
		Particles = { Texture = SMOKE, Rate = 6, Lifetime = { 2, 3 }, Speed = { 0.2, 0.5 }, Size = 1.2,
			Size2 = 2.2, LightEmission = 0.2, Transparency = 0.6, Spread = 180, Rise = 0.2, RotSpeed = 15, Height = 0.1 },
	},
	RedSignal = {
		Id = "RedSignal", Color = rgb(255, 60, 60), Color2 = rgb(120, 0, 0),
		Light = { Brightness = 1.4, Range = 12 },
		Particles = { Texture = SPARKLE, Rate = 12, Lifetime = { 0.4, 0.9 }, Speed = { 2, 4 }, Size = 0.55,
			Size2 = 0.05, LightEmission = 1, Transparency = 0, Spread = 180, Drag = 3, RotSpeed = 300, Height = 0.6 },
		Ring = true,
	},
	Prism = {
		Id = "Prism", Color = rgb(255, 120, 220), Color2 = rgb(80, 255, 230),
		Light = { Brightness = 1, Range = 10 },
		Particles = { Texture = SPARKLE, Rate = 10, Lifetime = { 1, 1.8 }, Speed = { 0.6, 1.6 }, Size = 0.5,
			Size2 = 0.1, LightEmission = 1, Transparency = 0, Spread = 180, Rise = 0.5, RotSpeed = 140, Height = 0.6 },
	},
	Golden = {
		Id = "Golden", Color = rgb(255, 235, 150), Color2 = rgb(255, 160, 30),
		Light = { Brightness = 1.2, Range = 11 },
		Particles = { Texture = SPARKLE, Rate = 10, Lifetime = { 1.2, 2 }, Speed = { 0.4, 1 }, Size = 0.5,
			LightEmission = 1, Transparency = 0, Spread = 180, Rise = 0.6, RotSpeed = 90, Height = 0.7 },
		Ring = true,
	},
	Abyss = {
		Id = "Abyss", Color = rgb(30, 10, 60), Color2 = rgb(0, 0, 0),
		Light = { Brightness = 0.7, Range = 10 },
		Particles = { Texture = SMOKE, Rate = 10, Lifetime = { 1.8, 2.8 }, Speed = { 0.5, 1.2 }, Size = 2,
			Size2 = 3.2, LightEmission = 0, Transparency = 0.35, Spread = 180, Rise = -0.3, RotSpeed = 25, Height = 0.3 },
		Ring = true,
	},
	Otherglow = {
		Id = "Otherglow", Color = rgb(80, 255, 210), Color2 = rgb(255, 90, 170),
		Light = { Brightness = 0.9, Range = 10 },
		Particles = { Texture = SPARKLE, Rate = 8, Lifetime = { 1.6, 2.6 }, Speed = { 0.2, 0.7 }, Size = 0.4,
			LightEmission = 1, Transparency = 0.1, Spread = 180, Rise = -0.4, Drag = 0.6, Height = 0.8 },
	},
	Starfield = {
		Id = "Starfield", Color = rgb(255, 255, 255), Color2 = rgb(140, 100, 255),
		Light = { Brightness = 1, Range = 12 },
		Particles = { Texture = SPARKLE, Rate = 12, Lifetime = { 1.5, 2.5 }, Speed = { 0.3, 1 }, Size = 0.35,
			Size2 = 0.05, LightEmission = 1, Transparency = 0, Spread = 180, Drag = 0.5, RotSpeed = 60, Height = 0.6 },
		Ring = true,
	},
	NullLight = {
		Id = "NullLight", Color = rgb(255, 255, 255), Color2 = rgb(0, 255, 200),
		Light = { Brightness = 1.6, Range = 14 },
		Particles = { Texture = SPARKLE, Rate = 14, Lifetime = { 1, 1.8 }, Speed = { 1, 2.4 }, Size = 0.6,
			Size2 = 0.05, LightEmission = 1, Transparency = 0, Spread = 180, Drag = 1.5, RotSpeed = 200, Height = 0.6 },
		Ring = true,
	},
}

AuraLibrary.Defs = defs

function AuraLibrary.Get(auraId: string?): AuraDef?
	if auraId == nil then
		return nil
	end
	return defs[auraId]
end

function AuraLibrary.Has(auraId: string): boolean
	return defs[auraId] ~= nil
end

-- Sortierte Liste aller Ids (für Tests/Debug-UI)
function AuraLibrary.Ids(): { string }
	local out = {}
	for id in defs do
		table.insert(out, id)
	end
	table.sort(out)
	return out
end

local function numberRange(r: { number }, scale: number): NumberRange
	local a = r[1] * scale
	local b = (r[2] or r[1]) * scale
	return NumberRange.new(math.min(a, b), math.max(a, b))
end

-- Hängt die Aura an. Gibt das Attachment zurück (nil bei LowDetail/unbekannter Id).
function AuraLibrary.Apply(target: Instance, auraId: string, strength: number?, options: ApplyOptions?): Attachment?
	local def = defs[auraId]
	if not def then
		warn("[AuraLibrary] Unbekannte Aura-Id: " .. tostring(auraId))
		return nil
	end
	local opts: ApplyOptions = options or {}
	if opts.LowDetail then
		return nil
	end
	local s = math.clamp(strength or 1, 0, 1)
	local scale = opts.Scale or 1
	local color1 = opts.Color or def.Color
	local color2 = opts.Color2 or (if opts.Color then opts.Color:Lerp(def.Color2, 0.35) else def.Color2)

	local attachment: Attachment
	if target:IsA("Attachment") then
		attachment = target :: Attachment
	else
		attachment = Instance.new("Attachment")
		attachment.Name = opts.Name or ("Aura_" .. auraId)
		if opts.Offset then
			attachment.Position = opts.Offset
		end
		attachment.Parent = target
	end

	local p = def.Particles
	if p then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = auraId
		if p.Texture then
			emitter.Texture = p.Texture
		end
		emitter.Rate = math.clamp(math.floor(p.Rate * (0.4 + 0.6 * s) + 0.5), 1, MAX_RATE)
		emitter.Lifetime = numberRange(p.Lifetime, 1)
		emitter.Speed = numberRange(p.Speed, math.sqrt(scale))
		emitter.Color = ColorSequence.new(color1, color2)
		local size1 = p.Size * scale * (0.7 + 0.3 * s)
		local size2 = (p.Size2 or p.Size * 0.3) * scale * (0.7 + 0.3 * s)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size1),
			NumberSequenceKeypoint.new(1, size2),
		})
		local t0 = p.Transparency or 0.2
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, t0),
			NumberSequenceKeypoint.new(0.7, math.min(1, t0 + 0.25)),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.LightEmission = p.LightEmission
		local spread = p.Spread or 180
		emitter.SpreadAngle = Vector2.new(spread, spread)
		if p.Rise then
			emitter.Acceleration = Vector3.new(0, p.Rise * math.sqrt(scale), 0)
		end
		if p.Drag then
			emitter.Drag = p.Drag
		end
		if p.RotSpeed then
			emitter.RotSpeed = NumberRange.new(-p.RotSpeed, p.RotSpeed)
			emitter.Rotation = NumberRange.new(0, 360)
		end
		emitter.LockedToPart = false
		emitter.Parent = attachment
	end

	local light = def.Light
	if light then
		local pl = Instance.new("PointLight")
		pl.Name = auraId .. "Light"
		pl.Color = color1
		pl.Brightness = light.Brightness * (0.5 + 0.5 * s)
		pl.Range = math.min(60, light.Range * scale)
		pl.Shadows = false
		pl.Parent = attachment
	end

	return attachment
end

return AuraLibrary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ModelFactory</string>
            <string name="Source"><![CDATA[--!strict
-- ModelFactory (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Visual > ModelFactory
--
-- Baut prozedurale Placeholder-Models für alle Characters aus CharacterDef.Visual.
-- Keine externen Assets: nur Parts (Block/Ball/Cylinder/Wedge), SpecialMesh mit
-- eingebautem MeshType (Ellipsoide) und Partikel mit rbxasset-Texturen.
--
-- API:
--   ModelFactory.Build(characterId, options?)      -> Model
--   ModelFactory.BuildFromDef(def, options?)       -> Model
--   ModelFactory.ApplyLevelVisual(model, level)    -- idempotent: 5 / 10 / 15 (MAX)
--   ModelFactory.ApplyMutation(model, mutationId)  -- idempotent, "Normal" setzt zurück
--   options = { Level: number?, Mutation: string?, LowDetail: boolean? }
--
-- Model-Vertrag (BaseAnimator / BaseService verlassen sich darauf):
--   * Model.Name = def.Id, Attribute: CharacterId, Rarity, Height (Studs über Root-Unterseite),
--     Width (größte horizontale Ausdehnung in Studs) (+ LowDetail,
--     VisualLevel, Mutation, Body, AnimationSet)
--   * PrimaryPart = unsichtbarer Part "Root" (2 x 0.2 x 2). Seine Unterseite ist der
--     Bodenpunkt (PivotOffset zeigt dorthin): model:PivotTo(groundCFrame) stellt die
--     Füße auf den Boden, Blickrichtung = groundCFrame.LookVector.
--   * Alle BaseParts: Anchored, CanCollide/CanTouch/CanQuery = false, Massless.
--   * Animierbare Gruppen sind Kind-Models mit PrimaryPart "Joint" (winziger,
--     unsichtbarer Part am Drehpunkt, Rotation = Model-Achsen):
--       Head, ArmL, ArmR, Held (in ArmR), WingL, WingR, Tail, Orbit, Core
--     Alles andere liegt im Kind-Model "Body". Es wird NICHT geschweißt.
--   * Effekte (ParticleEmitter, PointLight) hängen an Attachments unter Root:
--       FX_Aura, FX_Level, FX_Mutation. LowDetail = keine Emitter/Lichter.
--
-- Visual-Vokabular: siehe Bodies (Body-Typen), Accessories (Accessory-Ids und
-- HairStyles), Faces (Face-Typen).

local Shared = script.Parent.Parent
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))

local Bodies = require(script:WaitForChild("Bodies"))
local Accessories = require(script:WaitForChild("Accessories"))
local Faces = require(script:WaitForChild("Faces"))
local Effects = require(script:WaitForChild("Effects"))

export type BuildOptions = {
	Level: number?,
	Mutation: string?,
	LowDetail: boolean?,
}

local ModelFactory = {}

-- Für Tests / Debug-UI
ModelFactory.Bodies = Bodies
ModelFactory.Accessories = Accessories
ModelFactory.Faces = Faces
ModelFactory.Effects = Effects

ModelFactory.ROOT_SIZE = Vector3.new(2, 0.2, 2)
ModelFactory.GROUP_NAMES = { "Head", "ArmL", "ArmR", "Held", "WingL", "WingR", "Tail", "Orbit", "Core" }

-------------------------------------------------------------------------------
-- Builder: legt Parts in "unskalierten" Model-Koordinaten an (Boden = y 0,
-- vorne = -Z) und rechnet Scale ein. Zählt Parts und die Bounding-Box.
-------------------------------------------------------------------------------
local Builder = {}
Builder.__index = Builder

local SHAPES = {
	Block = Enum.PartType.Block,
	Ball = Enum.PartType.Ball,
	Cyl = Enum.PartType.Cylinder,
}

function Builder.new(model: Model, scale: number, limit: number, lowDetail: boolean)
	local self = setmetatable({
		Model = model,
		S = scale,
		Limit = limit,
		LowDetail = lowDetail,
		Count = 0,
		Created = {} :: { Instance },
		MaxY = 0,
		MaxX = 0,
		MaxZ = 0,
		Body = (nil :: any) :: Model,
		Colors = {} :: { [string]: Color3 },
		Recolored = {} :: { { part: BasePart, color: Color3 } },
	}, Builder)
	return self
end

-- Skaliert eine unskalierte Model-CFrame
function Builder:CF(cf: CFrame): CFrame
	return CFrame.new(cf.Position * self.S) * cf.Rotation
end

function Builder:_track(part: BasePart, size: Vector3, cf: CFrame)
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local rx, ry, rz = cf.XVector, cf.YVector, cf.ZVector
	local ex = math.abs(rx.X) * hx + math.abs(ry.X) * hy + math.abs(rz.X) * hz
	local ey = math.abs(rx.Y) * hx + math.abs(ry.Y) * hy + math.abs(rz.Y) * hz
	local ez = math.abs(rx.Z) * hx + math.abs(ry.Z) * hy + math.abs(rz.Z) * hz
	local p = cf.Position
	self.MaxY = math.max(self.MaxY, p.Y + ey)
	self.MaxX = math.max(self.MaxX, math.abs(p.X) + ex)
	self.MaxZ = math.max(self.MaxZ, math.abs(p.Z) + ez)
end

local function setupPart(part: BasePart, size: Vector3)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if math.max(size.X, size.Y, size.Z) < 1 then
		part.CastShadow = false
	end
end

export type PartProps = {
	Transparency: number?,
	Role: string?, -- "Eye" | "Glow" | "FX" (nicht von Mutationen eingefärbt)
	Reflectance: number?,
}

-- shape: "Block" | "Ball" (Size.X = Durchmesser) | "Cyl" (Achse = lokale X, Size = Länge, D, D)
--        | "Wedge" | "Corner" | "Sphere" (Ellipsoid per SpecialMesh) | "CylMesh" (elliptischer Zylinder)
function Builder:Part(
	parent: Instance,
	name: string,
	shape: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	props: PartProps?
): BasePart
	local part: BasePart
	if shape == "Wedge" then
		part = Instance.new("WedgePart")
	elseif shape == "Corner" then
		part = Instance.new("CornerWedgePart")
	else
		local p = Instance.new("Part")
		if shape == "Ball" then
			size = Vector3.new(size.X, size.X, size.X)
			p.Shape = Enum.PartType.Ball
		elseif shape == "Cyl" then
			local d = math.max(size.Y, size.Z)
			size = Vector3.new(size.X, d, d)
			p.Shape = Enum.PartType.Cylinder
		elseif SHAPES[shape] == nil and shape ~= "Sphere" and shape ~= "CylMesh" then
			error("[ModelFactory] Unbekannte Part-Form: " .. shape)
		end
		part = p
		if shape == "Sphere" or shape == "CylMesh" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = if shape == "Sphere" then Enum.MeshType.Sphere else Enum.MeshType.Cylinder
			mesh.Parent = part
		end
	end
	local s = self.S
	local finalSize = size * s
	local finalCF = self:CF(cf)
	part.Name = name
	part.Size = finalSize
	part.CFrame = finalCF
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	setupPart(part, finalSize)
	local pr = props
	if pr then
		if pr.Transparency then
			part.Transparency = pr.Transparency
		end
		if pr.Reflectance then
			part.Reflectance = pr.Reflectance
		end
		if pr.Role then
			part:SetAttribute("VDRole", pr.Role)
		end
	end
	if part.Material == Enum.Material.Neon and not (pr and pr.Role) then
		part:SetAttribute("VDRole", "Glow")
	end
	part.Parent = parent
	self.Count += 1
	table.insert(self.Created, part)
	if part.Transparency < 0.95 then
		self:_track(part, finalSize, finalCF)
	end
	return part
end

-- Animierbare Gruppe mit "Joint" als PrimaryPart (Drehpunkt = jointPos, unskaliert)
function Builder:Group(name: string, parent: Instance, jointPos: Vector3): Model
	local g = Instance.new("Model")
	g.Name = name
	local joint = Instance.new("Part")
	joint.Name = "Joint"
	joint.Size = Vector3.new(0.1, 0.1, 0.1)
	joint.CFrame = CFrame.new(jointPos * self.S)
	joint.Transparency = 1
	setupPart(joint, joint.Size)
	joint.Parent = g
	g.PrimaryPart = joint
	g.Parent = parent
	self.Count += 1
	table.insert(self.Created, g)
	return g
end

-- Gruppe holen oder anlegen (z. B. Orbit wird von mehreren Accessories geteilt)
function Builder:GetGroup(name: string, parent: Instance, jointPos: Vector3): Model
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Model") then
		return existing
	end
	return self:Group(name, parent, jointPos)
end

function Builder:Remaining(): number
	return self.Limit - self.Count
end

-- Checkpoint/Rollback: Accessories, die das Part-Budget sprengen, werden wieder entfernt
function Builder:Checkpoint()
	return {
		n = #self.Created,
		count = self.Count,
		maxY = self.MaxY,
		maxX = self.MaxX,
		maxZ = self.MaxZ,
		recolor = #self.Recolored,
	}
end

function Builder:Rollback(cp)
	for i = #self.Created, cp.n + 1, -1 do
		local inst = self.Created[i]
		self.Created[i] = nil
		if inst.Parent ~= nil then
			inst.Parent = nil
		end
		inst:Destroy()
	end
	for i = #self.Recolored, cp.recolor + 1, -1 do
		local r = self.Recolored[i]
		r.part.Color = r.color
		self.Recolored[i] = nil
	end
	self.Count = cp.count
	self.MaxY = cp.maxY
	self.MaxX = cp.maxX
	self.MaxZ = cp.maxZ
end

-- Bestehenden Part umfärben (z. B. Ärmel unter einem Laborkittel), rollback-fähig
function Builder:Recolor(part: Instance?, color: Color3, material: Enum.Material?)
	if part and part:IsA("BasePart") then
		table.insert(self.Recolored, { part = part, color = part.Color })
		part.Color = color
		if material then
			part.Material = material
		end
	end
end

ModelFactory.Builder = Builder

-------------------------------------------------------------------------------
-- Farben auflösen
-------------------------------------------------------------------------------
local COLOR_KEYS = { "Skin", "Hair", "Top", "Bottom", "Shoes", "Accent", "Glow" }

local function resolveColors(visual: any): { [string]: Color3 }
	local defaults = Bodies.Defaults[visual.Body] or Bodies.Defaults.Teen
	local out = {}
	for _, key in COLOR_KEYS do
		out[key] = visual[key] or defaults[key]
	end
	return out
end

-------------------------------------------------------------------------------
-- Build
-------------------------------------------------------------------------------
local function emptyModel(id: string): Model
	local model = Instance.new("Model")
	model.Name = id
	return model
end

function ModelFactory.BuildFromDef(def: any, options: BuildOptions?): Model
	local opts: BuildOptions = options or {}
	local lowDetail = opts.LowDetail == true
	local visual = def.Visual or { Body = "Teen" }
	local bodyType = visual.Body
	if Bodies.Builders[bodyType] == nil then
		warn("[ModelFactory] Unbekannter Body-Typ '" .. tostring(bodyType) .. "' bei " .. tostring(def.Id))
		bodyType = "Teen"
	end
	local scale = math.clamp(visual.Scale or 1, 0.4, 3)
	local model = emptyModel(def.Id)

	local limit = (Bodies.Budget[bodyType] or 45) - Effects.RESERVED_PARTS
	local ctx = Builder.new(model, scale, limit, lowDetail)

	-- Root: Unterseite = Boden
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = ModelFactory.ROOT_SIZE
	root.CFrame = CFrame.new(0, ModelFactory.ROOT_SIZE.Y / 2, 0)
	root.Transparency = 1
	setupPart(root, root.Size)
	root.CastShadow = false
	root.PivotOffset = CFrame.new(0, -ModelFactory.ROOT_SIZE.Y / 2, 0)
	root.Parent = model
	model.PrimaryPart = root
	ctx.Count += 1

	local body = Instance.new("Model")
	body.Name = "Body"
	body.Parent = model
	ctx.Body = body

	local colors = resolveColors(visual)
	ctx.Colors = colors

	-- 1) Körper
	local anchors = Bodies.Builders[bodyType](ctx, colors, visual)
	anchors.BodyType = bodyType

	-- 2) Gesicht
	if anchors.Face then
		local faceType = visual.Face or Bodies.DefaultFace[bodyType] or "Smile"
		Faces.Build(ctx, anchors.Face, faceType, colors)
	end

	-- 3) Haare
	local hairStyle = visual.HairStyle
	if hairStyle and hairStyle ~= "None" and anchors.Head then
		Accessories.BuildHair(ctx, anchors, hairStyle, colors)
	end

	-- 4) Accessories (jedes einzeln budgetiert, rollt bei Überschreitung zurück).
	-- Verworfene (Budget/Fehler) und übersprungene (kein passender Anker) Ids
	-- landen zur Kontrolle im Attribut "SkippedAccessories".
	local skipped = {}
	if visual.Accessories then
		for _, accessoryId in visual.Accessories do
			local before = #ctx.Created + #ctx.Recolored
			local ok = Accessories.Build(ctx, anchors, accessoryId, colors)
			if not ok or #ctx.Created + #ctx.Recolored == before then
				table.insert(skipped, accessoryId)
			end
		end
	end
	if #skipped > 0 then
		model:SetAttribute("SkippedAccessories", table.concat(skipped, ","))
	end

	-- Attribute
	local height = math.max(ctx.MaxY, 0.5 * scale)
	local width = math.max(ctx.MaxX, ctx.MaxZ, 0.5) * 2
	model:SetAttribute("CharacterId", def.Id)
	model:SetAttribute("Rarity", def.Rarity)
	model:SetAttribute("Height", math.floor(height * 100 + 0.5) / 100)
	model:SetAttribute("Width", math.floor(width * 100 + 0.5) / 100)
	model:SetAttribute("Body", bodyType)
	model:SetAttribute("AnimationSet", def.AnimationSet or "Default")
	model:SetAttribute("LowDetail", lowDetail)
	model:SetAttribute("PartCount", ctx.Count)

	-- 5) Aura, Level, Mutation
	if def.AuraReference then
		Effects.ApplyAura(model, def.AuraReference)
	end
	local level = opts.Level or 1
	if level >= 5 then
		Effects.ApplyLevel(model, level)
	end
	if opts.Mutation and opts.Mutation ~= "Normal" then
		Effects.ApplyMutation(model, opts.Mutation)
	end

	return model
end

function ModelFactory.Build(characterId: string, options: BuildOptions?): Model
	local def = CharacterConfig.Get(characterId)
	if not def then
		warn("[ModelFactory] Unbekannte Character-Id: " .. tostring(characterId))
		def = {
			Id = characterId,
			Rarity = "Common",
			AnimationSet = "Default",
			Visual = { Body = "Teen", Face = "Blank", Top = Color3.fromRGB(255, 0, 255) },
		} :: any
	end
	local fromAsset = ModelFactory.FromAsset(def, options)
	if fromAsset then
		return fromAsset
	end
	return ModelFactory.BuildFromDef(def, options)
end

-- Fertige Models statt Placeholder: ModelReference = "Asset:<Name>" sucht
-- ReplicatedStorage > VoidDiceAssets > Characters > <Name>. Das Model muss
-- denselben Vertrag erfüllen wie die Placeholder (PrimaryPart "Root" an den
-- Füßen, verankerte Teile, optionale Gruppen Head/ArmL/ArmR … mit "Joint").
-- Fehlt es, wird der Placeholder gebaut.
function ModelFactory.FromAsset(def: any, options: BuildOptions?): Model?
	local reference = def.ModelReference
	if type(reference) ~= "string" or reference:sub(1, 6) ~= "Asset:" then
		return nil
	end
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("VoidDiceAssets")
	local folder = assets and assets:FindFirstChild("Characters")
	local source = folder and folder:FindFirstChild(reference:sub(7))
	if not source or not source:IsA("Model") or not source.PrimaryPart then
		warn("[ModelFactory] Asset fehlt oder hat keinen PrimaryPart: " .. reference .. " – nutze Placeholder")
		return nil
	end
	local model = source:Clone()
	model.Name = def.Id
	local _, size = model:GetBoundingBox()
	model:SetAttribute("CharacterId", def.Id)
	model:SetAttribute("Rarity", def.Rarity)
	model:SetAttribute("Height", size.Y)
	model:SetAttribute("Width", math.max(size.X, size.Z))
	model:SetAttribute("AnimationSet", def.AnimationSet)
	local opts = options or {}
	model:SetAttribute("LowDetail", opts.LowDetail == true)
	if opts.Level then
		Effects.ApplyLevel(model, opts.Level)
	end
	if opts.Mutation then
		Effects.ApplyMutation(model, opts.Mutation)
	end
	return model
end

function ModelFactory.ApplyLevelVisual(model: Model, level: number)
	Effects.ApplyLevel(model, level)
end

function ModelFactory.ApplyMutation(model: Model, mutationId: string)
	Effects.ApplyMutation(model, mutationId)
end

return ModelFactory
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Accessories</string>
              <string name="Source"><![CDATA[--!strict
-- Accessories (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Visual > ModelFactory > Accessories
--
-- Prozedurale Ausrüstung und Frisuren. Jedes Accessory dockt an einen Anker aus
-- Bodies an (Head, Face, Top, Torso, Back, Waist, HandR/HandL, Feet, Under,
-- TailRoot, Center). Fehlt der Anker, wird das Accessory still übersprungen.
-- Sprengt ein Accessory das Part-Budget, wird es komplett zurückgerollt.
--
-- Hand-Items: das erste kommt als Gruppe "Held" in ArmR (bewegt sich mit dem Arm),
-- das zweite in die linke Hand (ArmL). Items mit "links bevorzugt" (Shield,
-- Skateboard, Clipboard, Notebook) nehmen zuerst die linke Hand.
--
-- Accessory-Vokabular (Accessories.Ids):
--   Kopf:   Cap, CapBackward, BikeHelmet, Headphones, Glasses, Shades, Goggles,
--           NightVision, GasMask, Headband, Bandana, SheriffHat, RangerHat,
--           DetectiveHat, BucketHat, Hood, Crown, Halo, Horns, Antlers, Antennae,
--           Earpiece, Beard, Eyestalks, ThirdEye, Mandibles, Teeth, Ears
--   Körper: LabCoat, Jacket, Trenchcoat, Vest, Apron, HazmatSuit, Scarf, Tie, Badge,
--           Camera, Whistle, Cape, Shoulderpads, Toolbelt, PaperBag, Backpack,
--           RadioPack, Wings, Spikes, Tail, Tentacles, Chains
--   Hand:   Flashlight, WalkieTalkie, Clipboard, Notebook, SpikedBat, SignalBat,
--           Detector, Lantern, FishingRod, Wrench, CoffeePot, Microphone, Crossbow,
--           Staff, GateKey, PhoneHandset, Cassette, StopSign, Boombox, Shield,
--           Skateboard, Magnifier, Crystal
--   Füße:   Rollerskates
--   Orbit:  OrbitDebris, OrbitRing, OrbitEyes
--
-- HairStyle-Vokabular: None, Short, Messy, Curly, Long, Mohawk, Bowl, Ponytail,
--                      Afro, Buzz, Spiky, Bun, Mullet

local Bodies = require(script.Parent:WaitForChild("Bodies"))

local Accessories = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rgb = Color3.fromRGB

local UPRIGHT = Bodies.UPRIGHT
local FORWARD = Bodies.FORWARD
local segment = Bodies.Segment
local ring = Bodies.Ring

local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass
local WOOD = Enum.Material.Wood
local FABRIC = Enum.Material.Fabric

local BLACK = rgb(28, 26, 32)
local DARKGREY = rgb(58, 60, 66)
local GREY = rgb(140, 144, 150)
local SILVER = rgb(205, 210, 218)
local WHITE = rgb(240, 240, 236)
local GOLD = rgb(255, 196, 60)
local BROWN = rgb(110, 72, 42)
local RED = rgb(210, 40, 40)

type Builder = (ctx: any, a: any, C: { [string]: Color3 }) -> ()

local Builders: { [string]: Builder } = {}

-------------------------------------------------------------------------------
-- Hilfen
-------------------------------------------------------------------------------
-- Höhe (relativ zur Kopfmitte), auf der Hüte sitzen
local function hatY(a: any): number
	local head = a.Head
	return math.max(head.Size.Y / 2, (head.HairTop or head.Size.Y / 2) - 0.08)
end

local function darker(c: Color3, f: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), f)
end

-- Hand-Slot holen: (Gruppe, Griff-CFrame, Seite) oder nil
local function handSlot(ctx: any, a: any, preferLeft: boolean?): (Model?, CFrame?, number)
	local function right()
		if a.HandR and not a.HeldUsed then
			a.HeldUsed = true
			local g = ctx:Group("Held", a.HandR.Group, a.HandR.CF.Position)
			return g, a.HandR.CF, 1
		end
		return nil, nil, 0
	end
	local function left()
		if a.HandL and not a.LeftUsed then
			a.LeftUsed = true
			return a.HandL.Group, a.HandL.CF, -1
		end
		return nil, nil, 0
	end
	local g, cf, side
	if preferLeft then
		g, cf, side = left()
		if not g then
			g, cf, side = right()
		end
	else
		g, cf, side = right()
		if not g then
			g, cf, side = left()
		end
	end
	return g, cf, side
end

-- Gruppe "Orbit" holen/anlegen
local function orbitGroup(ctx: any, a: any): Model
	return ctx:GetGroup("Orbit", ctx.Model, a.Center.Position)
end

-- Mantel-Grundform (LabCoat, Jacket, Trenchcoat, Vest)
local function coat(ctx: any, a: any, color: Color3, length: number, sleeves: boolean, material: Enum.Material?)
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	local len = math.min(length, math.max(0, (a.HipY or 1) - 0.45))
	local total = h + len
	local cy = h / 2 - total / 2 + 0.03
	ctx:Part(T.Group, "CoatBack", "Block", V3(w + 0.1, total + 0.06, d * 0.72), T.CF * CF(0, cy, d * 0.16 + 0.04), color, material)
	for _, side in { -1, 1 } do
		ctx:Part(T.Group, "CoatFlap", "Block", V3(w * 0.3, total + 0.06, 0.08), T.CF * CF(side * (w * 0.35 + 0.05), cy, -d / 2 - 0.04), color, material)
	end
	if sleeves and a.Parts then
		ctx:Recolor(a.Parts.ArmL, color, material)
		ctx:Recolor(a.Parts.ArmR, color, material)
	end
end

-------------------------------------------------------------------------------
-- Frisuren
-------------------------------------------------------------------------------
local Hair: { [string]: (ctx: any, a: any, color: Color3) -> number } = {}

local function hairCap(ctx: any, a: any, color: Color3, t: number): ()
	local head = a.Head
	local W, H, D = head.Size.X, head.Size.Y, head.Size.Z
	local cf = head.CF * CF(0, H / 2 + t / 2 - 0.06, 0)
	if head.Round then
		ctx:Part(head.Group, "Hair", "Cyl", V3(t, W + 0.08, W + 0.08), cf * UPRIGHT, color)
	else
		ctx:Part(head.Group, "Hair", "Block", V3(W + 0.08, t, D + 0.08), cf, color)
	end
end

local function hairPart(ctx: any, a: any, color: Color3, shape: string, size: Vector3, x: number, y: number, z: number, rot: CFrame?)
	local cf = a.Head.CF * CF(x, y, z)
	if rot then
		cf *= rot
	end
	return ctx:Part(a.Head.Group, "Hair", shape, size, cf, color)
end

Hair.Short = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.22)
	hairPart(ctx, a, c, "Block", V3(s.X * 0.9, s.Y * 0.55, 0.16), 0, s.Y * 0.18, s.Z / 2 - 0.02)
	return s.Y / 2 + 0.16
end

Hair.Buzz = function(ctx: any, a: any, c: Color3): number
	hairCap(ctx, a, c, 0.12)
	return a.Head.Size.Y / 2 + 0.06
end

Hair.Messy = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.25)
	hairPart(ctx, a, c, "Block", V3(0.32, 0.22, 0.32), -s.X * 0.25, s.Y / 2 + 0.2, -0.1, ANG(0.3, 0.5, 0.4))
	hairPart(ctx, a, c, "Block", V3(0.3, 0.22, 0.34), s.X * 0.2, s.Y / 2 + 0.22, 0.05, ANG(-0.2, 0.8, -0.5))
	hairPart(ctx, a, c, "Block", V3(0.28, 0.2, 0.3), 0, s.Y / 2 + 0.18, s.Z * 0.28, ANG(0.6, 0.2, 0.1))
	hairPart(ctx, a, c, "Block", V3(s.X * 0.72, 0.15, 0.14), 0, s.Y * 0.38, -s.Z / 2 + 0.02)
	return s.Y / 2 + 0.3
end

Hair.Curly = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	local d = s.X * 0.48
	local spots = {
		{ -0.25, 0.5, -0.12 },
		{ 0.25, 0.5, -0.12 },
		{ 0, 0.56, 0.15 },
		{ -0.32, 0.28, 0.3 },
		{ 0.32, 0.28, 0.3 },
		{ 0, 0.3, 0.42 },
	}
	for _, p in spots do
		hairPart(ctx, a, c, "Ball", V3(d, d, d), p[1] * s.X, p[2] * s.Y, p[3] * s.Z)
	end
	return s.Y * 0.56 + d / 2
end

Hair.Long = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.22)
	hairPart(ctx, a, c, "Block", V3(s.X + 0.04, s.Y + 0.5, 0.22), 0, -0.25, s.Z / 2 - 0.02)
	for _, side in { -1, 1 } do
		hairPart(ctx, a, c, "Block", V3(0.14, s.Y * 0.85, s.Z * 0.5), side * (s.X / 2 + 0.02), -s.Y * 0.08, s.Z * 0.12)
	end
	return s.Y / 2 + 0.16
end

Hair.Mohawk = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.1)
	hairPart(ctx, a, c, "Block", V3(0.2, 0.55, s.Z * 0.9), 0, s.Y / 2 + 0.27, 0.05)
	return s.Y / 2 + 0.55
end

Hair.Bowl = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.14)
	if a.Head.Round then
		hairPart(ctx, a, c, "Cyl", V3(s.Y * 0.4, s.X + 0.14, s.X + 0.14), 0, s.Y * 0.41, 0, UPRIGHT)
	else
		hairPart(ctx, a, c, "Block", V3(s.X + 0.14, s.Y * 0.4, s.Z + 0.14), 0, s.Y * 0.41, 0)
	end
	return s.Y / 2 + 0.1
end

Hair.Ponytail = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.2)
	hairPart(ctx, a, c, "Block", V3(s.X * 0.82, s.Y * 0.45, 0.15), 0, s.Y * 0.2, s.Z / 2 - 0.02)
	hairPart(ctx, a, c, "Ball", V3(0.34, 0.34, 0.34), 0, s.Y * 0.22, s.Z / 2 + 0.14)
	hairPart(ctx, a, c, "Block", V3(0.26, 0.75, 0.26), 0, -s.Y * 0.18, s.Z / 2 + 0.22, ANG(-0.15, 0, 0))
	return s.Y / 2 + 0.14
end

Hair.Afro = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	local d = s.X * 1.45
	hairPart(ctx, a, c, "Ball", V3(d, d, d), 0, s.Y * 0.55, 0.2)
	return s.Y * 0.55 + d / 2
end

Hair.Spiky = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.2)
	local y = s.Y / 2 + 0.25
	hairPart(ctx, a, c, "Block", V3(0.22, 0.5, 0.22), -s.X * 0.25, y, 0, ANG(0, 0, 0.5))
	hairPart(ctx, a, c, "Block", V3(0.22, 0.5, 0.22), s.X * 0.25, y, 0, ANG(0, 0, -0.5))
	hairPart(ctx, a, c, "Block", V3(0.22, 0.55, 0.22), 0, y + 0.05, -s.Z * 0.18, ANG(-0.45, 0, 0))
	hairPart(ctx, a, c, "Block", V3(0.22, 0.5, 0.22), 0, y, s.Z * 0.22, ANG(0.5, 0, 0))
	return s.Y / 2 + 0.45
end

Hair.Bun = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.2)
	hairPart(ctx, a, c, "Ball", V3(0.5, 0.5, 0.5), 0, s.Y / 2 + 0.3, 0.12)
	return s.Y / 2 + 0.14
end

Hair.Mullet = function(ctx: any, a: any, c: Color3): number
	local s = a.Head.Size
	hairCap(ctx, a, c, 0.2)
	hairPart(ctx, a, c, "Block", V3(s.X * 0.86, s.Y * 0.85, 0.2), 0, -s.Y * 0.22, s.Z / 2)
	return s.Y / 2 + 0.14
end

Accessories.HairStyles = { "None", "Short", "Messy", "Curly", "Long", "Mohawk", "Bowl", "Ponytail", "Afro", "Buzz", "Spiky", "Bun", "Mullet" }

function Accessories.HasHairStyle(style: string): boolean
	return style == "None" or Hair[style] ~= nil
end

function Accessories.BuildHair(ctx: any, a: any, style: string, C: { [string]: Color3 }): boolean
	local fn = Hair[style]
	if not fn or not a.Head then
		return false
	end
	local cp = ctx:Checkpoint()
	local ok, result = pcall(fn, ctx, a, C.Hair)
	if not ok or ctx.Count > ctx.Limit then
		ctx:Rollback(cp)
		return false
	end
	a.Head.HairTop = result
	return true
end

-------------------------------------------------------------------------------
-- Kopf
-------------------------------------------------------------------------------
local function headPart(ctx: any, a: any, name: string, shape: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, props: any?)
	return ctx:Part(a.Head.Group, name, shape, size, a.Head.CF * offset, color, material, props)
end

local function capBase(ctx: any, a: any, C: { [string]: Color3 }, backward: boolean)
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	local y = hatY(a)
	if head.Round then
		headPart(ctx, a, "Cap", "Cyl", V3(0.38, s.X + 0.12, s.X + 0.12), CF(0, y + 0.1, 0) * UPRIGHT, C.Accent)
	else
		headPart(ctx, a, "Cap", "Block", V3(s.X + 0.12, 0.38, s.Z + 0.12), CF(0, y + 0.1, 0), C.Accent)
	end
	local z = (s.Z / 2 + 0.25) * (if backward then 1 else -1)
	headPart(ctx, a, "Brim", "Block", V3(s.X * 0.8, 0.08, 0.6), CF(0, y - 0.06, z), darker(C.Accent, 0.2))
end

Builders.Cap = function(ctx: any, a: any, C: { [string]: Color3 })
	capBase(ctx, a, C, false)
end

Builders.CapBackward = function(ctx: any, a: any, C: { [string]: Color3 })
	capBase(ctx, a, C, true)
end

Builders.BikeHelmet = function(ctx: any, a: any, C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	local y = hatY(a)
	headPart(ctx, a, "Helmet", "Sphere", V3(s.X + 0.34, 0.85, s.Z + 0.4), CF(0, y - 0.02, 0.04), C.Accent)
	headPart(ctx, a, "HelmetStripe", "Block", V3(0.18, 0.2, s.Z + 0.3), CF(0, y + 0.33, 0.04), WHITE)
	headPart(ctx, a, "HelmetVisor", "Block", V3(s.X * 0.7, 0.07, 0.28), CF(0, y - 0.05, -s.Z / 2 - 0.2), darker(C.Accent, 0.35))
end

Builders.Headphones = function(ctx: any, a: any, C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	local y = hatY(a)
	headPart(ctx, a, "Band", "Block", V3(s.X + 0.3, 0.1, 0.16), CF(0, y + 0.1, 0), BLACK)
	for _, side in { -1, 1 } do
		headPart(ctx, a, "EarCup", "Cyl", V3(0.22, 0.48, 0.48), CF(side * (s.X / 2 + 0.1), 0, 0), C.Accent)
	end
end

Builders.Glasses = function(ctx: any, a: any, _C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	local W, H = F.W, F.H
	local z = -(if F.Round then 0.04 else 0.06)
	ctx:Part(F.Group, "GlassesFrame", "Block", V3(W * 0.82, 0.07, 0.05), F.CF * CF(0, H * 0.14, z - 0.02), BLACK, nil, { Role = "Eye" })
	for _, side in { -1, 1 } do
		local x = side * W * 0.2
		local back = if F.Round then F.Round - math.sqrt(F.Round ^ 2 - x * x) else 0
		ctx:Part(F.Group, "Lens", "Block", V3(W * 0.26, H * 0.24, 0.04), F.CF * CF(x, H * 0.07, back + z) * ANG(0, -math.asin(x / (F.Round or 1e3)), 0), rgb(180, 220, 255), GLASS, { Transparency = 0.45, Role = "Eye" })
	end
end

Builders.Shades = function(ctx: any, a: any, _C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	ctx:Part(F.Group, "Shades", "Block", V3(F.W * 0.86, F.H * 0.22, 0.08), F.CF * CF(0, F.H * 0.08, -0.05), BLACK, nil, { Reflectance = 0.3, Role = "Eye" })
end

Builders.Goggles = function(ctx: any, a: any, C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	local y = s.Y * 0.3
	if head.Round then
		headPart(ctx, a, "Strap", "Cyl", V3(0.16, s.X + 0.06, s.X + 0.06), CF(0, y, 0) * UPRIGHT, BLACK)
	else
		headPart(ctx, a, "Strap", "Block", V3(s.X + 0.06, 0.16, s.Z + 0.06), CF(0, y, 0), BLACK)
	end
	for _, side in { -1, 1 } do
		headPart(ctx, a, "GoggleLens", "Cyl", V3(0.16, 0.36, 0.36), CF(side * s.X * 0.2, y + 0.04, -s.Z / 2 - 0.04) * FORWARD, C.Accent, GLASS, { Transparency = 0.2 })
	end
end

Builders.NightVision = function(ctx: any, a: any, C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	local y = s.Y * 0.08
	if head.Round then
		headPart(ctx, a, "Strap", "Cyl", V3(0.18, s.X + 0.06, s.X + 0.06), CF(0, y, 0) * UPRIGHT, BLACK)
	else
		headPart(ctx, a, "Strap", "Block", V3(s.X + 0.06, 0.18, s.Z + 0.06), CF(0, y, 0), BLACK)
	end
	for _, side in { -1, 1 } do
		headPart(ctx, a, "NVTube", "Cyl", V3(0.3, 0.26, 0.26), CF(side * s.X * 0.2, y, -s.Z / 2 - 0.14) * FORWARD, DARKGREY, METAL)
		headPart(ctx, a, "NVLens", "Cyl", V3(0.05, 0.2, 0.2), CF(side * s.X * 0.2, y, -s.Z / 2 - 0.3) * FORWARD, C.Glow, NEON, { Role = "Glow" })
	end
end

Builders.GasMask = function(ctx: any, a: any, C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	local W, H = F.W, F.H
	ctx:Part(F.Group, "MaskPlate", "Block", V3(W * 0.8, H * 0.44, 0.12), F.CF * CF(0, -H * 0.2, -0.04), DARKGREY)
	ctx:Part(F.Group, "MaskSnout", "Cyl", V3(0.32, 0.42, 0.42), F.CF * CF(0, -H * 0.24, -0.24) * FORWARD, BLACK)
	ctx:Part(F.Group, "MaskFilter", "Cyl", V3(0.12, 0.32, 0.32), F.CF * CF(0, -H * 0.24, -0.44) * FORWARD, C.Accent)
end

local function band(ctx: any, a: any, color: Color3, y: number, t: number)
	local head = a.Head
	local s = head.Size
	if head.Round then
		headPart(ctx, a, "Band", "Cyl", V3(t, s.X + 0.06, s.X + 0.06), CF(0, y, 0) * UPRIGHT, color)
	else
		headPart(ctx, a, "Band", "Block", V3(s.X + 0.06, t, s.Z + 0.06), CF(0, y, 0), color)
	end
end

Builders.Headband = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Head then
		return
	end
	band(ctx, a, C.Accent, a.Head.Size.Y * 0.32, 0.15)
end

Builders.Bandana = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Head then
		return
	end
	local s = a.Head.Size
	band(ctx, a, C.Accent, s.Y * 0.3, 0.2)
	headPart(ctx, a, "Knot", "Block", V3(0.18, 0.4, 0.1), CF(0.12, s.Y * 0.12, s.Z / 2 + 0.08) * ANG(0, 0, 0.35), C.Accent)
	headPart(ctx, a, "Knot", "Block", V3(0.18, 0.36, 0.1), CF(-0.1, s.Y * 0.1, s.Z / 2 + 0.1) * ANG(0, 0, -0.3), C.Accent)
end

Builders.SheriffHat = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Head then
		return
	end
	local s = a.Head.Size
	local y = hatY(a)
	headPart(ctx, a, "HatBrim", "Cyl", V3(0.09, s.X + 0.95, s.X + 0.95), CF(0, y, 0) * UPRIGHT, C.Accent)
	headPart(ctx, a, "HatCrown", "Block", V3(s.X * 0.82, 0.5, s.Z * 0.78), CF(0, y + 0.27, 0), C.Accent)
	headPart(ctx, a, "HatBand", "Block", V3(s.X * 0.84, 0.1, s.Z * 0.8), CF(0, y + 0.1, 0), darker(C.Accent, 0.5))
	headPart(ctx, a, "HatStar", "Block", V3(0.16, 0.16, 0.05), CF(0, y + 0.3, -s.Z * 0.4) * ANG(0, 0, math.pi / 4), GOLD, METAL)
end

Builders.RangerHat = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Head then
		return
	end
	local s = a.Head.Size
	local y = hatY(a)
	headPart(ctx, a, "HatBrim", "Cyl", V3(0.08, s.X + 1.05, s.X + 1.05), CF(0, y, 0) * UPRIGHT, C.Accent)
	headPart(ctx, a, "HatCrown", "Cyl", V3(0.48, s.X * 0.8, s.X * 0.8), CF(0, y + 0.26, 0) * UPRIGHT, C.Accent)
	headPart(ctx, a, "HatPinch", "Block", V3(0.08, 0.14, s.X * 0.6), CF(0, y + 0.52, 0), darker(C.Accent, 0.25))
end

Builders.DetectiveHat = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Head then
		return
	end
	local s = a.Head.Size
	local y = hatY(a)
	headPart(ctx, a, "HatBrim", "Cyl", V3(0.08, s.X + 0.55, s.X + 0.55), CF(0, y, 0) * UPRIGHT, C.Accent)
	headPart(ctx, a, "HatCrown", "Cyl", V3(0.46, s.X * 0.86, s.X * 0.86), CF(0, y + 0.25, 0) * UPRIGHT, C.Accent)
	headPart(ctx, a, "HatBand", "Cyl", V3(0.12, s.X * 0.88, s.X * 0.88), CF(0, y + 0.1, 0) * UPRIGHT, BLACK)
end

Builders.BucketHat = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Head then
		return
	end
	local s = a.Head.Size
	local y = hatY(a)
	headPart(ctx, a, "HatCrown", "Cyl", V3(0.42, s.X + 0.08, s.X + 0.08), CF(0, y + 0.12, 0) * UPRIGHT, C.Accent, FABRIC)
	headPart(ctx, a, "HatBrim", "Cyl", V3(0.1, s.X + 0.5, s.X + 0.5), CF(0, y - 0.08, 0) * UPRIGHT, darker(C.Accent, 0.15), FABRIC)
end

Builders.Hood = function(ctx: any, a: any, C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	headPart(ctx, a, "Hood", "Block", V3(s.X + 0.28, s.Y + 0.24, s.Z + 0.1), CF(0, 0.1, 0.18), C.Top)
	head.HairTop = s.Y / 2 + 0.22
	local T = a.Torso
	if T and a.Kind == "Humanoid" then
		ctx:Part(T.Group, "HoodDrape", "Block", V3(T.Size.X * 0.8, 0.3, T.Size.Z + 0.12), T.CF * CF(0, T.Size.Y / 2 + 0.05, 0.08), C.Top)
	end
end

local function topAnchor(a: any): (Model?, CFrame?, number)
	local top = a.Top
	if not top then
		return nil, nil, 1
	end
	local lift = 0
	if a.Head and a.Head.Group == top.Group then
		lift = math.max(0, (a.Head.HairTop or 0) - a.Head.Size.Y / 2)
	end
	return top.Group, top.CF * CF(0, lift, 0), top.W
end

Builders.Crown = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, cf, w = topAnchor(a)
	if not g or not cf then
		return
	end
	local d = w * 0.85
	ctx:Part(g, "CrownBand", "Cyl", V3(0.3, d, d), cf * CF(0, 0.12, 0) * UPRIGHT, C.Accent, METAL)
	for i = 0, 3 do
		local theta = i / 4 * math.pi * 2 + math.pi / 4
		ctx:Part(g, "CrownPoint", "Block", V3(0.22, 0.22, 0.08), cf * ANG(0, theta, 0) * CF(0, 0.34, -d / 2 + 0.02) * ANG(0, 0, math.pi / 4), C.Accent, METAL)
	end
	ctx:Part(g, "CrownGem", "Ball", V3(0.2, 0.2, 0.2), cf * CF(0, 0.14, -d / 2 - 0.04), C.Glow, NEON)
end

Builders.Halo = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, cf, w = topAnchor(a)
	if not g or not cf then
		return
	end
	ring(ctx, g, "Halo", cf * CF(0, 0.55, 0), w * 0.45 + 0.12, 0.11, 8, C.Glow, NEON, "Glow")
end

Builders.Horns = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, cf, w = topAnchor(a)
	if not g or not cf then
		return
	end
	local base = cf.Position
	for _, side in { -1, 1 } do
		local p0 = base + V3(side * w * 0.32, -0.08, 0)
		local p1 = p0 + V3(side * 0.38, 0.45, 0.05)
		local p2 = p1 + V3(side * 0.04, 0.42, -0.18)
		segment(ctx, g, "Horn", p0, p1, 0.26, C.Accent)
		segment(ctx, g, "HornTip", p1, p2, 0.15, darker(C.Accent, 0.2))
	end
end

Builders.Antlers = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, cf, w = topAnchor(a)
	if not g or not cf then
		return
	end
	local base = cf.Position
	for _, side in { -1, 1 } do
		local p0 = base + V3(side * w * 0.3, -0.05, 0)
		local p1 = p0 + V3(side * 0.55, 0.7, 0.1)
		local p2 = p1 + V3(side * 0.35, 0.6, -0.05)
		segment(ctx, g, "Antler", p0, p1, 0.14, C.Accent)
		segment(ctx, g, "Antler", p1, p2, 0.12, C.Accent)
		segment(ctx, g, "Tine", p1, p1 + V3(-side * 0.05, 0.5, -0.3), 0.1, C.Accent)
	end
end

Builders.Antennae = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, cf, w = topAnchor(a)
	if not g or not cf then
		return
	end
	local base = cf.Position
	for _, side in { -1, 1 } do
		local p0 = base + V3(side * w * 0.2, -0.05, -0.05)
		local p1 = p0 + V3(side * 0.35, 0.75, -0.25)
		segment(ctx, g, "Antenna", p0, p1, 0.07, C.Accent)
		ctx:Part(g, "AntennaTip", "Ball", V3(0.18, 0.18, 0.18), CF(p1), C.Glow, NEON)
	end
end

Builders.Earpiece = function(ctx: any, a: any, _C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	headPart(ctx, a, "Earpiece", "Block", V3(0.1, 0.18, 0.14), CF(s.X / 2 + 0.04, 0, 0), BLACK)
	headPart(ctx, a, "EarCord", "Block", V3(0.04, 0.45, 0.04), CF(s.X / 2 + 0.04, -0.3, 0.05), rgb(230, 230, 230))
end

Builders.Beard = function(ctx: any, a: any, C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	local W, H = F.W, F.H
	ctx:Part(F.Group, "Beard", "Block", V3(W * 0.82, H * 0.4, 0.3), F.CF * CF(0, -H * 0.3, 0.02), C.Hair)
	ctx:Part(F.Group, "Moustache", "Block", V3(W * 0.5, H * 0.09, 0.14), F.CF * CF(0, -H * 0.1, -0.1), C.Hair)
end

Builders.Eyestalks = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, cf, w = topAnchor(a)
	if not g or not cf then
		return
	end
	local base = cf.Position
	for _, side in { -1, 1 } do
		local p0 = base + V3(side * w * 0.22, -0.05, 0)
		local p1 = p0 + V3(side * 0.3, 0.8, -0.15)
		segment(ctx, g, "Stalk", p0, p1, 0.13, C.Accent, nil, "Cyl")
		ctx:Part(g, "StalkEye", "Ball", V3(0.4, 0.4, 0.4), CF(p1), WHITE, nil, { Role = "Eye" })
		ctx:Part(g, "StalkPupil", "Ball", V3(0.18, 0.18, 0.18), CF(p1 + V3(0, 0, -0.14)), C.Glow, NEON, { Role = "Eye" })
	end
end

Builders.ThirdEye = function(ctx: any, a: any, C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	local W, H = F.W, F.H
	ctx:Part(F.Group, "ThirdEyeLid", "Sphere", V3(W * 0.26, H * 0.16, 0.08), F.CF * CF(0, H * 0.33, -0.01), C.Accent, nil, { Role = "Eye" })
	ctx:Part(F.Group, "ThirdEye", "Ball", V3(W * 0.09, W * 0.09, W * 0.09), F.CF * CF(0, H * 0.33, -0.04), C.Glow, NEON, { Role = "Eye" })
end

Builders.Mandibles = function(ctx: any, a: any, C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	local W, H = F.W, F.H
	for _, side in { -1, 1 } do
		local p0 = (F.CF * CF(side * W * 0.3, -H * 0.3, 0.05)).Position
		local p1 = (F.CF * CF(side * W * 0.38, -H * 0.42, -0.45)).Position
		local p2 = (F.CF * CF(side * W * 0.08, -H * 0.45, -0.7)).Position
		segment(ctx, F.Group, "Mandible", p0, p1, 0.14, C.Accent)
		segment(ctx, F.Group, "MandibleTip", p1, p2, 0.1, darker(C.Accent, 0.3))
	end
end

Builders.Teeth = function(ctx: any, a: any, _C: { [string]: Color3 })
	local F = a.Face
	if not F then
		return
	end
	local W, H = F.W, F.H
	for i = -2, 2 do
		ctx:Part(F.Group, "Tooth", "Block", V3(0.14, 0.14, 0.06), F.CF * CF(i * W * 0.1, -H * 0.33, -0.04) * ANG(0, 0, math.pi / 4), WHITE, nil, { Role = "Eye" })
	end
end

Builders.Ears = function(ctx: any, a: any, C: { [string]: Color3 })
	local head = a.Head
	if not head then
		return
	end
	local s = head.Size
	for _, side in { -1, 1 } do
		headPart(ctx, a, "Ear", "Wedge", V3(0.22, 0.5, 0.36), CF(side * s.X * 0.32, s.Y / 2 + 0.22, 0.02), C.Skin)
		headPart(ctx, a, "EarInner", "Wedge", V3(0.12, 0.34, 0.2), CF(side * s.X * 0.32, s.Y / 2 + 0.17, -0.06), C.Accent)
	end
end

-------------------------------------------------------------------------------
-- Körper
-------------------------------------------------------------------------------
Builders.LabCoat = function(ctx: any, a: any, _C: { [string]: Color3 })
	coat(ctx, a, rgb(238, 240, 242), 0.95, true)
end

Builders.Jacket = function(ctx: any, a: any, C: { [string]: Color3 })
	coat(ctx, a, C.Accent, 0.12, true)
end

Builders.Trenchcoat = function(ctx: any, a: any, C: { [string]: Color3 })
	coat(ctx, a, C.Accent, 1.35, true)
	local T = a.Torso
	if T and a.Kind == "Humanoid" then
		ctx:Part(T.Group, "CoatBelt", "Block", V3(T.Size.X + 0.14, 0.18, T.Size.Z + 0.16), T.CF * CF(0, -T.Size.Y * 0.25, 0), darker(C.Accent, 0.35))
	end
end

Builders.Vest = function(ctx: any, a: any, C: { [string]: Color3 })
	coat(ctx, a, C.Accent, 0, false)
end

Builders.Apron = function(ctx: any, a: any, C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	local len = h * 0.75 + math.min(0.7, (a.HipY or 1) * 0.4)
	ctx:Part(T.Group, "Apron", "Block", V3(w * 0.72, len, 0.06), T.CF * CF(0, h * 0.25 - len / 2, -d / 2 - 0.04), C.Accent)
	ctx:Part(T.Group, "ApronPocket", "Block", V3(w * 0.4, 0.3, 0.07), T.CF * CF(0, -h * 0.25, -d / 2 - 0.06), darker(C.Accent, 0.12))
end

Builders.HazmatSuit = function(ctx: any, a: any, C: { [string]: Color3 })
	local P = a.Parts
	local suit = rgb(240, 200, 40)
	if P and a.Kind == "Humanoid" then
		for _, key in { "Torso", "LegL", "LegR", "ArmL", "ArmR" } do
			ctx:Recolor(P[key], suit)
		end
		ctx:Recolor(P.ShoeL, BLACK)
		ctx:Recolor(P.ShoeR, BLACK)
		ctx:Recolor(P.HandL, BLACK)
		ctx:Recolor(P.HandR, BLACK)
	end
	local head = a.Head
	if head then
		local s = head.Size
		headPart(ctx, a, "HazmatHood", "Block", V3(s.X + 0.3, s.Y + 0.28, s.Z + 0.12), CF(0, 0.08, 0.2), suit)
		headPart(ctx, a, "HazmatVisor", "Block", V3(s.X * 0.8, s.Y * 0.62, 0.05), CF(0, 0.04, -s.Z / 2 - 0.1), rgb(200, 235, 255), GLASS, { Transparency = 0.55, Role = "Eye" })
		head.HairTop = s.Y / 2 + 0.22
	end
end

Builders.Scarf = function(ctx: any, a: any, C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	ctx:Part(T.Group, "Scarf", "Block", V3(w * 0.72, 0.32, d + 0.14), T.CF * CF(0, h / 2 + 0.06, 0), C.Accent, FABRIC)
	ctx:Part(T.Group, "ScarfTail", "Block", V3(0.3, 0.85, 0.09), T.CF * CF(-w * 0.2, h / 2 - 0.4, -d / 2 - 0.07) * ANG(0, 0, 0.08), C.Accent, FABRIC)
end

Builders.Tie = function(ctx: any, a: any, C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	ctx:Part(T.Group, "TieKnot", "Block", V3(w * 0.12, 0.14, 0.07), T.CF * CF(0, h / 2 - 0.1, -d / 2 - 0.035), darker(C.Accent, 0.2))
	ctx:Part(T.Group, "Tie", "Block", V3(w * 0.14, h * 0.6, 0.05), T.CF * CF(0, h * 0.12, -d / 2 - 0.03), C.Accent)
end

Builders.Badge = function(ctx: any, a: any, _C: { [string]: Color3 })
	local T = a.Torso
	if not T then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	local cf = T.CF * CF(-w * 0.26, h * 0.2, -d / 2 - 0.04)
	ctx:Part(T.Group, "Badge", "Block", V3(0.26, 0.26, 0.05), cf * ANG(0, 0, math.pi / 4), GOLD, METAL)
	ctx:Part(T.Group, "BadgeCenter", "Block", V3(0.13, 0.13, 0.07), cf, rgb(255, 240, 180), METAL)
end

Builders.Camera = function(ctx: any, a: any, _C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	ctx:Part(T.Group, "CameraStrap", "Block", V3(0.06, h * 0.45, 0.04), T.CF * CF(w * 0.15, h * 0.3, -d / 2 - 0.03), BLACK)
	ctx:Part(T.Group, "Camera", "Block", V3(0.55, 0.36, 0.26), T.CF * CF(w * 0.15, 0, -d / 2 - 0.14), DARKGREY)
	ctx:Part(T.Group, "CameraLens", "Cyl", V3(0.2, 0.26, 0.26), T.CF * CF(w * 0.15, -0.02, -d / 2 - 0.36) * FORWARD, BLACK, GLASS)
end

Builders.Whistle = function(ctx: any, a: any, _C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local h, d = T.Size.Y, T.Size.Z
	ctx:Part(T.Group, "WhistleCord", "Block", V3(0.05, h * 0.38, 0.03), T.CF * CF(0, h * 0.3, -d / 2 - 0.02), RED)
	ctx:Part(T.Group, "Whistle", "Block", V3(0.14, 0.12, 0.22), T.CF * CF(0, h * 0.08, -d / 2 - 0.1), SILVER, METAL)
end

Builders.Cape = function(ctx: any, a: any, C: { [string]: Color3 })
	local T = a.Torso
	if not T then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	local total = h + (a.HipY or 1) * 0.8
	ctx:Part(T.Group, "CapeCollar", "Block", V3(w + 0.2, 0.26, d + 0.16), T.CF * CF(0, h / 2 + 0.02, 0.02), darker(C.Accent, 0.25))
	ctx:Part(T.Group, "Cape", "Block", V3(w + 0.3, total, 0.12), T.CF * CF(0, h / 2, d / 2 + 0.1) * ANG(-0.08, 0, 0) * CF(0, -total / 2, 0), C.Accent, FABRIC)
end

Builders.Shoulderpads = function(ctx: any, a: any, C: { [string]: Color3 })
	for _, key in { "ArmL", "ArmR" } do
		local arm = a[key]
		if arm then
			ctx:Part(arm.Group, "Shoulderpad", "Block", V3(arm.W + 0.32, 0.3, arm.D + 0.3), arm.Shoulder * CF(0, 0.08, 0), C.Accent, METAL)
		end
	end
end

Builders.Toolbelt = function(ctx: any, a: any, _C: { [string]: Color3 })
	local W = a.Waist
	if not W then
		return
	end
	ctx:Part(W.Group, "Belt", "Block", V3(W.W + 0.08, 0.24, W.D + 0.08), W.CF, BROWN)
	ctx:Part(W.Group, "Pouch", "Block", V3(0.36, 0.34, 0.24), W.CF * CF(W.W * 0.3, -0.12, -W.D / 2 - 0.1), darker(BROWN, 0.2))
	ctx:Part(W.Group, "Hammer", "Block", V3(0.1, 0.5, 0.1), W.CF * CF(-W.W * 0.32, -0.2, -W.D / 2 - 0.08), GREY, METAL)
end

Builders.PaperBag = function(ctx: any, a: any, C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	local p0 = (T.CF * CF(-w * 0.38, h / 2, -d / 2 - 0.03)).Position
	local p1 = (T.CF * CF(w * 0.4, -h / 2, -d / 2 - 0.03)).Position
	segment(ctx, T.Group, "BagStrap", p0, p1, 0.1, darker(C.Accent, 0.3))
	ctx:Part(T.Group, "Bag", "Block", V3(0.32, 0.65, 0.75), T.CF * CF(w / 2 + 0.16, -h / 2 + 0.05, 0), C.Accent, FABRIC)
	ctx:Part(T.Group, "Papers", "Block", V3(0.22, 0.2, 0.6), T.CF * CF(w / 2 + 0.16, -h / 2 + 0.45, 0), WHITE)
end

Builders.Backpack = function(ctx: any, a: any, C: { [string]: Color3 })
	local B = a.Back
	if not B then
		return
	end
	local w, h = B.W, B.H
	ctx:Part(B.Group, "Backpack", "Block", V3(w * 0.8, h * 0.78, 0.5), B.CF * CF(0, -h * 0.02, -0.25), C.Accent)
	ctx:Part(B.Group, "BackpackPocket", "Block", V3(w * 0.55, h * 0.3, 0.18), B.CF * CF(0, -h * 0.2, -0.56), darker(C.Accent, 0.3))
	local T = a.Torso
	if T and a.Kind == "Humanoid" then
		for _, side in { -1, 1 } do
			ctx:Part(T.Group, "Strap", "Block", V3(0.13, T.Size.Y * 0.62, 0.04), T.CF * CF(side * T.Size.X * 0.27, T.Size.Y * 0.18, -T.Size.Z / 2 - 0.02), darker(C.Accent, 0.3))
		end
	end
end

Builders.RadioPack = function(ctx: any, a: any, C: { [string]: Color3 })
	local B = a.Back
	if not B then
		return
	end
	local w, h = B.W, B.H
	ctx:Part(B.Group, "Radio", "Block", V3(w * 0.88, h * 0.85, 0.66), B.CF * CF(0, 0, -0.33), DARKGREY, METAL)
	ctx:Part(B.Group, "RadioDial", "Block", V3(w * 0.5, 0.16, 0.05), B.CF * CF(0, h * 0.2, -0.68), C.Glow, NEON)
	local top = B.CF * CF(w * 0.3, h * 0.42, -0.3)
	ctx:Part(B.Group, "RadioAntenna", "Cyl", V3(2.0, 0.07, 0.07), top * CF(0, 1.0, 0) * UPRIGHT, SILVER, METAL)
	ctx:Part(B.Group, "RadioAntennaTip", "Ball", V3(0.2, 0.2, 0.2), top * CF(0, 2.02, 0), RED, NEON)
end

Builders.Wings = function(ctx: any, a: any, C: { [string]: Color3 })
	local B = a.Back
	if not B or a.HasWings then
		return
	end
	a.HasWings = true
	local base = (B.CF * CF(0, B.H * 0.2, -0.1)).Position
	for _, side in { -1, 1 } do
		local nm = if side > 0 then "R" else "L"
		local root = base + V3(side * 0.3, 0, 0)
		local g = ctx:Group("Wing" .. nm, ctx.Model, root)
		local cf = CF(root) * ANG(0, -side * 0.4, 0) * ANG(0, 0, side * 0.3)
		ctx:Part(g, "Wing", "Block", V3(1.9, 1.3, 0.08), cf * CF(side * 1.0, 0.35, 0), C.Accent)
		ctx:Part(g, "WingTip", "Block", V3(1.3, 0.85, 0.08), cf * CF(side * 1.25, -0.45, 0.04) * ANG(0, 0, -side * 0.35), darker(C.Accent, 0.25))
	end
end

Builders.Spikes = function(ctx: any, a: any, C: { [string]: Color3 })
	local B = a.Back
	if not B then
		return
	end
	for i = 0, 3 do
		local t = B.H * (0.36 - i * 0.24)
		ctx:Part(B.Group, "Spike", "Wedge", V3(0.16, 0.5, 0.6), B.CF * CF(0, t, -0.28), C.Accent)
	end
end

Builders.Tail = function(ctx: any, a: any, C: { [string]: Color3 })
	local root = a.TailRoot
	if not root or a.HasTail then
		return
	end
	a.HasTail = true
	local g = ctx:Group("Tail", ctx.Model, root)
	local p1 = root + V3(0, -0.3, 0.7)
	local p2 = p1 + V3(0, -0.05, 0.65)
	local p3 = p2 + V3(0, 0.45, 0.4)
	segment(ctx, g, "Tail", root, p1, 0.3, C.Skin)
	segment(ctx, g, "Tail", p1, p2, 0.24, C.Skin)
	segment(ctx, g, "TailTip", p2, p3, 0.16, C.Accent)
end

Builders.Tentacles = function(ctx: any, a: any, C: { [string]: Color3 })
	local U = a.Under
	if U then
		local base = U.CF.Position
		for i = 0, 3 do
			local ang = i / 4 * math.pi * 2 + math.pi / 4
			local dx, dz = math.cos(ang), math.sin(ang)
			local p0 = base + V3(dx * U.R * 0.6, 0, dz * U.R * 0.6)
			local p1 = base + V3(dx * (U.R + 0.5), -0.8, dz * (U.R + 0.5))
			local p2 = base + V3(dx * (U.R + 0.95), -1.5, dz * (U.R + 0.95))
			p1 = V3(p1.X, math.max(p1.Y, 0.2), p1.Z)
			p2 = V3(p2.X, math.max(p2.Y, 0.06), p2.Z)
			segment(ctx, U.Group, "Tentacle", p0, p1, 0.26, C.Accent, nil, "Cyl")
			segment(ctx, U.Group, "Tentacle", p1, p2, 0.16, C.Accent, nil, "Cyl")
		end
		return
	end
	local B = a.Back
	if not B then
		return
	end
	local base = B.CF.Position
	for i, off in { V3(-0.5, 0.4, 0), V3(0.5, 0.4, 0), V3(0, -0.3, 0) } do
		local side = if off.X < 0 then -1 elseif off.X > 0 then 1 else 0
		local p0 = base + off
		local p1 = p0 + V3(side * 0.6, 0.5, 0.6)
		local p2 = p1 + V3(side * 0.5, 0.7 - i * 0.2, 0.5)
		segment(ctx, B.Group, "Tendril", p0, p1, 0.24, C.Accent, nil, "Cyl")
		segment(ctx, B.Group, "Tendril", p1, p2, 0.15, C.Accent, nil, "Cyl")
	end
end

Builders.Chains = function(ctx: any, a: any, _C: { [string]: Color3 })
	local T = a.Torso
	if not T or a.Kind ~= "Humanoid" then
		return
	end
	local w, h, d = T.Size.X, T.Size.Y, T.Size.Z
	for _, side in { -1, 1 } do
		local p0 = (T.CF * CF(side * w * 0.45, h * 0.45, -d / 2 - 0.05)).Position
		local p1 = (T.CF * CF(-side * w * 0.45, -h * 0.45, -d / 2 - 0.05)).Position
		segment(ctx, T.Group, "Chain", p0, p1, 0.13, GREY, METAL)
	end
	ctx:Part(T.Group, "Padlock", "Block", V3(0.3, 0.34, 0.14), T.CF * CF(0, 0, -d / 2 - 0.12), GOLD, METAL)
end

-------------------------------------------------------------------------------
-- Hand-Items (G = Griff-CFrame, s = Seite: +1 rechts, -1 links)
-------------------------------------------------------------------------------
local function hand(ctx: any, a: any, preferLeft: boolean?): (Model?, CFrame, number)
	local g, cf, s = handSlot(ctx, a, preferLeft)
	return g, cf or CFrame.identity, s
end

Builders.Flashlight = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, G = hand(ctx, a)
	if not g then
		return
	end
	ctx:Part(g, "FlashlightBody", "Cyl", V3(0.7, 0.22, 0.22), G * CF(0, 0, -0.22) * FORWARD, BLACK)
	ctx:Part(g, "FlashlightHead", "Cyl", V3(0.22, 0.34, 0.34), G * CF(0, 0, -0.64) * FORWARD, DARKGREY, METAL)
	ctx:Part(g, "FlashlightLens", "Cyl", V3(0.05, 0.28, 0.28), G * CF(0, 0, -0.77) * FORWARD, rgb(255, 245, 190), NEON, { Role = "Glow" })
end

Builders.WalkieTalkie = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, G = hand(ctx, a)
	if g then
		ctx:Part(g, "Walkie", "Block", V3(0.28, 0.52, 0.2), G * CF(0, 0.16, -0.12), DARKGREY)
		ctx:Part(g, "WalkieAntenna", "Cyl", V3(0.42, 0.06, 0.06), G * CF(0.08, 0.62, -0.12) * UPRIGHT, BLACK)
		ctx:Part(g, "WalkieLed", "Block", V3(0.07, 0.07, 0.04), G * CF(-0.06, 0.34, -0.23), RED, NEON)
		return
	end
	local W = a.Waist
	if W then
		ctx:Part(W.Group, "Walkie", "Block", V3(0.22, 0.48, 0.3), W.CF * CF(-(W.W / 2 + 0.12), -0.05, 0), DARKGREY)
		ctx:Part(W.Group, "WalkieAntenna", "Cyl", V3(0.38, 0.06, 0.06), W.CF * CF(-(W.W / 2 + 0.12), 0.38, 0.06) * UPRIGHT, BLACK)
	end
end

Builders.Clipboard = function(ctx: any, a: any, _C: { [string]: Color3 })
	local g, G = hand(ctx, a, true)
	if not g then
		return
	end
	local board = G * CF(0, 0.15, -0.38) * ANG(0.9, 0, 0)
	ctx:Part(g, "Clipboard", "Block", V3(0.62, 0.82, 0.06), board, BROWN)
	ctx:Part(g, "Paper", "Block", V3(0.52, 0.64, 0.02), board * CF(0, -0.05, -0.04), WHITE)
	ctx:Part(g, "Clip", "Block", V3(0.26, 0.09, 0.08), board * CF(0, 0.38, -0.05), SILVER, METAL)
end

Builders.Notebook = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, G, s = hand(ctx, a, true)
	if not g then
		return
	end
	local book = G * CF(0, 0.08, -0.32) * ANG(0.9, 0, 0)
	ctx:Part(g, "Notebook", "Block", V3(0.46, 0.62, 0.1), book, C.Accent)
	ctx:Part(g, "Pages", "Block", V3(0.42, 0.56, 0.08), book * CF(s * 0.04, 0, -0.01), WHITE)
end

local function batBase(ctx: any, g: Model, G: CFrame, s: number): (Vector3, Vector3)
	local dir = V3(s * 0.3, 1, 0.2).Unit
	local start = G.Position - dir * 0.12
	segment(ctx, g, "BatGrip", start, start + dir * 0.55, 0.13, BLACK, nil, "Cyl")
	return start, dir
end

Builders.SpikedBat = function(ctx: any, a: any, _C: { [string]: Color3 })
	local g, G, s = hand(ctx, a)
	if not g then
		return
	end
	local start, dir = batBase(ctx, g, G, s)
	segment(ctx, g, "BatBarrel", start + dir * 0.55, start + dir * 1.85, 0.27, rgb(160, 110, 60), WOOD, "Cyl")
	local collar = start + dir * 1.5
	segment(ctx, g, "BatCollar", collar - dir * 0.1, collar + dir * 0.1, 0.36, GREY, METAL, "Cyl")
	local side = dir:Cross(V3(0, 0, 1)).Unit
	local fwd = dir:Cross(side).Unit
	for _, v in { side, -side, fwd } do
		segment(ctx, g, "BatSpike", collar, collar + v * 0.32, 0.07, SILVER, METAL)
	end
end

Builders.SignalBat = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, G, s = hand(ctx, a)
	if not g then
		return
	end
	local start, dir = batBase(ctx, g, G, s)
	segment(ctx, g, "BatBarrel", start + dir * 0.55, start + dir * 1.8, 0.25, SILVER, METAL, "Cyl")
	segment(ctx, g, "BatCoil", start + dir * 0.75, start + dir * 1.1, 0.31, rgb(205, 115, 45), METAL, "Cyl")
	for _, t in { 1.3, 1.6 } do
		local p = start + dir * t
		segment(ctx, g, "BatSignal", p - dir * 0.05, p + dir * 0.05, 0.3, C.Glow, NEON, "Cyl")
	end
end

