            <string name="Name">AchievementConfig</string>
            <string name="Source"><![CDATA[--!strict
-- AchievementConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > AchievementConfig
--
-- Einmalige Erfolge. Die Logik prüft nach jeder relevanten Aktion alle noch
-- offenen Achievements (Check-Typen siehe Logic > Achievements).
--
--   Check = { Type = "Stat", Stat = "TotalRolls", Value = 1000 }
--           { Type = "BestRarity", Rarity = "Legendary" }
--           { Type = "Discovered", Value = 50 }
--           { Type = "MaxLevelCharacter" }
--           { Type = "Mutation" }

export type AchievementDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Check: { [string]: any },
	Rewards: {
		CashSeconds: number?,
		Potions: { [string]: number }?,
		Cosmetic: string?,
		SeasonXp: number?,
	},
}

local AchievementConfig = {}

AchievementConfig.List = {
	{ Id = "FirstRoll", DisplayName = "FIRST ROLL", Description = "Roll your first character.",
		Check = { Type = "Stat", Stat = "TotalRolls", Value = 1 }, Rewards = { CashSeconds = 0, Potions = { Luck = 1 } } },
	{ Id = "FirstRare", DisplayName = "SOMETHING STRANGE", Description = "Roll a Rare character.",
		Check = { Type = "BestRarity", Rarity = "Rare" }, Rewards = { CashSeconds = 0 } },
	{ Id = "FirstEpic", DisplayName = "EPIC FIND", Description = "Roll an Epic character.",
		Check = { Type = "BestRarity", Rarity = "Epic" }, Rewards = { CashSeconds = 0, Potions = { Luck = 1 } } },
	{ Id = "FirstLegendary", DisplayName = "FIRST LEGENDARY", Description = "Roll a Legendary character.",
		Check = { Type = "BestRarity", Rarity = "Legendary" }, Rewards = { CashSeconds = 0, Potions = { SuperLuck = 1 }, Cosmetic = "MysteryHunter" } },
	{ Id = "FirstMythic", DisplayName = "FIRST MYTHIC", Description = "Roll a Mythic character.",
		Check = { Type = "BestRarity", Rarity = "Mythic" }, Rewards = { CashSeconds = 30, Potions = { SuperLuck = 2 } } },
	{ Id = "FirstSupernatural", DisplayName = "BEYOND NATURE", Description = "Roll a Supernatural character.",
		Check = { Type = "BestRarity", Rarity = "Supernatural" }, Rewards = { CashSeconds = 60, Potions = { VoidElixir = 1 } } },
	{ Id = "FirstVoid", DisplayName = "FIRST VOID", Description = "Roll a Void character.",
		Check = { Type = "BestRarity", Rarity = "Void" }, Rewards = { CashSeconds = 90, Potions = { VoidElixir = 2 } } },
	{ Id = "FirstSecret", DisplayName = "FIRST SECRET", Description = "Roll a Secret character.",
		Check = { Type = "BestRarity", Rarity = "Secret" }, Rewards = { CashSeconds = 180, Potions = { VoidElixir = 3 } } },
	{ Id = "FirstAnomaly", DisplayName = "IT FOUND YOU", Description = "Roll an Anomaly.",
		Check = { Type = "BestRarity", Rarity = "Anomaly" }, Rewards = { CashSeconds = 600, Cosmetic = "AnomalyHunter" } },
	{ Id = "Rolls1000", DisplayName = "1,000 ROLLS", Description = "Roll 1,000 times.",
		Check = { Type = "Stat", Stat = "TotalRolls", Value = 1000 }, Rewards = { CashSeconds = 0, Potions = { Luck = 2 } } },
	{ Id = "Rolls10000", DisplayName = "10,000 ROLLS", Description = "Roll 10,000 times.",
		Check = { Type = "Stat", Stat = "TotalRolls", Value = 10000 }, Rewards = { CashSeconds = 60, Potions = { SuperLuck = 3 } } },
	{ Id = "Rolls100000", DisplayName = "100,000 ROLLS", Description = "Roll 100,000 times.",
		Check = { Type = "Stat", Stat = "TotalRolls", Value = 100000 }, Rewards = { CashSeconds = 300, Potions = { VoidElixir = 3 } } },
	{ Id = "Rebirth1", DisplayName = "BORN AGAIN", Description = "Complete your first Rebirth.",
		Check = { Type = "Stat", Stat = "Rebirths", Value = 1 }, Rewards = { Potions = { Luck = 2 } } },
	{ Id = "Rebirth10", DisplayName = "REBIRTH 10", Description = "Reach Rebirth 10.",
		Check = { Type = "Stat", Stat = "Rebirths", Value = 10 }, Rewards = { Potions = { VoidElixir = 2 } } },
	{ Id = "MaxCharacter", DisplayName = "MAX CHARACTER", Description = "Upgrade a character to level 15.",
		Check = { Type = "MaxLevelCharacter" }, Rewards = { CashSeconds = 30, Cosmetic = "MaxedOut" } },
	{ Id = "FirstMutation", DisplayName = "MUTATED", Description = "Roll a character with a mutation.",
		Check = { Type = "Mutation" }, Rewards = { CashSeconds = 0, Potions = { Mutagen = 1 } } },
	{ Id = "Index25", DisplayName = "CASE FILES I", Description = "Discover 25 characters.",
		Check = { Type = "Discovered", Value = 25 }, Rewards = { CashSeconds = 0, Potions = { SuperLuck = 1 } } },
	{ Id = "Index50", DisplayName = "CASE FILES II", Description = "Discover 50 characters.",
		Check = { Type = "Discovered", Value = 50 }, Rewards = { CashSeconds = 30, Cosmetic = "Collector" } },
	{ Id = "Index100", DisplayName = "THE COMPLETE ARCHIVE", Description = "Discover all 100 characters.",
		Check = { Type = "Discovered", Value = 100 }, Rewards = { CashSeconds = 300, Potions = { VoidElixir = 5 } } },
	{ Id = "Catch100", DisplayName = "RIFT ANGLER", Description = "Catch 100 items while fishing.",
		Check = { Type = "Stat", Stat = "FishingCatches", Value = 100 }, Rewards = { CashSeconds = 0, Cosmetic = "DeepAngler" } },
	{ Id = "Gear10", DisplayName = "GEARED UP", Description = "Obtain 10 gear items.",
		Check = { Type = "Stat", Stat = "GearObtained", Value = 10 }, Rewards = { CashSeconds = 0, Potions = { FishingLuck = 1 } } },
} :: { AchievementDef }

AchievementConfig.ById = {} :: { [string]: AchievementDef }
for _, a in AchievementConfig.List do
	AchievementConfig.ById[a.Id] = a
end

return AchievementConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">AreaConfig</string>
            <string name="Source"><![CDATA[--!strict
-- AreaConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > AreaConfig
--
-- Die sechs Gebiete. Das erste (Suburb) ist der Hub mit Spawn und Bases.
-- Die anderen liegen hintereinander an der "Signal Road" nach Norden (-Z).
--
-- Freischalten: RequiredRebirths erreicht UND UnlockCost bezahlt.
-- Ein freigeschaltetes Gebiet bringt:
--   * seine Dice (DiceConfig.Area)
--   * sein Fishing-Gewässer (FishingConfig.Waters[...].Area)
--   * Teleport im Menü
--
-- Position/Size beschreiben die Zone (für Licht/Ambience am Client und für
-- Server-Checks). Lighting wird vom Client weich überblendet.

export type AreaDef = {
	Id: string,
	DisplayName: string,
	Order: number,
	Tagline: string,
	RequiredRebirths: number,
	UnlockCost: number,
	Center: Vector3,
	Size: Vector3,
	PrimaryColor: Color3,
	SecondaryColor: Color3,
	GroundColor: Color3,
	GroundMaterial: Enum.Material,
	Lighting: {
		Ambient: Color3,
		OutdoorAmbient: Color3,
		FogColor: Color3,
		FogStart: number,
		FogEnd: number,
		ClockTime: number,
		Brightness: number,
		ColorShift: Color3,
	},
	Ambience: string,
}

local AreaConfig = {}

AreaConfig.List = {
	{
		Id = "Suburb",
		DisplayName = "MYSTERY SUBURB",
		Order = 1,
		Tagline = "A quiet 80s town. Too quiet.",
		RequiredRebirths = 0,
		UnlockCost = 0,
		Center = Vector3.new(0, 0, 0),
		Size = Vector3.new(560, 200, 560),
		PrimaryColor = Color3.fromRGB(255, 120, 60),
		SecondaryColor = Color3.fromRGB(70, 110, 255),
		GroundColor = Color3.fromRGB(46, 66, 44),
		GroundMaterial = Enum.Material.Grass,
		Lighting = {
			Ambient = Color3.fromRGB(70, 64, 100),
			OutdoorAmbient = Color3.fromRGB(86, 80, 120),
			FogColor = Color3.fromRGB(30, 26, 60),
			FogStart = 180,
			FogEnd = 900,
			ClockTime = 20.6,
			Brightness = 1.6,
			ColorShift = Color3.fromRGB(255, 160, 110),
		},
		Ambience = "Suburb",
	},
	{
		Id = "DarkForest",
		DisplayName = "DARK FOREST",
		Order = 2,
		Tagline = "Something moves between the trees.",
		RequiredRebirths = 1,
		UnlockCost = 77000,
		Center = Vector3.new(0, 0, -470),
		Size = Vector3.new(260, 200, 240),
		PrimaryColor = Color3.fromRGB(80, 200, 110),
		SecondaryColor = Color3.fromRGB(30, 60, 40),
		GroundColor = Color3.fromRGB(30, 44, 28),
		GroundMaterial = Enum.Material.Grass,
		Lighting = {
			Ambient = Color3.fromRGB(40, 56, 46),
			OutdoorAmbient = Color3.fromRGB(46, 64, 52),
			FogColor = Color3.fromRGB(20, 34, 26),
			FogStart = 40,
			FogEnd = 420,
			ClockTime = 0,
			Brightness = 1,
			ColorShift = Color3.fromRGB(120, 255, 160),
		},
		Ambience = "Forest",
	},
	{
		Id = "SecretLab",
		DisplayName = "SECRET LAB",
		Order = 3,
		Tagline = "Level B4 does not officially exist.",
		RequiredRebirths = 3,
		UnlockCost = 11000000,
		Center = Vector3.new(0, 0, -750),
		Size = Vector3.new(260, 200, 240),
		PrimaryColor = Color3.fromRGB(230, 236, 255),
		SecondaryColor = Color3.fromRGB(60, 200, 255),
		GroundColor = Color3.fromRGB(70, 74, 82),
		GroundMaterial = Enum.Material.Concrete,
		Lighting = {
			Ambient = Color3.fromRGB(90, 100, 120),
			OutdoorAmbient = Color3.fromRGB(80, 90, 110),
			FogColor = Color3.fromRGB(40, 50, 70),
			FogStart = 120,
			FogEnd = 700,
			ClockTime = 22,
			Brightness = 1.4,
			ColorShift = Color3.fromRGB(160, 220, 255),
		},
		Ambience = "Lab",
	},
	{
		Id = "RiftZone",
		DisplayName = "RIFT ZONE",
		Order = 4,
		Tagline = "Reality is coming apart at the seams.",
		RequiredRebirths = 5,
		UnlockCost = 98000000,
		Center = Vector3.new(0, 0, -1030),
		Size = Vector3.new(260, 240, 240),
		PrimaryColor = Color3.fromRGB(150, 80, 255),
		SecondaryColor = Color3.fromRGB(60, 220, 255),
		GroundColor = Color3.fromRGB(40, 30, 60),
		GroundMaterial = Enum.Material.Slate,
		Lighting = {
			Ambient = Color3.fromRGB(80, 50, 120),
			OutdoorAmbient = Color3.fromRGB(90, 60, 140),
			FogColor = Color3.fromRGB(50, 20, 90),
			FogStart = 60,
			FogEnd = 600,
			ClockTime = 0,
			Brightness = 1.2,
			ColorShift = Color3.fromRGB(180, 110, 255),
		},
		Ambience = "Rift",
	},
	{
		Id = "Otherworld",
		DisplayName = "OTHERWORLD",
		Order = 5,
		Tagline = "The mirror side. Everything is almost right.",
		RequiredRebirths = 8,
		UnlockCost = 840000000,
		Center = Vector3.new(0, 0, -1310),
		Size = Vector3.new(260, 240, 240),
		PrimaryColor = Color3.fromRGB(40, 230, 190),
		SecondaryColor = Color3.fromRGB(255, 90, 170),
		GroundColor = Color3.fromRGB(16, 40, 44),
		GroundMaterial = Enum.Material.Basalt,
		Lighting = {
			Ambient = Color3.fromRGB(30, 80, 80),
			OutdoorAmbient = Color3.fromRGB(30, 90, 90),
			FogColor = Color3.fromRGB(10, 50, 50),
			FogStart = 30,
			FogEnd = 380,
			ClockTime = 3,
			Brightness = 0.9,
			ColorShift = Color3.fromRGB(60, 255, 210),
		},
		Ambience = "Otherworld",
	},
	{
		Id = "Void",
		DisplayName = "THE VOID",
		Order = 6,
		Tagline = "Nothing ends here. Nothing begins.",
		RequiredRebirths = 12,
		UnlockCost = 53000000000,
		Center = Vector3.new(0, 0, -1590),
		Size = Vector3.new(260, 300, 240),
		PrimaryColor = Color3.fromRGB(130, 50, 255),
		SecondaryColor = Color3.fromRGB(10, 0, 20),
		GroundColor = Color3.fromRGB(8, 4, 16),
		GroundMaterial = Enum.Material.Glass,
		Lighting = {
			Ambient = Color3.fromRGB(40, 20, 70),
			OutdoorAmbient = Color3.fromRGB(30, 10, 60),
			FogColor = Color3.fromRGB(6, 0, 14),
			FogStart = 20,
			FogEnd = 500,
			ClockTime = 0,
			Brightness = 0.6,
			ColorShift = Color3.fromRGB(140, 60, 255),
		},
		Ambience = "Void",
	},
} :: { AreaDef }

AreaConfig.ById = {} :: { [string]: AreaDef }
for _, def in AreaConfig.List do
	AreaConfig.ById[def.Id] = def
end

AreaConfig.StartArea = "Suburb"

function AreaConfig.Get(id: string): AreaDef?
	return AreaConfig.ById[id]
end

-- Liegt eine Position in dieser Zone? (Achsen-ausgerichtete Box)
function AreaConfig.Contains(def: AreaDef, position: Vector3): boolean
	local d = position - def.Center
	local h = def.Size / 2
	return math.abs(d.X) <= h.X and math.abs(d.Z) <= h.Z and d.Y >= -20 and d.Y <= def.Size.Y
end

return AreaConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">CharacterConfig</string>
            <string name="Source"><![CDATA[--!strict
-- CharacterConfig (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Config > CharacterConfig
--
-- Die einzige Stelle, an der Characters registriert werden. Die eigentlichen
-- Daten stehen, nach Rarity getrennt, im Ordner Config > Characters. Neue
-- Characters (auch später lizenzierte) werden dort als weitere Tabelle
-- eingetragen. Kein anderes Script muss dafür angepasst werden.
--
-- Felder pro Character:
--   Id                  eindeutig, ohne Leerzeichen (wird gespeichert, NIE umbenennen)
--   DisplayName         Anzeigename
--   Rarity              Id aus RarityConfig
--   RollChance          "1 in X" bei Luck 1. Bei Commons ist das ein relatives
--                       Gewicht: Commons füllen die Restwahrscheinlichkeit auf
--                       (siehe Util > RollMath). Die UI zeigt immer die echte,
--                       normalisierte Chance an.
--   BaseMoneyPerSecond  $/s auf Level 1 ohne Mutation
--   BasePower           Basis-Power (Base Value, später Raid-Verteidigung)
--   BaseFishingPower    Basis-Fishing-Power
--   MaxLevel            Standard 15
--   Category            "Human" | "Creature" | "Entity"
--   VisualTheme         Kurzbeschreibung des Looks
--   Description         Index-Text
--   ModelReference      "Procedural:<Id>" = ModelFactory baut den Placeholder.
--                       Später: "Asset:<Name>" = fertiges Model aus
--                       ReplicatedStorage > VoidDiceAssets > Characters.
--   AuraReference       Id aus Visual > AuraLibrary oder nil
--   AnimationSet        Idle-Set für den BaseAnimator (siehe UIConfig.AnimationSets)
--   Thumbnail           true = als Thumbnail/Icon-Kandidat markiert
--   Source              "Original" für eigene IP. Lizenzierte Inhalte bekommen
--                       hier den Lizenzgeber und können über ReleaseEnabled
--                       ein- oder ausgeschaltet werden.
--   ReleaseEnabled      false = nicht rollbar (z. B. Testfiguren, abgelaufene Lizenz)
--   Visual              Bauplan für den ModelFactory-Placeholder

local Characters = script.Parent:WaitForChild("Characters")

export type VisualSpec = {
	Body: string,
	Scale: number?,
	Skin: Color3?,
	Hair: Color3?,
	HairStyle: string?,
	Top: Color3?,
	Bottom: Color3?,
	Shoes: Color3?,
	Accent: Color3?,
	Glow: Color3?,
	Face: string?,
	Accessories: { string }?,
}

export type CharacterDef = {
	Id: string,
	DisplayName: string,
	Rarity: string,
	RollChance: number,
	BaseMoneyPerSecond: number,
	BasePower: number,
	BaseFishingPower: number,
	MaxLevel: number,
	Category: string,
	VisualTheme: string,
	Description: string,
	ModelReference: string,
	AuraReference: string?,
	AnimationSet: string,
	Thumbnail: boolean?,
	Source: string,
	ReleaseEnabled: boolean,
	Visual: VisualSpec,
	-- vom Loader ergänzt:
	Index: number,
}

local RARITY_FILES = {
	"Common",
	"Uncommon",
	"Rare",
	"Epic",
	"Legendary",
	"Mythic",
	"Supernatural",
	"Void",
	"Secret",
	"Anomaly",
}

local CharacterConfig = {}
CharacterConfig.DefaultMaxLevel = 15

CharacterConfig.List = {} :: { CharacterDef }
CharacterConfig.ById = {} :: { [string]: CharacterDef }
CharacterConfig.ByRarity = {} :: { [string]: { CharacterDef } }

for _, fileName in RARITY_FILES do
	local module = Characters:FindFirstChild(fileName)
	if module then
		local entries = require(module) :: any
		for _, raw in entries do
			local def = raw :: CharacterDef
			assert(type(def.Id) == "string" and def.Id ~= "", "Character ohne Id in " .. fileName)
			assert(CharacterConfig.ById[def.Id] == nil, "Doppelte Character-Id: " .. def.Id)
			def.MaxLevel = def.MaxLevel or CharacterConfig.DefaultMaxLevel
			def.ModelReference = def.ModelReference or ("Procedural:" .. def.Id)
			def.Source = def.Source or "Original"
			if def.ReleaseEnabled == nil then
				def.ReleaseEnabled = true
			end
			def.AnimationSet = def.AnimationSet or "Default"
			def.Category = def.Category or "Human"
			table.insert(CharacterConfig.List, def)
			def.Index = #CharacterConfig.List
			CharacterConfig.ById[def.Id] = def
			local bucket = CharacterConfig.ByRarity[def.Rarity]
			if not bucket then
				bucket = {}
				CharacterConfig.ByRarity[def.Rarity] = bucket
			end
			table.insert(bucket, def)
		end
	end
end

function CharacterConfig.Get(id: string): CharacterDef?
	return CharacterConfig.ById[id]
end

return CharacterConfig
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="8">
          <Properties>
            <string name="Name">Characters</string>
          </Properties>
          <Item class="ModuleScript" referent="9">
            <Properties>
              <string name="Name">Anomaly</string>
              <string name="Source"><![CDATA[--!strict
-- Characters > Anomaly
-- Feste Chancen: The Endless 1 in 2.5M, The Null Child 1 in 5M, The Watcher Beyond 1 in 10M.
-- Felder: siehe CharacterConfig. Visual-Vokabular: siehe Visual > ModelFactory.

local rgb = Color3.fromRGB

local characters: { any } = {
	{
		Id = "TheEndless", DisplayName = "The Endless", Rarity = "Anomaly", RollChance = 2500000,
		BaseMoneyPerSecond = 220000, BasePower = 7000, BaseFishingPower = 150, MaxLevel = 15, Category = "Entity",
		VisualTheme = "blinding white orb inside endless rings of light, halo and drifting starlit shards",
		Description = "It has no beginning, so it cannot end. The rings around it are every loop time has ever made in Milbrook.",
		ModelReference = "Procedural:TheEndless", AuraReference = "Starfield", AnimationSet = "Hover", Thumbnail = true, Source = "Original",
		Visual = { Body = "Orb", Scale = 2.6, Skin = rgb(255, 255, 255), Accent = rgb(0, 255, 200), Glow = rgb(255, 255, 255), Face = "Blank", Accessories = { "OrbitRing", "OrbitDebris", "Halo" } },
	},
	{
		Id = "TheNullChild", DisplayName = "The Null Child", Rarity = "Anomaly", RollChance = 5000000,
		BaseMoneyPerSecond = 300000, BasePower = 9500, BaseFishingPower = 170, MaxLevel = 15, Category = "Human",
		VisualTheme = "all-white child with cyan glowing eyes, a halo and floating shards over a ring of light",
		Description = "A child made of the space where the Void used to be. When it laughs, the Rift closes a little.",
		ModelReference = "Procedural:TheNullChild", AuraReference = "NullLight", AnimationSet = "Float", Thumbnail = true, Source = "Original",
		Visual = { Body = "Kid", Scale = 1.05, Skin = rgb(250, 250, 255), Hair = rgb(255, 255, 255), HairStyle = "Bowl", Top = rgb(250, 250, 255), Bottom = rgb(240, 240, 250), Shoes = rgb(255, 255, 255), Accent = rgb(0, 255, 200), Glow = rgb(0, 255, 200), Face = "GlowEyes", Accessories = { "Halo", "OrbitDebris" } },
	},
	{
		Id = "TheWatcherBeyond", DisplayName = "The Watcher Beyond", Rarity = "Anomaly", RollChance = 10000000,
		BaseMoneyPerSecond = 400000, BasePower = 12000, BaseFishingPower = 200, MaxLevel = 15, Category = "Entity",
		VisualTheme = "colossal void eye with magenta iris, halo, ring of light and a circle of lesser eyes",
		Description = "The Observer was only its reflection. It looks at Milbrook from beyond the Void, and today, Milbrook looked back.",
		ModelReference = "Procedural:TheWatcherBeyond", AuraReference = "Abyss", AnimationSet = "Hover", Thumbnail = true, Source = "Original",
		Visual = { Body = "Eye", Scale = 2.6, Skin = rgb(255, 250, 240), Top = rgb(20, 10, 40), Accent = rgb(60, 20, 90), Glow = rgb(255, 40, 200), Face = "Blank", Accessories = { "OrbitEyes", "OrbitRing", "Halo" } },
	},
}

return characters
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="10">
            <Properties>
              <string name="Name">Common</string>
              <string name="Source"><![CDATA[--!strict
-- Characters > Common
-- RollChance ist auch bei Commons "1 in X" (8..40), wird aber normalisiert: Commons füllen die
-- Restwahrscheinlichkeit auf. Größeres X = seltener = etwas mehr $/s (wie bei allen Rarities).
-- Felder: siehe CharacterConfig. Visual-Vokabular: siehe Visual > ModelFactory.

local rgb = Color3.fromRGB

local characters: { any } = {
	{
		Id = "MysteryKid", DisplayName = "Mystery Kid", Rarity = "Common", RollChance = 8,
		BaseMoneyPerSecond = 1, BasePower = 1, BaseFishingPower = 1, MaxLevel = 15, Category = "Human",
		VisualTheme = "80s kid, orange tee, red backpack, flashlight and walkie-talkie",
		Description = "Rides out after curfew with a flashlight and a walkie-talkie tuned to channel 9. Swears something in the Black Pines blinked back.",
		ModelReference = "Procedural:MysteryKid", AuraReference = nil, AnimationSet = "Flashlight", Thumbnail = true, Source = "Original",
		Visual = { Body = "Kid", Scale = 0.9, Skin = rgb(240, 200, 165), Hair = rgb(90, 55, 30), HairStyle = "Messy", Top = rgb(230, 120, 40), Bottom = rgb(60, 80, 140), Shoes = rgb(235, 235, 235), Accent = rgb(200, 50, 50), Glow = rgb(255, 240, 180), Face = "Determined", Accessories = { "Flashlight", "WalkieTalkie", "Backpack" } },
	},
	{
		Id = "PierKid", DisplayName = "Pier Kid", Rarity = "Common", RollChance = 12,
		BaseMoneyPerSecond = 1, BasePower = 1, BaseFishingPower = 3, MaxLevel = 15, Category = "Human",
		VisualTheme = "small kid in a tank top and green bucket hat with a fishing rod",
		Description = "Fishing specialist. Spends every summer on the Milbrook pier and knows which ripples are not fish. Earns little, catches a lot.",
