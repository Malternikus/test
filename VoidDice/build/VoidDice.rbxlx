Builders.Crystal = function(ctx: any, a: any, C: { [string]: Color3 })
	local g, G = hand(ctx, a)
	local base: CFrame
	if g then
		base = G * CF(0, 0.75, -0.3)
	else
		local tg, tcf = topAnchor(a)
		if not tg or not tcf then
			return
		end
		g = tg
		base = tcf * CF(0, 1.0, 0)
	end
	ctx:Part(g :: Model, "Crystal", "Block", V3(0.38, 0.62, 0.38), base * ANG(0, math.pi / 4, 0.25), C.Glow, NEON)
	ctx:Part(g :: Model, "CrystalShell", "Block", V3(0.5, 0.78, 0.5), base * ANG(0, math.pi / 4, 0.25), WHITE, GLASS, { Transparency = 0.6 })
end

-------------------------------------------------------------------------------
-- Füße
-------------------------------------------------------------------------------
Builders.Rollerskates = function(ctx: any, a: any, C: { [string]: Color3 })
	local F = a.Feet
	if not F then
		return
	end
	if a.Parts then
		ctx:Recolor(a.Parts.ShoeL, WHITE)
		ctx:Recolor(a.Parts.ShoeR, WHITE)
	end
	for _, key in { "L", "R" } do
		local foot: CFrame = F[key]
		for _, z in { -0.24, 0.22 } do
			ctx:Part(ctx.Body, "Wheel", "Cyl", V3(F.W + 0.16, 0.22, 0.22), foot * CF(0, -F.H / 2 + 0.11, z), C.Accent, NEON)
		end
	end
end

-------------------------------------------------------------------------------
-- Orbit
-------------------------------------------------------------------------------
local DEBRIS = {
	{ 0.0, -0.6, 0.55 },
	{ 1.26, 0.4, 0.4 },
	{ 2.51, 0.9, 0.6 },
	{ 3.77, -0.2, 0.35 },
	{ 5.03, 0.6, 0.45 },
}
Builders.OrbitDebris = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Center then
		return
	end
	local g = orbitGroup(ctx, a)
	local c = a.Center
	local r = a.OrbitR or 2.4
	for i, d in DEBRIS do
		local cf = c * CF(math.cos(d[1]) * r, d[2], math.sin(d[1]) * r) * ANG(d[1], d[1] * 2, d[1] * 0.5)
		local glow = i % 2 == 0
		ctx:Part(g, "Debris", "Block", V3(d[3], d[3] * 0.8, d[3] * 0.9), cf, if glow then C.Glow else C.Accent, if glow then NEON else Enum.Material.Slate)
	end
end

Builders.OrbitRing = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Center then
		return
	end
	local g = orbitGroup(ctx, a)
	ring(ctx, g, "OrbitRing", a.Center * ANG(0.18, 0, -0.12), (a.OrbitR or 2.4) * 0.92, 0.12, 12, C.Glow, NEON, "Glow")
end

Builders.OrbitEyes = function(ctx: any, a: any, C: { [string]: Color3 })
	if not a.Center then
		return
	end
	local g = orbitGroup(ctx, a)
	local r = (a.OrbitR or 2.4) + 0.2
	for i = 0, 3 do
		local theta = i / 4 * math.pi * 2 + 0.4
		local dir = V3(math.cos(theta), 0, math.sin(theta))
		local p = a.Center.Position + dir * r + V3(0, (i % 2) * 0.8 - 0.3, 0)
		ctx:Part(g, "OrbitEye", "Ball", V3(0.5, 0.5, 0.5), CF(p), WHITE, nil, { Role = "Eye" })
		ctx:Part(g, "OrbitPupil", "Ball", V3(0.24, 0.24, 0.24), CF(p + dir * 0.17), C.Glow, NEON, { Role = "Eye" })
	end
end

Accessories.Builders = Builders

local ids = {}
for id in Builders do
	table.insert(ids, id)
end
table.sort(ids)
Accessories.Ids = ids

function Accessories.Has(id: string): boolean
	return Builders[id] ~= nil
end

-- Baut ein Accessory. Rollt bei Fehler oder Budget-Überschreitung komplett zurück.
-- Rückgabe: true = gebaut (oder still übersprungen), false = verworfen.
function Accessories.Build(ctx: any, a: any, id: string, C: { [string]: Color3 }): boolean
	local fn = Builders[id]
	if not fn then
		warn("[ModelFactory.Accessories] Unbekanntes Accessory: " .. tostring(id))
		return false
	end
	local cp = ctx:Checkpoint()
	local flags = { a.HeldUsed, a.LeftUsed, a.HasWings, a.HasTail, a.Head and a.Head.HairTop }
	local ok, err = pcall(fn :: any, ctx, a, C)
	if not ok or ctx.Count > ctx.Limit then
		if not ok then
			warn(string.format("[ModelFactory.Accessories] '%s' fehlgeschlagen: %s", id, tostring(err)))
		end
		ctx:Rollback(cp)
		a.HeldUsed, a.LeftUsed, a.HasWings, a.HasTail = flags[1], flags[2], flags[3], flags[4]
		if a.Head then
			a.Head.HairTop = flags[5]
		end
		return false
	end
	return true
end

return Accessories
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Bodies</string>
              <string name="Source"><![CDATA[--!strict
-- Bodies (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Visual > ModelFactory > Bodies
--
-- Körper-Bauer für Visual.Body. Alle Maße sind "unskaliert" (Boden = y 0,
-- vorne = -Z, rechts = +X); der Builder rechnet Visual.Scale ein.
--
-- Body-Vokabular:
--   Kid        kleiner Mensch, großer Kopf
--   Teen       Jugendlicher
--   Adult      Erwachsener
--   Tall       groß, schlank, langer Hals
--   Bulky      breit, kräftig, Blockkopf
--   Shade      dünn, sehr groß, lange Glieder, spitze Füße
--   Colossus   riesiger Humanoid mit Schulterplatten und Brustkern
--   Quadruped  Vierbeiner mit Schnauze, Ohren und Schwanz
--   Crawler    Insekt mit 6 Beinen
--   Blob       Schleim-/Klumpenwesen (pulsierender Core)
--   Serpent    aufgerichtete Schlange aus Segmenten, Tail am Boden
--   Winged     schwebender Flieger (Motte/Fledermaus) mit WingL/WingR
--   Hive       Zellhaufen mit Tentakeln, leuchtendem Core und Insektenschwarm (Orbit)
--   Floating   schwebende Kutten-Gestalt ohne Beine
--   Orb        leuchtender Kern mit Glashülle und Orbit-Ringen
--   Eye        riesiges Auge mit Lidern und Tentakel-Beinen
--
-- Jeder Bauer gibt eine Anchors-Tabelle zurück, an der Faces/Hair/Accessories
-- andocken (Head, Face, Top, Torso, Back, Waist, HandR/HandL, Feet, Under,
-- TailRoot, Center, OrbitR, Parts ...). Fehlende Anker = Accessory wird übersprungen.

local Bodies = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rgb = Color3.fromRGB

local UPRIGHT = ANG(0, 0, math.pi / 2) -- Zylinderachse senkrecht
local FORWARD = ANG(0, math.pi / 2, 0) -- Zylinderachse entlang Z
local BACKFACE = ANG(0, math.pi, 0) -- LookVector nach +Z (Rückseite)
local UPFACE = ANG(math.pi / 2, 0, 0) -- LookVector nach +Y (Oberseite)

Bodies.UPRIGHT = UPRIGHT
Bodies.FORWARD = FORWARD

-- Part-Budget (inkl. Root und Joints). Menschen 45, große Entities 80.
Bodies.Budget = {
	Kid = 45,
	Teen = 45,
	Adult = 45,
	Tall = 45,
	Bulky = 45,
	Shade = 45,
	Quadruped = 60,
	Crawler = 60,
	Blob = 60,
	Serpent = 60,
	Winged = 60,
	Hive = 80,
	Floating = 80,
	Colossus = 80,
	Orb = 80,
	Eye = 80,
}

Bodies.Humanoid = {
	Kid = true,
	Teen = true,
	Adult = true,
	Tall = true,
	Bulky = true,
	Shade = true,
	Colossus = true,
}

Bodies.DefaultFace = {
	Kid = "Smile",
	Teen = "Smile",
	Adult = "Calm",
	Tall = "Calm",
	Bulky = "Determined",
	Shade = "GlowEyes",
	Colossus = "GlowEyes",
	Quadruped = "GlowEyes",
	Crawler = "ManyEyes",
	Blob = "Grin",
	Serpent = "GlowEyes",
	Winged = "GlowEyes",
	Hive = "ManyEyes",
	Floating = "Hollow",
	Orb = "Blank",
	Eye = "Blank",
}

local HUMAN_DEFAULTS = {
	Skin = rgb(234, 192, 150),
	Hair = rgb(70, 45, 30),
	Top = rgb(60, 90, 170),
	Bottom = rgb(50, 55, 80),
	Shoes = rgb(225, 225, 230),
	Accent = rgb(200, 60, 60),
	Glow = rgb(120, 200, 255),
}
local CREATURE_DEFAULTS = {
	Skin = rgb(70, 80, 64),
	Hair = rgb(40, 40, 40),
	Top = rgb(50, 58, 46),
	Bottom = rgb(40, 44, 36),
	Shoes = rgb(30, 30, 30),
	Accent = rgb(120, 130, 90),
	Glow = rgb(170, 255, 120),
}
local ENTITY_DEFAULTS = {
	Skin = rgb(220, 225, 240),
	Hair = rgb(20, 16, 30),
	Top = rgb(26, 20, 40),
	Bottom = rgb(16, 12, 26),
	Shoes = rgb(10, 8, 16),
	Accent = rgb(140, 80, 255),
	Glow = rgb(180, 120, 255),
}

Bodies.Defaults = {
	Kid = HUMAN_DEFAULTS,
	Teen = HUMAN_DEFAULTS,
	Adult = HUMAN_DEFAULTS,
	Tall = HUMAN_DEFAULTS,
	Bulky = HUMAN_DEFAULTS,
	Shade = ENTITY_DEFAULTS,
	Colossus = ENTITY_DEFAULTS,
	Quadruped = CREATURE_DEFAULTS,
	Crawler = CREATURE_DEFAULTS,
	Blob = CREATURE_DEFAULTS,
	Serpent = CREATURE_DEFAULTS,
	Winged = CREATURE_DEFAULTS,
	Hive = CREATURE_DEFAULTS,
	Floating = ENTITY_DEFAULTS,
	Orb = ENTITY_DEFAULTS,
	Eye = ENTITY_DEFAULTS,
}

local BLACK = rgb(18, 14, 22)

-- Block/Zylinder von a nach b (unskalierte Model-Koordinaten)
local function segment(ctx: any, parent: Instance, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local dir = b - a
	local len = dir.Magnitude
	local mid = (a + b) / 2
	local up = if math.abs(dir.Unit.Y) > 0.98 then V3(0, 0, 1) else V3(0, 1, 0)
	local cf = CFrame.lookAt(mid, b, up)
	if shape == "Cyl" then
		return ctx:Part(parent, name, "Cyl", V3(len, thickness, thickness), cf * FORWARD, color, material)
	end
	return ctx:Part(parent, name, "Block", V3(thickness, thickness, len), cf, color, material)
end
Bodies.Segment = segment

-- Ring aus Segmenten (für Orb-Ringe, Halos usw.)
local function ring(ctx: any, parent: Instance, name: string, center: CFrame, radius: number, thickness: number, segments: number, color: Color3, material: Enum.Material?, role: string?)
	local segLen = 2 * math.pi * radius / segments * 1.08
	for i = 0, segments - 1 do
		local theta = (i / segments) * math.pi * 2
		ctx:Part(parent, name, "Block", V3(segLen, thickness, thickness), center * ANG(0, theta, 0) * CF(0, 0, -radius), color, material, if role then { Role = role } else nil)
	end
end
Bodies.Ring = ring

-------------------------------------------------------------------------------
-- Humanoide
-------------------------------------------------------------------------------
type HumanParams = {
	ShoeH: number,
	LegH: number,
	LegW: number,
	LegD: number,
	LegGap: number,
	TorsoW: number,
	TorsoH: number,
	TorsoD: number,
	ArmW: number,
	ArmD: number,
	ArmL: number,
	HandH: number,
	HeadH: number,
	HeadW: number,
	HeadD: number,
	HeadShape: string,
	Neck: number,
	ShoeShape: string?,
}

local PARAMS: { [string]: HumanParams } = {
	Kid = { ShoeH = 0.28, LegH = 1.05, LegW = 0.62, LegD = 0.68, LegGap = 0.04, TorsoW = 1.5, TorsoH = 1.25, TorsoD = 0.8,
		ArmW = 0.48, ArmD = 0.5, ArmL = 1.25, HandH = 0.36, HeadH = 1.12, HeadW = 1.28, HeadD = 1.28, HeadShape = "Cyl", Neck = 0 },
	Teen = { ShoeH = 0.3, LegH = 1.45, LegW = 0.66, LegD = 0.7, LegGap = 0.05, TorsoW = 1.65, TorsoH = 1.5, TorsoD = 0.85,
		ArmW = 0.52, ArmD = 0.54, ArmL = 1.5, HandH = 0.38, HeadH = 1.05, HeadW = 1.15, HeadD = 1.15, HeadShape = "Cyl", Neck = 0 },
	Adult = { ShoeH = 0.32, LegH = 1.75, LegW = 0.74, LegD = 0.78, LegGap = 0.06, TorsoW = 1.9, TorsoH = 1.8, TorsoD = 0.95,
		ArmW = 0.6, ArmD = 0.62, ArmL = 1.75, HandH = 0.42, HeadH = 1.05, HeadW = 1.1, HeadD = 1.1, HeadShape = "Cyl", Neck = 0.05 },
	Tall = { ShoeH = 0.3, LegH = 2.3, LegW = 0.6, LegD = 0.66, LegGap = 0.08, TorsoW = 1.6, TorsoH = 2.0, TorsoD = 0.8,
		ArmW = 0.5, ArmD = 0.52, ArmL = 2.1, HandH = 0.4, HeadH = 1.15, HeadW = 1.0, HeadD = 1.0, HeadShape = "Cyl", Neck = 0.15 },
	Bulky = { ShoeH = 0.36, LegH = 1.6, LegW = 0.92, LegD = 0.95, LegGap = 0.08, TorsoW = 2.6, TorsoH = 2.0, TorsoD = 1.4,
		ArmW = 0.8, ArmD = 0.82, ArmL = 1.85, HandH = 0.5, HeadH = 1.05, HeadW = 1.1, HeadD = 1.05, HeadShape = "Block", Neck = 0 },
	Shade = { ShoeH = 0.22, LegH = 2.9, LegW = 0.42, LegD = 0.45, LegGap = 0.14, TorsoW = 1.3, TorsoH = 2.3, TorsoD = 0.6,
		ArmW = 0.36, ArmD = 0.38, ArmL = 3.1, HandH = 0.6, HeadH = 1.35, HeadW = 0.82, HeadD = 0.85, HeadShape = "Block", Neck = 0.3,
		ShoeShape = "Wedge" },
	Colossus = { ShoeH = 0.5, LegH = 2.4, LegW = 1.25, LegD = 1.3, LegGap = 0.12, TorsoW = 3.4, TorsoH = 2.9, TorsoD = 1.8,
		ArmW = 1.15, ArmD = 1.2, ArmL = 3.0, HandH = 0.7, HeadH = 1.4, HeadW = 1.4, HeadD = 1.35, HeadShape = "Block", Neck = 0.1 },
}
Bodies.HumanParams = PARAMS

local function humanoid(ctx: any, C: { [string]: Color3 }, P: HumanParams, kind: string)
	local body = ctx.Body
	local parts: { [string]: BasePart } = {}
	local shoeH, legH, legW, legD = P.ShoeH, P.LegH, P.LegW, P.LegD
	local hipY = shoeH + legH
	local tW, tH, tD = P.TorsoW, P.TorsoH, P.TorsoD
	local lx = legW / 2 + P.LegGap / 2

	local feet = {}
	for _, side in { -1, 1 } do
		local nm = if side > 0 then "R" else "L"
		parts["Leg" .. nm] = ctx:Part(body, "Leg" .. nm, "Block", V3(legW, legH + 0.05, legD), CF(side * lx, shoeH + legH / 2, 0), C.Bottom)
		local shoeCF
		if P.ShoeShape == "Wedge" then
			shoeCF = CF(side * lx, shoeH / 2, -0.2)
			parts["Shoe" .. nm] = ctx:Part(body, "Shoe" .. nm, "Wedge", V3(legW + 0.04, shoeH, legD + 0.5), shoeCF, C.Shoes)
		else
			shoeCF = CF(side * lx, shoeH / 2, -0.09)
			parts["Shoe" .. nm] = ctx:Part(body, "Shoe" .. nm, "Block", V3(legW + 0.08, shoeH, legD + 0.2), shoeCF, C.Shoes)
		end
		feet[nm] = shoeCF
	end

	local torsoCF = CF(0, hipY + tH / 2, 0)
	parts.Torso = ctx:Part(body, "Torso", "Block", V3(tW, tH, tD), torsoCF, C.Top)

	-- Arme: Joint an der Schulter, Hand unten
	local armTop = hipY + tH
	local hands = {}
	local arms = {}
	for _, side in { -1, 1 } do
		local nm = if side > 0 then "R" else "L"
		local jx = side * (tW / 2 + P.ArmW / 2 + 0.02)
		local g = ctx:Group("Arm" .. nm, ctx.Model, V3(jx, armTop - P.ArmW / 2, 0))
		local sleeveL = P.ArmL - P.HandH
		parts["Arm" .. nm] = ctx:Part(g, "Arm", "Block", V3(P.ArmW, sleeveL, P.ArmD), CF(jx, armTop - sleeveL / 2, 0), C.Top)
		local handCF = CF(jx, armTop - sleeveL - P.HandH / 2, 0)
		parts["Hand" .. nm] =
			ctx:Part(g, "Hand", "Block", V3(P.ArmW * 0.92, P.HandH, P.ArmD * 0.92), handCF, C.Skin)
		hands[nm] = { Group = g, CF = handCF, W = P.ArmW }
		arms[nm] = { Group = g, Shoulder = CF(jx, armTop, 0), W = P.ArmW, D = P.ArmD }
	end

	-- Kopf
	local neckY = armTop
	local hg = ctx:Group("Head", ctx.Model, V3(0, neckY, 0))
	if P.Neck > 0 then
		ctx:Part(hg, "Neck", "Block", V3(P.HeadW * 0.42, P.Neck + 0.12, P.HeadW * 0.42), CF(0, neckY + P.Neck / 2, 0), C.Skin)
	end
	local hH, hW, hD = P.HeadH, P.HeadW, P.HeadD
	local headCF = CF(0, neckY + P.Neck + hH / 2, 0)
	local round: number? = nil
	if P.HeadShape == "Cyl" then
		parts.Head = ctx:Part(hg, "Head", "Cyl", V3(hH, hW, hW), headCF * UPRIGHT, C.Skin)
		hD = hW
		round = hW / 2
	else
		parts.Head = ctx:Part(hg, "Head", "Block", V3(hW, hH, hD), headCF, C.Skin)
	end
	local total = neckY + P.Neck + hH

	return {
		Kind = kind,
		Parts = parts,
		HipY = hipY,
		Height = total,
		Head = { Group = hg, CF = headCF, Size = V3(hW, hH, hD), Round = round, HairTop = hH / 2 },
		Face = { Group = hg, CF = headCF * CF(0, 0, -hD / 2), W = hW, H = hH, Round = round },
		Top = { Group = hg, CF = headCF * CF(0, hH / 2, 0), W = hW },
		Torso = { Group = body, CF = torsoCF, Size = V3(tW, tH, tD) },
		Back = { Group = body, CF = CF(0, hipY + tH / 2, tD / 2) * BACKFACE, W = tW, H = tH },
		Waist = { Group = body, CF = CF(0, hipY + 0.14, 0), W = tW, D = tD },
		HandR = hands.R,
		HandL = hands.L,
		ArmR = arms.R,
		ArmL = arms.L,
		Feet = { L = feet.L, R = feet.R, W = legW, D = legD, H = shoeH },
		TailRoot = V3(0, hipY + 0.1, tD / 2),
		Center = CF(0, total * 0.55, 0),
		OrbitR = math.max(tW, hW) * 0.5 + P.ArmW + 0.9,
	}
end

local Builders: { [string]: (ctx: any, C: { [string]: Color3 }, visual: any) -> any } = {}

for _, name in { "Kid", "Teen", "Adult", "Tall", "Bulky", "Shade" } do
	Builders[name] = function(ctx: any, C: { [string]: Color3 }, _visual: any)
		return humanoid(ctx, C, PARAMS[name], "Humanoid")
	end
end

Builders.Colossus = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local P = PARAMS.Colossus
	local a = humanoid(ctx, C, P, "Humanoid")
	-- Schulterplatten (bewegen sich mit den Armen)
	for _, side in { -1, 1 } do
		local arm = if side > 0 then a.ArmR else a.ArmL
		ctx:Part(arm.Group, "ShoulderPlate", "Block", V3(P.ArmW + 0.5, 0.55, P.ArmD + 0.45), arm.Shoulder * CF(side * 0.1, 0.12, 0), C.Accent, Enum.Material.Metal)
	end
	-- Gürtel und leuchtender Brustkern
	ctx:Part(ctx.Body, "Belt", "Block", V3(P.TorsoW + 0.1, 0.45, P.TorsoD + 0.1), CF(0, a.HipY + 0.22, 0), C.Accent, Enum.Material.Metal)
	ctx:Part(ctx.Body, "ChestCore", "Cyl", V3(0.12, 0.95, 0.95), CF(0, a.HipY + P.TorsoH * 0.62, -P.TorsoD / 2 - 0.04) * FORWARD, C.Glow, Enum.Material.Neon)
	a.OrbitR += 0.6
	return a
end

-------------------------------------------------------------------------------
-- Kreaturen
-------------------------------------------------------------------------------
Builders.Quadruped = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local legH = 1.1
	local bW, bH, bD = 1.3, 1.1, 2.5
	local by = legH + bH / 2 - 0.1
	local parts = {}
	parts.Torso = ctx:Part(body, "Torso", "Block", V3(bW, bH, bD), CF(0, by, 0), C.Skin)
	ctx:Part(body, "Belly", "Block", V3(bW * 0.8, 0.3, bD * 0.75), CF(0, by - bH / 2 - 0.05, -0.05), C.Accent)
	ctx:Part(body, "Hump", "Sphere", V3(bW * 1.08, 0.75, 1.3), CF(0, by + bH / 2 - 0.08, -0.55), C.Top)
	for _, z in { -0.85, 0.85 } do
		for _, side in { -1, 1 } do
			ctx:Part(body, "Leg", "Block", V3(0.38, legH, 0.4), CF(side * 0.42, legH / 2, z), C.Skin)
			ctx:Part(body, "Paw", "Block", V3(0.46, 0.2, 0.52), CF(side * 0.42, 0.1, z - 0.06), C.Shoes)
		end
	end
	-- Kopf
	local hg = ctx:Group("Head", ctx.Model, V3(0, by + 0.3, -bD / 2))
	local headCF = CF(0, by + 0.6, -1.6)
	parts.Head = ctx:Part(hg, "Head", "Block", V3(1.0, 0.9, 1.0), headCF, C.Skin)
	ctx:Part(hg, "Snout", "Block", V3(0.62, 0.45, 0.55), CF(0, by + 0.4, -2.3), C.Accent)
	ctx:Part(hg, "Nose", "Block", V3(0.22, 0.14, 0.08), CF(0, by + 0.56, -2.6), BLACK, nil, { Role = "Eye" })
	for _, side in { -1, 1 } do
		ctx:Part(hg, "Ear", "Wedge", V3(0.22, 0.48, 0.34), CF(side * 0.33, by + 1.27, -1.5), C.Top)
	end
	-- Schwanz
	local tailRoot = V3(0, by + 0.3, bD / 2)
	local tg = ctx:Group("Tail", ctx.Model, tailRoot)
	ctx:Part(tg, "Tail", "Block", V3(0.24, 0.24, 1.25), CF(tailRoot) * ANG(-math.rad(35), 0, 0) * CF(0, 0, 0.6), C.Top)

	return {
		Kind = "Quadruped",
		Parts = parts,
		HipY = legH,
		Height = by + 1.5,
		HasTail = true,
		Head = { Group = hg, CF = headCF, Size = V3(1.0, 0.9, 1.0), HairTop = 0.45 },
		Face = { Group = hg, CF = CF(0, by + 0.77, -2.1), W = 1.0, H = 0.56 },
		Top = { Group = hg, CF = headCF * CF(0, 0.45, 0), W = 0.9 },
		Torso = { Group = body, CF = CF(0, by, 0), Size = V3(bW, bH, bD) },
		Back = { Group = body, CF = CF(0, by + bH / 2, 0.1) * UPFACE, W = bW, H = bD * 0.8 },
		Under = nil,
		TailRoot = tailRoot,
		Center = CF(0, by, 0),
		OrbitR = 2.2,
	}
end

Builders.Crawler = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local parts = {}
	parts.Torso = ctx:Part(body, "Thorax", "Sphere", V3(1.2, 0.85, 1.1), CF(0, 1.05, -0.2), C.Skin)
	ctx:Part(body, "Abdomen", "Sphere", V3(1.5, 1.1, 2.0), CF(0, 1.25, 1.2) * ANG(math.rad(-12), 0, 0), C.Top)
	ctx:Part(body, "Stripe", "Sphere", V3(1.56, 0.95, 0.32), CF(0, 1.27, 1.15) * ANG(math.rad(-12), 0, 0), C.Accent)
	-- Beine: zwei Segmente (Hüfte -> Knie -> Fuß)
	local zs = { -0.55, -0.15, 0.3 }
	for i, z in zs do
		for _, side in { -1, 1 } do
			local hip = V3(side * 0.45, 1.0, z)
			local knee = V3(side * 1.25, 1.6, z + (i - 2) * 0.25)
			local foot = V3(side * 1.75, 0.04, z + (i - 2) * 0.6)
			segment(ctx, body, "LegUpper", hip, knee, 0.17, C.Skin)
			segment(ctx, body, "LegLower", knee, foot, 0.12, C.Shoes)
		end
	end
	local hg = ctx:Group("Head", ctx.Model, V3(0, 1.1, -0.75))
	local headCF = CF(0, 1.15, -1.05)
	parts.Head = ctx:Part(hg, "Head", "Sphere", V3(0.85, 0.75, 0.75), headCF, C.Skin)
	return {
		Kind = "Crawler",
		Parts = parts,
		HipY = 1.0,
		Height = 1.9,
		Head = { Group = hg, CF = headCF, Size = V3(0.85, 0.75, 0.75), Round = 0.42, HairTop = 0.38 },
		Face = { Group = hg, CF = CF(0, 1.2, -1.4), W = 0.8, H = 0.6, Round = 0.42 },
		Top = { Group = hg, CF = headCF * CF(0, 0.36, 0), W = 0.7 },
		Torso = { Group = body, CF = CF(0, 1.05, -0.2), Size = V3(1.2, 0.85, 1.1) },
		Back = { Group = body, CF = CF(0, 1.78, 1.1) * UPFACE, W = 1.3, H = 1.6 },
		TailRoot = V3(0, 1.4, 2.15),
		Center = CF(0, 1.2, 0.2),
		OrbitR = 2.4,
	}
end

Builders.Blob = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local core = ctx:Group("Core", ctx.Model, V3(0, 1.0, 0))
	local parts = {}
	parts.Torso = ctx:Part(core, "Blob", "Sphere", V3(2.6, 2.1, 2.3), CF(0, 1.05, 0), C.Skin)
	ctx:Part(core, "Lump", "Sphere", V3(1.3, 1.0, 1.2), CF(0.25, 2.0, 0.3), C.Skin)
	ctx:Part(core, "Lump", "Ball", V3(0.95, 0.95, 0.95), CF(-1.15, 0.47, 0.35), C.Top)
	ctx:Part(core, "Lump", "Ball", V3(0.75, 0.75, 0.75), CF(1.15, 0.38, 0.5), C.Top)
	ctx:Part(core, "Spot", "Ball", V3(0.38, 0.38, 0.38), CF(-0.75, 0.55, -0.95), C.Accent)
	ctx:Part(core, "Spot", "Ball", V3(0.3, 0.3, 0.3), CF(0.85, 1.55, -0.7), C.Accent)
	ctx:Part(body, "Puddle", "Cyl", V3(0.08, 3.2, 3.2), CF(0, 0.04, 0.1) * UPRIGHT, C.Bottom, nil, { Transparency = 0.25 })
	return {
		Kind = "Blob",
		Parts = parts,
		HipY = 0.4,
		Height = 2.5,
		Head = { Group = core, CF = CF(0, 1.6, 0), Size = V3(2.0, 1.0, 1.8), HairTop = 0.5 },
		Face = { Group = core, CF = CF(0, 1.25, -1.13), W = 1.7, H = 1.0, Round = 1.15 },
		Top = { Group = core, CF = CF(0.25, 2.5, 0.3), W = 1.1 },
		Torso = { Group = core, CF = CF(0, 1.05, 0), Size = V3(2.6, 2.1, 2.3) },
		Back = { Group = core, CF = CF(0, 1.2, 1.1) * BACKFACE, W = 1.8, H = 1.4 },
		Under = { Group = core, CF = CF(0, 0.35, 0), R = 1.0 },
		TailRoot = V3(0, 0.6, 1.1),
		Center = CF(0, 1.2, 0),
		OrbitR = 2.3,
	}
end

Builders.Serpent = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local parts = {}
	parts.Torso = ctx:Part(body, "Coil", "Sphere", V3(2.6, 0.8, 2.6), CF(0, 0.4, 0.5), C.Skin)
	ctx:Part(body, "Coil", "Sphere", V3(2.0, 0.75, 2.0), CF(0.15, 0.98, 0.55), C.Top)
	local spine = {
		{ V3(0.1, 1.55, 0.45), 1.15 },
		{ V3(0, 2.15, 0.2), 1.05 },
		{ V3(-0.05, 2.7, -0.1), 0.95 },
		{ V3(0, 3.2, -0.35), 0.85 },
	}
	for i, s in spine do
		ctx:Part(body, "Segment", "Ball", V3(s[2], s[2], s[2]), CF(s[1]), if i % 2 == 0 then C.Top else C.Skin)
	end
	-- Bauchschuppen vorne am Hals
	ctx:Part(body, "Belly", "Sphere", V3(0.7, 1.6, 0.4), CF(0, 2.4, -0.38) * ANG(math.rad(-15), 0, 0), C.Accent)
	local hg = ctx:Group("Head", ctx.Model, V3(0, 3.45, -0.45))
	local headCF = CF(0, 3.7, -0.85)
	parts.Head = ctx:Part(hg, "Head", "Sphere", V3(1.05, 0.8, 1.5), headCF, C.Skin)
	ctx:Part(hg, "Jaw", "Sphere", V3(0.85, 0.35, 1.2), CF(0, 3.4, -0.98), C.Accent)
	local tailRoot = V3(0.9, 0.35, 1.4)
	local tg = ctx:Group("Tail", ctx.Model, tailRoot)
	ctx:Part(tg, "TailSeg", "Ball", V3(0.62, 0.62, 0.62), CF(1.15, 0.31, 1.62), C.Skin)
	ctx:Part(tg, "TailSeg", "Ball", V3(0.46, 0.46, 0.46), CF(1.45, 0.24, 1.98), C.Top)
	ctx:Part(tg, "TailTip", "Wedge", V3(0.3, 0.28, 0.6), CF(1.62, 0.16, 2.38) * BACKFACE, C.Accent)
	return {
		Kind = "Serpent",
		Parts = parts,
		HipY = 1.0,
		Height = 4.1,
		HasTail = true,
		Head = { Group = hg, CF = headCF, Size = V3(1.05, 0.8, 1.5), Round = 0.5, HairTop = 0.4 },
		Face = { Group = hg, CF = CF(0, 3.84, -1.42), W = 0.9, H = 0.42, Round = 0.5 },
		Top = { Group = hg, CF = headCF * CF(0, 0.4, 0), W = 0.9 },
		Torso = { Group = body, CF = CF(0, 2.2, 0.15), Size = V3(1.05, 1.6, 1.05) },
		Back = { Group = body, CF = CF(0, 2.4, 0.68) * BACKFACE, W = 0.9, H = 1.6 },
		TailRoot = tailRoot,
		Center = CF(0, 2.0, 0),
		OrbitR = 2.4,
	}
end

Builders.Winged = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local parts = {}
	parts.Torso = ctx:Part(body, "Thorax", "Sphere", V3(0.95, 1.05, 0.9), CF(0, 2.55, 0), C.Skin)
	ctx:Part(body, "Abdomen", "Sphere", V3(0.75, 1.35, 0.75), CF(0, 1.55, 0.18) * ANG(math.rad(10), 0, 0), C.Top)
	ctx:Part(body, "Collar", "Sphere", V3(1.18, 0.42, 1.05), CF(0, 2.98, 0), C.Accent)
	for _, side in { -1, 1 } do
		segment(ctx, body, "Leg", V3(side * 0.22, 2.2, -0.3), V3(side * 0.32, 1.6, -0.45), 0.1, C.Shoes)
	end
	local hg = ctx:Group("Head", ctx.Model, V3(0, 3.05, 0))
	local headCF = CF(0, 3.4, -0.1)
	parts.Head = ctx:Part(hg, "Head", "Ball", V3(0.8, 0.8, 0.8), headCF, C.Skin)
	-- Flügel: Joint an der Wurzel, große Platte + kleine Platte + Augenfleck
	for _, side in { -1, 1 } do
		local nm = if side > 0 then "R" else "L"
		local root = V3(side * 0.4, 2.7, 0.2)
		local g = ctx:Group("Wing" .. nm, ctx.Model, root)
		local up = CF(root) * ANG(0, 0, side * 0.2)
		ctx:Part(g, "WingUpper", "Block", V3(2.4, 1.7, 0.08), up * CF(side * 1.25, 0.45, 0), C.Top)
		ctx:Part(g, "WingLower", "Block", V3(1.5, 1.2, 0.08), CF(root) * ANG(0, 0, -side * 0.45) * CF(side * 0.85, -0.35, 0.02), C.Accent)
		ctx:Part(g, "EyeSpot", "Cyl", V3(0.1, 0.55, 0.55), up * CF(side * 1.45, 0.5, -0.06) * FORWARD, C.Glow, Enum.Material.Neon, { Role = "Glow" })
	end
	return {
		Kind = "Winged",
		Parts = parts,
		HipY = 1.8,
		Height = 3.8,
		HasWings = true,
		Head = { Group = hg, CF = headCF, Size = V3(0.8, 0.8, 0.8), Round = 0.4, HairTop = 0.4 },
		Face = { Group = hg, CF = CF(0, 3.42, -0.48), W = 0.75, H = 0.6, Round = 0.4 },
		Top = { Group = hg, CF = headCF * CF(0, 0.38, 0), W = 0.7 },
		Torso = { Group = body, CF = CF(0, 2.55, 0), Size = V3(0.95, 1.05, 0.9) },
		Back = { Group = body, CF = CF(0, 2.5, 0.45) * BACKFACE, W = 0.9, H = 1.0 },
		Under = { Group = body, CF = CF(0, 1.0, 0.25), R = 0.3 },
		TailRoot = V3(0, 0.95, 0.3),
		Center = CF(0, 2.3, 0),
		OrbitR = 2.8,
	}
end

Builders.Hive = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local parts = {}
	parts.Torso = ctx:Part(body, "Cell", "Sphere", V3(2.4, 1.9, 2.3), CF(0, 0.95, 0), C.Skin)
	local cells = {
		{ V3(1.2, 1.1, 1.2), V3(-1.15, 0.6, -0.35), C.Top },
		{ V3(1.2, 1.0, 1.1), V3(1.1, 0.55, -0.25), C.Top },
		{ V3(1.1, 1.0, 1.1), V3(-0.8, 0.55, 0.95), C.Skin },
		{ V3(1.0, 0.9, 1.0), V3(0.85, 0.5, 0.95), C.Top },
		{ V3(1.4, 1.2, 1.3), V3(0, 1.95, 0.2), C.Skin },
		{ V3(0.8, 0.8, 0.8), V3(-0.6, 2.4, 0.4), C.Top },
	}
	for _, c in cells do
		ctx:Part(body, "Cell", "Sphere", c[1], CF(c[2]), c[3])
	end
	-- Poren
	for _, p in { V3(-1.15, 0.75, -0.93), V3(1.12, 0.65, -0.78), V3(0.45, 2.2, -0.4) } do
		ctx:Part(body, "Pore", "Cyl", V3(0.1, 0.32, 0.32), CF(p) * FORWARD, BLACK, nil, { Role = "Eye" })
	end
	-- Pulsierender Kern
	local core = ctx:Group("Core", ctx.Model, V3(0, 1.5, -0.8))
	ctx:Part(core, "CoreRim", "Cyl", V3(0.15, 1.25, 1.25), CF(0, 1.5, -0.95) * FORWARD, C.Accent)
	ctx:Part(core, "CoreGlow", "Ball", V3(0.95, 0.95, 0.95), CF(0, 1.5, -1.0), C.Glow, Enum.Material.Neon)
	-- Tentakel (2 Segmente + leuchtende Spitze)
	local tendrils = {
		{ V3(0.9, 1.6, 0.3), V3(1.7, 2.6, 0.5), V3(2.0, 3.3, 0.1) },
		{ V3(-0.9, 1.6, 0.3), V3(-1.6, 2.8, 0.6), V3(-1.8, 3.5, 0.2) },
		{ V3(0.4, 2.3, 0.6), V3(0.7, 3.4, 1.1), V3(0.3, 4.0, 1.3) },
		{ V3(-0.3, 1.0, 1.1), V3(-0.4, 1.8, 2.0), V3(-0.2, 2.2, 2.6) },
	}
	for _, t in tendrils do
		segment(ctx, body, "Tendril", t[1], t[2], 0.32, C.Accent, nil, "Cyl")
		segment(ctx, body, "Tendril", t[2], t[3], 0.2, C.Accent, nil, "Cyl")
		ctx:Part(body, "TendrilTip", "Ball", V3(0.28, 0.28, 0.28), CF(t[3]), C.Glow, Enum.Material.Neon)
	end
	-- Schwarm (Orbit)
	local orbit = ctx:GetGroup("Orbit", ctx.Model, V3(0, 2.0, 0))
	local heights = { 1.4, 2.6, 1.9, 3.0, 2.2 }
	for i = 1, 5 do
		local theta = (i - 1) / 5 * math.pi * 2
		ctx:Part(orbit, "Bug", "Ball", V3(0.26, 0.26, 0.26), CF(math.cos(theta) * 2.4, heights[i], math.sin(theta) * 2.4), C.Glow, Enum.Material.Neon)
	end
	return {
		Kind = "Hive",
		Parts = parts,
		HipY = 0.5,
		Height = 4.1,
		Head = nil,
		Face = { Group = body, CF = CF(0, 0.75, -1.12), W = 1.6, H = 0.7, Round = 1.15 },
		Top = { Group = body, CF = CF(0, 2.7, 0.2), W = 1.2 },
		Torso = { Group = body, CF = CF(0, 0.95, 0), Size = V3(2.4, 1.9, 2.3) },
		Back = { Group = body, CF = CF(0, 1.2, 1.15) * BACKFACE, W = 2.0, H = 1.6 },
		Under = { Group = body, CF = CF(0, 0.3, 0), R = 1.2 },
		TailRoot = V3(0, 0.8, 1.3),
		Center = CF(0, 2.0, 0),
		OrbitR = 2.6,
	}
end

-------------------------------------------------------------------------------
-- Entities
-------------------------------------------------------------------------------
Builders.Floating = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local parts = {}
	ctx:Part(body, "Hem", "Block", V3(2.0, 1.0, 1.5), CF(0, 1.0, 0), C.Top)
	ctx:Part(body, "Robe", "Block", V3(1.7, 1.4, 1.25), CF(0, 2.15, 0), C.Top)
	parts.Torso = ctx:Part(body, "Chest", "Block", V3(1.9, 1.1, 1.2), CF(0, 3.35, 0), C.Top)
	ctx:Part(body, "Sash", "Block", V3(0.45, 2.7, 0.08), CF(0, 2.35, -0.66), C.Accent)
	ctx:Part(body, "Mantle", "Sphere", V3(2.35, 0.6, 1.5), CF(0, 3.9, 0.02), C.Bottom)
	for i, x in { -0.7, -0.23, 0.23, 0.7 } do
		ctx:Part(body, "Tatter", "Block", V3(0.42, 0.42, 0.42 + (i % 2) * 0.3), CF(x, 0.55 - (i % 2) * 0.08, 0) * ANG(0, 0, math.pi / 4), C.Bottom)
	end
	-- Kapuze
	local hg = ctx:Group("Head", ctx.Model, V3(0, 3.95, 0))
	local hoodCF = CF(0, 4.6, 0.05)
	parts.Head = ctx:Part(hg, "Hood", "Block", V3(1.35, 1.35, 1.3), hoodCF, C.Top)
	ctx:Part(hg, "HoodPeak", "Wedge", V3(1.0, 0.5, 0.95), CF(0, 5.5, 0.22), C.Top)
	ctx:Part(hg, "FaceVoid", "Block", V3(0.95, 0.95, 0.1), CF(0, 4.5, -0.62), BLACK, nil, { Role = "Eye" })
	-- Ärmel
	local hands = {}
	for _, side in { -1, 1 } do
		local nm = if side > 0 then "R" else "L"
		local g = ctx:Group("Arm" .. nm, ctx.Model, V3(side * 1.1, 3.65, 0))
		ctx:Part(g, "Arm", "Block", V3(0.6, 1.5, 0.65), CF(side * 1.15, 3.0, 0), C.Top)
		ctx:Part(g, "Cuff", "Block", V3(0.78, 0.35, 0.8), CF(side * 1.15, 2.2, 0), C.Bottom)
		local handCF = CF(side * 1.15, 1.85, 0)
		ctx:Part(g, "Hand", "Block", V3(0.38, 0.45, 0.38), handCF, C.Skin)
		hands[nm] = { Group = g, CF = handCF, W = 0.6 }
	end
	return {
		Kind = "Floating",
		Parts = parts,
		HipY = 1.5,
		Height = 5.75,
		Head = { Group = hg, CF = hoodCF, Size = V3(1.35, 1.35, 1.3), HairTop = 0.68 },
		Face = { Group = hg, CF = CF(0, 4.5, -0.68), W = 0.9, H = 0.85 },
		Top = { Group = hg, CF = CF(0, 5.3, 0.05), W = 1.2 },
		Torso = { Group = body, CF = CF(0, 3.35, 0), Size = V3(1.9, 1.1, 1.2) },
		Back = { Group = body, CF = CF(0, 3.0, 0.63) * BACKFACE, W = 1.8, H = 2.0 },
		HandR = hands.R,
		HandL = hands.L,
		Under = { Group = body, CF = CF(0, 0.6, 0), R = 0.8 },
		Center = CF(0, 2.9, 0),
		OrbitR = 2.4,
	}
end

Builders.Orb = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local cy = 3.0
	local core = ctx:Group("Core", ctx.Model, V3(0, cy, 0))
	local parts = {}
	ctx:Part(core, "Heart", "Ball", V3(1.3, 1.3, 1.3), CF(0, cy, 0), C.Glow, Enum.Material.Neon)
	parts.Torso = ctx:Part(core, "Shell", "Ball", V3(2.2, 2.2, 2.2), CF(0, cy, 0), C.Skin, Enum.Material.Glass, { Transparency = 0.5 })
	ctx:Part(core, "Band", "Cyl", V3(0.25, 2.3, 2.3), CF(0, cy, 0) * UPRIGHT, C.Accent, Enum.Material.Metal)
	local orbit = ctx:GetGroup("Orbit", ctx.Model, V3(0, cy, 0))
	ring(ctx, orbit, "Ring", CF(0, cy, 0) * ANG(0.35, 0, 0.15), 2.1, 0.14, 10, C.Glow, Enum.Material.Neon)
	ring(ctx, orbit, "Ring", CF(0, cy, 0) * ANG(-0.5, 0, -0.3), 2.7, 0.12, 12, C.Accent, Enum.Material.Neon)
	ctx:Part(body, "Projector", "Cyl", V3(0.08, 1.8, 1.8), CF(0, 0.04, 0) * UPRIGHT, C.Accent, Enum.Material.Neon, { Transparency = 0.4 })
	return {
		Kind = "Orb",
		Parts = parts,
		HipY = cy - 1.1,
		Height = cy + 2.8,
		Head = nil,
		Face = { Group = core, CF = CF(0, cy + 0.1, -1.1), W = 1.4, H = 0.8, Round = 1.1 },
		Top = { Group = core, CF = CF(0, cy + 1.1, 0), W = 1.0 },
		Torso = { Group = core, CF = CF(0, cy, 0), Size = V3(2.2, 2.2, 2.2) },
		Back = { Group = core, CF = CF(0, cy, 1.1) * BACKFACE, W = 1.4, H = 1.4 },
		Under = { Group = core, CF = CF(0, cy - 1.0, 0), R = 0.6 },
		Center = CF(0, cy, 0),
		OrbitR = 3.3,
	}
end

Builders.Eye = function(ctx: any, C: { [string]: Color3 }, _visual: any)
	local body = ctx.Body
	local cy = 3.3
	local core = ctx:Group("Core", ctx.Model, V3(0, cy, 0))
	local parts = {}
	parts.Torso = ctx:Part(core, "Eyeball", "Ball", V3(2.6, 2.6, 2.6), CF(0, cy, 0), C.Skin)
	ctx:Part(core, "Iris", "Cyl", V3(0.2, 1.25, 1.25), CF(0, cy, -1.2) * FORWARD, C.Glow, Enum.Material.Neon, { Role = "Eye" })
	ctx:Part(core, "Pupil", "Cyl", V3(0.2, 0.55, 0.55), CF(0, cy, -1.28) * FORWARD, BLACK, nil, { Role = "Eye" })
	ctx:Part(core, "Glint", "Ball", V3(0.2, 0.2, 0.2), CF(0.22, cy + 0.22, -1.38), rgb(255, 255, 255), Enum.Material.Neon, { Role = "Eye" })
	ctx:Part(core, "LidUpper", "Sphere", V3(2.95, 1.1, 2.8), CF(0, cy + 1.15, 0.12), C.Top)
	ctx:Part(core, "LidLower", "Sphere", V3(2.85, 0.9, 2.7), CF(0, cy - 1.18, 0.12), C.Top)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + 0.3
		local cx, cz = math.cos(a), math.sin(a)
		local p0 = V3(cx * 0.5, cy - 1.0, cz * 0.5)
		local p1 = V3(cx * 1.3, cy - 2.1, cz * 1.3)
		local p2 = V3(cx * 2.0, 0.08, cz * 2.0)
		segment(ctx, body, "Tendril", p0, p1, 0.36, C.Accent, nil, "Cyl")
		segment(ctx, body, "Tendril", p1, p2, 0.22, C.Accent, nil, "Cyl")
	end
	return {
		Kind = "Eye",
		Parts = parts,
		HipY = cy - 1.3,
		Height = cy + 1.7,
		Head = nil,
		Face = nil,
		Top = { Group = core, CF = CF(0, cy + 1.7, 0.12), W = 2.0 },
		Torso = { Group = core, CF = CF(0, cy, 0), Size = V3(2.6, 2.6, 2.6) },
		Back = { Group = core, CF = CF(0, cy, 1.35) * BACKFACE, W = 2.0, H = 2.0 },
		Under = { Group = core, CF = CF(0, cy - 1.2, 0), R = 0.7 },
		Center = CF(0, cy, 0),
		OrbitR = 3.4,
	}
end

Bodies.Builders = Builders

-- Sortierte Liste aller Body-Typen (für Tests)
function Bodies.Types(): { string }
	local out = {}
	for name in Builders do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

return Bodies
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Effects (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Visual > ModelFactory > Effects
--
-- Aura, Level-Visual und Mutation auf einem fertigen ModelFactory-Model.
-- Alles ist idempotent: vorherige Effekte desselben Slots werden zuerst entfernt.
--
-- Slots (Attachments unter Root):
--   FX_Aura      Character-Aura (CharacterDef.AuraReference)
--   FX_Level     Level 5 "LevelGlow1", Level 10 "LevelGlow2", Level 15 "LevelMax"
--   FX_Mutation  MutationConfig.Effect
-- Pro Slot höchstens 1 ParticleEmitter -> max. 3 Emitter pro Model.
--
-- Zusätzliche Parts (zählen ins Budget, deshalb RESERVED_PARTS):
--   AuraRing / MutationRing  leuchtende Bodenscheibe (AuraLibrary-Eintrag mit Ring = true)
--   LevelRing + LevelStar    nur bei Level 15 (MAX)
--
-- LowDetail (Model-Attribut): keine ParticleEmitter und keine Lichter, nur Parts.

local Visual = script.Parent.Parent
local AuraLibrary = require(Visual:WaitForChild("AuraLibrary"))
local Config = Visual.Parent:WaitForChild("Config")
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))

local Effects = {}

-- Parts, die der Builder für Effekte frei lässt (AuraRing, LevelRing, LevelStar, MutationRing)
Effects.RESERVED_PARTS = 4

Effects.LEVEL_STEPS = {
	{ Level = 15, Aura = "LevelMax", Strength = 1 },
	{ Level = 10, Aura = "LevelGlow2", Strength = 0.8 },
	{ Level = 5, Aura = "LevelGlow1", Strength = 0.6 },
}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local UPRIGHT = ANG(0, 0, math.pi / 2)

local function getRoot(model: Model): BasePart?
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function dims(model: Model): (number, number, number)
	local h = model:GetAttribute("Height")
	local w = model:GetAttribute("Width")
	local height = if type(h) == "number" then h else 5
	local width = if type(w) == "number" then w else 2
	local scale = math.clamp(height / 5, 0.5, 4)
	return height, width, scale
end

local function isLowDetail(model: Model): boolean
	return model:GetAttribute("LowDetail") == true
end

-- Entfernt Attachment + Parts eines Slots
local function clearSlot(model: Model, slot: string)
	local root = getRoot(model)
	if root then
		local att = root:FindFirstChild("FX_" .. slot)
		if att then
			att:Destroy()
		end
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and inst:GetAttribute("VDSlot") == slot then
			inst:Destroy()
		end
	end
end

local function fxParent(model: Model): Instance
	return model:FindFirstChild("Body") or model
end

local function fxPart(model: Model, slot: string, name: string, size: Vector3, cf: CFrame, color: Color3, transparency: number, shape: Enum.PartType?): BasePart
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Transparency = transparency
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part:SetAttribute("VDRole", "FX")
	part:SetAttribute("VDSlot", slot)
	part.Parent = fxParent(model)
	return part
end

-- Leuchtende Bodenscheibe unter den Füßen
local function floorRing(model: Model, slot: string, color: Color3, diameter: number, lift: number, transparency: number)
	local root = getRoot(model)
	if not root then
		return
	end
	local ground = root.CFrame * CF(0, -root.Size.Y / 2 + lift, 0)
	fxPart(model, slot, slot .. "Ring", V3(0.06, diameter, diameter), ground * UPRIGHT, color, transparency, Enum.PartType.Cylinder)
end

local function makeAttachment(model: Model, slot: string, height: number): Attachment?
	local root = getRoot(model)
	if not root then
		return nil
	end
	local att = Instance.new("Attachment")
	att.Name = "FX_" .. slot
	att.Position = V3(0, height - root.Size.Y / 2, 0)
	att.Parent = root
	return att
end

-------------------------------------------------------------------------------
-- Aura
-------------------------------------------------------------------------------
function Effects.ApplyAura(model: Model, auraId: string?)
	clearSlot(model, "Aura")
	model:SetAttribute("Aura", auraId)
	if not auraId then
		return
	end
	local def = AuraLibrary.Get(auraId)
	if not def then
		warn("[ModelFactory.Effects] Unbekannte Aura: " .. tostring(auraId))
		return
	end
	local height, width, scale = dims(model)
	if not isLowDetail(model) then
		local rel = if def.Particles and def.Particles.Height then def.Particles.Height else 0.5
		local att = makeAttachment(model, "Aura", height * rel)
		if att then
			AuraLibrary.Apply(att, auraId, 1, { Scale = scale })
		end
	end
	if def.Ring then
		floorRing(model, "Aura", def.Color, math.max(width * 1.05, 2.5 * scale), 0.03, 0.55)
	end
end

-------------------------------------------------------------------------------
-- Level
-------------------------------------------------------------------------------
function Effects.LevelAuraId(level: number): (string?, number)
	for _, step in Effects.LEVEL_STEPS do
		if level >= step.Level then
			return step.Aura, step.Strength
		end
	end
	return nil, 0
end

function Effects.ApplyLevel(model: Model, level: number)
	clearSlot(model, "Level")
	model:SetAttribute("VisualLevel", level)
	local auraId, strength = Effects.LevelAuraId(level)
	if not auraId then
		return
	end
	local height, width, scale = dims(model)
	local rarityId = model:GetAttribute("Rarity")
	local rarity = if type(rarityId) == "string" then RarityConfig.ById[rarityId] else nil
	local color = if rarity then rarity.Color else Color3.new(1, 1, 1)
	local color2 = if rarity then rarity.Color2 else Color3.new(0.8, 0.8, 1)

	if not isLowDetail(model) then
		local att = makeAttachment(model, "Level", 0.15 * scale)
		if att then
			AuraLibrary.Apply(att, auraId, strength, { Scale = scale, Color = color, Color2 = color2 })
		end
	end

	if level >= 15 then
		floorRing(model, "Level", color, math.max(width * 1.3, 3 * scale), 0.05, 0.4)
		local root = getRoot(model)
		if root then
			local s = 0.45 * math.clamp(scale, 0.8, 2.5)
			local cf = root.CFrame * CF(0, -root.Size.Y / 2 + height + 0.5 * scale + s, 0) * ANG(math.pi / 4, 0, math.pi / 4)
			fxPart(model, "Level", "LevelStar", V3(s, s, s), cf, color, 0, nil)
		end
	end
end

-------------------------------------------------------------------------------
-- Mutation
-------------------------------------------------------------------------------
local function baseColor(part: BasePart): Color3
	local stored = part:GetAttribute("VDBaseColor")
	if typeof(stored) == "Color3" then
		return stored :: Color3
	end
	part:SetAttribute("VDBaseColor", part.Color)
	return part.Color
end

local function baseMaterial(part: BasePart): Enum.Material
	local stored = part:GetAttribute("VDBaseMaterial")
	if type(stored) == "string" then
		local ok, mat = pcall(function()
			return (Enum.Material :: any)[stored]
		end)
		if ok and mat then
			return mat
		end
	end
	part:SetAttribute("VDBaseMaterial", part.Material.Name)
	return part.Material
end

function Effects.ApplyMutation(model: Model, mutationId: string?)
	local def = MutationConfig.Get(mutationId)
	clearSlot(model, "Mutation")
	model:SetAttribute("Mutation", def.Id)
	local active = def.Id ~= MutationConfig.None and def.Tint ~= nil

	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name ~= "Root" and inst.Name ~= "Joint" and inst.Transparency < 1 then
			local role = inst:GetAttribute("VDRole")
			if role ~= "FX" and role ~= "Eye" then
				local color0 = baseColor(inst)
				local material0 = baseMaterial(inst)
				if not active then
					inst.Color = color0
					inst.Material = material0
				elseif role == "Glow" then
					inst.Color = color0:Lerp(def.Color, 0.6)
					inst.Material = material0
				else
					inst.Color = color0:Lerp(def.Tint :: Color3, def.TintStrength)
					if def.Material and material0 ~= Enum.Material.Neon and material0 ~= Enum.Material.Glass then
						inst.Material = def.Material
					else
						inst.Material = material0
					end
				end
			end
		end
	end

	if not active or not def.Effect then
		return
	end
	local effectDef = AuraLibrary.Get(def.Effect)
	if not effectDef then
		warn("[ModelFactory.Effects] Unbekannter Mutations-Effekt: " .. tostring(def.Effect))
		return
	end
	local height, width, scale = dims(model)
	if not isLowDetail(model) then
		local rel = if effectDef.Particles and effectDef.Particles.Height then effectDef.Particles.Height else 0.5
		local att = makeAttachment(model, "Mutation", height * rel)
		if att then
			AuraLibrary.Apply(att, def.Effect, 1, { Scale = scale })
		end
	end
	if effectDef.Ring then
		floorRing(model, "Mutation", effectDef.Color, math.max(width * 1.15, 2.8 * scale), 0.04, 0.5)
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Faces</string>
              <string name="Source"><![CDATA[--!strict
-- Faces (ModuleScript)
-- Ort: ReplicatedStorage > VoidDice > Visual > ModelFactory > Faces
--
-- Part-basierte Gesichter (keine Decals): kleine schwarze bzw. leuchtende Parts
-- auf der Vorderseite des Kopfes. Billig und aus der Distanz gut lesbar.
--
-- Face-Vokabular:
--   Smile       Augen + lächelnder Mund
--   Determined  Augen + schräge, entschlossene Brauen + gerader Mund
--   Worried     Augen + besorgte Brauen + kleiner offener Mund
--   Calm        geschlossene Strich-Augen + kleiner Mund
--   Grin        Augen + breites Grinsen (weiß, dunkel umrandet)
--   GlowEyes    zwei leuchtende Augen (Visual.Glow)
--   Visor       leuchtender Visier-Balken
--   Blank       kein Gesicht
--   Hollow      dunkle Augenhöhlen mit glimmenden Pupillen + Mundschlitz
--   ManyEyes    sieben leuchtende Augen
--   Mask        glatte Maske (Visual.Accent) mit leuchtenden Sehschlitzen
--
-- Face-Anker (von Bodies): { Group, CF (Mitte der Vorderfläche, Blick -Z), W, H, Round? }
-- Round = Radius bei runden Köpfen -> Teile folgen der Krümmung.

local Faces = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rgb = Color3.fromRGB

local DARK = rgb(24, 18, 28)
local WHITE = rgb(245, 245, 245)

Faces.Types = {
	"Smile",
	"Determined",
	"Worried",
	"Calm",
	"Grin",
	"GlowEyes",
	"Visor",
	"Blank",
	"Hollow",
	"ManyEyes",
	"Mask",
}

-- CFrame auf der Gesichtsfläche bei (x, y), "out" Studs davor
local function at(F: any, x: number, y: number, out: number): CFrame
	local back = 0
	local yaw = 0
	if F.Round then
		local r = F.Round
		local xx = math.clamp(x, -r * 0.9, r * 0.9)
		back = r - math.sqrt(r * r - xx * xx)
		yaw = -math.asin(xx / r)
	end
	return F.CF * CF(x, y, back - out) * ANG(0, yaw, 0)
end

local function piece(ctx: any, F: any, name: string, x: number, y: number, w: number, h: number, color: Color3, material: Enum.Material?, depth: number?, rot: number?, shape: string?)
	local d = depth or 0.06
	local cf = at(F, x, y, d / 2 - 0.015)
	if rot then
		cf *= ANG(0, 0, rot)
	end
	return ctx:Part(F.Group, name, shape or "Block", V3(w, h, d), cf, color, material, { Role = "Eye" })
end

-- Strich von (x1,y1) nach (x2,y2) auf der Gesichtsfläche
local function stroke(ctx: any, F: any, name: string, x1: number, y1: number, x2: number, y2: number, thick: number, color: Color3)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	return piece(ctx, F, name, (x1 + x2) / 2, (y1 + y2) / 2, len, thick, color, nil, 0.06, math.atan2(dy, dx))
end

local function eyes(ctx: any, F: any, color: Color3?, material: Enum.Material?, scaleW: number?, scaleH: number?)
	local W, H = F.W, F.H
	local ex, ey = W * 0.2, H * 0.08
	for _, side in { -1, 1 } do
		piece(ctx, F, "Eye", side * ex, ey, W * 0.13 * (scaleW or 1), H * 0.22 * (scaleH or 1), color or DARK, material)
	end
end

local Builders: { [string]: (ctx: any, F: any, C: { [string]: Color3 }) -> () } = {}

Builders.Smile = function(ctx: any, F: any, _C: { [string]: Color3 })
	local W, H = F.W, F.H
	eyes(ctx, F)
	stroke(ctx, F, "Mouth", -W * 0.15, -H * 0.17, -W * 0.02, -H * 0.23, H * 0.05, DARK)
	stroke(ctx, F, "Mouth", W * 0.02, -H * 0.23, W * 0.15, -H * 0.17, H * 0.05, DARK)
end

Builders.Determined = function(ctx: any, F: any, _C: { [string]: Color3 })
	local W, H = F.W, F.H
	local ex, ey = W * 0.2, H * 0.08
	eyes(ctx, F)
	for _, side in { -1, 1 } do
		stroke(ctx, F, "Brow", side * (ex + W * 0.1), ey + H * 0.21, side * (ex - W * 0.09), ey + H * 0.14, H * 0.055, DARK)
	end
	piece(ctx, F, "Mouth", 0, -H * 0.21, W * 0.22, H * 0.05, DARK)
end

Builders.Worried = function(ctx: any, F: any, _C: { [string]: Color3 })
	local W, H = F.W, F.H
	local ex, ey = W * 0.2, H * 0.08
	eyes(ctx, F)
	for _, side in { -1, 1 } do
		stroke(ctx, F, "Brow", side * (ex + W * 0.1), ey + H * 0.15, side * (ex - W * 0.09), ey + H * 0.22, H * 0.05, DARK)
	end
	piece(ctx, F, "Mouth", 0, -H * 0.22, W * 0.1, H * 0.09, DARK)
end

Builders.Calm = function(ctx: any, F: any, _C: { [string]: Color3 })
	local W, H = F.W, F.H
	eyes(ctx, F, DARK, nil, 1.1, 0.3)
	piece(ctx, F, "Mouth", 0, -H * 0.2, W * 0.16, H * 0.045, DARK)
end

Builders.Grin = function(ctx: any, F: any, _C: { [string]: Color3 })
	local W, H = F.W, F.H
	eyes(ctx, F)
	piece(ctx, F, "MouthRim", 0, -H * 0.2, W * 0.42, H * 0.2, DARK, nil, 0.05)
	piece(ctx, F, "Teeth", 0, -H * 0.2, W * 0.36, H * 0.13, WHITE, nil, 0.08)
end

Builders.GlowEyes = function(ctx: any, F: any, C: { [string]: Color3 })
	eyes(ctx, F, C.Glow, Enum.Material.Neon, 1.25, 0.65)
end

Builders.Visor = function(ctx: any, F: any, C: { [string]: Color3 })
	local W, H = F.W, F.H
	piece(ctx, F, "VisorFrame", 0, H * 0.08, W * 0.82, H * 0.28, DARK, nil, 0.06)
	piece(ctx, F, "Visor", 0, H * 0.08, W * 0.72, H * 0.15, C.Glow, Enum.Material.Neon, 0.1)
end

Builders.Blank = function(_ctx: any, _F: any, _C: { [string]: Color3 }) end

Builders.Hollow = function(ctx: any, F: any, C: { [string]: Color3 })
	local W, H = F.W, F.H
	local ex, ey = W * 0.21, H * 0.1
	for _, side in { -1, 1 } do
		piece(ctx, F, "Socket", side * ex, ey, W * 0.26, H * 0.32, DARK, nil, 0.06, nil, "Sphere")
		piece(ctx, F, "Pupil", side * ex, ey, W * 0.07, W * 0.07, C.Glow, Enum.Material.Neon, 0.1)
	end
	piece(ctx, F, "Mouth", 0, -H * 0.24, W * 0.3, H * 0.06, DARK)
end

local MANY = {
	{ -0.27, 0.16, 0.14 },
	{ 0.27, 0.16, 0.14 },
	{ 0, 0.3, 0.12 },
	{ -0.11, -0.02, 0.1 },
	{ 0.11, -0.02, 0.1 },
	{ -0.33, -0.17, 0.08 },
	{ 0.33, -0.17, 0.08 },
}
Builders.ManyEyes = function(ctx: any, F: any, C: { [string]: Color3 })
	local W, H = F.W, F.H
	for _, e in MANY do
		local d = e[3] * W
		local cf = at(F, e[1] * W, e[2] * H, 0)
		ctx:Part(F.Group, "Eye", "Ball", V3(d, d, d), cf, C.Glow, Enum.Material.Neon, { Role = "Eye" })
	end
end

Builders.Mask = function(ctx: any, F: any, C: { [string]: Color3 })
	local W, H = F.W, F.H
	piece(ctx, F, "Mask", 0, 0, W * 0.8, H * 0.78, C.Accent, nil, 0.1)
	for _, side in { -1, 1 } do
		piece(ctx, F, "Slit", side * W * 0.18, H * 0.1, W * 0.17, H * 0.06, C.Glow, Enum.Material.Neon, 0.14)
	end
end

Faces.Builders = Builders

function Faces.Has(faceType: string): boolean
	return Builders[faceType] ~= nil
end

function Faces.Build(ctx: any, F: any, faceType: string, C: { [string]: Color3 })
	local builder = Builders[faceType]
	if not builder then
		warn("[ModelFactory.Faces] Unbekannter Face-Typ: " .. tostring(faceType))
		builder = Builders.Smile
	end
	builder(ctx, F, C)
end

return Faces
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="48">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="49">
      <Properties>
        <string name="Name">VoidDiceServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- VoidDiceServer (Script)
-- Ort: ServerScriptService > VoidDiceServer
--
-- Startet alle Services in fester Reihenfolge: erst Init (Vorbereitung, z. B.
-- Welt bauen, Remotes anlegen), dann Start (Verbindungen, Loops).
--
-- Aufbau:
--   Logic/     reine Spiellogik (Profil-Tabellen rein, Änderungen raus)
--   Services/  Roblox-Anbindung: Remotes, DataStore, Welt, Models, Robux
--   World/     prozeduraler Map-Bau (Hub, Bases, Gebiete)

local Services = script:WaitForChild("Services")

local ORDER = {
	"DataService",
	"AntiCheatService",
	"SessionService",
	"WorldService",
	"AnnouncementService",
	"EconomyService",
	"RollService",
	"CharacterService",
	"ProgressionService",
	"GoalsService",
	"BaseService",
	"AvatarService",
	"LeaderboardService",
	"MonetizationService",
	"DebugService",
}

local loaded = {}
for _, name in ORDER do
	loaded[name] = require(Services:WaitForChild(name)) :: any
end

for _, name in ORDER do
	local service = loaded[name]
	if service.Init then
		service.Init()
	end
end

for _, name in ORDER do
	local service = loaded[name]
	if service.Start then
		service.Start()
	end
end

-- Erst jetzt Spieler annehmen (alle Hooks sind registriert)
loaded.SessionService.Begin()

print("[VoidDice] Server bereit. ROLL. COLLECT. SURVIVE.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Logic</string>
          <string name="Source"><![CDATA[--!strict
-- Logic (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic
--
-- Die komplette Spiellogik als reine Funktionen auf Profil-Tabellen.
-- Keine Remotes, keine DataStores, keine Instanzen. Dadurch:
--   * Services sind dünne Hüllen (Validierung, Rate Limits, Sync)
--   * Tests und die Economy-Simulation nutzen exakt denselben Code
--
-- Untermodule:
--   Context, ProfileTemplate, Modifiers, Economy, Inventory, Rolling,
--   Upgrades, Items, Fishing, Progression, Goals, Rewards, Cosmetics,
--   QuestTracker

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))

local Context = require(script:WaitForChild("Context"))
local ProfileTemplate = require(script:WaitForChild("ProfileTemplate"))
local Modifiers = require(script:WaitForChild("Modifiers"))
local Economy = require(script:WaitForChild("Economy"))
local Inventory = require(script:WaitForChild("Inventory"))
local Rolling = require(script:WaitForChild("Rolling"))
local Upgrades = require(script:WaitForChild("Upgrades"))
local Items = require(script:WaitForChild("Items"))
local Fishing = require(script:WaitForChild("Fishing"))
local Progression = require(script:WaitForChild("Progression"))
local Goals = require(script:WaitForChild("Goals"))
local Rewards = require(script:WaitForChild("Rewards"))
local Cosmetics = require(script:WaitForChild("Cosmetics"))
local QuestTracker = require(script:WaitForChild("QuestTracker"))

local Logic = {
	Context = Context,
	ProfileTemplate = ProfileTemplate,
	Modifiers = Modifiers,
	Economy = Economy,
	Inventory = Inventory,
	Rolling = Rolling,
	Upgrades = Upgrades,
	Items = Items,
	Fishing = Fishing,
	Progression = Progression,
	Goals = Goals,
	Rewards = Rewards,
	Cosmetics = Cosmetics,
	QuestTracker = QuestTracker,
}

-- Beim Laden eines Profils (Join)
function Logic.onLoad(profile, ctx: Context.Context)
	ProfileTemplate.reconcile(profile)
	if profile.FirstJoin == 0 then
		profile.FirstJoin = ctx.now
	end
	profile.LastJoin = ctx.now
	Goals.ensureSeason(profile, ctx)
	QuestTracker.ensureDaily(profile, ctx)
	local mods = Modifiers.compute(profile)
	Inventory.validateSlots(profile, ctx, mods)
	-- Pässe, die Cosmetics mitbringen (VIP)
	for passName, owned in profile.Passes do
		if owned then
			Logic.applyPassCosmetics(profile, ctx, passName)
		end
	end
end

-- Ein Server-Tick (dt Sekunden): Einkommen, Boosts, Fishing, Spielzeit
function Logic.tick(profile, ctx: Context.Context, dt: number)
	local mods = Modifiers.compute(profile)
	Economy.tick(profile, ctx, mods, dt)
	Items.tickBoosts(profile, ctx, dt)
	if Fishing.isUnlocked(profile) then
		Fishing.tick(profile, ctx, mods, dt)
	end
	profile.Stats.Playtime += dt
	QuestTracker.ensureDaily(profile, ctx)
	Goals.evaluateAchievements(profile, ctx)
end

-- Gamepass gekauft/erkannt
function Logic.grantPass(profile, ctx: Context.Context, passName: string): boolean
	if not MonetizationConfig.Gamepasses[passName] then
		return false
	end
	if not profile.Passes[passName] then
		profile.Passes[passName] = true
		Context.mark(ctx, "Passes")
	end
	Logic.applyPassCosmetics(profile, ctx, passName)
	return true
end

function Logic.applyPassCosmetics(profile, ctx: Context.Context, passName: string)
	local effects = MonetizationConfig.PassEffects[passName]
	if effects and effects.Cosmetics then
		for _, id in effects.Cosmetics do
			if not profile.Cosmetics.Owned[id] then
				profile.Cosmetics.Owned[id] = true
				Context.mark(ctx, "Cosmetics")
			end
		end
	end
end

-- Developer Product (fester Inhalt, keine Zufallsbelohnung)
function Logic.grantProduct(profile, ctx: Context.Context, productName: string): boolean
	local def = MonetizationConfig.Products[productName]
	if not def then
		return false
	end
	if def.Kind == "Cash" then
		local amount = Economy.scaledAmount(profile, def.Seconds, def.Minimum)
		Economy.earn(profile, ctx, amount, "Product")
	elseif def.Kind == "Potion" then
		for id, amount in def.Potions do
			Items.addPotion(profile, ctx, id, amount)
		end
	else
		return false
	end
	Context.event(ctx, "ProductGranted", { Id = productName })
	return true
end

-- Einstellungen (Whitelist + Typprüfung)
Logic.SettingTypes = {
	AutoPlace = "boolean",
	Music = "boolean",
	SFX = "boolean",
	ReducedEffects = "boolean",
	ShowOthersReveals = "boolean",
}

function Logic.setSetting(profile, ctx: Context.Context, key: string, value: any): boolean
	local expected = Logic.SettingTypes[key]
	if not expected or type(value) ~= expected then
		return false
	end
	profile.Settings[key] = value
	Context.mark(ctx, "Settings")
	return true
end

function Logic.setAutoDelete(profile, ctx: Context.Context, rarityId: string, enabled: boolean): boolean
	local RarityConfig = require(Config:WaitForChild("RarityConfig"))
	local def = RarityConfig.ById[rarityId]
	if not def or def.Order > Rolling.MaxAutoDeleteOrder then
		return false
	end
	profile.Settings.AutoDelete[rarityId] = if enabled then true else nil
	Context.mark(ctx, "Settings")
	return true
end

-- Tutorial: nur der jeweils aktuelle Schritt kann abgeschlossen werden
function Logic.tutorialStep(profile, ctx: Context.Context, stepId: string): boolean
	local tutorial = profile.Tutorial
	if tutorial.Done then
		return false
	end
	local current = GameConfig.TutorialSteps[tutorial.Step]
	if not current or current.Id ~= stepId then
		return false
	end
	tutorial.Step += 1
	if tutorial.Step > #GameConfig.TutorialSteps then
		tutorial.Done = true
		-- Belohnung nur beim ersten Durchlauf (Replay gibt nichts)
		if not tutorial.Rewarded then
			tutorial.Rewarded = true
			Items.addPotion(profile, ctx, "Luck", 1)
		end
		Context.event(ctx, "TutorialDone", {})
	end
	Context.mark(ctx, "Tutorial")
	return true
end

function Logic.replayTutorial(profile, ctx: Context.Context)
	profile.Tutorial.Step = 1
	profile.Tutorial.Done = false
	Context.mark(ctx, "Tutorial")
end

function Logic.skipTutorial(profile, ctx: Context.Context)
	if not profile.Tutorial.Done then
		profile.Tutorial.Done = true
		Context.mark(ctx, "Tutorial")
	end
end

-- Abgeleitete Werte für die UI (werden mit jedem Sync mitgeschickt)
function Logic.derived(profile)
	local mods = Modifiers.compute(profile)
	local income = Economy.incomePerSecond(profile, mods)
	return {
		Luck = mods.Luck,
		LuckBreakdown = mods.LuckBreakdown,
		CashMultiplier = mods.CashMultiplier,
		CashBreakdown = mods.CashBreakdown,
		RollCooldown = mods.RollCooldown,
		RollSpeed = mods.RollSpeed,
		FishingLuck = mods.FishingLuck,
		FishingSpeed = mods.FishingSpeed,
		MutationLuck = mods.MutationLuck,
		BaseSlots = mods.BaseSlots,
		FishingSlots = mods.FishingSlots,
		GearSlots = mods.GearSlots,
		AutoCollect = mods.AutoCollect,
		IncomePerSecond = income,
		VaultCapacity = Economy.vaultCapacity(income),
		RebirthCost = Progression.rebirthCost(profile),
		FishingUnlocked = Fishing.isUnlocked(profile),
		BaseValue = Economy.baseValue(profile),
		CollectionScore = Economy.collectionScore(profile),
		SeasonTier = Goals.seasonTier(profile),
		InventoryCount = Inventory.count(profile),
		Discovered = Modifiers.discovered(profile),
	}
end

return Logic
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Context</string>
            <string name="Source"><![CDATA[--!strict
-- Context (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Context
--
-- Ein Context begleitet einen Logik-Aufruf (eine Spieleraktion oder einen Tick).
-- Er liefert Zeit und Zufall von außen (Server: echte Zeit/Random, Simulation:
-- simulierte Zeit/Seed) und sammelt, was sich geändert hat:
--   dirty       geänderte Top-Level-Keys des Profils -> Sync an den Client
--   dirtyChars  geänderte Characters (uid)
--   dirtyGear   geänderte Gear-Items (uid)
--   events      Meldungen für den Client (Toasts, Reveals, Ansagen)
--
-- Die Logik-Module sind dadurch reine Funktionen auf Tabellen und ohne
-- Roblox-Services testbar.

export type RNG = { NextNumber: (self: any) -> number, NextInteger: (self: any, number, number) -> number }

export type Context = {
	now: number,
	rng: RNG,
	userId: number,
	isStudio: boolean,
	events: { { Kind: string, Data: any } },
	dirty: { [string]: boolean },
	dirtyChars: { [string]: boolean },
	dirtyGear: { [string]: boolean },
}

local Context = {}

function Context.new(options: { now: number, rng: RNG, userId: number?, isStudio: boolean? }): Context
	return {
		now = options.now,
		rng = options.rng,
		userId = options.userId or 0,
		isStudio = options.isStudio == true,
		events = {},
		dirty = {},
		dirtyChars = {},
		dirtyGear = {},
	}
end

function Context.mark(ctx: Context, key: string)
	ctx.dirty[key] = true
end

function Context.markChar(ctx: Context, uid: string)
	ctx.dirtyChars[uid] = true
end

function Context.markGear(ctx: Context, uid: string)
	ctx.dirtyGear[uid] = true
end

function Context.event(ctx: Context, kind: string, data: any?)
	table.insert(ctx.events, { Kind = kind, Data = data })
end

return Context
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetics (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Cosmetics

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CosmeticConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("CosmeticConfig"))

local Context = require(script.Parent:WaitForChild("Context"))

local Cosmetics = {}

-- true wenn neu
function Cosmetics.grant(profile, ctx: Context.Context, id: string): boolean
	local def = CosmeticConfig.Get(id)
	if not def or profile.Cosmetics.Owned[id] then
		return false
	end
	profile.Cosmetics.Owned[id] = true
	Context.mark(ctx, "Cosmetics")
	Context.event(ctx, "Cosmetic", { Id = id, Kind = def.Kind, Name = def.DisplayName })
	return true
end

function Cosmetics.equip(profile, ctx: Context.Context, kind: string, id: string): (boolean, string?)
	local def = CosmeticConfig.Get(id)
	if not def or def.Kind ~= kind then
		return false, "Unknown cosmetic"
	end
	if not profile.Cosmetics.Owned[id] then
		return false, "Not owned"
	end
	profile.Cosmetics.Equipped[kind] = id
	Context.mark(ctx, "Cosmetics")
	return true, nil
end

function Cosmetics.unequip(profile, ctx: Context.Context, kind: string)
	local default = CosmeticConfig.Defaults[kind]
	profile.Cosmetics.Equipped[kind] = default
	Context.mark(ctx, "Cosmetics")
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Economy (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Economy
--
-- Cash rein, Cash raus. Jede Änderung an profile.Cash läuft über diese
-- Funktionen (validiert gegen NaN/inf/negativ) – das ist die Grundlage der
-- Anti-Cheat-Prüfung "Cash Changes".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Modifiers = require(Logic:WaitForChild("Modifiers"))
local QuestTracker = require(Logic:WaitForChild("QuestTracker"))

local Economy = {}

local function valid(amount: number): boolean
	return type(amount) == "number" and amount == amount and amount ~= math.huge and amount ~= -math.huge and amount >= 0
end

-- Verdientes Cash gutschreiben (zählt für TotalCashEarned)
function Economy.earn(profile, ctx: Context.Context, amount: number, source: string?)
	if not valid(amount) then
		warn("[Economy] ungültiger Betrag verworfen:", amount, source)
		return
	end
	if amount == 0 then
		return
	end
	profile.Cash += amount
	profile.Stats.TotalCashEarned += amount
	Context.mark(ctx, "Cash")
	Context.mark(ctx, "Stats")
end

-- Ausgeben. false wenn nicht genug Cash.
function Economy.spend(profile, ctx: Context.Context, amount: number): boolean
	if not valid(amount) then
		return false
	end
	if profile.Cash + 1e-6 < amount then
		return false
	end
	profile.Cash = math.max(0, profile.Cash - amount)
	profile.Stats.CashSpent += amount
	Context.mark(ctx, "Cash")
	return true
end

-- Gear-Cash-Bonus eines Characters in %
function Economy.gearCashPct(profile, char): number
	local pct = 0
	for _, gearUid in char.Gear do
		local item = profile.Gear[gearUid]
		local def = item and GearConfig.Get(item.Id)
		if def and def.CashPct then
			pct += def.CashPct
		end
	end
	return math.min(pct, EconomyConfig.MaxGearCashPctPerCharacter)
end

-- $/s eines Characters inkl. Gear und globaler Multiplikatoren
function Economy.characterIncome(profile, char, mods: Modifiers.Mods): number
	local def = CharacterConfig.ById[char.Id]
	if not def then
		return 0
	end
	local base = Stats.income(def, char.Level, char.Mutation)
	return base * (1 + Economy.gearCashPct(profile, char) / 100) * mods.CashMultiplier
end

-- Summe $/s aller Characters in der Base
function Economy.incomePerSecond(profile, mods: Modifiers.Mods): number
	local total = 0
	for _, char in profile.Characters do
		if char.Slot then
			total += Economy.characterIncome(profile, char, mods)
		end
	end
	return total
end

function Economy.vaultCapacity(incomePerSecond: number): number
	return math.max(EconomyConfig.VaultMinCapacity, incomePerSecond * EconomyConfig.VaultCapacitySeconds)
end

-- Ein Tick passives Einkommen
function Economy.tick(profile, ctx: Context.Context, mods: Modifiers.Mods, dt: number): number
	local income = Economy.incomePerSecond(profile, mods)
	local amount = income * dt
	if amount <= 0 then
		return income
	end
	if mods.AutoCollect then
		Economy.earn(profile, ctx, amount, "Income")
		QuestTracker.track(profile, ctx, "CashCollected", amount)
	else
		local cap = Economy.vaultCapacity(income)
		local before = profile.Vault
		profile.Vault = math.min(cap, profile.Vault + amount)
		if profile.Vault ~= before then
			Context.mark(ctx, "Vault")
		end
	end
	return income
end

function Economy.collect(profile, ctx: Context.Context): number
	local amount = profile.Vault
	if amount <= 0 then
		return 0
	end
	profile.Vault = 0
	Context.mark(ctx, "Vault")
	Economy.earn(profile, ctx, amount, "Collect")
	QuestTracker.track(profile, ctx, "CashCollected", amount)
	return amount
end

-- Belohnung in "Sekunden aktuelles Einkommen" (Quests, Fishing, Produkte)
function Economy.scaledAmount(profile, seconds: number, minimum: number?): number
	local mods = Modifiers.compute(profile)
	local income = math.max(EconomyConfig.ScaledReward.MinIncomePerSecond, Economy.incomePerSecond(profile, mods))
	return math.max(minimum or 0, math.floor(income * seconds))
end

-- Base Value (Flex): Summe der Power der Characters in der Base
function Economy.baseValue(profile): number
	local total = 0
	for _, char in profile.Characters do
		if char.Slot then
			local def = CharacterConfig.ById[char.Id]
			if def then
				total += Stats.power(def, char.Level, char.Mutation)
			end
		end
	end
	return total
end

-- Punkte für das "Rarest Collection" Leaderboard
function Economy.collectionScore(profile): number
	local score = 0
	for id in profile.Index do
		local def = CharacterConfig.ById[id]
		if def then
			score += EconomyConfig.CollectionPoints[def.Rarity] or 0
		end
	end
	return score
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Fishing</string>
            <string name="Source"><![CDATA[--!strict
-- Fishing (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Fishing
--
-- Rift Fishing. Fortschritt läuft im Server-Tick (nur online). Der Server
-- entscheidet Zeitpunkt und Inhalt jedes Fangs; der Client sieht nur das
-- Ergebnis (Event "Catch").

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local Util = Shared:WaitForChild("Util")
local Stats = require(Util:WaitForChild("Stats"))
local RollMath = require(Util:WaitForChild("RollMath"))
local Odds = require(Util:WaitForChild("Odds"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Modifiers = require(Logic:WaitForChild("Modifiers"))
local Economy = require(Logic:WaitForChild("Economy"))
local Items = require(Logic:WaitForChild("Items"))
local Cosmetics = require(Logic:WaitForChild("Cosmetics"))
local QuestTracker = require(Logic:WaitForChild("QuestTracker"))

local Fishing = {}

Fishing.DuplicateCosmeticCashSeconds = 60
Fishing.MaxCatchesPerTick = 3 -- Schutz, falls ein Tick sehr lang war

function Fishing.isUnlocked(profile): boolean
	return profile.Rebirths > 0 or profile.Stats.TotalCashEarned >= GameConfig.FishingUnlockCashEarned
end

function Fishing.fishers(profile): { [number]: string }
	local bySeat = {}
	for uid, char in profile.Characters do
		if char.Fishing then
			bySeat[char.Fishing] = uid
		end
	end
	return bySeat
end

function Fishing.characterStats(profile, char): (number, number)
	local def = CharacterConfig.ById[char.Id]
	if not def then
		return 0, 0
	end
	local power = Stats.fishingPower(def, char.Level)
	local luckPct = 0
	for _, gearUid in char.Gear do
		local item = profile.Gear[gearUid]
		local g = item and GearConfig.Get(item.Id)
		if g then
			power += g.FishingPower or 0
			luckPct += g.FishingLuckPct or 0
		end
	end
	return power, luckPct
end

function Fishing.interval(profile, char, mods: Modifiers.Mods): number
	local power = Fishing.characterStats(profile, char)
	return Stats.catchInterval(power, mods.FishingSpeed)
end

function Fishing.send(profile, ctx: Context.Context, uid: string, mods: Modifiers.Mods): (boolean, string?)
	if not Fishing.isUnlocked(profile) then
		return false, "Fishing is locked"
	end
	local char = profile.Characters[uid]
	if not char then
		return false, "Character not found"
	end
	if char.Fishing then
		return true, nil
	end
	local bySeat = Fishing.fishers(profile)
	local seat = nil
	for i = 1, mods.FishingSlots do
		if not bySeat[i] then
			seat = i
			break
		end
	end
	if not seat then
		return false, "All fishing spots are taken"
	end
	if char.Slot then
		char.Slot = nil
		Context.mark(ctx, "Base")
	end
	char.Fishing = seat
	char.FishProgress = 0
	Context.markChar(ctx, uid)
	Context.mark(ctx, "Fishers")
	return true, nil
end

function Fishing.recall(profile, ctx: Context.Context, uid: string): boolean
	local char = profile.Characters[uid]
	if not char or not char.Fishing then
		return false
	end
	char.Fishing = nil
	char.FishProgress = 0
	Context.markChar(ctx, uid)
	Context.mark(ctx, "Fishers")
	return true
end

function Fishing.setWaters(profile, ctx: Context.Context, watersId: string): (boolean, string?)
	local waters = FishingConfig.WatersById[watersId]
	if not waters then
		return false, "Unknown waters"
	end
	if not profile.Areas[waters.Area] then
		local area = AreaConfig.Get(waters.Area)
		return false, "Unlock " .. (if area then area.DisplayName else waters.Area) .. " first"
	end
	profile.FishingWaters = watersId
	Context.mark(ctx, "FishingWaters")
	return true, nil
end

-- Einen Fang ausführen und gutschreiben
function Fishing.catch(profile, ctx: Context.Context, uid: string, mods: Modifiers.Mods)
	local char = profile.Characters[uid]
	local tbl = Odds.watersTable(profile.FishingWaters) or Odds.watersTable(FishingConfig.DefaultWaters)
	assert(tbl, "Fishing: keine Loot-Tabelle")
	local _, gearLuckPct = Fishing.characterStats(profile, char)
	local luck = mods.FishingLuck * (1 + gearLuckPct / 100)
	local entry, _, probability = RollMath.pick(tbl, luck, ctx.rng:NextNumber())
	local loot = entry.Key

	local result = {
		Uid = uid,
		Kind = loot.Kind,
		Id = loot.Id,
		Rarity = loot.Rarity,
		Probability = probability,
		Amount = 1,
		Cash = nil :: number?,
		Waters = profile.FishingWaters,
	}

	if loot.Kind == "Cash" then
		local amount = Economy.scaledAmount(profile, loot.Seconds or 10, 25)
		Economy.earn(profile, ctx, amount, "Fishing")
		result.Cash = amount
	elseif loot.Kind == "Potion" then
		Items.addPotion(profile, ctx, loot.Id, 1)
	elseif loot.Kind == "Gear" then
		local gearUid, overflowCash = Items.addGear(profile, ctx, loot.Id)
		result.GearUid = gearUid
		result.Cash = overflowCash
	elseif loot.Kind == "Relic" then
		Items.addRelic(profile, ctx, loot.Id)
	elseif loot.Kind == "Cosmetic" then
		if not Cosmetics.grant(profile, ctx, loot.Id) then
			local amount = Economy.scaledAmount(profile, Fishing.DuplicateCosmeticCashSeconds, 500)
			Economy.earn(profile, ctx, amount, "FishingDuplicate")
			result.Cash = amount
			result.Duplicate = true
		end
	end

	profile.Stats.FishingCatches += 1
	Context.mark(ctx, "Stats")
	QuestTracker.track(profile, ctx, "FishingCatches", 1)
	Context.event(ctx, "Catch", result)
	return result
end

function Fishing.tick(profile, ctx: Context.Context, mods: Modifiers.Mods, dt: number)
	for uid, char in profile.Characters do
		if char.Fishing then
			if char.Fishing > mods.FishingSlots then
				Fishing.recall(profile, ctx, uid)
			else
				char.FishProgress = (char.FishProgress or 0) + dt
				local interval = Fishing.interval(profile, char, mods)
				local catches = 0
				while char.FishProgress >= interval and catches < Fishing.MaxCatchesPerTick do
					char.FishProgress -= interval
					catches += 1
					Fishing.catch(profile, ctx, uid, mods)
				end
				if catches >= Fishing.MaxCatchesPerTick then
					char.FishProgress = 0
				end
			end
		end
	end
end

return Fishing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Goals</string>
            <string name="Source"><![CDATA[--!strict
-- Goals (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Goals
--
-- Quests einlösen, Achievements prüfen, Season-Tiers einlösen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local QuestConfig = require(Config:WaitForChild("QuestConfig"))
local AchievementConfig = require(Config:WaitForChild("AchievementConfig"))
local SeasonConfig = require(Config:WaitForChild("SeasonConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Rewards = require(Logic:WaitForChild("Rewards"))

local Goals = {}

-- Quests ---------------------------------------------------------------------------

function Goals.claimQuest(profile, ctx: Context.Context, questId: string): (boolean, string?)
	for _, entry in profile.Quests.List do
		if entry.Id == questId then
			local def = QuestConfig.ById[questId]
			if not def then
				return false, "Unknown quest"
			end
			if entry.Claimed then
				return false, "Already claimed"
			end
			if entry.Progress < def.Target then
				return false, "Quest not complete"
			end
			entry.Claimed = true
			Context.mark(ctx, "Quests")
			local granted = Rewards.grant(profile, ctx, def.Rewards)
			Context.event(ctx, "QuestClaimed", { Id = questId, Granted = granted })
			return true, nil
		end
	end
	return false, "Quest not active"
end

-- Achievements ---------------------------------------------------------------------

local function check(profile, def): boolean
	local c = def.Check
	if c.Type == "Stat" then
		return (profile.Stats[c.Stat] or 0) >= c.Value
	elseif c.Type == "BestRarity" then
		return profile.Stats.BestRarityOrder >= RarityConfig.Order(c.Rarity)
	elseif c.Type == "Discovered" then
		return profile.Stats.CharactersDiscovered >= math.min(c.Value, #CharacterConfig.List)
	elseif c.Type == "MaxLevelCharacter" then
		return profile.Stats.HighestCharacterLevel >= CharacterConfig.DefaultMaxLevel
	elseif c.Type == "Mutation" then
		return profile.Stats.Mutations > 0
	end
	return false
end

-- Prüft alle offenen Achievements, schaltet erreichte frei (inkl. Belohnung)
function Goals.evaluateAchievements(profile, ctx: Context.Context): { string }
	local unlocked = {}
	for _, def in AchievementConfig.List do
		if not profile.Achievements[def.Id] and check(profile, def) then
			profile.Achievements[def.Id] = ctx.now
			Context.mark(ctx, "Achievements")
			local granted = Rewards.grant(profile, ctx, def.Rewards)
			Context.event(ctx, "Achievement", { Id = def.Id, Name = def.DisplayName, Granted = granted })
			table.insert(unlocked, def.Id)
		end
	end
	return unlocked
end

-- Season ---------------------------------------------------------------------------

function Goals.ensureSeason(profile, ctx: Context.Context)
	if profile.Season.Id ~= SeasonConfig.Id then
		profile.Season = { Id = SeasonConfig.Id, Xp = 0, Free = {}, Premium = {} }
		Context.mark(ctx, "Season")
	end
end

function Goals.seasonTier(profile): number
	return math.min(#SeasonConfig.Tiers, math.floor(profile.Season.Xp / SeasonConfig.XpPerTier))
end

function Goals.claimSeason(profile, ctx: Context.Context, track: string, tier: number): (boolean, string?)
	if not SeasonConfig.Enabled then
		return false, "No active season"
	end
	if track ~= "Free" and track ~= "Premium" then
		return false, "Unknown track"
	end
	tier = math.floor(tier)
	local def = SeasonConfig.Tiers[tier]
	if not def then
		return false, "Unknown tier"
	end
	if Goals.seasonTier(profile) < tier then
		return false, "Tier not reached"
	end
	if track == "Premium" and not profile.Passes.SeasonPremium then
		return false, "Premium track locked"
	end
	local claimed = profile.Season[track]
	local key = tostring(tier)
	if claimed[key] then
		return false, "Already claimed"
	end
	claimed[key] = true
	Context.mark(ctx, "Season")
	local granted = Rewards.grant(profile, ctx, Rewards.fromSeasonReward(def[track]))
	Context.event(ctx, "SeasonClaimed", { Track = track, Tier = tier, Granted = granted })
	return true, nil
end

-- Hilfsfunktion für Tests/UI
function Goals.hasMutation(profile): boolean
	for _, char in profile.Characters do
		if char.Mutation ~= MutationConfig.None then
			return true
		end
	end
	return false
end

return Goals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Inventory</string>
            <string name="Source"><![CDATA[--!strict
-- Inventory (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Inventory
--
-- Besitz von Characters: hinzufügen, entfernen, in die Base stellen,
-- verkaufen, sperren. Ein Character ist immer genau in EINEM Zustand:
--   Inventar (Slot = nil, Fishing = nil)
--   Base     (Slot = 1..BaseSlots)
--   Fishing  (Fishing = Sitzplatz 1..FishingSlots)
--
-- Vorbereitung Steal/Raid: Inventory.transfer() verschiebt einen Character
-- atomar zwischen zwei geladenen Profilen (beide liegen auf demselben Server).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Modifiers = require(Logic:WaitForChild("Modifiers"))
local Economy = require(Logic:WaitForChild("Economy"))

local Inventory = {}

function Inventory.count(profile): number
	local n = 0
	for _ in profile.Characters do
		n += 1
	end
	return n
end

function Inventory.add(profile, ctx: Context.Context, id: string, mutation: string?, level: number?): string
	local uid = "c" .. profile.NextCharUid
	profile.NextCharUid += 1
	profile.Characters[uid] = {
		Id = id,
		Level = level or 1,
		Mutation = mutation or MutationConfig.None,
		Slot = nil,
		Fishing = nil,
		FishProgress = 0,
		Gear = {},
		Locked = false,
		At = ctx.now,
	}
	Context.markChar(ctx, uid)
	return uid
end

-- Entfernt einen Character. Ausgerüstetes Gear geht zurück ins Gear-Inventar.
function Inventory.remove(profile, ctx: Context.Context, uid: string)
	local char = profile.Characters[uid]
	if not char then
		return
	end
	for _, gearUid in char.Gear do
		local item = profile.Gear[gearUid]
		if item then
			item.On = nil
			Context.markGear(ctx, gearUid)
		end
	end
	profile.Characters[uid] = nil
	Context.markChar(ctx, uid)
end

function Inventory.placed(profile): { [number]: string }
	local bySlot = {}
	for uid, char in profile.Characters do
		if char.Slot then
			bySlot[char.Slot] = uid
		end
	end
	return bySlot
end

function Inventory.freeSlot(profile, mods: Modifiers.Mods): number?
	local bySlot = Inventory.placed(profile)
	for slot = 1, mods.BaseSlots do
		if not bySlot[slot] then
			return slot
		end
	end
	return nil
end

function Inventory.place(profile, ctx: Context.Context, uid: string, mods: Modifiers.Mods, slot: number?): (boolean, string?)
	local char = profile.Characters[uid]
	if not char then
		return false, "Character not found"
	end
	if char.Slot then
		return true, nil
	end
	local target = slot or Inventory.freeSlot(profile, mods)
	if not target then
		return false, "Base is full"
	end
	if char.Fishing then
		char.Fishing = nil
		char.FishProgress = 0
	end
	char.Slot = target
	Context.markChar(ctx, uid)
	Context.mark(ctx, "Base")
	return true, nil
end

function Inventory.unplace(profile, ctx: Context.Context, uid: string): boolean
	local char = profile.Characters[uid]
	if not char or not char.Slot then
		return false
	end
	char.Slot = nil
	Context.markChar(ctx, uid)
	Context.mark(ctx, "Base")
	return true
end

-- Neuer Character: freien Slot nehmen oder den schwächsten ersetzen,
-- wenn der neue mehr $/s bringt.
function Inventory.autoPlace(profile, ctx: Context.Context, uid: string, mods: Modifiers.Mods): boolean
	local char = profile.Characters[uid]
	if not char or char.Slot or char.Fishing then
		return false
	end
	local free = Inventory.freeSlot(profile, mods)
	if free then
		Inventory.place(profile, ctx, uid, mods, free)
		return true
	end
	local newIncome = Economy.characterIncome(profile, char, mods)
	local weakestUid, weakestIncome = nil, math.huge
	for otherUid, other in profile.Characters do
		if other.Slot then
			local inc = Economy.characterIncome(profile, other, mods)
			if inc < weakestIncome then
				weakestUid, weakestIncome = otherUid, inc
			end
		end
	end
	if weakestUid and newIncome > weakestIncome then
		local slot = profile.Characters[weakestUid].Slot
		Inventory.unplace(profile, ctx, weakestUid)
		Inventory.place(profile, ctx, uid, mods, slot)
		return true
	end
	return false
end

-- Stellt die besten Characters (nach aktuellem $/s) in die Base.
-- Fischende Characters bleiben am Pond.
function Inventory.placeBest(profile, ctx: Context.Context, mods: Modifiers.Mods)
	local candidates = {}
	for uid, char in profile.Characters do
		if not char.Fishing then
			table.insert(candidates, { uid = uid, income = Economy.characterIncome(profile, char, mods) })
		end
	end
	table.sort(candidates, function(a, b)
		if a.income == b.income then
			return a.uid < b.uid
		end
		return a.income > b.income
	end)
	local keep = {}
	for i = 1, math.min(mods.BaseSlots, #candidates) do
		keep[candidates[i].uid] = true
	end
	-- erst raus, dann rein (stabile Slot-Nummern für die, die bleiben)
	for uid, char in profile.Characters do
		if char.Slot and not keep[uid] then
			Inventory.unplace(profile, ctx, uid)
		end
	end
	for uid in keep do
		if not profile.Characters[uid].Slot then
			Inventory.place(profile, ctx, uid, mods)
		end
	end
end

-- Slots außerhalb des erlaubten Bereichs freimachen (z. B. Pass entfernt)
function Inventory.validateSlots(profile, ctx: Context.Context, mods: Modifiers.Mods)
	local seen = {}
	for uid, char in profile.Characters do
		if char.Slot then
			if char.Slot > mods.BaseSlots or char.Slot < 1 or seen[char.Slot] then
				char.Slot = nil
				Context.markChar(ctx, uid)
			else
				seen[char.Slot] = true
			end
		end
	end
end

function Inventory.sellValue(profile, uid: string): number
	local char = profile.Characters[uid]
	local def = char and CharacterConfig.ById[char.Id]
	if not def then
		return 0
	end
	return Stats.sellValue(def, char.Level, char.Mutation)
end

-- Der am wenigsten werte "freie" Character (nicht gesperrt, nicht in der
-- Base, nicht beim Fishing, ohne Mutation). Wird bei vollem Inventar ersetzt.
function Inventory.worstSellable(profile): (string?, number)
	local worstUid, worstValue = nil, math.huge
	for uid, char in profile.Characters do
		if not char.Locked and not char.Slot and not char.Fishing and char.Mutation == MutationConfig.None then
			local value = Inventory.sellValue(profile, uid)
			if value < worstValue then
				worstUid, worstValue = uid, value
			end
		end
	end
	return worstUid, worstValue
end

function Inventory.sell(profile, ctx: Context.Context, uid: string): (boolean, number | string)
	local char = profile.Characters[uid]
	if not char then
		return false, "Character not found"
	end
	if char.Locked then
		return false, "Character is locked"
	end
	local value = Inventory.sellValue(profile, uid)
	Inventory.remove(profile, ctx, uid)
	Economy.earn(profile, ctx, value, "Sell")
	profile.Stats.Sold += 1
	return true, value
end

-- Alle "freien" Characters einer Rarity verkaufen: nicht gesperrt, nicht in
-- der Base, nicht beim Fishing, ohne Mutation.
function Inventory.sellRarity(profile, ctx: Context.Context, rarityId: string): (number, number)
	if not RarityConfig.ById[rarityId] then
		return 0, 0
	end
	local count, total = 0, 0
	local uids = {}
	for uid, char in profile.Characters do
		local def = CharacterConfig.ById[char.Id]
		if def and def.Rarity == rarityId and not char.Locked and not char.Slot and not char.Fishing
			and char.Mutation == MutationConfig.None then
			table.insert(uids, uid)
		end
	end
	for _, uid in uids do
		local ok, value = Inventory.sell(profile, ctx, uid)
		if ok then
			count += 1
			total += value :: number
		end
	end
	return count, total
end

function Inventory.setLocked(profile, ctx: Context.Context, uid: string, locked: boolean): boolean
	local char = profile.Characters[uid]
	if not char then
		return false
	end
	char.Locked = locked
	Context.markChar(ctx, uid)
	return true
end

-- Steal/Raid-Vorbereitung (noch nicht ans Netz angeschlossen):
-- verschiebt einen Character zwischen zwei Profilen. Gear bleibt beim
-- ursprünglichen Besitzer. Gesperrte Characters können nicht verschoben werden.
function Inventory.transfer(fromProfile, fromCtx: Context.Context, toProfile, toCtx: Context.Context, uid: string): string?
	local char = fromProfile.Characters[uid]
	if not char or char.Locked then
		return nil
	end
	local id, mutation, level = char.Id, char.Mutation, char.Level
	Inventory.remove(fromProfile, fromCtx, uid)
	return Inventory.add(toProfile, toCtx, id, mutation, level)
end

return Inventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--!strict
-- Items (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Items
--
-- Potions (benutzen, Laufzeit), Gear (bekommen, ausrüsten, verkaufen) und
-- Relikte (verkaufen).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Modifiers = require(Logic:WaitForChild("Modifiers"))
local Economy = require(Logic:WaitForChild("Economy"))
local QuestTracker = require(Logic:WaitForChild("QuestTracker"))

local Items = {}

-- Potions ------------------------------------------------------------------------

function Items.addPotion(profile, ctx: Context.Context, id: string, amount: number)
	if not PotionConfig.Get(id) or amount <= 0 then
		return
	end
	profile.Potions[id] = (profile.Potions[id] or 0) + math.floor(amount)
	Context.mark(ctx, "Potions")
end

function Items.usePotion(profile, ctx: Context.Context, id: string): (boolean, string?)
	local def = PotionConfig.Get(id)
	if not def then
		return false, "Unknown potion"
	end
	local have = profile.Potions[id] or 0
	if have <= 0 then
		return false, "No potion left"
	end
	local remaining = profile.Boosts[id] or 0
	if remaining >= PotionConfig.MaxDuration - 1 then
		return false, "Already at max duration"
	end
	profile.Potions[id] = have - 1
	if profile.Potions[id] <= 0 then
		profile.Potions[id] = nil
	end
	profile.Boosts[id] = math.min(PotionConfig.MaxDuration, remaining + def.Duration)
	Context.mark(ctx, "Potions")
	Context.mark(ctx, "Boosts")
	QuestTracker.track(profile, ctx, "PotionsUsed", 1)
	return true, nil
end

-- Restzeit aller Boosts verringern (läuft nur online)
function Items.tickBoosts(profile, ctx: Context.Context, dt: number)
	local changed = false
	for id, remaining in profile.Boosts do
		local left = remaining - dt
		if left <= 0 then
			profile.Boosts[id] = nil
			Context.event(ctx, "BoostEnded", { Id = id })
		else
			profile.Boosts[id] = left
		end
		changed = true
	end
	if changed then
		Context.mark(ctx, "Boosts")
	end
end

-- Gear ---------------------------------------------------------------------------

function Items.gearCount(profile): number
	local n = 0
	for _ in profile.Gear do
		n += 1
	end
	return n
end

-- Gibt neue Gear-Uid zurück, oder nil + verkaufter Wert wenn Inventar voll
function Items.addGear(profile, ctx: Context.Context, id: string): (string?, number?)
	local def = GearConfig.Get(id)
	if not def then
		return nil, nil
	end
	profile.Stats.GearObtained += 1
	Context.mark(ctx, "Stats")
	if Items.gearCount(profile) >= GameConfig.GearInventoryCap then
		-- Gear-Inventar voll: halber Verkaufswert
		local value = Economy.scaledAmount(profile, def.SellValueSeconds * 0.5, 25)
		Economy.earn(profile, ctx, value, "GearOverflow")
		return nil, value
	end
	local uid = "g" .. profile.NextGearUid
	profile.NextGearUid += 1
	profile.Gear[uid] = { Id = id, On = nil }
	Context.markGear(ctx, uid)
	return uid, nil
end

function Items.unequipGear(profile, ctx: Context.Context, gearUid: string): boolean
	local item = profile.Gear[gearUid]
	if not item or not item.On then
		return false
	end
	local char = profile.Characters[item.On]
	if char then
		local index = table.find(char.Gear, gearUid)
		if index then
			table.remove(char.Gear, index)
		end
		Context.markChar(ctx, item.On)
	end
	item.On = nil
	Context.markGear(ctx, gearUid)
	Context.mark(ctx, "Derived")
	return true
end

function Items.equipGear(profile, ctx: Context.Context, gearUid: string, charUid: string, mods: Modifiers.Mods?): (boolean, string?)
	local item = profile.Gear[gearUid]
	if not item then
		return false, "Gear not found"
	end
	local char = profile.Characters[charUid]
	if not char then
		return false, "Character not found"
	end
	if item.On == charUid then
		return true, nil
	end
	local m = mods or Modifiers.compute(profile)
	if #char.Gear >= m.GearSlots then
		return false, "No free gear slot"
	end
	if item.On then
		Items.unequipGear(profile, ctx, gearUid)
	end
	table.insert(char.Gear, gearUid)
	item.On = charUid
	Context.markGear(ctx, gearUid)
	Context.markChar(ctx, charUid)
	Context.mark(ctx, "Derived")
	QuestTracker.track(profile, ctx, "GearEquips", 1)
	return true, nil
end

function Items.sellGear(profile, ctx: Context.Context, gearUid: string): (boolean, number | string)
	local item = profile.Gear[gearUid]
	if not item then
		return false, "Gear not found"
	end
	local def = GearConfig.Get(item.Id)
	if item.On then
		Items.unequipGear(profile, ctx, gearUid)
	end
	profile.Gear[gearUid] = nil
	Context.markGear(ctx, gearUid)
	local value = if def then Economy.scaledAmount(profile, def.SellValueSeconds, 50) else 0
	Economy.earn(profile, ctx, value, "SellGear")
	return true, value
end

-- Relikte ------------------------------------------------------------------------

function Items.addRelic(profile, ctx: Context.Context, id: string)
	if not FishingConfig.RelicById[id] then
		return
	end
	profile.Relics[id] = (profile.Relics[id] or 0) + 1
	Context.mark(ctx, "Relics")
end

function Items.sellRelic(profile, ctx: Context.Context, id: string): (boolean, number | string)
	local def = FishingConfig.RelicById[id]
	local have = profile.Relics[id] or 0
	if not def or have <= 0 then
		return false, "No relic"
	end
	profile.Relics[id] = if have > 1 then have - 1 else nil
	Context.mark(ctx, "Relics")
	local value = Economy.scaledAmount(profile, def.SellSeconds, 100)
	Economy.earn(profile, ctx, value, "SellRelic")
	return true, value
end

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Modifiers</string>
            <string name="Source"><![CDATA[--!strict
-- Modifiers (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Modifiers
--
-- Berechnet alle Multiplikatoren eines Spielers aus seinem Profil:
-- Luck, Cash, Roll Speed, Fishing, Slots. Ergebnis inkl. Aufschlüsselung,
-- damit die UI exakt anzeigen kann, woher die Werte kommen.
--
-- Luck = DiceLuck * (1 + Summe aller %-Boni) * (2 mit 2X LUCK Pass)
-- Cash = (1 + Summe aller %-Boni) * (2 mit 2X CASH Pass)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local RebirthConfig = require(Config:WaitForChild("RebirthConfig"))
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))

export type Mods = {
	Luck: number,
	LuckBreakdown: { { Label: string, Value: number, Kind: string } },
	CashMultiplier: number,
	CashBreakdown: { { Label: string, Value: number, Kind: string } },
	RollSpeed: number,
	RollCooldown: number,
	FishingLuck: number,
	FishingSpeed: number,
	MutationLuck: number,
	BaseSlots: number,
	FishingSlots: number,
	GearSlots: number,
	AutoCollect: boolean,
}

local Modifiers = {}

local rebirthCache: { [number]: any } = {}

local function accumulateRebirths(rebirths: number)
	local cached = rebirthCache[rebirths]
	if not cached then
		cached = RebirthConfig.Accumulate(rebirths)
		rebirthCache[rebirths] = cached
	end
	return cached
end

function Modifiers.boostTotals(profile): { [string]: number }
	local totals = { Luck = 0, Cash = 0, RollSpeed = 0, FishingLuck = 0, FishingSpeed = 0, MutationLuck = 0 }
	for potionId, remaining in profile.Boosts do
		local def = PotionConfig.Get(potionId)
		if def and remaining > 0 then
			totals[def.Effect] = (totals[def.Effect] or 0) + def.Amount
		end
	end
	return totals
end

-- Summe der globalen Gear-Luck aller Characters, die in der Base stehen
function Modifiers.gearLuckPct(profile): number
	local total = 0
	for _, char in profile.Characters do
		if char.Slot then
			for _, gearUid in char.Gear do
				local item = profile.Gear[gearUid]
				local def = item and GearConfig.Get(item.Id)
				if def and def.LuckPct then
					total += def.LuckPct
				end
			end
		end
	end
	return math.min(total, EconomyConfig.MaxGearLuckPct)
end

function Modifiers.discovered(profile): number
	local n = 0
	for _ in profile.Index do
		n += 1
	end
	return n
end

function Modifiers.compute(profile): Mods
	local passes = profile.Passes
	local rebirth = accumulateRebirths(profile.Rebirths)
	local dice = DiceConfig.Get(profile.Dice.Equipped) or DiceConfig.Get(DiceConfig.Default)
	assert(dice, "Default-Dice fehlt")
	local boosts = Modifiers.boostTotals(profile)
	local effects = MonetizationConfig.PassEffects

	-- Luck --------------------------------------------------------------------
	local luckBreakdown = {}
	table.insert(luckBreakdown, { Label = dice.DisplayName, Value = dice.Luck, Kind = "x" })
	local luckPct = 0
	local function addLuck(label: string, pct: number)
		if pct ~= 0 then
			luckPct += pct
			table.insert(luckBreakdown, { Label = label, Value = pct, Kind = "%" })
		end
	end
	addLuck("Rebirths", rebirth.LuckPct)
	addLuck("Potions", boosts.Luck * 100)
	addLuck("Gear", Modifiers.gearLuckPct(profile))
	addLuck("Index", math.min(25, Modifiers.discovered(profile) * EconomyConfig.IndexLuckPctPerDiscovery))
	if passes.VIP then
		addLuck("VIP", effects.VIP.LuckPct)
	end
	local luck = dice.Luck * (1 + luckPct / 100)
	if passes.DoubleLuck then
		luck *= effects.DoubleLuck.LuckMultiplier
		table.insert(luckBreakdown, { Label = "2X LUCK", Value = effects.DoubleLuck.LuckMultiplier, Kind = "x" })
	end
	luck = math.clamp(luck, 1, EconomyConfig.MaxLuck)

	-- Cash --------------------------------------------------------------------
	local cashBreakdown = {}
	local cashPct = 0
	local function addCash(label: string, pct: number)
		if pct ~= 0 then
			cashPct += pct
			table.insert(cashBreakdown, { Label = label, Value = pct, Kind = "%" })
		end
	end
	addCash("Rebirths", rebirth.CashPct)
	addCash("Potions", boosts.Cash * 100)
	if passes.VIP then
		addCash("VIP", effects.VIP.CashPct)
	end
	local cash = 1 + cashPct / 100
	if passes.DoubleCash then
		cash *= effects.DoubleCash.CashMultiplier
		table.insert(cashBreakdown, { Label = "2X CASH", Value = effects.DoubleCash.CashMultiplier, Kind = "x" })
	end
	cash = math.min(cash, EconomyConfig.MaxCashMultiplier)

	-- Roll Speed ----------------------------------------------------------------
	local speedPct = boosts.RollSpeed * 100
	if passes.FastRoll then
		speedPct += effects.FastRoll.RollSpeedPct
	end
	local rollSpeed = dice.RollSpeed * (1 + speedPct / 100)
	local cooldown = math.max(GameConfig.MinRollCooldown, GameConfig.RollCooldown / rollSpeed)

	-- Slots -------------------------------------------------------------------------
	local baseSlots = GameConfig.StartBaseSlots + rebirth.BaseSlots
	if passes.ExtraSlots then
		baseSlots += effects.ExtraSlots.BaseSlots
	end

	return {
		Luck = luck,
		LuckBreakdown = luckBreakdown,
		CashMultiplier = cash,
		CashBreakdown = cashBreakdown,
		RollSpeed = rollSpeed,
		RollCooldown = cooldown,
		FishingLuck = 1 + boosts.FishingLuck,
		FishingSpeed = 1 + boosts.FishingSpeed,
		MutationLuck = 1 + boosts.MutationLuck,
		BaseSlots = math.min(GameConfig.MaxBaseSlots, baseSlots),
		FishingSlots = math.min(GameConfig.MaxFishingSlots, GameConfig.StartFishingSlots + rebirth.FishingSlots),
		GearSlots = math.min(GameConfig.MaxGearSlots, GameConfig.StartGearSlots + rebirth.GearSlots),
		AutoCollect = rebirth.AutoCollect,
	}
end

return Modifiers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ProfileTemplate</string>
            <string name="Source"><![CDATA[--!strict
-- ProfileTemplate (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > ProfileTemplate
--
-- Aufbau eines gespeicherten Spielerprofils. Neue Felder einfach hier
-- ergänzen: reconcile() füllt sie bei bestehenden Profilen automatisch auf.
--
-- Wichtig für den DataStore: nur Strings als Tabellen-Keys in Maps
-- (Characters "c12", Gear "g7"), keine gemischten Arrays.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local SeasonConfig = require(Config:WaitForChild("SeasonConfig"))

local ProfileTemplate = {}

ProfileTemplate.Version = 1

local function defaults()
	local cosmeticsOwned = {}
	local equipped = {}
	for kind, id in CosmeticConfig.Defaults do
		cosmeticsOwned[id] = true
		equipped[kind] = id
	end

	return {
		Version = ProfileTemplate.Version,
		Cash = 0,
		Vault = 0,
		Rebirths = 0,

		-- [uid] = { Id, Level, Mutation, Slot?, Fishing?, FishProgress, Gear = {gearUid}, Locked, At }
		Characters = {},
		NextCharUid = 1,
		-- [uid] = { Id, On = charUid? }
		Gear = {},
		NextGearUid = 1,

		Potions = {},
		Boosts = {}, -- [potionId] = Restsekunden
		Relics = {},

		-- [characterId] = { N = Anzahl jemals gerollt, M = { [mutation] = true } }
		Index = {},

		Dice = { Owned = { [DiceConfig.Default] = true }, Equipped = DiceConfig.Default },
		Areas = { [AreaConfig.StartArea] = true },
		FishingWaters = FishingConfig.DefaultWaters,

		Settings = {
			AutoPlace = GameConfig.DefaultAutoPlace,
			AutoDelete = {},
			Music = true,
			SFX = true,
			ReducedEffects = false,
			ShowOthersReveals = true,
		},

		Quests = { Day = -1, List = {}, FirstDay = true },
		Achievements = {},
		Season = { Id = SeasonConfig.Id, Xp = 0, Free = {}, Premium = {} },
		Cosmetics = { Owned = cosmeticsOwned, Equipped = equipped },

		Passes = {},
		Purchases = {}, -- verarbeitete Receipt-Ids (Ringpuffer)

		Tutorial = { Step = 1, Done = false, Rewarded = false },

		Stats = {
			TotalRolls = 0,
			TotalCharactersRolled = 0,
			BestRarity = "",
			BestRarityOrder = 0,
			RarestRoll = 0, -- größtes "1 in X" (Basis-Chance), das je gerollt wurde
			TotalCashEarned = 0,
			CashSpent = 0,
			Rebirths = 0,
			FishingCatches = 0,
			GearObtained = 0,
			CharactersDiscovered = 0,
			Playtime = 0,
			HighestCharacterLevel = 1,
			Upgrades = 0,
			Mutations = 0,
			Sold = 0,
		},

		FirstJoin = 0,
		LastJoin = 0,
	}
end

function ProfileTemplate.new()
	return defaults()
end

-- Fehlende Felder (rekursiv) aus dem Template ergänzen. Bestehende Werte
-- bleiben unangetastet. Maps mit dynamischen Keys werden nicht angefasst.
local DYNAMIC_MAPS = {
	Characters = true,
	Gear = true,
	Potions = true,
	Boosts = true,
	Relics = true,
	Index = true,
	Achievements = true,
	Passes = true,
	Purchases = true,
	AutoDelete = true,
	Owned = true,
	List = true,
	Free = true,
	Premium = true,
	Equipped = false,
}

local function fill(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(target[key]) == "table" and not DYNAMIC_MAPS[key] then
			fill(target[key], value)
		end
	end
end

function ProfileTemplate.reconcile(profile: { [string]: any })
	fill(profile, defaults())
	-- Defaults bei Cosmetics immer besitzen
	for kind, id in CosmeticConfig.Defaults do
		profile.Cosmetics.Owned[id] = true
		if profile.Cosmetics.Equipped[kind] == nil then
			profile.Cosmetics.Equipped[kind] = id
		end
	end
	profile.Dice.Owned[DiceConfig.Default] = true
	profile.Areas[AreaConfig.StartArea] = true
	if not DiceConfig.Get(profile.Dice.Equipped) or not profile.Dice.Owned[profile.Dice.Equipped] then
		profile.Dice.Equipped = DiceConfig.Default
	end
	if not FishingConfig.WatersById[profile.FishingWaters] then
		profile.FishingWaters = FishingConfig.DefaultWaters
	end
	return profile
end

return ProfileTemplate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- Progression (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Progression
--
-- Rebirth, Dice kaufen/ausrüsten und Gebiete freischalten.
--
-- Rebirth setzt NUR Cash-Progression zurück (Cash, Vault, Character-Level).
-- Characters, Gear, Potions, Dice, Gebiete, Index, Cosmetics, Käufe bleiben.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local RebirthConfig = require(Config:WaitForChild("RebirthConfig"))
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Economy = require(Logic:WaitForChild("Economy"))
local Cosmetics = require(Logic:WaitForChild("Cosmetics"))
local QuestTracker = require(Logic:WaitForChild("QuestTracker"))

local Progression = {}

-- Rebirth --------------------------------------------------------------------------

function Progression.rebirthCost(profile): number
	return RebirthConfig.GetStep(profile.Rebirths + 1).Cost
end

function Progression.canRebirth(profile): boolean
	return profile.Cash >= Progression.rebirthCost(profile)
end

function Progression.rebirth(profile, ctx: Context.Context): (boolean, string?)
	local cost = Progression.rebirthCost(profile)
	if profile.Cash < cost then
		return false, "Not enough cash"
	end
	local nextRebirth = profile.Rebirths + 1
	local step = RebirthConfig.GetStep(nextRebirth)

	profile.Stats.CashSpent += profile.Cash
	profile.Cash = 0
	profile.Vault = 0
	for uid, char in profile.Characters do
		if char.Level ~= 1 then
			char.Level = 1
			Context.markChar(ctx, uid)
		end
	end
	profile.Rebirths = nextRebirth
	profile.Stats.Rebirths = nextRebirth

	if step.Rewards.Title then
		Cosmetics.grant(profile, ctx, step.Rewards.Title)
	end

	Context.mark(ctx, "Cash")
	Context.mark(ctx, "Vault")
	Context.mark(ctx, "Rebirths")
	Context.mark(ctx, "Stats")
	Context.mark(ctx, "Base")
	QuestTracker.track(profile, ctx, "Rebirths", 1)
	Context.event(ctx, "Rebirth", { Rebirths = nextRebirth, Rewards = step.Rewards })
	return true, nil
end

-- Dice -----------------------------------------------------------------------------

function Progression.buyDice(profile, ctx: Context.Context, diceId: string): (boolean, string?)
	local def = DiceConfig.Get(diceId)
	if not def then
		return false, "Unknown dice"
	end
	if profile.Dice.Owned[diceId] then
		return false, "Already owned"
	end
	if not profile.Areas[def.Area] then
		local area = AreaConfig.Get(def.Area)
		return false, "Unlock " .. (if area then area.DisplayName else def.Area) .. " first"
	end
	if not Economy.spend(profile, ctx, def.Cost) then
		return false, "Not enough cash"
	end
	profile.Dice.Owned[diceId] = true
	profile.Dice.Equipped = diceId
	Context.mark(ctx, "Dice")
	Context.event(ctx, "DiceUnlocked", { Id = diceId })
	return true, nil
end

function Progression.equipDice(profile, ctx: Context.Context, diceId: string): (boolean, string?)
	if not DiceConfig.Get(diceId) or not profile.Dice.Owned[diceId] then
		return false, "Dice not owned"
	end
	profile.Dice.Equipped = diceId
	Context.mark(ctx, "Dice")
	return true, nil
end

-- Gebiete --------------------------------------------------------------------------

function Progression.canUnlockArea(profile, areaId: string): (boolean, string?)
	local def = AreaConfig.Get(areaId)
	if not def then
		return false, "Unknown area"
	end
	if profile.Areas[areaId] then
		return false, "Already unlocked"
	end
	for _, other in AreaConfig.List do
		if other.Order == def.Order - 1 and not profile.Areas[other.Id] then
			return false, "Unlock " .. other.DisplayName .. " first"
		end
	end
	if profile.Rebirths < def.RequiredRebirths then
		return false, "Requires Rebirth " .. def.RequiredRebirths
	end
	if profile.Cash < def.UnlockCost then
		return false, "Not enough cash"
	end
	return true, nil
end

function Progression.unlockArea(profile, ctx: Context.Context, areaId: string): (boolean, string?)
	local ok, err = Progression.canUnlockArea(profile, areaId)
	if not ok then
		return false, err
	end
	local def = AreaConfig.Get(areaId) :: AreaConfig.AreaDef
	if not Economy.spend(profile, ctx, def.UnlockCost) then
		return false, "Not enough cash"
	end
	profile.Areas[areaId] = true
	Context.mark(ctx, "Areas")
	Context.event(ctx, "AreaUnlocked", { Id = areaId })
	return true, nil
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">QuestTracker</string>
            <string name="Source"><![CDATA[--!strict
-- QuestTracker (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > QuestTracker
--
-- Zählt Fortschritt der Daily Quests und würfelt jeden Tag neue.
-- Getrennt von Quests (Belohnungen), damit alle anderen Module Fortschritt
-- melden können, ohne zyklische requires.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local QuestConfig = require(Config:WaitForChild("QuestConfig"))

local Context = require(script.Parent:WaitForChild("Context"))

local QuestTracker = {}

local DAY = 86400

function QuestTracker.dayOf(now: number): number
	return math.floor(now / DAY)
end

-- Deterministische Auswahl: gleicher Spieler + gleicher Tag = gleiche Quests
local function pickQuests(userId: number, day: number): { string }
	local rng = Random.new((userId % 1000003) * 7919 + day * 104729 + 17)
	local pool = table.clone(QuestConfig.Pool)
	local picked = {}
	local usedCounters = {}
	while #picked < QuestConfig.DailyCount and #pool > 0 do
		local total = 0
		for _, q in pool do
			total += q.Weight
		end
		local r = rng:NextNumber() * total
		local chosenIndex = #pool
		for i, q in pool do
			r -= q.Weight
			if r <= 0 then
				chosenIndex = i
				break
			end
		end
		local q = table.remove(pool, chosenIndex) :: any
		-- höchstens zwei Quests mit demselben Zähler
		usedCounters[q.Counter] = (usedCounters[q.Counter] or 0) + 1
		if usedCounters[q.Counter] <= 2 then
			table.insert(picked, q.Id)
		end
	end
	return picked
end

function QuestTracker.ensureDaily(profile, ctx: Context.Context)
	local day = QuestTracker.dayOf(ctx.now)
	local quests = profile.Quests
	if quests.Day == day then
		return
	end
	local ids
	if quests.FirstDay then
		ids = table.clone(QuestConfig.FirstDayQuests)
		quests.FirstDay = false
	else
		ids = pickQuests(ctx.userId, day)
	end
	local list = {}
	for _, id in ids do
		if QuestConfig.ById[id] then
			table.insert(list, { Id = id, Progress = 0, Claimed = false })
		end
	end
	quests.Day = day
	quests.List = list
	Context.mark(ctx, "Quests")
end

function QuestTracker.track(profile, ctx: Context.Context, counter: string, amount: number)
	if amount <= 0 then
		return
	end
	for _, entry in profile.Quests.List do
		local def = QuestConfig.ById[entry.Id]
		if def and def.Counter == counter and entry.Progress < def.Target then
			entry.Progress = math.min(def.Target, entry.Progress + amount)
			Context.mark(ctx, "Quests")
			if entry.Progress >= def.Target then
				Context.event(ctx, "QuestComplete", { Id = def.Id, Text = def.Text })
			end
		end
	end
end

return QuestTracker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Rewards (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Rewards
--
-- Einheitliches Ausschütten von Belohnungen (Quests, Achievements, Season,
-- Produkte). Format:
--   { CashSeconds = n, Cash = n, Potions = { Id = n }, Gear = "Id",
--     Cosmetic = "Id", SeasonXp = n }

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SeasonConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("SeasonConfig"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Economy = require(Logic:WaitForChild("Economy"))
local Items = require(Logic:WaitForChild("Items"))
local Cosmetics = require(Logic:WaitForChild("Cosmetics"))

local Rewards = {}

Rewards.MinCashReward = 100

function Rewards.grant(profile, ctx: Context.Context, rewards: { [string]: any }): { [string]: any }
	local granted = {}
	if rewards.CashSeconds and rewards.CashSeconds > 0 then
		local amount = Economy.scaledAmount(profile, rewards.CashSeconds, Rewards.MinCashReward)
		Economy.earn(profile, ctx, amount, "Reward")
		granted.Cash = amount
	end
	if rewards.Cash and rewards.Cash > 0 then
		Economy.earn(profile, ctx, rewards.Cash, "Reward")
		granted.Cash = (granted.Cash or 0) + rewards.Cash
	end
	if rewards.Potions then
		for id, amount in rewards.Potions do
			Items.addPotion(profile, ctx, id, amount)
		end
		granted.Potions = rewards.Potions
	end
	if rewards.Gear then
		Items.addGear(profile, ctx, rewards.Gear)
		granted.Gear = rewards.Gear
	end
	if rewards.Cosmetic then
		Cosmetics.grant(profile, ctx, rewards.Cosmetic)
		granted.Cosmetic = rewards.Cosmetic
	end
	if rewards.SeasonXp and rewards.SeasonXp > 0 and SeasonConfig.Enabled then
		profile.Season.Xp += rewards.SeasonXp
		Context.mark(ctx, "Season")
		granted.SeasonXp = rewards.SeasonXp
	end
	return granted
end

-- Season-Tier-Belohnung ({ Kind = ... }) in das obige Format übersetzen
function Rewards.fromSeasonReward(reward: { [string]: any }): { [string]: any }
	if reward.Kind == "Cash" then
		return { CashSeconds = reward.Seconds }
	elseif reward.Kind == "Potion" then
		return { Potions = { [reward.Id] = reward.Amount or 1 } }
	elseif reward.Kind == "Cosmetic" then
		return { Cosmetic = reward.Id }
	elseif reward.Kind == "Gear" then
		return { Gear = reward.Id }
	end
	return {}
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Rolling</string>
            <string name="Source"><![CDATA[--!strict
-- Rolling (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Rolling
--
-- Ein Roll: Character ziehen (RollMath + Luck), Mutation ziehen, Index/Stats/
-- Quests aktualisieren, dann behalten, auto-verkaufen oder auto-platzieren.
-- Der Client erfährt das Ergebnis erst NACHDEM es hier feststeht.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local Util = Shared:WaitForChild("Util")
local RollMath = require(Util:WaitForChild("RollMath"))
local Odds = require(Util:WaitForChild("Odds"))
local Stats = require(Util:WaitForChild("Stats"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Modifiers = require(Logic:WaitForChild("Modifiers"))
local Economy = require(Logic:WaitForChild("Economy"))
local Inventory = require(Logic:WaitForChild("Inventory"))
local QuestTracker = require(Logic:WaitForChild("QuestTracker"))

export type RollResult = {
	Id: string,
	Rarity: string,
	Mutation: string,
	Uid: string?,
	IsNew: boolean,
	Probability: number, -- echte Wahrscheinlichkeit bei der aktuellen Luck
	BaseChance: number, -- "1 in X" aus der Config (Luck 1)
	SoldFor: number?, -- gesetzt, wenn automatisch verkauft
	SoldReason: string?,
	ReplacedValue: number?, -- Inventar voll: schwächster freier Character wurde dafür verkauft
	Placed: boolean,
	Luck: number,
}

local Rolling = {}

-- Höchste Rarity, die per Auto Delete gelöscht werden darf (Schutz vor Fehlklicks)
Rolling.MaxAutoDeleteOrder = RarityConfig.Order("Epic")

local function rollMutation(ctx: Context.Context, mods: Modifiers.Mods): (string, number)
	local entries = {}
	for _, m in MutationConfig.List do
		if m.Id ~= MutationConfig.None then
			local luck = mods.MutationLuck * (1 + (mods.Luck - 1) * m.LuckScaling)
			table.insert(entries, { Key = m.Id, Chance = m.Chance, Luck = luck })
		end
	end
	local id, p = RollMath.pickIndependent(entries, MutationConfig.None, ctx.rng:NextNumber())
	return id, p
end

function Rolling.roll(profile, ctx: Context.Context, mods: Modifiers.Mods?): RollResult
	local m = mods or Modifiers.compute(profile)
	local tbl = Odds.characterTable()
	local entry, _, probability = RollMath.pick(tbl, m.Luck, ctx.rng:NextNumber())
	local def = CharacterConfig.ById[entry.Key]
	local rarity = RarityConfig.Get(def.Rarity)
	local mutation = rollMutation(ctx, m)

	local stats = profile.Stats
	stats.TotalRolls += 1
	if rarity.Order > stats.BestRarityOrder then
		stats.BestRarityOrder = rarity.Order
		stats.BestRarity = rarity.Id
	end
	if def.RollChance > stats.RarestRoll and rarity.LuckAffected then
		stats.RarestRoll = def.RollChance
	end
	if mutation ~= MutationConfig.None then
		stats.Mutations += 1
		QuestTracker.track(profile, ctx, "Mutations", 1)
	end
	Context.mark(ctx, "Stats")

	-- Index
	local indexEntry = profile.Index[def.Id]
	local isNew = indexEntry == nil
	if isNew then
		indexEntry = { N = 0, M = {} }
		profile.Index[def.Id] = indexEntry
		stats.CharactersDiscovered += 1
	end
	indexEntry.N += 1
	indexEntry.M[mutation] = true
	Context.mark(ctx, "Index")

	-- Quests
	QuestTracker.track(profile, ctx, "Rolls", 1)
	if rarity.Order >= RarityConfig.Order("Rare") then
		QuestTracker.track(profile, ctx, "RareRolls", 1)
	end
	if rarity.Order >= RarityConfig.Order("Epic") then
		QuestTracker.track(profile, ctx, "EpicRolls", 1)
	end

	local result: RollResult = {
		Id = def.Id,
		Rarity = rarity.Id,
		Mutation = mutation,
		Uid = nil,
		IsNew = isNew,
		Probability = probability,
		BaseChance = def.RollChance,
		SoldFor = nil,
		SoldReason = nil,
		ReplacedValue = nil,
		Placed = false,
		Luck = m.Luck,
	}

	-- Behalten oder automatisch verkaufen?
	local count = Inventory.count(profile)
	local keepOverCap = isNew
		or mutation ~= MutationConfig.None
		or rarity.Order >= RarityConfig.Order(GameConfig.KeepRarityOverCap)
	local autoDelete = profile.Settings.AutoDelete[rarity.Id] == true
		and rarity.Order <= Rolling.MaxAutoDeleteOrder
		and not isNew
		and mutation == MutationConfig.None

	-- Bei vollem Inventar: den wertlosesten freien Character ersetzen, wenn der
	-- neue mehr wert ist. Sonst den neuen verkaufen (außer er ist besonders).
	local sellReason: string? = nil
	if autoDelete then
		sellReason = "AutoDelete"
	elseif count >= GameConfig.InventorySoftCap then
		local worstUid, worstValue = Inventory.worstSellable(profile)
		if worstUid and worstValue <= Stats.sellValue(def, 1, mutation) then
			local ok, value = Inventory.sell(profile, ctx, worstUid)
			if ok then
				result.ReplacedValue = value :: number
			end
		elseif not keepOverCap or count >= GameConfig.InventoryHardCap then
			sellReason = "InventoryFull"
		end
	end

	if sellReason then
		local value = Stats.sellValue(def, 1, mutation)
		Economy.earn(profile, ctx, value, "AutoSell")
		stats.Sold += 1
		result.SoldFor = value
		result.SoldReason = sellReason
	else
		stats.TotalCharactersRolled += 1
		local uid = Inventory.add(profile, ctx, def.Id, mutation)
		result.Uid = uid
		if profile.Settings.AutoPlace then
			result.Placed = Inventory.autoPlace(profile, ctx, uid, m)
		end
	end

	return result
end

return Rolling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--!strict
-- Upgrades (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Logic > Upgrades
--
-- Character-Level 1–15. Kosten kommen aus Util > Stats (EconomyConfig),
-- der Server berechnet sie immer selbst.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local CharacterConfig = require(Shared:WaitForChild("Config"):WaitForChild("CharacterConfig"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))

local Logic = script.Parent
local Context = require(Logic:WaitForChild("Context"))
local Economy = require(Logic:WaitForChild("Economy"))
local QuestTracker = require(Logic:WaitForChild("QuestTracker"))

local Upgrades = {}

Upgrades.MaxPerRequest = 15

function Upgrades.cost(profile, uid: string): number?
	local char = profile.Characters[uid]
	local def = char and CharacterConfig.ById[char.Id]
	if not def then
		return nil
	end
	return Stats.upgradeCost(def, char.Level, char.Mutation)
end

-- Upgradet bis zu `times` Mal (solange Cash reicht). Gibt neue Level-Anzahl zurück.
function Upgrades.upgrade(profile, ctx: Context.Context, uid: string, times: number?): (boolean, string | number)
	local char = profile.Characters[uid]
	if not char then
		return false, "Character not found"
	end
	local def = CharacterConfig.ById[char.Id]
	if not def then
		return false, "Unknown character"
	end
	local wanted = math.clamp(math.floor(times or 1), 1, Upgrades.MaxPerRequest)
	local done = 0
	for _ = 1, wanted do
		local cost = Stats.upgradeCost(def, char.Level, char.Mutation)
		if not cost then
			break
		end
		if not Economy.spend(profile, ctx, cost) then
			break
		end
		char.Level += 1
		done += 1
	end
	if done == 0 then
		if char.Level >= def.MaxLevel then
			return false, "Already max level"
		end
		return false, "Not enough cash"
	end
	local stats = profile.Stats
	stats.Upgrades += done
	if char.Level > stats.HighestCharacterLevel then
		stats.HighestCharacterLevel = char.Level
	end
	Context.markChar(ctx, uid)
	Context.mark(ctx, "Stats")
	QuestTracker.track(profile, ctx, "Upgrades", done)
	if char.Level >= def.MaxLevel then
		Context.event(ctx, "MaxLevel", { Uid = uid, Id = char.Id })
	end
	return true, done
end

return Upgrades
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">AnnouncementService</string>
            <string name="Source"><![CDATA[--!strict
-- AnnouncementService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > AnnouncementService
--
-- "Clipbare Momente" für alle sichtbar machen:
--   * Rolls ab Mythic -> Server-Ansage
--   * Secret / Anomaly -> Server-Ansage + Cross-Server (MessagingService)
--   * Double Secret (zweites Secret+ in einer Session)
--   * seltene Mutationen (Golden, Void)
--   * riesige Fishing-Drops (Legendary+)
--   * Max-Level Character
--
-- Client zeigt: "PlayerName rolled THE ENDLESS! 1 in 2,500,000"

local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))

local Services = script.Parent
local SessionService = require(Services:WaitForChild("SessionService"))

local AnnouncementService = {}

local TOPIC = "VoidDice_Announce_v1"
local JOB_ID = game.JobId
local crossServerReady = false

local function broadcast(data: { [string]: any }, global: boolean)
	SessionService.fireAll("Announcement", data)
	if global and GameConfig.CrossServerAnnouncements and crossServerReady then
		data.JobId = JOB_ID
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(TOPIC, data)
			end)
		end)
	end
end

function AnnouncementService.onRoll(session, result)
	local rarity = RarityConfig.Get(result.Rarity)
	local mutation = MutationConfig.Get(result.Mutation)
	local def = CharacterConfig.ById[result.Id]
	local shouldAnnounce = rarity.Announce ~= "None" or mutation.Announce
	if not shouldAnnounce then
		return
	end
	local double = rarity.Order >= RarityConfig.Order("Secret") and session.SecretRolls >= 2
	broadcast({
		Kind = "Roll",
		Player = session.Player.DisplayName,
		UserId = session.UserId,
		Id = result.Id,
		Name = def and def.DisplayName or result.Id,
		Rarity = result.Rarity,
		Mutation = result.Mutation,
		BaseChance = result.BaseChance,
		Double = double,
	}, rarity.Announce == "Global")
end

function AnnouncementService.onCatch(session, catch)
	if not FishingConfig.AnnounceRarities[catch.Rarity] then
		return
	end
	broadcast({
		Kind = "Catch",
		Player = session.Player.DisplayName,
		UserId = session.UserId,
		LootKind = catch.Kind,
		Id = catch.Id,
		Rarity = catch.Rarity,
		Probability = catch.Probability,
	}, false)
end

function AnnouncementService.onMaxLevel(session, characterId: string)
	local def = CharacterConfig.ById[characterId]
	if not def or RarityConfig.Order(def.Rarity) < RarityConfig.Order("Epic") then
		return
	end
	broadcast({
		Kind = "MaxLevel",
		Player = session.Player.DisplayName,
		UserId = session.UserId,
		Id = characterId,
		Name = def.DisplayName,
		Rarity = def.Rarity,
	}, false)
end

function AnnouncementService.Start()
	-- Fishing/MaxLevel-Events aus den Logic-Contexts mitlesen
	SessionService.onFlush(function(session, ctx)
		for _, event in ctx.events do
			if event.Kind == "Catch" then
				AnnouncementService.onCatch(session, event.Data)
			elseif event.Kind == "MaxLevel" then
				AnnouncementService.onMaxLevel(session, event.Data.Id)
			end
		end
	end)

	if GameConfig.CrossServerAnnouncements then
		task.spawn(function()
			local ok, err = pcall(function()
				MessagingService:SubscribeAsync(TOPIC, function(message)
					local data = message.Data
					if type(data) == "table" and data.JobId ~= JOB_ID then
						data.CrossServer = true
						SessionService.fireAll("Announcement", data)
					end
				end)
			end)
			crossServerReady = ok
			if not ok then
				warn("[AnnouncementService] MessagingService nicht verfügbar (in Studio normal):", err)
			end
		end)
	end
end

return AnnouncementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">AntiCheatService</string>
            <string name="Source"><![CDATA[--!strict
-- AntiCheatService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > AntiCheatService
--
-- Grundlage gegen Exploits:
--   * Rate Limits pro Spieler und Action-Kategorie (Token Bucket)
--   * Typprüfung aller Remote-Argumente (Net.Actions)
--   * Cash-Sanity nach jeder Aktion (NaN/inf/negativ -> zurücksetzen)
--   * Verdachtszähler: bei massivem Spam wird der Spieler gekickt
--
-- Wichtig: Spielentscheidungen (Roll-Ergebnis, Kosten, Drops) trifft ohnehin
-- nur der Server. Der Client kann höchstens zu oft fragen – das fängt das
-- Rate Limit ab.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Net = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Net"))

local AntiCheatService = {}

-- Kategorie pro Action (Standard: "Default")
local CATEGORY = {
	Roll = "Roll",
	Rebirth = "Heavy",
	BuyDice = "Heavy",
	UnlockArea = "Heavy",
	Teleport = "Heavy",
	SellRarity = "Heavy",
	PlaceBest = "Heavy",
	InspectBase = "Heavy",
	TestPurchase = "Heavy",
	Debug = "Heavy",
	SetSetting = "Settings",
	SetAutoDelete = "Settings",
	SetAutoRoll = "Settings",
}

-- Rate = Tokens pro Sekunde, Burst = maximale Tokens
local LIMITS = {
	Default = { Rate = 10, Burst = 25 },
	Roll = { Rate = 6, Burst = 10 },
	Heavy = { Rate = 2, Burst = 5 },
	Settings = { Rate = 4, Burst = 12 },
}

local STRIKE_WINDOW = 60
local STRIKES_TO_KICK = 300
local MAX_ARGS = 4

type Bucket = { tokens: number, last: number }
type PlayerState = { buckets: { [string]: Bucket }, strikes: number, windowStart: number, flags: { string } }

local states: { [Player]: PlayerState } = {}

local function getState(player: Player): PlayerState
	local s = states[player]
	if not s then
		s = { buckets = {}, strikes = 0, windowStart = os.clock(), flags = {} }
		states[player] = s
	end
	return s
end

function AntiCheatService.flag(player: Player, reason: string)
	local s = getState(player)
	if #s.flags < 50 then
		table.insert(s.flags, string.format("%.0f %s", os.time(), reason))
	end
	warn(string.format("[AntiCheat] %s (%d): %s", player.Name, player.UserId, reason))
end

local function strike(player: Player, reason: string)
	local s = getState(player)
	local now = os.clock()
	if now - s.windowStart > STRIKE_WINDOW then
		s.windowStart = now
		s.strikes = 0
	end
	s.strikes += 1
	if s.strikes == 1 or s.strikes % 50 == 0 then
		AntiCheatService.flag(player, reason .. " (x" .. s.strikes .. ")")
	end
	if s.strikes >= STRIKES_TO_KICK then
		player:Kick("Too many requests. Please rejoin.")
	end
end

-- true = Aktion darf ausgeführt werden
function AntiCheatService.allow(player: Player, action: string): boolean
	local category = CATEGORY[action] or "Default"
	local limit = LIMITS[category]
	local s = getState(player)
	local now = os.clock()
	local bucket = s.buckets[category]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		s.buckets[category] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.Rate)
	bucket.last = now
	if bucket.tokens < 1 then
		strike(player, "rate limit " .. action)
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArg(kind: string, value: any): boolean
	if kind == "string" then
		return type(value) == "string" and #value <= 64
	elseif kind == "id" then
		return type(value) == "string" and #value > 0 and #value <= 48 and value:match("^[%w_]+$") ~= nil
	elseif kind == "uid" then
		return type(value) == "string" and #value <= 12 and value:match("^[cg]%d+$") ~= nil
	elseif kind == "number" then
		return type(value) == "number" and value == value and math.abs(value) < 1e9
	elseif kind == "boolean" then
		return type(value) == "boolean"
	elseif kind == "any" then
		local t = type(value)
		return t == "boolean" or (t == "number" and value == value and math.abs(value) < 1e15) or (t == "string" and #value <= 64) or t == "nil"
	end
	return false
end

-- Prüft Action-Name und Argumente gegen Net.Actions.
function AntiCheatService.validate(player: Player, action: any, args: { any }): boolean
	if type(action) ~= "string" then
		strike(player, "action not a string")
		return false
	end
	local spec = Net.Actions[action]
	if not spec then
		strike(player, "unknown action " .. action:sub(1, 24))
		return false
	end
	if #args > MAX_ARGS then
		strike(player, "too many args " .. action)
		return false
	end
	for i, kind in spec do
		local value = args[i]
		-- "number" bei Upgrade darf fehlen
		if not (value == nil and (kind == "number" or kind == "any")) and not validArg(kind, value) then
			strike(player, "bad arg " .. i .. " for " .. action)
			return false
		end
	end
	return true
end

-- Nach jeder Aktion: Cash/Vault dürfen nie NaN, inf oder negativ sein.
function AntiCheatService.sanitize(player: Player, profile, lastGood: { Cash: number, Vault: number })
	local function bad(n: any): boolean
		return type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge or n < 0
	end
	if bad(profile.Cash) then
		AntiCheatService.flag(player, "invalid Cash " .. tostring(profile.Cash) .. ", reverted")
		profile.Cash = lastGood.Cash
	end
	if bad(profile.Vault) then
		AntiCheatService.flag(player, "invalid Vault " .. tostring(profile.Vault) .. ", reverted")
		profile.Vault = lastGood.Vault
	end
	lastGood.Cash = profile.Cash
	lastGood.Vault = profile.Vault
end

function AntiCheatService.getFlags(player: Player): { string }
	return getState(player).flags
end

function AntiCheatService.Start()
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return AntiCheatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">AvatarService</string>
            <string name="Source"><![CDATA[--!strict
-- AvatarService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > AvatarService
--
-- Overhead-Schild über dem Spieler (Titel, Name, VIP, Rebirth) sowie
-- Aura und Trail aus den ausgerüsteten Cosmetics. Für alle sichtbar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local UIConfig = require(Config:WaitForChild("UIConfig"))

local SessionService = require(script.Parent:WaitForChild("SessionService"))

local AvatarService = {}

local function clearOld(character: Model)
	for _, name in { "VD_Nameplate", "VD_Aura", "VD_Trail", "VD_TrailA0", "VD_TrailA1" } do
		local existing = character:FindFirstChild(name, true)
		while existing do
			existing:Destroy()
			existing = character:FindFirstChild(name, true)
		end
	end
end

function AvatarService.apply(session)
	local character = session.Player.Character
	if not character then
		return
	end
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not head or not root then
		return
	end
	clearOld(character)
	local profile = session.Profile
	local equipped = profile.Cosmetics.Equipped

	-- Nameplate -------------------------------------------------------------------
	local title = CosmeticConfig.Get(equipped.Title or "")
	local plate = CosmeticConfig.Get(equipped.Nameplate or "") or CosmeticConfig.Get(CosmeticConfig.Defaults.Nameplate)
	local gui = Instance.new("BillboardGui")
	gui.Name = "VD_Nameplate"
	gui.Size = UDim2.fromOffset(200, 54)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 110
	gui.LightInfluence = 0
	gui.Adornee = head :: BasePart

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = if plate and plate.Color then plate.Color else UIConfig.Colors.Panel
	frame.BackgroundTransparency = 0.25
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = if plate and plate.Color2 then plate.Color2 else UIConfig.Colors.Purple
	stroke.Thickness = 2
	stroke.Parent = frame

	local titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.new(1, -10, 0.42, 0)
	titleLabel.Position = UDim2.fromOffset(5, 3)
	titleLabel.Font = UIConfig.Fonts.Body
	titleLabel.TextScaled = true
	titleLabel.Text = if title and title.Text then title.Text else ""
	titleLabel.TextColor3 = if title and title.Color then title.Color else UIConfig.Colors.SubText
	titleLabel.Parent = frame

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, -10, 0.5, 0)
	nameLabel.Position = UDim2.new(0, 5, 0.45, 0)
	nameLabel.Font = UIConfig.Fonts.Title
	nameLabel.TextScaled = true
	local vip = if profile.Passes.VIP then "★ " else ""
	nameLabel.Text = string.format("%s%s  ·  R%d", vip, session.Player.DisplayName, profile.Rebirths)
	nameLabel.TextColor3 = UIConfig.Colors.Text
	nameLabel.Parent = frame
	gui.Parent = head

	-- Aura -------------------------------------------------------------------------
	local aura = CosmeticConfig.Get(equipped.Aura or "")
	if aura and aura.Color then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "VD_Aura"
		emitter.Color = ColorSequence.new(aura.Color)
		emitter.LightEmission = 0.8
		emitter.Rate = 8
		emitter.Lifetime = NumberRange.new(0.8, 1.4)
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Parent = root
	end

	-- Trail ------------------------------------------------------------------------
	local trailDef = CosmeticConfig.Get(equipped.Trail or "")
	if trailDef and trailDef.Color then
		local a0 = Instance.new("Attachment")
		a0.Name = "VD_TrailA0"
		a0.Position = Vector3.new(0, 0.8, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "VD_TrailA1"
		a1.Position = Vector3.new(0, -0.8, 0)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Name = "VD_Trail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.5
		trail.LightEmission = 0.7
		trail.Color = ColorSequence.new(trailDef.Color, trailDef.Color2 or trailDef.Color)
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
	end
end

function AvatarService.Start()
	SessionService.onLoaded(function(session)
		session.Player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 5)
			character:WaitForChild("HumanoidRootPart", 5)
			AvatarService.apply(session)
		end)
		AvatarService.apply(session)
	end)
	SessionService.onFlush(function(session, ctx)
		if ctx.dirty.Cosmetics or ctx.dirty.Rebirths or ctx.dirty.Passes then
			AvatarService.apply(session)
		end
	end)
end

return AvatarService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
-- BaseService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > BaseService
--
-- Jeder Spieler bekommt beim Join einen Plot (Base). Der Server stellt die
-- platzierten Characters dort als Models auf (für ALLE sichtbar = Social
-- Flex), dazu Billboards mit Name, Rarity, Level, Mutation, $/s, sowie die
-- fischenden Characters am Rift Pond.
--
-- Die Models sind verankert und werden vom Client nur lokal animiert
-- (Controllers > BaseAnimator). Aktualisiert wird per Diff, nicht neu gebaut.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local UIConfig = require(Config:WaitForChild("UIConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local ModelFactory = require(Shared:WaitForChild("Visual"):WaitForChild("ModelFactory"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))
local WorldService = require(script.Parent:WaitForChild("WorldService"))
local EconomyService = require(script.Parent:WaitForChild("EconomyService"))

local BaseService = {}

BaseService.CharacterTag = "VoidDiceCharacter"

local plotOwners: { [number]: SessionService.Session } = {}
local EMPTY_PAD = Color3.fromRGB(40, 42, 70)
local LOCKED_PAD = Color3.fromRGB(70, 20, 30)

local function plotOf(session): Model?
	return WorldService.plot(session.Plot)
end

local function setSign(plot: Model, title: string, subtitle: string)
	local board = plot:FindFirstChild("SignBoard", true)
	local gui = board and board:FindFirstChild("SignGui", true)
	if gui then
		local t = gui:FindFirstChild("Title", true)
		local s = gui:FindFirstChild("Subtitle", true)
		if t and t:IsA("TextLabel") then
			t.Text = title
		end
		if s and s:IsA("TextLabel") then
			s.Text = subtitle
		end
	end
end

-- Billboard über einem Character-Model
local function makeBillboard(model: Model): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(170, 58)
	gui.MaxDistance = 85
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	local height = (model:GetAttribute("Height") :: number?) or 6
	gui.StudsOffset = Vector3.new(0, height + 1.4, 0)
	gui.Adornee = model.PrimaryPart

	local list = Instance.new("UIListLayout")
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = gui

	local function label(name: string, order: number, size: number, font: Enum.Font)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.LayoutOrder = order
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, size)
		l.Font = font
		l.TextScaled = true
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0.35
		l.Text = ""
		l.Parent = gui
		return l
	end
	label("Mutation", 1, 13, UIConfig.Fonts.Body)
	label("Name", 2, 20, UIConfig.Fonts.Title)
	label("Stats", 3, 15, UIConfig.Fonts.Body)
	gui.Parent = model
	return gui
end

local function updateBillboard(model: Model, profile, char, mods)
	local gui = model:FindFirstChild("Info") :: BillboardGui?
	if not gui then
		gui = makeBillboard(model)
	end
	assert(gui)
	local def = CharacterConfig.ById[char.Id]
	local rarity = RarityConfig.Get(def.Rarity)
	local mutation = MutationConfig.Get(char.Mutation)
	local nameLabel = gui:FindFirstChild("Name") :: TextLabel
	local statsLabel = gui:FindFirstChild("Stats") :: TextLabel
	local mutLabel = gui:FindFirstChild("Mutation") :: TextLabel
	nameLabel.Text = def.DisplayName
	nameLabel.TextColor3 = rarity.Color
	if char.Fishing then
		statsLabel.Text = string.format("Lv %d · FISHING", char.Level)
	else
		local income = Logic.Economy.characterIncome(profile, char, mods)
		statsLabel.Text = string.format("Lv %d · %s", char.Level, Format.perSecond(income))
	end
	if mutation.Id ~= MutationConfig.None then
		mutLabel.Text = mutation.DisplayName
		mutLabel.TextColor3 = mutation.Color
		mutLabel.Visible = true
	else
		mutLabel.Text = rarity.DisplayName
		mutLabel.TextColor3 = rarity.Color
		mutLabel.Visible = rarity.Order >= RarityConfig.Order("Epic")
	end
end

local function buildModel(session, uid: string, char): Model?
	local ok, model = pcall(ModelFactory.Build, char.Id, { Level = char.Level, Mutation = char.Mutation })
	if not ok or not model then
		warn("[BaseService] Model konnte nicht gebaut werden:", char.Id, model)
		return nil
	end
	local def = CharacterConfig.ById[char.Id]
	model.Name = uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("CharacterId", char.Id)
	model:SetAttribute("Mutation", char.Mutation)
	model:SetAttribute("Level", char.Level)
	model:SetAttribute("OwnerUserId", session.UserId)
	model:SetAttribute("AnimationSet", def and def.AnimationSet or "Default")
	model:SetAttribute("Rarity", def and def.Rarity or "Common")
	CollectionService:AddTag(model, BaseService.CharacterTag)
	return model
end

-- Angel + Schnur an einen fischenden Character hängen
local function addFishingRod(model: Model, waterPoint: Vector3)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local armR = model:FindFirstChild("ArmR")
	local height = (model:GetAttribute("Height") :: number?) or 5
	local base = root.CFrame * CFrame.new(1.2, height * 0.55, -0.6)
	local rod = Instance.new("Part")
	rod.Name = "FishingRod"
	rod.Anchored = true
	rod.CanCollide = false
	rod.CanQuery = false
	rod.CanTouch = false
	rod.Material = Enum.Material.Metal
	rod.Color = Color3.fromRGB(60, 60, 70)
	rod.Size = Vector3.new(0.18, 0.18, 6)
	rod.CFrame = base * CFrame.Angles(math.rad(35), 0, 0) * CFrame.new(0, 0, -3)
	rod.Parent = if armR then armR else model

	local tip = Instance.new("Attachment")
	tip.Name = "RodTip"
	tip.Position = Vector3.new(0, 0, -3)
	tip.Parent = rod

	local waterAnchor = Instance.new("Part")
	waterAnchor.Name = "Bobber"
	waterAnchor.Anchored = true
	waterAnchor.CanCollide = false
	waterAnchor.CanQuery = false
	waterAnchor.CanTouch = false
	waterAnchor.Shape = Enum.PartType.Ball
	waterAnchor.Size = Vector3.new(0.6, 0.6, 0.6)
	waterAnchor.Material = Enum.Material.Neon
	waterAnchor.Color = Color3.fromRGB(255, 70, 90)
	waterAnchor.Position = waterPoint
	waterAnchor.Parent = model
	local bob = Instance.new("Attachment")
	bob.Name = "BobberAttachment"
	bob.Parent = waterAnchor

	local beam = Instance.new("Beam")
	beam.Attachment0 = tip
	beam.Attachment1 = bob
	beam.Width0 = 0.06
	beam.Width1 = 0.06
	beam.Color = ColorSequence.new(Color3.fromRGB(230, 230, 255))
	beam.FaceCamera = true
	beam.Segments = 6
	beam.CurveSize0 = -1
	beam.Parent = rod
end

local function syncFolder(session, folderName: string, wanted: { [string]: CFrame }, fishing: boolean, mods)
	local plot = plotOf(session)
	if not plot then
		return
	end
	local folder = plot:FindFirstChild(folderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = plot
	end
	assert(folder)
	local profile = session.Profile
	local pond = plot:FindFirstChild("PondWater", true)
	local pondCenter = if pond and pond:IsA("BasePart") then pond.Position else Vector3.zero

	-- Entfernen / ersetzen
	for _, model in folder:GetChildren() do
		local uid = model.Name
		local char = profile.Characters[uid]
		if not wanted[uid] or not char or model:GetAttribute("CharacterId") ~= char.Id or model:GetAttribute("Mutation") ~= char.Mutation then
			model:Destroy()
		end
	end
	-- Hinzufügen / aktualisieren
	for uid, cf in wanted do
		local char = profile.Characters[uid]
		local model = folder:FindFirstChild(uid) :: Model?
		if not model then
			model = buildModel(session, uid, char)
			if model then
				model:PivotTo(cf)
				if fishing then
					model:SetAttribute("Fishing", true)
					model:SetAttribute("AnimationSet", "Fishing")
					local toWater = (pondCenter - cf.Position) * Vector3.new(1, 0, 1)
					local waterPoint = cf.Position + (if toWater.Magnitude > 0 then toWater.Unit * math.min(7, toWater.Magnitude) else Vector3.zero)
					addFishingRod(model, Vector3.new(waterPoint.X, pondCenter.Y + 0.3, waterPoint.Z))
				end
				model.Parent = folder
			end
		else
			if (model:GetPivot().Position - cf.Position).Magnitude > 0.1 then
				model:PivotTo(cf)
			end
			if model:GetAttribute("Level") ~= char.Level then
				model:SetAttribute("Level", char.Level)
				pcall(ModelFactory.ApplyLevelVisual, model, char.Level)
			end
		end
		if model then
			updateBillboard(model, profile, char, mods)
		end
	end
end

local function updatePads(session, mods, bySlot)
	local plot = plotOf(session)
	local slots = plot and plot:FindFirstChild("Slots")
	if not slots then
		return
	end
	for _, pad in slots:GetChildren() do
		if pad:IsA("BasePart") then
			local index = pad:GetAttribute("SlotIndex") :: number? or tonumber(pad.Name:match("%d+")) or 0
			local rim = pad:FindFirstChild("Rim")
			local color = EMPTY_PAD
			local transparency = 0
			local uid = bySlot[index]
			if index > mods.BaseSlots then
				color = LOCKED_PAD
				transparency = 0.6
			elseif uid then
				local char = session.Profile.Characters[uid]
				local def = char and CharacterConfig.ById[char.Id]
				color = if def then RarityConfig.Get(def.Rarity).Color else EMPTY_PAD
			end
			if rim and rim:IsA("BasePart") then
				rim.Color = color
				rim.Transparency = transparency
			end
			pad:SetAttribute("Unlocked", index <= mods.BaseSlots)
			pad:SetAttribute("Uid", uid or "")
		end
	end
end

local function applyTheme(session)
	local plot = plotOf(session)
	local lights = plot and plot:FindFirstChild("Lights", true)
	if not lights then
		return
	end
	local themeId = session.Profile.Cosmetics.Equipped.BaseTheme
	local theme = CosmeticConfig.Get(themeId) or CosmeticConfig.Get(CosmeticConfig.Defaults.BaseTheme)
	local colors = theme and theme.Colors or { Color3.new(1, 1, 1) }
	local i = 0
	for _, bulb in lights:GetDescendants() do
		if bulb:IsA("BasePart") then
			i += 1
			bulb.Color = colors[(i - 1) % #colors + 1]
		end
	end
end

local function updateSign(session)
	local plot = plotOf(session)
	if not plot then
		return
	end
	local profile = session.Profile
	local value = Logic.Economy.baseValue(profile)
	setSign(plot, string.upper(session.Player.DisplayName) .. "'S BASE",
		string.format("BASE VALUE %s  ·  REBIRTH %d", Format.short(value), profile.Rebirths))
	plot:SetAttribute("BaseValue", value)
	plot:SetAttribute("Rebirths", profile.Rebirths)
	plot:SetAttribute("BestRarity", profile.Stats.BestRarity)
end

-- Anzeige über dem Collector-Pad: Inhalt des Vaults
local function updateCollector(session)
	local plot = plotOf(session)
	local collector = plot and plot:FindFirstChild("Collector", true)
	local gui = collector and collector:FindFirstChild("CollectorGui")
	if not gui then
		return
	end
	local title = gui:FindFirstChild("Title", true)
	local subtitle = gui:FindFirstChild("Subtitle", true)
	local autoCollect = Logic.Modifiers.compute(session.Profile).AutoCollect
	if title and title:IsA("TextLabel") then
		title.Text = if autoCollect then "AUTO" else Format.cash(session.Profile.Vault)
	end
	if subtitle and subtitle:IsA("TextLabel") then
		subtitle.Text = if autoCollect then "Cash goes straight to you" else "Step here to collect"
	end
end

function BaseService.refresh(session)
	if not session.Plot then
		return
	end
	local profile = session.Profile
	local mods = Logic.Modifiers.compute(profile)
	local plot = plotOf(session)
	if not plot then
		return
	end
	local slots = plot:FindFirstChild("Slots")
	local seats = plot:FindFirstChild("FishingSeats", true)

	local wantedBase: { [string]: CFrame } = {}
	local wantedFish: { [string]: CFrame } = {}
	local bySlot = {}
	for uid, char in profile.Characters do
		if char.Slot and slots then
			local pad = slots:FindFirstChild("Slot" .. char.Slot)
			if pad and pad:IsA("BasePart") then
				wantedBase[uid] = pad.CFrame * CFrame.new(0, pad.Size.Y / 2, 0)
				bySlot[char.Slot] = uid
			end
		elseif char.Fishing and seats then
			local seat = seats:FindFirstChild("Seat" .. char.Fishing)
			if seat and seat:IsA("BasePart") then
				wantedFish[uid] = seat.CFrame * CFrame.new(0, seat.Size.Y / 2, 0)
			end
		end
	end
	syncFolder(session, "Characters", wantedBase, false, mods)
	syncFolder(session, "Fishers", wantedFish, true, mods)
	updatePads(session, mods, bySlot)
	updateSign(session)
end

local function assignPlot(session)
	for index = 1, WorldService.plotCount() do
		if not plotOwners[index] then
			plotOwners[index] = session
			session.Plot = index
			local plot = WorldService.plot(index) :: Model
			plot:SetAttribute("OwnerUserId", session.UserId)
			plot:SetAttribute("OwnerName", session.Player.DisplayName)
			return index
		end
	end
	warn("[BaseService] Kein freier Plot! MaxPlayers in den Place-Einstellungen auf", GameConfig.MaxPlayers, "setzen.")
	return nil
end

local function clearPlot(index: number)
	local plot = WorldService.plot(index)
	if not plot then
		return
	end
	for _, folderName in { "Characters", "Fishers" } do
		local folder = plot:FindFirstChild(folderName)
		if folder then
			folder:ClearAllChildren()
		end
	end
	plot:SetAttribute("OwnerUserId", nil)
	plot:SetAttribute("OwnerName", nil)
	plot:SetAttribute("BaseValue", nil)
	setSign(plot, "EMPTY BASE", "Waiting for an investigator…")
	local slots = plot:FindFirstChild("Slots")
	if slots then
		for _, pad in slots:GetChildren() do
			local rim = pad:FindFirstChild("Rim")
			if rim and rim:IsA("BasePart") then
				rim.Color = EMPTY_PAD
				rim.Transparency = 0
			end
		end
	end
end

local function spawnAtBase(session, character: Model)
	task.defer(function()
		local cf = WorldService.plotSpawn(session.Plot)
		if cf and character.Parent then
			character:PivotTo(cf + Vector3.new(0, 3, 0))
		end
	end)
end

-- Für den "Inspect"-Dialog anderer Bases
function BaseService.summary(plotIndex: number)
	local session = plotOwners[plotIndex]
	if not session then
		return nil
	end
	local profile = session.Profile
	local chars = {}
	for uid, char in profile.Characters do
		if char.Slot then
			table.insert(chars, { Id = char.Id, Level = char.Level, Mutation = char.Mutation, Slot = char.Slot })
		end
	end
	return {
		Plot = plotIndex,
		Player = session.Player.DisplayName,
		UserId = session.UserId,
		Rebirths = profile.Rebirths,
		BaseValue = Logic.Economy.baseValue(profile),
		Income = Logic.Economy.incomePerSecond(profile, Logic.Modifiers.compute(profile)),
		Discovered = profile.Stats.CharactersDiscovered,
		BestRarity = profile.Stats.BestRarity,
		TotalRolls = profile.Stats.TotalRolls,
		Title = profile.Cosmetics.Equipped.Title,
		Characters = chars,
	}
end

function BaseService.Start()
	for index = 1, WorldService.plotCount() do
		clearPlot(index)
		local plot = WorldService.plot(index) :: Model
		local collector = plot:FindFirstChild("Collector", true)
		if collector and collector:IsA("BasePart") then
			local debounce: { [Player]: number } = {}
			collector.Touched:Connect(function(hit)
				local character = hit:FindFirstAncestorOfClass("Model")
				local player = character and Players:GetPlayerFromCharacter(character)
				if not player then
					return
				end
				local session = SessionService.get(player)
				if not session or session.Plot ~= index then
					return
				end
				local now = os.clock()
				if (debounce[player] or 0) > now then
					return
				end
				debounce[player] = now + 1
				EconomyService.collect(session)
			end)
		end
	end

	SessionService.onLoaded(function(session)
		assignPlot(session)
		BaseService.refresh(session)
		applyTheme(session)
		local player = session.Player
		player.CharacterAdded:Connect(function(character)
			spawnAtBase(session, character)
		end)
		if player.Character then
			spawnAtBase(session, player.Character)
		end
	end)

	SessionService.onRemoving(function(session)
		if session.Plot then
			plotOwners[session.Plot] = nil
			clearPlot(session.Plot)
		end
	end)

	SessionService.onFlush(function(session, ctx)
		local dirty = ctx.dirty
		if dirty.Base or dirty.Fishers or dirty.Rebirths or dirty.Derived or next(ctx.dirtyChars) then
			BaseService.refresh(session)
		end
		if dirty.Cosmetics then
			applyTheme(session)
		end
		if dirty.Vault or dirty.Derived or dirty.Rebirths then
			updateCollector(session)
		end
	end)

	SessionService.registerAction("InspectBase", function(session, _ctx, plotIndex: number)
		local summary = BaseService.summary(math.floor(plotIndex))
		if not summary then
			return false, "Nobody lives here (yet)"
		end
		SessionService.fire(session, "InspectBase", summary)
		return true
	end)

	-- Billboards gelegentlich auffrischen ($/s ändert sich durch Potions)
	task.spawn(function()
		while true do
			task.wait(5)
			for _, session in SessionService.all() do
				if not session.Removing then
					pcall(BaseService.refresh, session)
				end
			end
		end
	end)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--!strict
-- CharacterService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > CharacterService
--
-- Actions rund um Characters und Items: platzieren, upgraden, verkaufen,
-- sperren, Gear, Potions, Relikte. Jede Action prüft Besitz über das Profil
-- (uid muss im eigenen Profil existieren) – fremde uids gibt es dort nicht.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local Format = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Util"):WaitForChild("Format"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))

local Inventory = Logic.Inventory
local Modifiers = Logic.Modifiers

local CharacterService = {}

function CharacterService.Start()
	local register = SessionService.registerAction

	register("PlaceCharacter", function(session, ctx, uid: string)
		local profile = session.Profile
		local mods = Modifiers.compute(profile)
		if Inventory.freeSlot(profile, mods) == nil then
			-- Base voll: schwächsten ersetzen, wenn der neue besser ist
			if not Inventory.autoPlace(profile, ctx, uid, mods) then
				return false, "Base is full – remove a character first"
			end
			return true
		end
		return Inventory.place(profile, ctx, uid, mods)
	end)

	register("RemoveCharacter", function(session, ctx, uid: string)
		if not Inventory.unplace(session.Profile, ctx, uid) then
			return false, "Character is not in your base"
		end
		return true
	end)

	register("PlaceBest", function(session, ctx)
		local profile = session.Profile
		Inventory.placeBest(profile, ctx, Modifiers.compute(profile))
		return true
	end)

	register("UpgradeCharacter", function(session, ctx, uid: string, times: number?)
		local ok, result = Logic.Upgrades.upgrade(session.Profile, ctx, uid, times or 1)
		if not ok then
			return false, result :: string
		end
		SessionService.fire(session, "Upgraded", { Uid = uid, Times = result })
		return true
	end)

	register("SellCharacter", function(session, ctx, uid: string)
		local ok, result = Inventory.sell(session.Profile, ctx, uid)
		if not ok then
			return false, result :: string
		end
		SessionService.fire(session, "Sold", { Amount = result, Count = 1 })
		return true
	end)

	register("SellRarity", function(session, ctx, rarityId: string)
		local count, total = Inventory.sellRarity(session.Profile, ctx, rarityId)
		if count == 0 then
			return false, "Nothing to sell (locked, placed, fishing and mutated characters are kept)"
		end
		SessionService.fire(session, "Sold", { Amount = total, Count = count })
		SessionService.toast(session, string.format("Sold %d characters for %s", count, Format.cash(total)), "success")
		return true
	end)

	register("LockCharacter", function(session, ctx, uid: string, locked: boolean)
		if not Inventory.setLocked(session.Profile, ctx, uid, locked) then
			return false, "Character not found"
		end
		return true
	end)

	register("EquipGear", function(session, ctx, gearUid: string, charUid: string)
		return Logic.Items.equipGear(session.Profile, ctx, gearUid, charUid)
	end)

	register("UnequipGear", function(session, ctx, gearUid: string)
		if not Logic.Items.unequipGear(session.Profile, ctx, gearUid) then
			return false, "Gear is not equipped"
		end
		return true
	end)

	register("SellGear", function(session, ctx, gearUid: string)
		local ok, result = Logic.Items.sellGear(session.Profile, ctx, gearUid)
		if not ok then
			return false, result :: string
		end
		SessionService.fire(session, "Sold", { Amount = result, Count = 1 })
		return true
	end)

	register("UsePotion", function(session, ctx, potionId: string)
		local ok, err = Logic.Items.usePotion(session.Profile, ctx, potionId)
		if ok then
			local def = PotionConfig.Get(potionId)
			SessionService.toast(session, (def and def.DisplayName or potionId) .. " active!", "success")
		end
		return ok, err
	end)

	register("SellRelic", function(session, ctx, relicId: string)
		local ok, result = Logic.Items.sellRelic(session.Profile, ctx, relicId)
		if not ok then
			return false, result :: string
		end
		SessionService.fire(session, "Sold", { Amount = result, Count = 1 })
		return true
	end)
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- DataService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > DataService
--
-- Speichert Profile im DataStore – session-sicher:
--
--   * Session Lock: Beim Laden schreibt der Server per UpdateAsync seine JobId
--     in den Datensatz. Ein anderer Server, der das Profil noch hält, kann es
--     danach NICHT mehr überschreiben (sein Save prüft die JobId und bricht ab).
--     -> Kein Duplizieren durch schnelles Server-Hopping.
--   * Ist das Profil noch gesperrt (anderer Server speichert gerade beim
--     Verlassen), wird mit Pause erneut versucht. Ist der Lock älter als
--     LOCK_EXPIRY (Server abgestürzt), wird er übernommen.
--   * Autosave (GameConfig.AutosaveInterval), Save bei PlayerRemoving, Save
--     aller Profile bei BindToClose.
--   * Retries mit Backoff bei DataStore-Fehlern.
--   * Ohne DataStore-Zugriff (Studio ohne "Enable Studio Access to API
--     Services") läuft alles im Speicher, mit Warnung.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("GameConfig"))

local DataService = {}

local STORE_NAME = "VoidDice_Profiles_v1"
local LOCK_EXPIRY = 600 -- Sekunden ohne Autosave = Server gilt als tot
local LOAD_ATTEMPTS = 8
local LOAD_RETRY_WAIT = 4
local SAVE_ATTEMPTS = 4

local JOB_ID = if game.JobId ~= "" then game.JobId else "studio-" .. tostring(math.random(1, 1e9))

local store: DataStore? = nil
local memoryMode = false
local memory: { [string]: any } = {}

local savingCount = 0

local function keyFor(userId: number): string
	return "u_" .. userId
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local waited = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and waited < 10 do
		task.wait(0.5)
		waited += 0.5
	end
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		-- In Studio ohne API-Zugriff schlägt der erste echte Request fehl
		if RunService:IsStudio() then
			local probeOk, err = pcall(function()
				return (result :: DataStore):GetAsync("__probe")
			end)
			if not probeOk then
				warn("[DataService] Kein DataStore-Zugriff in Studio (" .. tostring(err) .. "). Speichern nur im Speicher. "
					.. "Game Settings > Security > Enable Studio Access to API Services aktivieren, um echtes Speichern zu testen.")
				memoryMode = true
			end
		end
	else
		warn("[DataService] DataStore nicht verfügbar, Speichern nur im Speicher:", result)
		memoryMode = true
	end
end

function DataService.isMemoryMode(): boolean
	return memoryMode
end

-- Lädt und sperrt das Profil. Gibt (profileTable oder nil für "neu", ok)
-- zurück. ok = false heißt: konnte nicht sicher geladen werden -> Spieler kicken.
function DataService.load(userId: number): (any, boolean)
	local key = keyFor(userId)
	if memoryMode or not store then
		local data = memory[key]
		return if data then data.Profile else nil, true
	end

	for attempt = 1, LOAD_ATTEMPTS do
		local lockedByOther = false
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, result = pcall(function()
			return (store :: DataStore):UpdateAsync(key, function(old)
				old = old or {}
				local lock = old.Lock
				local now = os.time()
				if lock and lock.JobId ~= JOB_ID and (now - (lock.Time or 0)) < LOCK_EXPIRY and attempt < LOAD_ATTEMPTS then
					lockedByOther = true
					return nil -- nichts schreiben
				end
				old.Lock = { JobId = JOB_ID, Time = now }
				return old
			end)
		end)
		if ok and not lockedByOther then
			local data = result or {}
			return data.Profile, true
		end
		if not ok then
			warn(string.format("[DataService] Laden fehlgeschlagen (Versuch %d/%d): %s", attempt, LOAD_ATTEMPTS, tostring(result)))
		end
		task.wait(LOAD_RETRY_WAIT * math.min(attempt, 3))
	end
	return nil, false
end

-- Speichert das Profil. release = Lock freigeben (Spieler verlässt Server).
-- Gibt false zurück, wenn der Lock verloren ging (anderer Server hat übernommen).
function DataService.save(userId: number, profile: any, release: boolean): boolean
	local key = keyFor(userId)
	if memoryMode or not store then
		memory[key] = { Profile = profile }
		return true
	end
	savingCount += 1
	local lostLock = false
	local success = false
	for attempt = 1, SAVE_ATTEMPTS do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(function()
			return (store :: DataStore):UpdateAsync(key, function(old)
				old = old or {}
				if old.Lock and old.Lock.JobId ~= JOB_ID then
					lostLock = true
					return nil
				end
				-- zweiter Rückgabewert: UserIds für DSGVO-Löschanfragen
				return {
					Profile = profile,
					Lock = if release then nil else { JobId = JOB_ID, Time = os.time() },
					SavedAt = os.time(),
				}, { userId }
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(string.format("[DataService] Speichern fehlgeschlagen (Versuch %d/%d): %s", attempt, SAVE_ATTEMPTS, tostring(err)))
		task.wait(2 ^ attempt)
	end
	savingCount -= 1
	if lostLock then
		warn("[DataService] Session Lock verloren für " .. key .. " – Save verworfen (kein Dupe).")
	end
	return success
end

function DataService.pendingSaves(): number
	return savingCount
end

DataService.AutosaveInterval = GameConfig.AutosaveInterval

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">DebugService</string>
            <string name="Source"><![CDATA[--!strict
-- DebugService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > DebugService
--
-- Test-Befehle NUR in Roblox Studio (RunService:IsStudio() + GameConfig.
-- StudioDebugTools). Im veröffentlichten Spiel lehnt der Server alles ab.
-- Im Client: Settings > DEBUG.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))

local DebugService = {}

local COMMANDS: { [string]: (session: any, ctx: any, arg: any) -> (boolean, string?) } = {}

COMMANDS.Cash = function(session, ctx, amount)
	local n = tonumber(amount) or 1e6
	Logic.Economy.earn(session.Profile, ctx, math.clamp(n, 0, 1e18), "Debug")
	return true, nil
end

COMMANDS.RebirthReady = function(session, ctx)
	local profile = session.Profile
	local need = Logic.Progression.rebirthCost(profile) - profile.Cash
	if need > 0 then
		Logic.Economy.earn(profile, ctx, need, "Debug")
	end
	return true, nil
end

COMMANDS.Potions = function(session, ctx)
	for _, def in PotionConfig.List do
		Logic.Items.addPotion(session.Profile, ctx, def.Id, 5)
	end
	return true, nil
end

COMMANDS.Gear = function(session, ctx)
	for _, def in GearConfig.List do
		Logic.Items.addGear(session.Profile, ctx, def.Id)
	end
	return true, nil
end

COMMANDS.UnlockAll = function(session, ctx)
	local profile = session.Profile
	for _, area in AreaConfig.List do
		profile.Areas[area.Id] = true
	end
	for _, dice in DiceConfig.List do
		profile.Dice.Owned[dice.Id] = true
	end
	profile.Stats.TotalCashEarned = math.max(profile.Stats.TotalCashEarned, GameConfig.FishingUnlockCashEarned)
	Logic.Context.mark(ctx, "Areas")
	Logic.Context.mark(ctx, "Dice")
	Logic.Context.mark(ctx, "Stats")
	return true, nil
end

-- n Rolls sofort (Statistik-Test für Luck), Ergebnis als Toast
COMMANDS.Roll = function(session, ctx, amount)
	local n = math.clamp(math.floor(tonumber(amount) or 1000), 1, 20000)
	local counts = {}
	local mods = Logic.Modifiers.compute(session.Profile)
	for _ = 1, n do
		local r = Logic.Rolling.roll(session.Profile, ctx, mods)
		counts[r.Rarity] = (counts[r.Rarity] or 0) + 1
	end
	local parts = {}
	for _, r in RarityConfig.List do
		if counts[r.Id] then
			table.insert(parts, string.format("%s %d", r.Id, counts[r.Id]))
		end
	end
	SessionService.toast(session, string.format("%d rolls @ luck %.2f: %s", n, mods.Luck, table.concat(parts, ", ")), "info")
	return true, nil
end

COMMANDS.Character = function(session, ctx, id)
	if type(id) ~= "string" or not CharacterConfig.ById[id] then
		return false, "Unknown character id"
	end
	Logic.Inventory.add(session.Profile, ctx, id, nil)
	return true, nil
end

COMMANDS.Reset = function(session, ctx)
	local fresh = Logic.ProfileTemplate.new()
	for key in session.Profile do
		session.Profile[key] = nil
	end
	for key, value in fresh do
		session.Profile[key] = value
	end
	Logic.onLoad(session.Profile, ctx)
	SessionService.sendFull(session)
	return true, nil
end

function DebugService.Start()
	SessionService.registerAction("Debug", function(session, ctx, command: string, arg: any)
		if not (RunService:IsStudio() and GameConfig.StudioDebugTools) then
			return false, "Debug tools are disabled"
		end
		local fn = COMMANDS[command]
		if not fn then
			return false, "Unknown debug command"
		end
		return fn(session, ctx, arg)
	end)
end

return DebugService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- EconomyService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > EconomyService
--
-- Der Server-Tick (jede Sekunde): passives Einkommen, Potion-Laufzeiten,
-- Fishing-Fortschritt, Spielzeit. Dazu "Collect" (Button und Collector-Pad).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))

local EconomyService = {}

function EconomyService.collect(session: SessionService.Session)
	SessionService.run(session, function(profile, ctx)
		local amount = Logic.Economy.collect(profile, ctx)
		if amount > 0 then
			SessionService.fire(session, "Collected", { Amount = amount })
		end
	end)
end

function EconomyService.Start()
	SessionService.registerAction("Collect", function(session, ctx)
		local amount = Logic.Economy.collect(session.Profile, ctx)
		if amount > 0 then
			SessionService.fire(session, "Collected", { Amount = amount })
		end
		return true
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(GameConfig.EconomyTickInterval)
			local now = os.clock()
			local dt = math.clamp(now - last, 0, 5)
			last = now
			for _, session in SessionService.all() do
				if not session.Removing then
					SessionService.run(session, function(profile, ctx)
						Logic.tick(profile, ctx, dt)
					end)
				end
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">GoalsService</string>
            <string name="Source"><![CDATA[--!strict
-- GoalsService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > GoalsService
--
-- Quests, Season Pass, Cosmetics, Einstellungen, Tutorial.

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))

local GoalsService = {}

function GoalsService.Start()
	local register = SessionService.registerAction

	register("ClaimQuest", function(session, ctx, questId: string)
		return Logic.Goals.claimQuest(session.Profile, ctx, questId)
	end)

	register("ClaimSeason", function(session, ctx, track: string, tier: number)
		return Logic.Goals.claimSeason(session.Profile, ctx, track, tier)
	end)

	register("EquipCosmetic", function(session, ctx, kind: string, id: string)
		return Logic.Cosmetics.equip(session.Profile, ctx, kind, id)
	end)

	register("SetSetting", function(session, ctx, key: string, value: any)
		if not Logic.setSetting(session.Profile, ctx, key, value) then
			return false, "Invalid setting"
		end
		return true
	end)

	register("SetAutoDelete", function(session, ctx, rarityId: string, enabled: boolean)
		if not Logic.setAutoDelete(session.Profile, ctx, rarityId, enabled) then
			return false, "Auto Delete is only available up to Epic"
		end
		return true
	end)

	register("TutorialStep", function(session, ctx, stepId: string)
		Logic.tutorialStep(session.Profile, ctx, stepId)
		return true
	end)

	register("ReplayTutorial", function(session, ctx)
		Logic.replayTutorial(session.Profile, ctx)
		return true
	end)

	register("SkipTutorial", function(session, ctx)
		Logic.skipTutorial(session.Profile, ctx)
		return true
	end)
end

return GoalsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- LeaderboardService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > LeaderboardService
--
-- * leaderstats (Spielerliste): Cash, Rebirths
-- * Globale Boards im Hub (OrderedDataStore): MOST ROLLS, MOST REBIRTHS,
--   TOTAL CASH, RAREST COLLECTION, BASE VALUE
--
-- OrderedDataStores speichern nur ganze Zahlen < 2^63. Total Cash wird
-- deshalb logarithmisch kodiert (log10 * 1000) und zur Anzeige zurückgerechnet.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local UIConfig = require(Config:WaitForChild("UIConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))
local WorldService = require(script.Parent:WaitForChild("WorldService"))

local LeaderboardService = {}

type BoardDef = {
	Key: string,
	Title: string,
	Part: string,
	Score: (profile: any) -> number,
	Display: (value: number) -> string,
}

local BOARDS: { BoardDef } = {
	{
		Key = "MostRolls", Title = "MOST ROLLS", Part = "Board_MostRolls",
		Score = function(p) return math.floor(p.Stats.TotalRolls) end,
		Display = function(v) return Format.short(v) end,
	},
	{
		Key = "MostRebirths", Title = "MOST REBIRTHS", Part = "Board_MostRebirths",
		Score = function(p) return math.floor(p.Rebirths) end,
		Display = function(v) return tostring(v) end,
	},
	{
		Key = "TotalCash", Title = "TOTAL CASH", Part = "Board_TotalCash",
		Score = function(p) return math.floor(math.log10(math.max(1, p.Stats.TotalCashEarned)) * 1000) end,
		Display = function(v) return Format.cash(10 ^ (v / 1000)) end,
	},
	{
		Key = "RarestCollection", Title = "RAREST COLLECTION", Part = "Board_RarestCollection",
		Score = function(p) return math.floor(Logic.Economy.collectionScore(p)) end,
		Display = function(v) return Format.short(v) .. " pts" end,
	},
	{
		Key = "BaseValue", Title = "BASE VALUE", Part = "Board_BaseValue",
		Score = function(p) return math.floor(Logic.Economy.baseValue(p)) end,
		Display = function(v) return Format.short(v) end,
	},
}

local stores: { [string]: OrderedDataStore } = {}
local available = true

local function setupLeaderstats(session)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = Format.cash(session.Profile.Cash)
	cash.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = session.Profile.Rebirths
	rebirths.Parent = folder
	folder.Parent = session.Player
end

local function updateLeaderstats(session)
	local folder = session.Player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local cash = folder:FindFirstChild("Cash") :: StringValue?
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue?
	if cash then
		cash.Value = Format.cash(session.Profile.Cash)
	end
	if rebirths then
		rebirths.Value = session.Profile.Rebirths
	end
end

local function buildBoardGui(part: BasePart, title: string): Frame
	local existing = part:FindFirstChild("BoardGui")
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = part

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = UIConfig.Colors.Background
	bg.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = UIConfig.Colors.Purple
	stroke.Thickness = 6
	stroke.Parent = bg

	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0.12, 0)
	header.BackgroundColor3 = UIConfig.Colors.PanelLight
	header.Font = UIConfig.Fonts.Title
	header.TextScaled = true
	header.TextColor3 = UIConfig.Colors.Gold
	header.Text = title
	header.Parent = bg

	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.04, 0.14)
	list.Size = UDim2.fromScale(0.92, 0.84)
	list.Parent = bg
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.005, 0)
	layout.Parent = list
	return list
end

local function renderBoard(list: Frame, rows: { { name: string, value: string } })
	list:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.005, 0)
	layout.Parent = list
	for i, row in rows do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.Size = UDim2.new(1, 0, 0.095, 0)
		label.BackgroundTransparency = if i % 2 == 0 then 1 else 0.85
		label.BackgroundColor3 = UIConfig.Colors.PanelLight
		label.Font = UIConfig.Fonts.Body
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = if i == 1 then UIConfig.Colors.Gold elseif i <= 3 then UIConfig.Colors.Text else UIConfig.Colors.SubText
		label.Text = string.format("  #%d  %s   %s", i, row.name, row.value)
		label.Parent = list
	end
	if #rows == 0 then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0.1, 0)
		label.BackgroundTransparency = 1
		label.Font = UIConfig.Fonts.Body
		label.TextScaled = true
		label.TextColor3 = UIConfig.Colors.SubText
		label.Text = if available then "No entries yet" else "Leaderboards need DataStore access"
		label.Parent = list
	end
end

local nameCache: { [number]: string } = {}
local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return game:GetService("Players"):GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else ("Player " .. userId)
	nameCache[userId] = result
	return result
end

local function pushScores(session)
	if not available then
		return
	end
	for _, board in BOARDS do
		local store = stores[board.Key]
		if store then
			local score = board.Score(session.Profile)
			if score > 0 then
				pcall(function()
					store:SetAsync(tostring(session.UserId), score)
				end)
			end
		end
	end
end

local function refreshBoards()
	local world = WorldService.get()
	if not world then
		return
	end
	for _, board in BOARDS do
		local part = world.Leaderboards and world.Leaderboards[board.Part]
		if part then
			local gui = part:FindFirstChild("BoardGui")
			local list = if gui then gui:FindFirstChild("List", true) else nil
			if not list then
				list = buildBoardGui(part, board.Title)
			end
			local rows = {}
			local store = stores[board.Key]
			if available and store then
				local ok, pages = pcall(function()
					return store:GetSortedAsync(false, 10)
				end)
				if ok and pages then
					for _, entry in pages:GetCurrentPage() do
						table.insert(rows, { name = nameFor(tonumber(entry.key) or 0), value = board.Display(entry.value) })
					end
				end
			else
				-- Ohne DataStore: aktuelle Spieler im Server anzeigen
				local entries = {}
				for _, session in SessionService.all() do
					table.insert(entries, { name = session.Player.DisplayName, score = board.Score(session.Profile) })
				end
				table.sort(entries, function(a, b)
					return a.score > b.score
				end)
				for i = 1, math.min(10, #entries) do
					table.insert(rows, { name = entries[i].name, value = board.Display(entries[i].score) })
				end
			end
			renderBoard(list :: Frame, rows)
		end
	end
end

function LeaderboardService.Start()
	for _, board in BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("VoidDice_LB_" .. board.Key)
		end)
		if ok then
			stores[board.Key] = store
		else
			available = false
		end
	end
	if game:GetService("RunService"):IsStudio() then
		local probeOk = pcall(function()
			local s = stores.MostRolls
			if s then
				s:GetSortedAsync(false, 1)
			end
		end)
		available = available and probeOk
	end

	SessionService.onLoaded(setupLeaderstats)
	SessionService.onFlush(function(session, ctx)
		if ctx.dirty.Cash or ctx.dirty.Rebirths then
			updateLeaderstats(session)
		end
	end)
	SessionService.onRemoving(function(session)
		task.spawn(pushScores, session)
	end)

	task.spawn(function()
		task.wait(5)
		while true do
			for _, session in SessionService.all() do
				if not session.Removing then
					pushScores(session)
				end
			end
			pcall(refreshBoards)
			task.wait(GameConfig.LeaderboardRefreshInterval)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- MonetizationService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > MonetizationService
--
-- Gamepasses und Developer Products.
--   * Gamepass-Besitz wird beim Join geprüft und im Profil gecacht.
--   * ProcessReceipt ist idempotent: Jede PurchaseId wird im Profil gemerkt
--     und erst nach erfolgreichem Speichern als "Granted" gemeldet. Stürzt der
--     Server vorher ab, liefert Roblox den Kauf erneut aus -> keine verlorenen
--     und keine doppelten Käufe.
--   * Keine Zufallsinhalte gegen Robux (siehe MonetizationConfig).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MonetizationConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("MonetizationConfig"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local MonetizationService = {}

local MAX_RECEIPTS = 100

local passByAssetId: { [number]: string } = {}
local productByAssetId: { [number]: string } = {}
for name, def in MonetizationConfig.Gamepasses do
	if def.Id ~= 0 then
		passByAssetId[def.Id] = name
	end
end
for name, def in MonetizationConfig.Products do
	if def.Id ~= 0 then
		productByAssetId[def.Id] = name
	end
end

local function grantPass(session, passName: string)
	SessionService.run(session, function(profile, ctx)
		if Logic.grantPass(profile, ctx, passName) then
			local def = MonetizationConfig.Gamepasses[passName]
			SessionService.toast(session, (def and def.DisplayName or passName) .. " unlocked!", "success")
		end
	end)
end

local function checkOwnedPasses(session)
	for name, def in MonetizationConfig.Gamepasses do
		if def.Id ~= 0 and not session.Profile.Passes[name] then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(session.UserId, def.Id)
			end)
			if ok and owns then
				SessionService.run(session, function(profile, ctx)
					Logic.grantPass(profile, ctx, name)
				end)
			end
		end
	end
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local session = player and SessionService.get(player)
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = session.Profile
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(profile.Purchases, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local productName = productByAssetId[receipt.ProductId]
	if not productName then
		warn("[Monetization] Unbekanntes Produkt:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local granted = SessionService.run(session, function(p, ctx)
		local ok = Logic.grantProduct(p, ctx, productName)
		if ok then
			table.insert(p.Purchases, purchaseId)
			while #p.Purchases > MAX_RECEIPTS do
				table.remove(p.Purchases, 1)
			end
		end
		return ok
	end)
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not DataService.save(session.UserId, profile, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, assetId, purchased)
		if not purchased then
			return
		end
		local name = passByAssetId[assetId]
		local session = SessionService.get(player)
		if name and session then
			grantPass(session, name)
		end
	end)

	SessionService.onLoaded(function(session)
		task.spawn(checkOwnedPasses, session)
	end)

	-- Studio: Käufe ohne Robux testen
	SessionService.registerAction("TestPurchase", function(session, ctx, kind: string, name: string)
		if not (RunService:IsStudio() and MonetizationConfig.StudioTestPurchases) then
			return false, "Test purchases only work in Studio"
		end
		if kind == "Pass" and MonetizationConfig.Gamepasses[name] then
			Logic.grantPass(session.Profile, ctx, name)
			SessionService.toast(session, "[STUDIO] " .. name .. " granted", "success")
			return true
		elseif kind == "Product" and MonetizationConfig.Products[name] then
			Logic.grantProduct(session.Profile, ctx, name)
			SessionService.toast(session, "[STUDIO] " .. name .. " granted", "success")
			return true
		end
		return false, "Unknown item"
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
-- ProgressionService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > ProgressionService
--
-- Rebirth, Dice, Gebiete, Teleport, Fishing-Actions.
-- Bedingungen (Cash, Rebirth-Stufe, Gebiet frei) prüft die Logic.

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))
local WorldService = require(script.Parent:WaitForChild("WorldService"))

local ProgressionService = {}

local TELEPORT_COOLDOWN = 3

function ProgressionService.Start()
	local register = SessionService.registerAction

	register("Rebirth", function(session, ctx)
		local ok, err = Logic.Progression.rebirth(session.Profile, ctx)
		if ok then
			SessionService.fireAll("PlayerRebirth", { Player = session.Player.DisplayName, UserId = session.UserId, Rebirths = session.Profile.Rebirths })
		end
		return ok, err
	end)

	register("BuyDice", function(session, ctx, diceId: string)
		return Logic.Progression.buyDice(session.Profile, ctx, diceId)
	end)

	register("EquipDice", function(session, ctx, diceId: string)
		return Logic.Progression.equipDice(session.Profile, ctx, diceId)
	end)

	register("UnlockArea", function(session, ctx, areaId: string)
		return Logic.Progression.unlockArea(session.Profile, ctx, areaId)
	end)

	register("Teleport", function(session, _ctx, target: string)
		local now = os.clock()
		if (session.Runtime.LastTeleport or 0) + TELEPORT_COOLDOWN > now then
			return false, "Wait a moment"
		end
		local character = session.Player.Character
		if not character then
			return false, nil
		end
		local cf: CFrame?
		if target == "Base" then
			cf = WorldService.plotSpawn(session.Plot)
		elseif target == "Hub" then
			cf = WorldService.hubSpawn()
		else
			if not session.Profile.Areas[target] then
				return false, "Area locked"
			end
			cf = WorldService.areaArrival(target)
		end
		if not cf then
			return false, "Unknown destination"
		end
		session.Runtime.LastTeleport = now
		character:PivotTo(cf + Vector3.new(0, 3, 0))
		return true
	end)

	register("SendFishing", function(session, ctx, uid: string)
		return Logic.Fishing.send(session.Profile, ctx, uid, Logic.Modifiers.compute(session.Profile))
	end)

	register("RecallFishing", function(session, ctx, uid: string)
		if not Logic.Fishing.recall(session.Profile, ctx, uid) then
			return false, "Character is not fishing"
		end
		return true
	end)

	register("SetWaters", function(session, ctx, watersId: string)
		return Logic.Fishing.setWaters(session.Profile, ctx, watersId)
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">RollService</string>
            <string name="Source"><![CDATA[--!strict
-- RollService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > RollService
--
-- Manuelles Rollen und Auto Roll. Der Server entscheidet alles:
--   * Cooldown (Roll Speed) wird mit Server-Uhr geprüft
--   * Auto Roll läuft komplett auf dem Server (kein Remote-Spam nötig)
--   * Nach großen Reveals (Legendary+) pausiert Auto Roll kurz
--     (RarityConfig.RevealSeconds), damit die Animation nicht überdeckt wird

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local Services = script.Parent
local SessionService = require(Services:WaitForChild("SessionService"))
local AnnouncementService = require(Services:WaitForChild("AnnouncementService"))

local RollService = {}

local function doRoll(session: SessionService.Session, manual: boolean): boolean
	local now = os.clock()
	local tolerance = if manual then GameConfig.RollCooldownTolerance else 0
	if now + tolerance < session.NextRollAt then
		return false
	end
	SessionService.run(session, function(profile, ctx)
		local mods = Logic.Modifiers.compute(profile)
		local result = Logic.Rolling.roll(profile, ctx, mods)
		local rarity = RarityConfig.Get(result.Rarity)
		session.NextRollAt = math.max(now, session.NextRollAt) + mods.RollCooldown + rarity.RevealSeconds

		if RarityConfig.Order(result.Rarity) >= RarityConfig.Order("Secret") then
			session.SecretRolls += 1
		end
		local def = CharacterConfig.ById[result.Id]
		SessionService.fire(session, "Roll", {
			Id = result.Id,
			Rarity = result.Rarity,
			Mutation = result.Mutation,
			Uid = result.Uid,
			IsNew = result.IsNew,
			Probability = result.Probability,
			BaseChance = result.BaseChance,
			SoldFor = result.SoldFor,
			SoldReason = result.SoldReason,
			ReplacedValue = result.ReplacedValue,
			Placed = result.Placed,
			Luck = result.Luck,
			Cooldown = mods.RollCooldown,
			Auto = not manual,
			Income = def and def.BaseMoneyPerSecond or 0,
		})
		AnnouncementService.onRoll(session, result)
	end)
	return true
end

function RollService.Start()
	SessionService.registerAction("Roll", function(session)
		if not doRoll(session, true) then
			return false, nil -- zu schnell: still ignorieren
		end
		return true
	end)

	SessionService.registerAction("SetAutoRoll", function(session, _ctx, enabled: boolean)
		if enabled and not GameConfig.AutoRollUnlocked then
			return false, "Auto Roll is locked"
		end
		session.AutoRoll = enabled
		SessionService.sendSession(session)
		return true
	end)

	-- Auto Roll: jeden Frame prüfen, wer dran ist
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, session in SessionService.all() do
			if session.AutoRoll and not session.Removing and now >= session.NextRollAt then
				doRoll(session, false)
			end
		end
	end)

	SessionService.onRemoving(function(session)
		session.AutoRoll = false
	end)
end

return RollService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">SessionService</string>
            <string name="Source"><![CDATA[--!strict
-- SessionService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > SessionService
--
-- Verwaltet die Spieler-Sessions (Profil im Speicher + Laufzeitdaten) und ist
-- die einzige Stelle, an der Client-Actions ankommen:
--
--   Client: Action:FireServer("UpgradeCharacter", "c12", 1)
--   -> AntiCheat: Rate Limit + Typprüfung
--   -> registrierter Handler (z. B. CharacterService) mit Context
--   -> Logic ändert das Profil
--   -> flush(): Cash-Sanity, Events an den Client, Sync-Patch, Hooks
--      (Base neu aufbauen, Avatar-Titel, Leaderstats ...)
--
-- Andere Services registrieren Actions mit SessionService.registerAction und
-- reagieren mit onLoaded / onRemoving / onFlush.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Net = require(Shared:WaitForChild("Net"))

local Server = script.Parent.Parent
local Logic = require(Server:WaitForChild("Logic"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local AntiCheatService = require(script.Parent:WaitForChild("AntiCheatService"))

export type Session = {
	Player: Player,
	UserId: number,
	Profile: any,
	Rng: Random,
	LastGood: { Cash: number, Vault: number },
	AutoRoll: boolean,
	NextRollAt: number,
	Plot: number?,
	JoinedAt: number,
	SecretRolls: number,
	Removing: boolean,
	Runtime: { [string]: any },
}

type Handler = (session: Session, ctx: any, ...any) -> (boolean?, string?)

local SessionService = {}

local sessions: { [Player]: Session } = {}
local handlers: { [string]: Handler } = {}
local loadedHooks: { (Session) -> () } = {}
local removingHooks: { (Session) -> () } = {}
local flushHooks: { (Session, any) -> () } = {}

-- Profil-Keys, die NICHT an den Client gehen
local PRIVATE_KEYS = {
	Purchases = true,
	NextCharUid = true,
	NextGearUid = true,
	Version = true,
}

local eventRemote: RemoteEvent
local syncRemote: RemoteEvent

function SessionService.get(player: Player): Session?
	local s = sessions[player]
	if s and not s.Removing then
		return s
	end
	return nil
end

function SessionService.all(): { [Player]: Session }
	return sessions
end

function SessionService.registerAction(name: string, handler: Handler)
	assert(Net.Actions[name], "Action fehlt in Net.Actions: " .. name)
	assert(not handlers[name], "Action doppelt registriert: " .. name)
	handlers[name] = handler
end

function SessionService.onLoaded(callback: (Session) -> ())
	table.insert(loadedHooks, callback)
end

function SessionService.onRemoving(callback: (Session) -> ())
	table.insert(removingHooks, callback)
end

function SessionService.onFlush(callback: (Session, any) -> ())
	table.insert(flushHooks, callback)
end

function SessionService.newContext(session: Session)
	return Logic.Context.new({
		now = os.time(),
		rng = session.Rng,
		userId = session.UserId,
		isStudio = RunService:IsStudio(),
	})
end

function SessionService.fire(session: Session, kind: string, data: any?)
	eventRemote:FireClient(session.Player, kind, data)
end

function SessionService.fireAll(kind: string, data: any?)
	eventRemote:FireAllClients(kind, data)
end

function SessionService.toast(session: Session, text: string, kind: string?)
	eventRemote:FireClient(session.Player, "Toast", { Text = text, Kind = kind or "info" })
end

local function publicProfile(profile)
	local view = {}
	for key, value in profile do
		if not PRIVATE_KEYS[key] then
			view[key] = value
		end
	end
	return view
end

function SessionService.sendFull(session: Session)
	local patch = publicProfile(session.Profile)
	patch.Full = true
	patch.Derived = Logic.derived(session.Profile)
	patch.Session = { AutoRoll = session.AutoRoll, Plot = session.Plot, MemoryMode = DataService.isMemoryMode(), IsStudio = RunService:IsStudio() }
	syncRemote:FireClient(session.Player, patch)
end

function SessionService.sendSession(session: Session)
	syncRemote:FireClient(session.Player, {
		Session = { AutoRoll = session.AutoRoll, Plot = session.Plot, MemoryMode = DataService.isMemoryMode(), IsStudio = RunService:IsStudio() },
	})
end

-- Änderungen eines Contexts an Client und Hooks weitergeben
function SessionService.flush(session: Session, ctx)
	local profile = session.Profile
	AntiCheatService.sanitize(session.Player, profile, session.LastGood)

	local patch = {}
	local any = false
	for key in ctx.dirty do
		if profile[key] ~= nil and not PRIVATE_KEYS[key] then
			patch[key] = profile[key]
		end
		any = true
	end
	if next(ctx.dirtyChars) then
		local chars = {}
		for uid in ctx.dirtyChars do
			chars[uid] = profile.Characters[uid] or false
		end
		patch.Characters = chars
		any = true
	end
	if next(ctx.dirtyGear) then
		local gear = {}
		for uid in ctx.dirtyGear do
			gear[uid] = profile.Gear[uid] or false
		end
		patch.Gear = gear
		any = true
	end
	if any then
		patch.Derived = Logic.derived(profile)
		syncRemote:FireClient(session.Player, patch)
	end

	for _, event in ctx.events do
		eventRemote:FireClient(session.Player, event.Kind, event.Data)
	end

	for _, hook in flushHooks do
		local ok, err = pcall(hook, session, ctx)
		if not ok then
			warn("[SessionService] Flush-Hook Fehler:", err)
		end
	end
end

-- Führt Logik für eine Session aus und flusht danach.
function SessionService.run(session: Session, fn: (profile: any, ctx: any) -> ...any): ...any
	local ctx = SessionService.newContext(session)
	local results = table.pack(pcall(fn, session.Profile, ctx))
	if not results[1] then
		warn("[SessionService] Logik-Fehler:", results[2])
		SessionService.toast(session, "Something went wrong. Please try again.", "error")
	end
	Logic.Goals.evaluateAchievements(session.Profile, ctx)
	SessionService.flush(session, ctx)
	return table.unpack(results, 2, results.n)
end

local function onAction(player: Player, action: any, ...: any)
	local session = SessionService.get(player)
	if not session then
		return
	end
	local args = table.pack(...)
	if not AntiCheatService.validate(player, action, args) then
		return
	end
	if not AntiCheatService.allow(player, action) then
		return
	end
	local handler = handlers[action]
	if not handler then
		return
	end
	local ctx = SessionService.newContext(session)
	local ok, success, err = pcall(handler, session, ctx, table.unpack(args, 1, args.n))
	if not ok then
		warn(string.format("[SessionService] Action %s Fehler: %s", tostring(action), tostring(success)))
		SessionService.toast(session, "Something went wrong.", "error")
	elseif success == false and err then
		eventRemote:FireClient(player, "Toast", { Text = err, Kind = "error" })
	end
	Logic.Goals.evaluateAchievements(session.Profile, ctx)
	SessionService.flush(session, ctx)
end

local function loadPlayer(player: Player)
	local stored, ok = DataService.load(player.UserId)
	if not ok then
		player:Kick("Your data could not be loaded safely. Please rejoin in a moment.")
		return
	end
	local profile = stored or Logic.ProfileTemplate.new()
	if not player.Parent then
		-- schon wieder weg: Lock sofort freigeben
		DataService.save(player.UserId, profile, true)
		return
	end
	local session: Session = {
		Player = player,
		UserId = player.UserId,
		Profile = profile,
		Rng = Random.new(),
		LastGood = { Cash = 0, Vault = 0 },
		AutoRoll = false,
		NextRollAt = 0,
		Plot = nil,
		JoinedAt = os.clock(),
		SecretRolls = 0,
		Removing = false,
		Runtime = {},
	}
	local ctx = SessionService.newContext(session)
	Logic.onLoad(profile, ctx)
	session.LastGood.Cash = profile.Cash
	session.LastGood.Vault = profile.Vault
	sessions[player] = session

	for _, hook in loadedHooks do
		local hookOk, err = pcall(hook, session)
		if not hookOk then
			warn("[SessionService] Loaded-Hook Fehler:", err)
		end
	end
	SessionService.sendFull(session)
	SessionService.flush(session, ctx)
end

local function removePlayer(player: Player)
	local session = sessions[player]
	if not session or session.Removing then
		return
	end
	session.Removing = true
	session.AutoRoll = false
	for _, hook in removingHooks do
		pcall(hook, session)
	end
	DataService.save(session.UserId, session.Profile, true)
	sessions[player] = nil
end

function SessionService.Init()
	Net.setup()
	eventRemote = Net.get("Event")
	syncRemote = Net.get("Sync")
end

function SessionService.Start()
	Net.get("Action").OnServerEvent:Connect(onAction)
end

-- Erst aufrufen, wenn alle anderen Services ihre Hooks registriert haben
function SessionService.Begin()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(loadPlayer, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		task.spawn(removePlayer, player)
	end)

	-- Autosave (gestaffelt)
	task.spawn(function()
		while true do
			task.wait(DataService.AutosaveInterval)
			for player, session in sessions do
				if not session.Removing then
					task.spawn(DataService.save, session.UserId, session.Profile, false)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, session in sessions do
			if not session.Removing then
				session.Removing = true
				pending += 1
				task.spawn(function()
					DataService.save(session.UserId, session.Profile, true)
					pending -= 1
				end)
			end
		end
		local started = os.clock()
		while (pending > 0 or DataService.pendingSaves() > 0) and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return SessionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- WorldService (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > Services > WorldService
--
-- Baut beim Serverstart die Map (World > WorldBuilder) und verbindet die
-- Stationen im Hub und die Dice-Altäre mit der UI (ProximityPrompt ->
-- Client öffnet das passende Menü).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local DiceConfig = require(Config:WaitForChild("DiceConfig"))

local Server = script.Parent.Parent
local WorldBuilder = require(Server:WaitForChild("World"):WaitForChild("WorldBuilder"))
local SessionService = require(script.Parent:WaitForChild("SessionService"))

local WorldService = {}

-- Station -> Menü im Client
local STATIONS = {
	ShopStation = { Panel = "Shop", Text = "Open Shop", Object = "SURPLUS SHOP" },
	RebirthStation = { Panel = "Rebirth", Text = "Rebirth", Object = "RIFT MACHINE" },
	IndexStation = { Panel = "Index", Text = "Open Index", Object = "CASE ARCHIVE" },
	QuestStation = { Panel = "Quests", Text = "Quests", Object = "NOTICE BOARD" },
	FishingStation = { Panel = "Fishing", Text = "Fishing", Object = "BAIT SHOP" },
}

local world: any = nil

function WorldService.get()
	return world
end

function WorldService.plot(index: number?): Model?
	if not world or not index then
		return nil
	end
	return world.Plots[index]
end

function WorldService.plotCount(): number
	return if world then #world.Plots else 0
end

function WorldService.plotSpawn(index: number?): CFrame?
	local plot = WorldService.plot(index)
	local spawn = plot and plot:FindFirstChild("SpawnPoint")
	return if spawn and spawn:IsA("BasePart") then spawn.CFrame else nil
end

function WorldService.hubSpawn(): CFrame?
	return if world and world.SpawnLocation then world.SpawnLocation.CFrame else nil
end

function WorldService.areaArrival(areaId: string): CFrame?
	if areaId == AreaConfig.StartArea then
		return WorldService.hubSpawn()
	end
	local area = world and world.Areas[areaId]
	local point = area and area:FindFirstChild("ArrivalPoint", true)
	return if point and point:IsA("BasePart") then point.CFrame else nil
end

local function addPrompt(part: BasePart, actionText: string, objectText: string, onTriggered: (Player) -> ())
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = part
	prompt.Triggered:Connect(onTriggered)
end

local function openUI(player: Player, data: { [string]: any })
	local session = SessionService.get(player)
	if session then
		SessionService.fire(session, "OpenUI", data)
	end
end

function WorldService.Init()
	local started = os.clock()
	world = WorldBuilder.Build(workspace)
	print(string.format("[VoidDice] Welt gebaut: %d Parts in %.0f ms", world.PartCount or 0, (os.clock() - started) * 1000))
end

function WorldService.Start()
	for name, station in world.Stations do
		local info = STATIONS[name]
		local promptPart = station:FindFirstChild("PromptPart", true)
		if info and promptPart and promptPart:IsA("BasePart") then
			addPrompt(promptPart, info.Text, info.Object, function(player)
				openUI(player, { Panel = info.Panel })
			end)
		end
	end
	for areaId, area in world.Areas do
		local altar = area:FindFirstChild("DiceAltar", true)
		local promptPart = altar and altar:FindFirstChild("PromptPart", true)
		local dice = nil
		for _, d in DiceConfig.List do
			if d.Area == areaId then
				dice = d
			end
		end
		if promptPart and promptPart:IsA("BasePart") and dice then
			addPrompt(promptPart, "View Dice", dice.DisplayName, function(player)
				openUI(player, { Panel = "Shop", Tab = "Dice", Highlight = dice.Id })
			end)
		end
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="81">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">Areas</string>
            <string name="Source"><![CDATA[--!strict
-- Areas (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > Areas
--
-- Baut die Gebiete nördlich des Hubs (alle außer Suburb). Jedes Gebiet hat
-- denselben "Rahmen" (Boden, Tor, Ankunftspunkt, Dice-Altar) und eine eigene
-- Deko-Funktion mit klar unterscheidbarem Look:
--   DarkForest  dichte dunkle Tannen, Camp, abgestürzter Wetterballon, Leuchtpilze
--   SecretLab   Betongelände, Zäune, Laborgebäude mit Sicherheitstür, Tanks, Racks
--   RiftZone    zerbrochener Boden, Neon-Risse, schwebende Brocken und Vorstadt-Trümmer
--   Otherworld  Spiegel-Vorstadt in Türkis/Magenta: Häuser kopfüber am Himmel, Kristalle
--   Void        schwarzer Glasboden, lila Neon-Raster, schwebende Würfel/Ringe, riesiges Auge
--
-- Vertrag mit den Services:
--   <AreaId>                   Model, Attribut AreaId
--     Gate                     Energie-Barriere über der Straße am Südrand
--                              (Attribute AreaId, RequiredRebirths, UnlockCost; CanCollide true)
--     GateFrame/Lintel         SurfaceGui "GateGui" (Title = DisplayName, Subtitle = Rebirth-Info)
--     ArrivalPoint             unsichtbar, knapp hinter dem Tor, schaut nach Norden
--     DiceAltar                Model (Attribut DiceId) mit "PromptPart" und Würfel "Die"
--     Ground, Decor

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local WorldConfig = require(ConfigFolder:WaitForChild("WorldConfig"))
local DiceConfig = require(ConfigFolder:WaitForChild("DiceConfig"))

local Parts = require(script.Parent:WaitForChild("Parts"))
local Props = require(script.Parent:WaitForChild("Props"))

local Palette = Parts.Palette
local V3 = Vector3.new
local CF = CFrame.new
local Mat = Enum.Material

local Areas = {}

type Ctx = {
	Model: Model,
	Decor: Folder,
	Def: any,
	Rng: Random,
	C: Vector3,
	HX: number,
	HZ: number,
	South: number,
	North: number,
	Reserved: { { x: number, z: number, r: number } },
}

-------------------------------------------------------------------------------
-- Platzierungs-Hilfen
-------------------------------------------------------------------------------

local ROAD_CLEAR = WorldConfig.RoadWidth / 2 + 6

local function reserve(ctx: Ctx, x: number, z: number, r: number)
	table.insert(ctx.Reserved, { x = x, z = z, r = r })
end

-- Ist (x, z) frei? (im Gebiet, nicht auf der Straße, nicht in reservierten Kreisen)
local function free(ctx: Ctx, x: number, z: number, r: number): boolean
	local dx, dz = x - ctx.C.X, z - ctx.C.Z
	if math.abs(dx) > ctx.HX - r - 3 or math.abs(dz) > ctx.HZ - r - 3 then
		return false
	end
	if math.abs(dx) < ROAD_CLEAR + r then
		return false
	end
	for _, res in ctx.Reserved do
		local ex, ez = res.x - x, res.z - z
		if ex * ex + ez * ez < (res.r + r) * (res.r + r) then
			return false
		end
	end
	return true
end

-- Verteilt bis zu count Objekte zufällig (deterministisch über ctx.Rng)
local function scatter(ctx: Ctx, count: number, r: number, fn: (x: number, z: number, i: number) -> ())
	local placed, tries = 0, 0
	while placed < count and tries < count * 30 do
		tries += 1
		local x = ctx.C.X + ctx.Rng:NextNumber(-ctx.HX, ctx.HX)
		local z = ctx.C.Z + ctx.Rng:NextNumber(-ctx.HZ, ctx.HZ)
		if free(ctx, x, z, r) then
			placed += 1
			reserve(ctx, x, z, r)
			fn(x, z, placed)
		end
	end
end

local function at(ctx: Ctx, x: number, y: number, z: number): CFrame
	return CF(ctx.C.X + x, WorldConfig.GroundY + y, ctx.C.Z + z)
end

local function yaw(ctx: Ctx): CFrame
	return CFrame.Angles(0, ctx.Rng:NextNumber(0, math.pi * 2), 0)
end

-- Spiegelachse für schwebende Kopfüber-Objekte
local function flipped(cf: CFrame, mirrorY: number): CFrame
	local p = cf.Position
	return CF(p.X, 2 * mirrorY - p.Y, p.Z) * (cf - p) * CFrame.Angles(0, 0, math.pi)
end

local function emitter(ctx: Ctx, cf: CFrame, size: Vector3, opts: Parts.Opts)
	local p = Parts.Invisible(ctx.Decor, cf, size, "ParticleZone", false)
	Parts.Particles(p, opts)
end

-------------------------------------------------------------------------------
-- Gemeinsamer Rahmen: Tor, Ankunft, Altar
-------------------------------------------------------------------------------

local function buildGate(ctx: Ctx)
	local def = ctx.Def
	local gw, gh = WorldConfig.GateWidth, WorldConfig.GateHeight
	local x, z = ctx.C.X, ctx.South
	local gate = Parts.Part({
		Parent = ctx.Model,
		Name = "Gate",
		CFrame = CF(x, WorldConfig.GroundY + gh / 2, z),
		Size = V3(gw, gh, 1.5),
		Color = def.PrimaryColor,
		Material = Mat.ForceField,
		CanCollide = true,
		CastShadow = false,
		Attributes = {
			AreaId = def.Id,
			RequiredRebirths = def.RequiredRebirths,
			UnlockCost = def.UnlockCost,
		},
	})
	gate.CanTouch = true

	local frame = Parts.Model(ctx.Model, "GateFrame")
	local pillarH = gh + 6
	for _, sx in { -1, 1 } do
		local px = x + sx * (gw / 2 + 2)
		Parts.Box(frame, CF(px, pillarH / 2, z), V3(4, pillarH, 4), Palette.MetalDark, Mat.Metal, "Pillar")
		Parts.Neon(frame, CF(px, pillarH / 2, z + 2.05), V3(0.6, pillarH - 2, 0.2), def.PrimaryColor, "PillarGlow")
		Parts.Neon(frame, CF(px, pillarH / 2, z - 2.05), V3(0.6, pillarH - 2, 0.2), def.PrimaryColor, "PillarGlow")
	end
	local lintel = Parts.Box(frame, CF(x, gh + 3, z), V3(gw + 8, 6, 4), Palette.Navy, Mat.Metal, "Lintel")
	local reqText = if def.RequiredRebirths == 1 then "REBIRTH 1 REQUIRED" else ("REBIRTH " .. def.RequiredRebirths .. " REQUIRED")
	Parts.SurfaceLabel(lintel, Enum.NormalId.Back, def.DisplayName, reqText, {
		Name = "GateGui",
		TitleColor = def.PrimaryColor,
		SubtitleColor = Palette.White,
		Background = Palette.Night,
		PixelsPerStud = 16,
	})
	-- Rückseite (aus dem Gebiet heraus gesehen)
	Parts.SurfaceLabel(lintel, Enum.NormalId.Front, "SIGNAL ROAD", "SOUTH", {
		Name = "ExitGui",
		TitleColor = Palette.White,
		Background = Palette.Night,
		PixelsPerStud = 16,
	})
	Parts.Neon(frame, CF(x, gh + 0.2, z), V3(gw, 0.4, 4.2), def.PrimaryColor, "LintelGlow")
end

local function buildAltar(ctx: Ctx)
	local def = ctx.Def
	local dice = nil
	for _, d in DiceConfig.List do
		if d.Area == def.Id then
			dice = d
			break
		end
	end
	local x, z = ctx.C.X - 42, ctx.South - 60
	reserve(ctx, x, z, 16)
	local base = Parts.FaceTowards(V3(x, WorldConfig.GroundY, z), V3(ctx.C.X, WorldConfig.GroundY, z))
	local m = Parts.Model(ctx.Model, "DiceAltar")
	local color = if dice then dice.Color else def.PrimaryColor
	local color2 = if dice then dice.Color2 else def.SecondaryColor
	if dice then
		m:SetAttribute("DiceId", dice.Id)
	end
	Parts.VCyl(m, base * CF(0, 0.5, 0), 1, 16, Palette.MetalDark, Mat.Slate, "Step")
	Parts.VCyl(m, base * CF(0, 1.5, 0), 1, 11, Palette.NavyLight, Mat.Slate, "Step")
	Parts.VCyl(m, base * CF(0, 1.95, 0), 0.2, 11.6, color, Mat.Neon, "StepGlow")
	Parts.Box(m, base * CF(0, 3.5, 0), V3(3.5, 3, 3.5), Palette.Navy, Mat.Slate, "Pillar")
	Parts.Part({
		Parent = m,
		Name = "LightColumn",
		Shape = Enum.PartType.Cylinder,
		CFrame = base * CF(0, 7.5, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Size = V3(5, 2, 2),
		Color = color,
		Material = Mat.Neon,
		Transparency = 0.55,
		CanCollide = false,
	})
	local dieCf = base * CF(0, 12, 0) * CFrame.Angles(math.rad(35.26), 0, math.rad(45))
	local die = Props.Die(m, dieCf, { Name = "Die", Size = 6, Color = color, PipColor = color2 })
	Parts.Ring(m, base * CF(0, 12, 0) * CFrame.Angles(math.rad(90), 0, 0), 6.5, 10, 0.5, 0.5, color, Mat.Neon, "Orbit")
	local core = die.PrimaryPart :: BasePart
	Parts.Light(core, color, 20, 1.6)
	Parts.Billboard(core, if dice then dice.DisplayName else def.DisplayName, if dice then ("LUCK x" .. dice.Luck) else nil, {
		Name = "DiceGui",
		Offset = V3(0, 7, 0),
		Width = 14,
		Height = 4,
		TitleColor = color,
		MaxDistance = 140,
	})
	Parts.Invisible(m, base * CF(0, 3, -7), V3(4, 4, 4), "PromptPart", false)
end

-------------------------------------------------------------------------------
-- DARK FOREST
-------------------------------------------------------------------------------

local function buildDarkForest(ctx: Ctx)
	local d = ctx.Decor
	local rng = ctx.Rng
	local leafColors = { Palette.LeafDark, Color3.fromRGB(24, 48, 34), Color3.fromRGB(16, 34, 26), Color3.fromRGB(26, 40, 36) }

	-- Camp (rechts der Straße)
	local camp = at(ctx, 48, 0, 15)
	reserve(ctx, camp.X, camp.Z, 18)
	local tentCf = camp * CF(-7, 0, -7) * CFrame.Angles(0, math.rad(30), 0)
	Parts.Box(d, tentCf * CF(0, 0.1, 0), V3(7, 0.2, 8), Color3.fromRGB(60, 60, 50), Mat.Fabric, "TentFloor")
	for _, sx in { -1, 1 } do
		Parts.Box(d, tentCf * CF(sx * 1.6, 2.3, 0) * CFrame.Angles(0, 0, sx * math.rad(35)), V3(0.3, 5.6, 8), Palette.Orange, Mat.Fabric, "TentSide")
	end
	for k = 0, 3 do
		local a = k * math.pi / 2 + 0.4
		Props.Rock(d, camp * CF(math.cos(a) * 2.2, 0, math.sin(a) * 2.2), { Rng = rng, Size = 1.2, Parts = 1 })
	end
	for _, r in { 0.5, -0.6 } do
		Parts.Cyl(d, camp * CF(0, 0.4, 0) * CFrame.Angles(0, r, 0), 3.2, 0.6, Palette.Bark, Mat.Wood, "FireLog")
	end
	local flame = Parts.Neon(d, camp * CF(0, 1.3, 0) * CFrame.Angles(0, 0.7, 0), V3(1.4, 2, 1.4), Palette.Orange, "Flame")
	Parts.Neon(d, camp * CF(0, 1.9, 0) * CFrame.Angles(0, 0.2, 0), V3(0.8, 1.4, 0.8), Palette.Yellow, "Flame")
	Parts.Light(flame, Palette.Orange, 26, 2)
	Parts.Particles(flame, { Color = Palette.Orange, Rate = 10, Size = 0.25, Lifetime = 1.5, Speed = 2, Acceleration = V3(0, 4, 0) })
	for _, a in { 0.9, 2.4 } do
		Parts.Cyl(d, camp * CF(math.cos(a) * 5, 0.6, math.sin(a) * 5) * CFrame.Angles(0, a, 0), 4, 1.2, Palette.Bark, Mat.Wood, "SitLog")
	end
	Parts.Box(d, camp * CF(5, 1, -4), V3(2.6, 2, 1.8), Palette.Red, Mat.SmoothPlastic, "Cooler")
	Parts.Neon(d, camp * CF(5, 2.4, -4), V3(0.6, 0.8, 0.6), Palette.Amber, "Lantern")

	-- Abgestürzter Wetterballon (links, weiter hinten)
	local crash = at(ctx, -52, 0, -45)
	reserve(ctx, crash.X, crash.Z, 20)
	Parts.VCyl(d, crash * CF(0, 0.02 - 0.1, 0), 0.2, 22, Color3.fromRGB(20, 20, 18), Mat.Ground, "Scorch")
	local balloon = Parts.Part({
		Parent = d,
		Name = "Balloon",
		CFrame = crash * CF(5, 1.6, 2) * CFrame.Angles(0.15, 0.6, 0.1),
		Size = V3(16, 3.6, 12),
		Color = Color3.fromRGB(230, 230, 220),
		Material = Mat.SmoothPlastic,
		Transparency = 0.15,
		CanCollide = false,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = balloon
	local payloadCf = crash * CF(-4, 1.2, -2) * CFrame.Angles(0.3, 0.8, 0.25)
	local payload = Parts.Box(d, payloadCf, V3(3, 2.5, 3), Palette.Metal, Mat.Metal, "Payload")
	Parts.SurfaceLabel(payload, Enum.NormalId.Front, "WX-7", "PROBE", { TitleColor = Palette.Red, PixelsPerStud = 30 })
	Parts.Box(d, payloadCf * CF(0, 2.2, 0) * CFrame.Angles(0, math.rad(45), 0), V3(3.6, 0.15, 0.15), Palette.White, Mat.Metal, "Reflector")
	Parts.Box(d, payloadCf * CF(0, 2.2, 0) * CFrame.Angles(0, math.rad(-45), 0), V3(3.6, 0.15, 0.15), Palette.White, Mat.Metal, "Reflector")
	Parts.Ball(d, payloadCf * CF(0, 1.5, 0), 0.6, Palette.Red, Mat.Neon, "Blinker")
	for k = 1, 4 do
		local tip = crash * V3(5 + (k - 2.5) * 3, 2.5, 2 + (k % 2) * 3)
		Parts.Beam(d, payloadCf * V3(0, 1.25, 0), tip, 0.08, Palette.Paper, Mat.Fabric, "Cord")
	end
	for k = 0, 4 do
		local a = k * 1.25
		Props.Rock(d, crash * CF(math.cos(a) * 10, 0, math.sin(a) * 10), { Rng = rng, Size = rng:NextNumber(2, 3.5), Parts = 1, Color = Color3.fromRGB(56, 50, 44) })
	end

	-- Dichte Tannen + tote Bäume
	scatter(ctx, 68, 4.5, function(x, z)
		Props.PineTree(d, CF(x, WorldConfig.GroundY, z) * yaw(ctx), {
			Height = rng:NextNumber(24, 40),
			Tiers = 2,
			Color = leafColors[rng:NextInteger(1, #leafColors)],
			TrunkColor = Color3.fromRGB(46, 34, 28),
		})
	end)
	scatter(ctx, 10, 3, function(x, z)
		Props.DeadTree(d, CF(x, WorldConfig.GroundY, z) * yaw(ctx), { Height = rng:NextNumber(12, 20) })
	end)
	-- Leuchtpilze (auch dicht an der Straße erlaubt -> kleiner Radius)
	local mushroomColors = { Palette.Green, Palette.Cyan, Color3.fromRGB(170, 255, 120) }
	scatter(ctx, 24, 1.2, function(x, z, i)
		Props.Mushroom(d, CF(x, WorldConfig.GroundY, z), { Height = rng:NextNumber(1.2, 3.2), Color = mushroomColors[(i % 3) + 1] })
	end)

	-- Bodennebel + Glühwürmchen
	for k = -1, 1 do
		emitter(ctx, at(ctx, k * 70, 3, k * 50), V3(60, 2, 60), {
			Color = Color3.fromRGB(150, 190, 170),
			Rate = 3,
			Size = 9,
			Lifetime = 10,
			Speed = 0.3,
			Transparency = 0.85,
			LightEmission = 0,
			Acceleration = V3(0.2, 0, 0),
		})
	end
	emitter(ctx, at(ctx, 0, 6, 0), V3(200, 6, 200), { Color = Palette.Green, Rate = 12, Size = 0.25, Lifetime = 4 })
end

-------------------------------------------------------------------------------
-- SECRET LAB
-------------------------------------------------------------------------------

local function buildSecretLab(ctx: Ctx)
	local d = ctx.Decor
	local rng = ctx.Rng
	local wall = Color3.fromRGB(150, 152, 160)
	local hx, hz = ctx.HX, ctx.HZ

	-- Zäune an West- und Ostseite
	for _, sx in { -1, 1 } do
		local fx = sx * (hx - 6)
		local n = 4
		local zSeg = (hz * 2 - 12) / n
		for k = 0, n - 1 do
			local z = -hz + 6 + zSeg / 2 + k * zSeg
			Props.ChainFence(d, at(ctx, fx, 0, z) * CFrame.Angles(0, math.pi / 2, 0), { Length = zSeg, Height = 9 })
		end
		for _, z in { -hz + 30, hz - 30 } do
			Props.WarningLight(d, at(ctx, fx, 0, z), { Height = 10, Color = Palette.Red })
		end
	end

	-- Laborgebäude (West/Nord) mit Sicherheitstür zur Straße
	local bx, bz, bw, bd, bh = -72, -52, 64, 56, 22
	reserve(ctx, ctx.C.X + bx, ctx.C.Z + bz, 46)
	local b = at(ctx, bx, 0, bz)
	Parts.Box(d, b * CF(0, bh / 2, bd / 2 - 1), V3(bw, bh, 2), wall, Mat.Concrete, "LabWall")
	Parts.Box(d, b * CF(0, bh / 2, -bd / 2 + 1), V3(bw, bh, 2), wall, Mat.Concrete, "LabWall")
	Parts.Box(d, b * CF(-bw / 2 + 1, bh / 2, 0), V3(2, bh, bd), wall, Mat.Concrete, "LabWall")
	-- Ostwand mit Toröffnung (12 breit, 12 hoch)
	local seg = (bd - 12) / 2
	for _, sz in { -1, 1 } do
		Parts.Box(d, b * CF(bw / 2 - 1, bh / 2, sz * (6 + seg / 2)), V3(2, bh, seg), wall, Mat.Concrete, "LabWall")
	end
	Parts.Box(d, b * CF(bw / 2 - 1, 12 + (bh - 12) / 2, 0), V3(2, bh - 12, 12), wall, Mat.Concrete, "LabWall")
	Parts.Box(d, b * CF(0, bh + 0.5, 0), V3(bw + 1, 1, bd + 1), Palette.ConcreteDark, Mat.Concrete, "LabRoof")
	for _, sz in { -1, 1 } do
		Parts.Neon(d, b * CF(bw / 2 + 0.05, 16, sz * (6 + seg / 2)), V3(0.2, 2, seg - 4), Color3.fromRGB(180, 230, 255), "WindowBand")
	end
	-- Containment Door (geschlossene Sicherheitstür mit leuchtender Fuge)
	local door = b * CF(bw / 2 + 0.6, 0, 0)
	Parts.Box(d, door * CF(0, 6, -3.2), V3(1, 12, 5.6), Palette.MetalDark, Mat.DiamondPlate, "BlastDoor")
	Parts.Box(d, door * CF(0, 6, 3.2), V3(1, 12, 5.6), Palette.MetalDark, Mat.DiamondPlate, "BlastDoor")
	for _, sz in { -1, 1 } do
		Parts.Box(d, door * CF(0.55, 6, sz * 6.6), V3(0.4, 12, 1.2), Palette.Yellow, Mat.SmoothPlastic, "HazardStripe")
	end
	Parts.Neon(d, door * CF(0.6, 6, 0), V3(0.2, 11, 0.6), Palette.Red, "DoorSeam")
	local doorLight = Parts.Ball(d, door * CF(0.8, 13.2, 0), 1.4, Palette.Red, Mat.Neon, "AlarmLight")
	Parts.Light(doorLight, Palette.Red, 24, 2)
	local facility = Parts.Box(d, door * CF(0.4, 17.5, 0) * CFrame.Angles(0, -math.pi / 2, 0), V3(26, 4, 0.4), Palette.Night, Mat.SmoothPlastic, "FacilitySign")
	Parts.SurfaceLabel(facility, Enum.NormalId.Front, "KESTREL FACILITY", "SECTOR 4 - AUTHORIZED ONLY", {
		TitleColor = Color3.fromRGB(200, 230, 255),
		SubtitleColor = Palette.Red,
		Font = Enum.Font.Michroma,
	})
	for k = -1, 1 do
		Parts.Box(d, b * CF(k * 14, bh + 2.2, k * 10), V3(6, 3.4, 5), Palette.Metal, Mat.Metal, "ACUnit")
	end
	Props.AntennaMast(d, b * CF(-20, bh + 1, -16), { Height = 18 })

	-- Tank-Hof (Ost/Nord)
	local tx, tz = 62, -62
	reserve(ctx, ctx.C.X + tx, ctx.C.Z + tz, 24)
	for row = 0, 1 do
		for col = 0, 2 do
			Props.LabTank(d, at(ctx, tx - 12 + col * 12, 0, tz - 6 + row * 12), {
				Height = 11,
				Diameter = 5,
				LiquidColor = if (row + col) % 2 == 0 then Palette.Cyan else Palette.Green,
			})
		end
	end
	local tankGlow = Parts.Neon(d, at(ctx, tx, 0.06, tz), V3(34, 0.1, 22), Color3.fromRGB(40, 120, 160), "TankYardFloor")
	tankGlow.Transparency = 0.6
	Parts.Light(tankGlow, Palette.Cyan, 30, 1.2)

	-- Server-Hof unter Vordach (Ost/Süd)
	local sx0, sz0 = 62, 22
	reserve(ctx, ctx.C.X + sx0, ctx.C.Z + sz0, 20)
	local yard = at(ctx, sx0, 0, sz0)
	for k = 0, 5 do
		-- Reihe entlang Z, Front zeigt nach Westen (zur Straße)
		Props.ServerRack(d, yard * CF(-2, 0, -12.5 + k * 5) * CFrame.Angles(0, math.pi / 2, 0))
	end
	for _, c in { { -6, -16 }, { 6, -16 }, { -6, 16 }, { 6, 16 } } do
		Parts.Box(d, yard * CF(c[1], 5.5, c[2]), V3(0.8, 11, 0.8), Palette.MetalDark, Mat.Metal, "CanopyPost")
	end
	Parts.Box(d, yard * CF(0, 11.3, 0), V3(16, 0.6, 36), Palette.ConcreteDark, Mat.Metal, "Canopy")

	-- Wachhäuschen am Tor (Osten)
	local gh = at(ctx, 30, 0, hz - 20)
	reserve(ctx, gh.X, gh.Z, 7)
	Parts.Box(d, gh * CF(0, 4, 0), V3(6, 8, 6), wall, Mat.Concrete, "GuardBooth")
	Parts.Glass(d, gh * CF(-3.05, 5, 0), V3(0.2, 3, 4.4), Color3.fromRGB(160, 220, 255), 0.4, "GuardWindow")
	Parts.Box(d, gh * CF(0, 8.3, 0), V3(7, 0.6, 7), Palette.ConcreteDark, Mat.Concrete, "GuardRoof")
	Parts.Neon(d, gh * CF(-3.05, 7.4, 0), V3(0.2, 0.4, 5), Palette.Yellow, "GuardLight")

	-- Suchscheinwerfer-Türme an den Südecken
	for _, sx in { -1, 1 } do
		local t = at(ctx, sx * (hx - 18), 0, hz - 18)
		reserve(ctx, t.X, t.Z, 6)
		Parts.Box(d, t * CF(0, 9, 0), V3(1.4, 18, 1.4), Palette.MetalDark, Mat.Metal, "TowerPole")
		Parts.Box(d, t * CF(0, 18.3, 0), V3(5, 0.6, 5), Palette.MetalDark, Mat.DiamondPlate, "TowerDeck")
		local headCf = t * CF(0, 19.8, 0) * CFrame.Angles(math.rad(-25), sx * math.rad(30), 0)
		Parts.Box(d, headCf, V3(2.2, 2.2, 2.6), Palette.Metal, Mat.Metal, "Searchlight")
		local lens = Parts.Neon(d, headCf * CF(0, 0, -1.35), V3(1.8, 1.8, 0.1), Palette.White, "Lens")
		if sx == 1 then
			Parts.Light(lens, Color3.fromRGB(220, 240, 255), 60, 3, "Spot", Enum.NormalId.Front)
		end
	end

	-- Kleinkram verstreut: Warnschilder, Fässer, Van
	local signTexts = { { "DANGER", "BIOHAZARD" }, { "RESTRICTED", "LEVEL B4" }, { "WARNING", "HIGH VOLTAGE" } }
	scatter(ctx, 6, 3, function(x, z, i)
		local t = signTexts[(i - 1) % #signTexts + 1]
		Props.WarningSign(d, Parts.FaceTowards(V3(x, WorldConfig.GroundY, z), V3(ctx.C.X, WorldConfig.GroundY, z)), { Text = t[1], Subtext = t[2] })
	end)
	scatter(ctx, 3, 5, function(x, z)
		Props.Barrels(d, CF(x, WorldConfig.GroundY, z) * yaw(ctx), { Count = 3, Toxic = true, Color = Color3.fromRGB(200, 170, 40) })
	end)
	scatter(ctx, 1, 10, function(x, z)
		Props.Van(d, CF(x, WorldConfig.GroundY, z) * yaw(ctx), { Color = Palette.White, StripeColor = Palette.MetalDark })
	end)
	scatter(ctx, 6, 3, function(x, z)
		Props.Crate(d, CF(x, WorldConfig.GroundY, z) * yaw(ctx), { Size = rng:NextNumber(2.5, 4), Color = Color3.fromRGB(90, 110, 80) })
	end)
	-- Bodenmarkierungen (gelbe Streifen)
	for k = -2, 2 do
		Parts.Detail(d, at(ctx, 40, 0.0, k * 30), V3(20, 0.08, 0.8), Palette.Yellow, Mat.SmoothPlastic, "FloorMark")
	end
end

-------------------------------------------------------------------------------
-- RIFT ZONE
-------------------------------------------------------------------------------

local function buildRiftZone(ctx: Ctx)
	local d = ctx.Decor
	local rng = ctx.Rng
	local def = ctx.Def
	local rock = Color3.fromRGB(52, 40, 74)

	-- Senkrechte Risse ("Rift Tears") zuerst, damit sie Platz reservieren
	local tears = { { -70, -20 }, { 75, -70 }, { -90, 95 }, { 60, 50 }, { -60, -95 } }
	for i, t in tears do
		reserve(ctx, ctx.C.X + t[1], ctx.C.Z + t[2], 16)
		local cf = at(ctx, t[1], 0, t[2]) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
		local tear = Props.RiftCrack(d, cf, { Length = rng:NextNumber(18, 30), Width = 2.2, Vertical = true, Color = def.PrimaryColor, Rng = rng })
		if i <= 2 then
			local first = tear:FindFirstChild("Crack") :: BasePart?
			if first then
				Parts.Light(first, def.PrimaryColor, 30, 2.4)
				Parts.Particles(first, { Color = def.SecondaryColor, Rate = 10, Size = 0.4 })
			end
		end
	end
	-- Zerbrochener Boden: gekippte Schollen mit leuchtenden Fugen
	scatter(ctx, 14, 11, function(x, z)
		local sx, sz = rng:NextNumber(14, 24), rng:NextNumber(12, 20)
		local tilt = CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(0, 6.28), rng:NextNumber(-0.12, 0.12))
		local baseCf = CF(x, WorldConfig.GroundY, z) * tilt
		Parts.Neon(d, CF(x, WorldConfig.GroundY - 0.05, z) * (tilt - tilt.Position), V3(sx + 1.6, 0.2, sz + 1.6), def.PrimaryColor, "Seam")
		Parts.Box(d, baseCf * CF(0, rng:NextNumber(0.4, 2.2), 0), V3(sx, 2.4, sz), rock, Mat.Slate, "Slab")
	end)
	-- Risse im Boden
	scatter(ctx, 16, 6, function(x, z, i)
		Props.RiftCrack(d, CF(x, WorldConfig.GroundY, z) * yaw(ctx), {
			Length = rng:NextNumber(10, 22),
			Width = rng:NextNumber(0.8, 1.6),
			Color = if i % 3 == 0 then def.SecondaryColor else def.PrimaryColor,
			Rng = rng,
		})
	end)
	-- Schwebende Erdschollen
	for _ = 1, 14 do
		local x = rng:NextNumber(-ctx.HX + 10, ctx.HX - 10)
		local z = rng:NextNumber(-ctx.HZ + 10, ctx.HZ - 10)
		Props.FloatingIsland(d, at(ctx, x, rng:NextNumber(22, 70), z) * yaw(ctx) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), 0, rng:NextNumber(-0.2, 0.2)), {
			Size = rng:NextNumber(8, 18),
			Color = rock,
			TopColor = Color3.fromRGB(70, 56, 96),
		})
	end
	-- Schwebende Trümmer
	for _ = 1, 18 do
		local x = rng:NextNumber(-ctx.HX + 6, ctx.HX - 6)
		local z = rng:NextNumber(-ctx.HZ + 6, ctx.HZ - 6)
		Props.FloatingDebris(d, at(ctx, x, rng:NextNumber(10, 45), z), { Rng = rng, Count = 3, Color = rock, Size = rng:NextNumber(1.5, 3.5) })
	end
	-- Vorstadt-Trümmer, mitten in der Luft
	local function tilted(x: number, y: number, z: number): CFrame
		return at(ctx, x, y, z) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6.28), rng:NextNumber(-0.6, 0.6))
	end
	Props.Van(d, tilted(55, 24, 5), { Color = Color3.fromRGB(120, 90, 60) })
	Props.House(d, at(ctx, -62, 30, -40) * CFrame.Angles(0.35, 0.8, -0.25), { Color = Parts.HouseColors[2], Lit = false, Width = 20 })
	Props.Streetlamp(d, tilted(-30, 30, 30), { Height = 12, Color = def.SecondaryColor })
	Props.Mailbox(d, tilted(35, 18, 60))
	Props.Bicycle(d, tilted(-38, 16, 15), { Color = Palette.Red })
	Props.PicketFence(d, tilted(48, 36, -40), { Length = 10 })
	Props.ArcadeCabinet(d, tilted(-55, 20, 50), { Title = "RIFT KONG" })
	Props.CRT(d, tilted(28, 14, -12), { Text = "NO SIGNAL" })
	Props.Bench(d, tilted(-28, 22, -75))

	-- Zackige Felsnadeln an den Rändern
	for _, sx in { -1, 1 } do
		for k = 0, 11 do
			local z = -ctx.HZ + 10 + k * (ctx.HZ * 2 - 20) / 11
			local h = rng:NextNumber(18, 40)
			Parts.Box(d, at(ctx, sx * (ctx.HX - 6), h / 2 - 2, z) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6.28), sx * rng:NextNumber(0.05, 0.25)), V3(rng:NextNumber(5, 9), h, rng:NextNumber(5, 9)), rock, Mat.Slate, "Spire")
		end
	end
	emitter(ctx, at(ctx, 0, 10, 0), V3(220, 10, 200), { Color = def.PrimaryColor, Rate = 14, Size = 0.35, Lifetime = 6 })
	emitter(ctx, at(ctx, 0, 30, 0), V3(220, 20, 200), { Color = def.SecondaryColor, Rate = 6, Size = 0.6, Lifetime = 8, Acceleration = V3(0, 1, 0) })
end

-------------------------------------------------------------------------------
-- OTHERWORLD (Spiegel-Vorstadt, Türkis/Magenta, kristallin)
-------------------------------------------------------------------------------

local function buildOtherworld(ctx: Ctx)
	local d = ctx.Decor
	local rng = ctx.Rng
	local def = ctx.Def
	local teal, magenta = def.PrimaryColor, def.SecondaryColor
	local mirrorY = 36
	local houseColors = { Color3.fromRGB(30, 70, 76), Color3.fromRGB(46, 60, 84), Color3.fromRGB(36, 84, 80), Color3.fromRGB(60, 44, 76) }

	-- Häuser an der Straße + ihre Kopfüber-Spiegelbilder am Himmel
	local houses = { { -50, 15 }, { -50, -55 }, { 50, 70 }, { 50, 0 }, { 50, -70 } }
	for i, h in houses do
		local pos = at(ctx, h[1], 0, h[2])
		reserve(ctx, pos.X, pos.Z, 17)
		local cf = Parts.FaceTowards(pos.Position, V3(ctx.C.X, WorldConfig.GroundY, pos.Z))
		local opts = {
			Width = 22,
			Depth = 16,
			Height = 10,
			Color = houseColors[(i - 1) % #houseColors + 1],
			RoofColor = Color3.fromRGB(20, 30, 40),
			WindowColor = if i % 2 == 0 then magenta else teal,
			Garage = i % 2 == 1,
		}
		Props.House(d, cf, opts)
		Props.House(d, flipped(cf, mirrorY), opts)
		-- Kristalle wachsen aus dem Vorgarten
		Props.Crystal(d, cf * CF(rng:NextNumber(-8, 8), 0, -15), { Height = rng:NextNumber(5, 9), Color = magenta, Color2 = teal, Rng = rng })
	end
	-- Kristall-Spitzen
	scatter(ctx, 10, 6, function(x, z, i)
		Props.Crystal(d, CF(x, WorldConfig.GroundY, z), {
			Height = rng:NextNumber(18, 32),
			Color = if i % 2 == 0 then teal else magenta,
			Color2 = if i % 2 == 0 then magenta else teal,
			Rng = rng,
		})
	end)
	scatter(ctx, 16, 2.5, function(x, z, i)
		Props.Crystal(d, CF(x, WorldConfig.GroundY, z), { Height = rng:NextNumber(4, 9), Color = if i % 2 == 0 then teal else magenta, Rng = rng })
	end)
	-- Türkise Bäume + ihre Spiegelbilder
	scatter(ctx, 6, 5, function(x, z)
		local cf = CF(x, WorldConfig.GroundY, z) * yaw(ctx)
		local opts = { Height = rng:NextNumber(18, 26), Tiers = 3, Color = Color3.fromRGB(20, 110, 100), TrunkColor = Color3.fromRGB(40, 30, 60) }
		Props.PineTree(d, cf, opts)
		Props.PineTree(d, flipped(cf, mirrorY + 4), opts)
	end)
	-- Kopfüber hängende Laternen über der Straße
	for k = 0, 3 do
		local z = ctx.HZ - 40 - k * 50
		local side = if k % 2 == 0 then -1 else 1
		local pos = at(ctx, side * 22, 0, z)
		local cf = Parts.FaceTowards(pos.Position, V3(ctx.C.X, WorldConfig.GroundY, pos.Z))
		Props.Streetlamp(d, flipped(cf, mirrorY + 6), { Height = 14, Color = magenta })
	end
	-- Schwebende Kristallsplitter
	for _ = 1, 10 do
		local cf = at(ctx, rng:NextNumber(-ctx.HX + 10, ctx.HX - 10), rng:NextNumber(20, 60), rng:NextNumber(-ctx.HZ + 10, ctx.HZ - 10))
		Parts.Neon(d, cf * CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), 0), V3(1.2, rng:NextNumber(4, 9), 1.2), if rng:NextNumber() < 0.5 then teal else magenta, "FloatingShard")
	end
	-- Spiegelsee
	local lake = at(ctx, -62, 0, -100 + 10)
	reserve(ctx, lake.X, lake.Z, 20)
	local mirror = Parts.Part({
		Parent = d,
		Name = "MirrorLake",
		CFrame = lake * CF(0, 0.1 - 0.15, 0),
		Size = V3(40, 0.3, 26),
		Color = Color3.fromRGB(20, 60, 70),
		Material = Mat.Glass,
		Reflectance = 0.6,
		Transparency = 0.1,
	})
	Parts.Light(mirror, teal, 30, 1.5)
	for _, e in { { 0, -13.4, 41, 0.8 }, { 0, 13.4, 41, 0.8 } } do
		Parts.Neon(d, lake * CF(e[1], 0.08, e[2]), V3(e[3], 0.16, e[4]), magenta, "LakeRim")
	end
	for _, sx in { -1, 1 } do
		Parts.Neon(d, lake * CF(sx * 20.4, 0.08, 0), V3(0.8, 0.16, 26), magenta, "LakeRim")
	end
	-- Sporen
	emitter(ctx, at(ctx, 0, 8, 0), V3(220, 14, 200), { Color = teal, Rate = 18, Size = 0.3, Lifetime = 7, Speed = 0.4 })
	emitter(ctx, at(ctx, 0, 30, 0), V3(220, 20, 200), { Color = magenta, Rate = 10, Size = 0.45, Lifetime = 9, Acceleration = V3(0, -0.6, 0) })
	emitter(ctx, at(ctx, 0, 55, 0), V3(220, 10, 200), { Color = teal, Rate = 8, Size = 0.5, Lifetime = 9, Acceleration = V3(0, -1, 0) })
end

-------------------------------------------------------------------------------
-- THE VOID
-------------------------------------------------------------------------------

local function buildVoid(ctx: Ctx)
	local d = ctx.Decor
	local rng = ctx.Rng
	local def = ctx.Def
	local purple = def.PrimaryColor
	local magenta = Color3.fromRGB(220, 60, 255)

	-- Neon-Raster auf dem Glasboden
	local step = 20
	local x = -ctx.HX + step
	while x < ctx.HX do
		Parts.Neon(d, at(ctx, x, 0.0, 0), V3(0.4, 0.08, ctx.HZ * 2), purple, "GridLine")
		x += step
	end
	local z = -ctx.HZ + step
	while z < ctx.HZ do
		Parts.Neon(d, at(ctx, 0, 0.0, z), V3(ctx.HX * 2, 0.08, 0.4), purple, "GridLine")
		z += step
	end

	-- Endplattform der Straße + riesiges Auge darüber
	local endZ = -ctx.HZ + 40
	Parts.VCyl(d, at(ctx, 0, 0.12 - 0.5, endZ - 6), 1, 50, Color3.fromRGB(16, 8, 30), Mat.Glass, "EndPlatform")
	Parts.VCyl(d, at(ctx, 0, 0.1 - 0.5, endZ - 6), 1, 52, purple, Mat.Neon, "EndRing")
	local eyeCf = at(ctx, 0, 58, -ctx.HZ + 18) -- schaut nach Süden (+Z) -> Rotation 180°
		* CFrame.Angles(0, math.pi, 0)
	Parts.Ring(d, eyeCf, 34, 24, 2.2, 3, purple, Mat.Neon, "EyeRing")
	Parts.Ring(d, eyeCf * CF(0, 0, 1), 27, 20, 1.2, 2, magenta, Mat.Neon, "EyeRingInner")
	local iris = Parts.Part({
		Parent = d,
		Name = "Iris",
		Shape = Enum.PartType.Cylinder,
		CFrame = eyeCf * CF(0, 0, 0.5) * CFrame.Angles(0, math.pi / 2, 0),
		Size = V3(0.6, 30, 30),
		Color = Color3.fromRGB(150, 60, 255),
		Material = Mat.Neon,
		Transparency = 0.1,
		CanCollide = false,
	})
	Parts.Light(iris, purple, 60, 3)
	Parts.Part({
		Parent = d,
		Name = "Pupil",
		Shape = Enum.PartType.Cylinder,
		CFrame = eyeCf * CF(0, 0, -0.2) * CFrame.Angles(0, math.pi / 2, 0),
		Size = V3(1, 12, 12),
		Color = Palette.Black,
		Material = Mat.Glass,
		CanCollide = false,
	})
	Parts.Ball(d, eyeCf * CF(3.5, 3.5, -0.9), 2.6, Palette.White, Mat.Neon, "Glint")
	-- Lider: zwei Bögen eines größeren Kreises
	for _, sy in { -1, 1 } do
		local center = eyeCf * CF(0, -sy * 30, 0)
		-- Bogen von -54° bis +54°: trifft die Lid-Gegenseite bei y = 0 (Augenwinkel)
		for k = -6, 5 do
			local a0, a1 = math.rad(k * 9), math.rad((k + 1) * 9)
			local p0 = center * V3(math.sin(a0) * 52, sy * math.cos(a0) * 52, 0)
			local p1 = center * V3(math.sin(a1) * 52, sy * math.cos(a1) * 52, 0)
			Parts.Beam(d, p0, p1, 1.6, magenta, Mat.Neon, "EyeLid")
		end
	end

	-- Riesige schwebende Würfel (schwarzes Glas mit leuchtendem Kern)
	for _ = 1, 12 do
		local s = rng:NextNumber(8, 22)
		local cf = at(ctx, rng:NextNumber(-ctx.HX + 15, ctx.HX - 15), rng:NextNumber(24, 80), rng:NextNumber(-ctx.HZ + 50, ctx.HZ - 15))
			* CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28))
		Parts.Glass(d, cf, V3(s, s, s), Color3.fromRGB(10, 4, 20), 0.25, "VoidCube")
		Parts.Neon(d, cf, V3(s * 0.6, s * 0.6, s * 0.6), if rng:NextNumber() < 0.5 then purple else magenta, "VoidCore")
	end
	-- Schwebende Ringe
	for _ = 1, 5 do
		local cf = at(ctx, rng:NextNumber(-ctx.HX + 25, ctx.HX - 25), rng:NextNumber(26, 60), rng:NextNumber(-ctx.HZ + 60, ctx.HZ - 30))
			* CFrame.Angles(rng:NextNumber(-1, 1), rng:NextNumber(0, 6.28), 0)
		Parts.Ring(d, cf, rng:NextNumber(9, 16), 12, 1, 1.4, if rng:NextNumber() < 0.5 then purple else Palette.Cyan, Mat.Neon, "VoidRing")
	end
	-- Treppe ins Nichts
	local stairBase = at(ctx, 60, 0, 30) * CFrame.Angles(0, math.rad(-30), 0)
	reserve(ctx, ctx.C.X + 60, ctx.C.Z + 30 - 15, 22)
	for k = 0, 11 do
		Parts.Box(d, stairBase * CF(0, 1 + k * 2.2, -k * 3), V3(8, 1, 3), Color3.fromRGB(20, 10, 36), Mat.Glass, "FloatingStep")
	end
	-- Obelisken
	scatter(ctx, 10, 5, function(ox, oz)
		local h = rng:NextNumber(16, 34)
		local cf = CF(ox, WorldConfig.GroundY + h / 2 + rng:NextNumber(2, 8), oz) * yaw(ctx)
		Parts.Box(d, cf, V3(4, h, 4), Color3.fromRGB(12, 6, 22), Mat.Glass, "Obelisk")
		Parts.Neon(d, cf * CF(0, 0, -2.05), V3(0.5, h - 2, 0.1), purple, "ObeliskGlow")
	end)
	emitter(ctx, at(ctx, 0, 12, 0), V3(220, 20, 200), { Color = purple, Rate = 16, Size = 0.3, Lifetime = 8, Acceleration = V3(0, 0.8, 0) })
	emitter(ctx, at(ctx, 0, 4, 0), V3(220, 4, 200), { Color = Palette.White, Rate = 6, Size = 0.15, Lifetime = 5, Speed = 0.2 })
end

local BUILDERS: { [string]: (Ctx) -> () } = {
	DarkForest = buildDarkForest,
	SecretLab = buildSecretLab,
	RiftZone = buildRiftZone,
	Otherworld = buildOtherworld,
	Void = buildVoid,
}

-------------------------------------------------------------------------------
-- Build
-------------------------------------------------------------------------------

function Areas.Build(def: any, parent: Instance, rng: Random?): Model
	local model = Parts.Model(nil, def.Id)
	model:SetAttribute("AreaId", def.Id)
	local decor = Parts.Folder(model, "Decor")
	local c = def.Center
	local hx, hz = def.Size.X / 2, def.Size.Z / 2
	local ctx: Ctx = {
		Model = model,
		Decor = decor,
		Def = def,
		Rng = rng or Random.new(4000 + def.Order),
		C = V3(c.X, WorldConfig.GroundY, c.Z),
		HX = hx,
		HZ = hz,
		South = c.Z + hz,
		North = c.Z - hz,
		Reserved = {},
	}

	Parts.Part({
		Parent = model,
		Name = "Ground",
		CFrame = CF(c.X, WorldConfig.GroundY - 0.1 - 2, c.Z),
		Size = V3(def.Size.X, 4, def.Size.Z),
		Color = def.GroundColor,
		Material = def.GroundMaterial,
	})

	buildGate(ctx)
	Parts.Invisible(model, CF(c.X, WorldConfig.GroundY + 3, ctx.South - 14), V3(4, 1, 4), "ArrivalPoint", false)
	buildAltar(ctx)

	local builder = BUILDERS[def.Id]
	if builder then
		builder(ctx)
	end

	model.Parent = parent
	return model
end

return Areas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--!strict
-- Hub (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > Hub
--
-- Mystery Suburb: Boden über das ganze Suburb-Gebiet, Roll Plaza mit
-- schwebendem Würfel, SpawnLocation, die fünf Stationen, die Leaderboard-Wand,
-- eine achteckige Ringstraße vor den Plot-Eingängen und 80er-Vorstadt-Deko
-- (Häuser, Zäune, Laternen, Bäume) in den Lücken zwischen den Plots.
--
-- Vertrag mit den Services:
--   Hub/PlazaDie                     Model (PrimaryPart "Core"), schwebt über der Plaza
--   Hub/SpawnLocation                Neutral, Duration 0
--   Hub/Stations/<Name>Station       ShopStation, RebirthStation, IndexStation,
--                                    QuestStation, FishingStation; je ein Part
--                                    "PromptPart" (unsichtbar, für ProximityPrompt)
--                                    und Attribut StationId (= Schlüssel in WorldConfig.Stations)
--   Hub/LeaderboardWall/Board_*      5 leere Tafeln, Front-Fläche zeigt zur Plaza

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local WorldConfig = require(ConfigFolder:WaitForChild("WorldConfig"))
local AreaConfig = require(ConfigFolder:WaitForChild("AreaConfig"))
local DiceConfig = require(ConfigFolder:WaitForChild("DiceConfig"))

local Parts = require(script.Parent:WaitForChild("Parts"))
local Props = require(script.Parent:WaitForChild("Props"))

local Palette = Parts.Palette
local V3 = Vector3.new
local CF = CFrame.new
local Mat = Enum.Material

local Hub = {}

-- Reihenfolge = Reihenfolge an der Wand (links -> rechts, von der Plaza aus gesehen)
Hub.BoardNames = {
	"Board_MostRolls",
	"Board_MostRebirths",
	"Board_TotalCash",
	"Board_RarestCollection",
	"Board_BaseValue",
}

Hub.StationModelNames = {
	Shop = "ShopStation",
	Rebirth = "RebirthStation",
	Index = "IndexStation",
	Quests = "QuestStation",
	Fishing = "FishingStation",
}

local RING_APOTHEM = 162 -- Ringstraße: Abstand Mitte -> Straßenmitte (vor den Plot-Eingängen)
local RING_WIDTH = 14

-- Liegt pos (XZ) innerhalb eines Plots (+ margin)?
function Hub.InsidePlot(pos: Vector3, margin: number): boolean
	local hx = WorldConfig.PlotSize.X / 2 + margin
	local hz = WorldConfig.PlotSize.Z / 2 + margin
	for i = 1, WorldConfig.PlotCount do
		local rel = WorldConfig.PlotCFrame(i):PointToObjectSpace(V3(pos.X, WorldConfig.GroundY, pos.Z))
		if math.abs(rel.X) < hx and math.abs(rel.Z) < hz then
			return true
		end
	end
	return false
end

-- Peilung (Grad, 0 = Norden/-Z, im Uhrzeigersinn) + Radius -> Weltposition
local function polar(bearingDeg: number, radius: number): Vector3
	local a = math.rad(bearingDeg)
	local c = WorldConfig.HubCenter
	return V3(c.X + math.sin(a) * radius, WorldConfig.GroundY, c.Z - math.cos(a) * radius)
end

-------------------------------------------------------------------------------
-- Stationen
-------------------------------------------------------------------------------

type BoothOpts = {
	Width: number,
	Depth: number,
	Height: number,
	Wall: Color3,
	WallMaterial: Enum.Material,
	Trim: Color3,
	Title: string,
	Subtitle: string?,
}

-- Grundbude: Plattform, Rück-/Seitenwände, Dach mit Neonkante, Theke vorne,
-- Schild auf dem Dach. Front (Theke) zeigt zur Plaza (-Z lokal).
local function booth(m: Model, cf: CFrame, o: BoothOpts): BasePart
	local w, d, h = o.Width, o.Depth, o.Height
	Parts.Box(m, cf * CF(0, 0.3, 0), V3(w, 0.6, d), Palette.WoodDark, Mat.WoodPlanks, "Platform")
	Parts.Box(m, cf * CF(0, h / 2, d / 2 - 0.3), V3(w, h, 0.6), o.Wall, o.WallMaterial, "BackWall")
	for _, sx in { -1, 1 } do
		Parts.Box(m, cf * CF(sx * (w / 2 - 0.3), h / 2, d * 0.15), V3(0.6, h, d * 0.7), o.Wall, o.WallMaterial, "SideWall")
		Parts.Box(m, cf * CF(sx * (w / 2 - 0.3), h / 2, -d / 2 + 0.3), V3(0.6, h, 0.6), Palette.WoodDark, Mat.Wood, "Post")
	end
	Parts.Box(m, cf * CF(0, h + 0.3, 0.3), V3(w + 2, 0.6, d + 2), Palette.Navy, Mat.Slate, "Roof")
	Parts.Neon(m, cf * CF(0, h - 0.05, -d / 2 - 0.65), V3(w + 2, 0.35, 0.3), o.Trim, "RoofTrim")
	Parts.Box(m, cf * CF(0, 1.6, -d / 2 + 1.6), V3(w - 3, 3.2, 1.6), o.Wall, o.WallMaterial, "Counter")
	local sign = Parts.Box(m, cf * CF(0, h + 2.2, -d / 2 + 0.3), V3(w * 0.85, 3, 0.4), Palette.Night, Mat.SmoothPlastic, "Sign")
	Parts.SurfaceLabel(sign, Enum.NormalId.Front, o.Title, o.Subtitle, {
		Name = "SignGui",
		TitleColor = o.Trim,
		SubtitleColor = Palette.White,
		PixelsPerStud = 20,
	})
	return sign
end

local function promptPart(m: Model, cf: CFrame): BasePart
	return Parts.Invisible(m, cf, V3(4, 4, 4), "PromptPart", false)
end

local function stationTitle(anchor: BasePart, title: string, subtitle: string, color: Color3)
	Parts.Billboard(anchor, title, subtitle, {
		Name = "TitleGui",
		Offset = V3(0, 5, 0),
		Width = 18,
		Height = 5,
		TitleColor = color,
		MaxDistance = 220,
	})
end

local function buildShop(m: Model, cf: CFrame)
	local trim = Palette.Orange
	local sign = booth(m, cf, {
		Width = 16,
		Depth = 10,
		Height = 9,
		Wall = Palette.Wood,
		WallMaterial = Mat.WoodPlanks,
		Trim = trim,
		Title = "MILBROOK SURPLUS",
		Subtitle = "TRADING POST",
	})
	stationTitle(sign, "SHOP", "DICE & GEAR", trim)
	-- Regale mit Waren an der Rückwand
	for _, y in { 4, 6.4 } do
		Parts.Box(m, cf * CF(0, y, 3.6), V3(13, 0.3, 1.4), Palette.WoodDark, Mat.Wood, "Shelf")
	end
	local wares = { Palette.Red, Palette.Yellow, Palette.Cyan, Palette.Green, Palette.Magenta, Palette.White }
	for i, c in wares do
		local x = -5 + ((i - 1) % 3) * 5
		local y = if i <= 3 then 4.75 else 7.15
		Parts.Box(m, cf * CF(x, y, 3.6), V3(1.4, 1.2, 1), c, Mat.SmoothPlastic, "Ware")
	end
	Props.Crate(m, cf * CF(10.2, 0, -2.5))
	Props.Crate(m, cf * CF(10.2, 3, -2.5) * CFrame.Angles(0, 0.3, 0), { Size = 2.6 })
	Props.Crate(m, cf * CF(10.6, 0, 1.2), { Size = 2.6 })
	Props.ArcadeCabinet(m, cf * CF(-10.5, 0, -2), { Title = "VOID RUN", Color = trim })
	local prompt = promptPart(m, cf * CF(0, 3, -7))
	Parts.Light(prompt, trim, 18, 1.3)
end

local function buildRebirth(m: Model, cf: CFrame)
	local glow = Palette.Purple
	Parts.VCyl(m, cf * CF(0, 0.5, 0), 1, 16, Palette.MetalDark, Mat.DiamondPlate, "Base")
	Parts.VCyl(m, cf * CF(0, 0.35, 0), 0.7, 16.8, glow, Mat.Neon, "BaseGlow")
	for _, sx in { -1, 1 } do
		Parts.Box(m, cf * CF(sx * 6, 6, 0), V3(2, 11, 2), Palette.Metal, Mat.Metal, "Pillar")
		for k = 1, 3 do
			Parts.VCyl(m, cf * CF(sx * 6, 2.5 + k * 2.4, 0), 0.4, 2.8, glow, Mat.Neon, "Coil")
		end
	end
	Parts.Box(m, cf * CF(0, 12, 0), V3(14.5, 1.4, 2.4), Palette.Metal, Mat.Metal, "TopBar")
	Parts.Ring(m, cf * CF(0, 6.4, 0), 4.6, 12, 0.9, 1.2, glow, Mat.Neon, "RiftRing")
	local rift = Parts.Part({
		Parent = m,
		Name = "Rift",
		Shape = Enum.PartType.Cylinder,
		CFrame = cf * CF(0, 6.4, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Size = V3(0.3, 8.6, 8.6),
		Color = Color3.fromRGB(190, 90, 255),
		Material = Mat.Neon,
		Transparency = 0.15,
		CanCollide = false,
	})
	Parts.Light(rift, glow, 24, 2)
	Parts.Particles(rift, { Color = Palette.Magenta, Rate = 8, Size = 0.4 })
	local sign = Parts.Box(m, cf * CF(0, 14, 0), V3(13, 2.6, 0.4), Palette.Night, Mat.SmoothPlastic, "Sign")
	Parts.SurfaceLabel(sign, Enum.NormalId.Front, "REBIRTH CHAMBER", nil, { Name = "SignGui", TitleColor = glow })
	stationTitle(sign, "REBIRTH", "RESET FOR POWER", glow)
	-- Konsole vor der Maschine
	Parts.Box(m, cf * CF(0, 1.8, -5) * CFrame.Angles(math.rad(-15), 0, 0), V3(4, 2.4, 1.6), Palette.Navy, Mat.Metal, "Console")
	Parts.Neon(m, cf * CF(0, 3.1, -5.3) * CFrame.Angles(math.rad(-40), 0, 0), V3(3.2, 0.1, 1), Palette.Cyan, "ConsoleScreen")
	for _, sx in { -1, 1 } do
		Parts.Beam(m, cf * V3(sx * 6, 1.1, -1), cf * V3(sx * 1.6, 1.1, -5), 0.35, Palette.Black, Mat.Rubber, "Cable")
	end
	promptPart(m, cf * CF(0, 3, -8))
end

local function buildIndex(m: Model, cf: CFrame)
	local trim = Palette.Cyan
	local sign = booth(m, cf, {
		Width = 14,
		Depth = 10,
		Height = 9,
		Wall = Palette.NavyLight,
		WallMaterial = Mat.Metal,
		Trim = trim,
		Title = "COUNTY RECORDS",
		Subtitle = "ARCHIVE",
	})
	stationTitle(sign, "INDEX", "YOUR COLLECTION", trim)
	for i = 0, 3 do
		local x = -4.5 + i * 3
		Parts.Box(m, cf * CF(x, 3.1, 3.6), V3(2.6, 5, 2), Palette.Metal, Mat.Metal, "FilingCabinet")
		Parts.Neon(m, cf * CF(x, 4.6, 2.58), V3(1.6, 0.18, 0.06), if i % 2 == 0 then trim else Palette.Amber, "DrawerLabel")
	end
	Props.CRT(m, cf * CF(-2.5, 3.2, -3.4), { ScreenColor = trim, Text = "INDEX\n> LOAD" })
	Parts.Box(m, cf * CF(3, 3.6, -3.4) * CFrame.Angles(0, 0.2, 0), V3(2, 0.8, 1.5), Palette.Paper, Mat.SmoothPlastic, "Papers")
	Parts.Box(m, cf * CF(4.8, 3.45, -3.2) * CFrame.Angles(0, -0.3, 0), V3(1.6, 0.5, 1.2), Palette.Paper, Mat.SmoothPlastic, "Papers")
	local prompt = promptPart(m, cf * CF(0, 3, -7))
	Parts.Light(prompt, trim, 18, 1.2)
end

local function buildQuests(m: Model, cf: CFrame)
	local trim = Palette.Yellow
	for _, sx in { -1, 1 } do
		Parts.Box(m, cf * CF(sx * 7.5, 5.5, 0.4), V3(1, 11, 1), Palette.WoodDark, Mat.Wood, "Post")
	end
	Parts.Box(m, cf * CF(0, 6, 0.4), V3(15.4, 8.4, 0.6), Palette.WoodDark, Mat.Wood, "Frame")
	Parts.Box(m, cf * CF(0, 6, 0.05), V3(14, 7, 0.2), Palette.Cork, Mat.Fabric, "Cork")
	Parts.Box(m, cf * CF(0, 11, 0) * CFrame.Angles(math.rad(-20), 0, 0), V3(17, 0.5, 3), Palette.Navy, Mat.Slate, "Roof")
	local notes = {
		{ -5, 8, Palette.Paper },
		{ -2, 7.6, Color3.fromRGB(250, 236, 140) },
		{ 1.5, 8.1, Palette.Paper },
		{ 5, 7.7, Color3.fromRGB(255, 180, 190) },
		{ -4.2, 4.6, Palette.Paper },
		{ -0.6, 4.4, Color3.fromRGB(180, 220, 255) },
		{ 3, 4.8, Palette.Paper },
		{ 5.6, 4.2, Palette.Paper },
	}
	for i, n in notes do
		Parts.Detail(m, cf * CF(n[1], n[2], -0.1) * CFrame.Angles(0, 0, (i % 3 - 1) * 0.08), V3(2.2, 2.6, 0.05), n[3], Mat.SmoothPlastic, "Note")
		if i % 2 == 1 then
			Parts.Ball(m, cf * CF(n[1], n[2] + 1.1, -0.18), 0.3, Palette.Red, Mat.Neon, "Pin")
		end
	end
	for _, sx in { -4, 4 } do
		Parts.Neon(m, cf * CF(sx, 10.2, -1), V3(1.6, 0.4, 0.6), trim, "Lamp")
	end
	local sign = Parts.Box(m, cf * CF(0, 12.4, -0.4), V3(12, 2.4, 0.4), Palette.Night, Mat.SmoothPlastic, "Sign")
	Parts.SurfaceLabel(sign, Enum.NormalId.Front, "NOTICE BOARD", nil, { Name = "SignGui", TitleColor = trim })
	stationTitle(sign, "QUESTS", "HELP WANTED", trim)
	Props.Bench(m, cf * CF(-10.5, 0, -1) * CFrame.Angles(0, math.rad(-30), 0), { Width = 5 })
	local prompt = promptPart(m, cf * CF(0, 3, -3.5))
	Parts.Light(prompt, trim, 16, 1.2)
end

local function buildFishing(m: Model, cf: CFrame)
	local trim = Palette.Teal
	local sign = booth(m, cf, {
		Width = 14,
		Depth = 10,
		Height = 9,
		Wall = Color3.fromRGB(70, 110, 120),
		WallMaterial = Mat.WoodPlanks,
		Trim = trim,
		Title = "BAIT & TACKLE",
		Subtitle = "RIFT FISHING",
	})
	stationTitle(sign, "FISHING", "RODS & BAIT", trim)
	for i = 0, 2 do
		local x = 7.6 + i * 0.6
		Parts.Beam(m, cf * V3(x, 0.2, -2 + i * 1.4), cf * V3(x - 0.2, 8.5, -1.2 + i * 1.4), 0.15, Palette.WoodLight, Mat.Wood, "FishingRod")
	end
	Parts.Box(m, cf * CF(-9, 1.2, -2.5), V3(3, 2.4, 2), Palette.White, Mat.SmoothPlastic, "Cooler")
	Parts.Box(m, cf * CF(-9, 2.55, -2.5), V3(3.1, 0.3, 2.1), Palette.ElectricBlue, Mat.SmoothPlastic, "CoolerLid")
	Parts.VCyl(m, cf * CF(-9, 0.6, 0.4), 1.2, 1.4, Palette.Red, Mat.Metal, "BaitBucket")
	-- Leuchtfisch auf dem Dach
	local fish = Parts.Neon(m, cf * CF(0, 14.6, 0.5), V3(5, 2.2, 0.6), trim, "FishSign")
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = fish
	Parts.Neon(m, cf * CF(3.2, 14.6, 0.5) * CFrame.Angles(0, 0, math.rad(45)), V3(1.6, 1.6, 0.4), trim, "FishTail")
	Parts.Cyl(m, cf * CF(5.5, 5, 4.6) * CFrame.Angles(0, math.pi / 2, 0), 0.4, 2.6, Palette.Red, Mat.SmoothPlastic, "LifeRing")
	local prompt = promptPart(m, cf * CF(0, 3, -7))
	Parts.Light(prompt, trim, 18, 1.2)
end

local STATION_BUILDERS: { [string]: (Model, CFrame) -> () } = {
	Shop = buildShop,
	Rebirth = buildRebirth,
	Index = buildIndex,
	Quests = buildQuests,
	Fishing = buildFishing,
}

-------------------------------------------------------------------------------
-- Leaderboard-Wand
-------------------------------------------------------------------------------

local BOARD_SIZE = V3(14, 18, 1)
local BOARD_GAP = 3

local function buildLeaderboards(hub: Model, pos: Vector3): (Model, { [string]: BasePart })
	local m = Parts.Model(hub, "LeaderboardWall")
	-- Front (-Z lokal) zeigt zur Plaza
	local cf = Parts.FaceTowards(pos, WorldConfig.HubCenter)
	local n = #Hub.BoardNames
	local total = n * BOARD_SIZE.X + (n - 1) * BOARD_GAP
	Parts.Box(m, cf * CF(0, 0.5, 0.5), V3(total + 6, 1, 8), Palette.ConcreteDark, Mat.Concrete, "Base")
	Parts.Box(m, cf * CF(0, 12, 1.4), V3(total + 4, 22, 1), Palette.Navy, Mat.Slate, "Backing")
	for _, sx in { -1, 1 } do
		Parts.Box(m, cf * CF(sx * (total / 2 + 2.5), 13, 1), V3(2, 26, 2), Palette.NavyLight, Mat.Metal, "Pillar")
		Parts.Ball(m, cf * CF(sx * (total / 2 + 2.5), 26.6, 1), 1.6, Palette.Purple, Mat.Neon, "PillarCap")
	end
	local header = Parts.Box(m, cf * CF(0, 24.6, 1), V3(40, 4, 0.8), Palette.Night, Mat.SmoothPlastic, "Header")
	Parts.SurfaceLabel(header, Enum.NormalId.Front, "HALL OF RECORDS", nil, { Name = "HeaderGui", TitleColor = Palette.Amber })
	Parts.Neon(m, cf * CF(0, 22.4, 0.7), V3(total + 4, 0.4, 0.4), Palette.Purple, "HeaderTrim")

	local boards: { [string]: BasePart } = {}
	for i, name in Hub.BoardNames do
		local x = -total / 2 + BOARD_SIZE.X / 2 + (i - 1) * (BOARD_SIZE.X + BOARD_GAP)
		local y = 2 + BOARD_SIZE.Y / 2
		Parts.Neon(m, cf * CF(x, y, 0.75), V3(BOARD_SIZE.X + 0.8, BOARD_SIZE.Y + 0.8, 0.3), Palette.ElectricBlue, "BoardFrame")
		local board = Parts.Part({
			Parent = m,
			Name = name,
			CFrame = cf * CF(x, y, 0),
			Size = BOARD_SIZE,
			Color = Palette.Night,
			Material = Mat.SmoothPlastic,
		})
		boards[name] = board
	end
	return m, boards
end

-------------------------------------------------------------------------------
-- Plaza + Würfel-Statue
-------------------------------------------------------------------------------

local function buildPlaza(hub: Model, decor: Folder)
	local c = WorldConfig.HubCenter
	local r = WorldConfig.PlazaRadius
	local base = CF(c.X, WorldConfig.GroundY, c.Z)
	Parts.VCyl(decor, base * CF(0, -0.4, 0), 1, r * 2, Color3.fromRGB(54, 50, 74), Mat.Pavement, "Plaza")
	Parts.VCyl(decor, base * CF(0, -0.45, 0), 0.9, r * 2 + 2, Palette.Purple, Mat.Neon, "PlazaRing")
	Parts.VCyl(decor, base * CF(0, -0.35, 0), 1, 30, Palette.Navy, Mat.Slate, "InnerCircle")
	Parts.VCyl(decor, base * CF(0, -0.38, 0), 1, 31.4, Palette.ElectricBlue, Mat.Neon, "InnerRing")
	for k = 0, 7 do
		local a = math.rad(k * 45 + 22.5)
		local mid = (15.7 + r) / 2
		Parts.Neon(decor, base * CFrame.Angles(0, -a, 0) * CF(0, 0.12, -mid), V3(0.5, 0.06, r - 15.7), Palette.PurpleDeep, "PlazaLine")
	end
	-- Sockel mit Lichtsäule
	Parts.VCyl(decor, base * CF(0, 1, 0), 2, 12, Palette.NavyLight, Mat.Slate, "Pedestal")
	Parts.VCyl(decor, base * CF(0, 1.9, 0), 0.4, 12.6, Palette.Purple, Mat.Neon, "PedestalRing")
	Parts.Part({
		Parent = decor,
		Name = "LightColumn",
		Shape = Enum.PartType.Cylinder,
		CFrame = base * CF(0, 6, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Size = V3(8, 3, 3),
		Color = Color3.fromRGB(180, 140, 255),
		Material = Mat.Neon,
		Transparency = 0.55,
		CanCollide = false,
	})
	-- Schwebender Würfel (Basic-Dice-Farben, gekippt -> Ecke nach oben)
	local basic = DiceConfig.Get(DiceConfig.Default)
	local dieCf = base * CF(0, 17, 0) * CFrame.Angles(math.rad(35.26), 0, math.rad(45))
	local die = Props.Die(hub, dieCf, {
		Name = "PlazaDie",
		Size = 10,
		Color = if basic then basic.Color else Palette.White,
		PipColor = Palette.Purple,
	})
	Parts.Light(die.PrimaryPart :: BasePart, Palette.Purple, 30, 2)
	-- Bänke und Laternen
	for k = 0, 3 do
		local pos = polar(45 + k * 90, r - 7)
		Props.Bench(decor, Parts.FaceTowards(pos, c))
	end
	for k = 0, 5 do
		local pos = polar(30 + k * 60, r - 2.5)
		Props.Streetlamp(decor, Parts.FaceTowards(pos, c), { Height = 13, Color = Palette.Amber, Light = true, Range = 30 })
	end
end

-------------------------------------------------------------------------------
-- Ringstraße (Achteck, Kanten vor den Plot-Eingängen)
-------------------------------------------------------------------------------

local function buildRingStreet(decor: Folder)
	local segLen = 2 * RING_APOTHEM * math.tan(math.rad(22.5)) + 2
	for k = 0, 7 do
		local bearing = WorldConfig.PlotAngleOffset + k * 45
		local pos = polar(bearing, RING_APOTHEM)
		local cf = Parts.FaceTowards(pos, WorldConfig.HubCenter)
		local top = if k % 2 == 0 then 0 else 0.012
		Parts.Box(decor, cf * CF(0, top - 0.5, 0), V3(segLen, 1, RING_WIDTH), Palette.Asphalt, Mat.Asphalt, "RingStreet")
		-- Mittellinie (ein Streifen pro Segment)
		Parts.Box(decor, cf * CF(0, top + 0.02, 0), V3(segLen * 0.7, 0.06, 0.4), Palette.Yellow, Mat.SmoothPlastic, "LaneLine")
		local corner = polar(k * 45, RING_APOTHEM / math.cos(math.rad(22.5)))
		Parts.VCyl(decor, CF(corner.X, 0.02 - 0.5, corner.Z), 1, RING_WIDTH + 1.5, Palette.Asphalt, Mat.Asphalt, "RingCorner")
	end
end

-------------------------------------------------------------------------------
-- Vorstadt-Deko
-------------------------------------------------------------------------------

local function buildSuburbDecor(decor: Folder, rng: Random)
	local c = WorldConfig.HubCenter
	local houseSpots = {}
	local function addHouse(bearing: number, radius: number)
		local pos = polar(bearing, radius)
		local cf = Parts.FaceTowards(pos, c)
		local w = rng:NextInteger(20, 24)
		local d = 16
		Props.House(decor, cf, {
			Width = w,
			Depth = d,
			Height = rng:NextInteger(9, 11),
			Color = Parts.HouseColors[rng:NextInteger(1, #Parts.HouseColors)],
			Garage = rng:NextNumber() < 0.5,
			Lit = rng:NextNumber() < 0.7,
		})
		-- Vorgarten: Zaun mit Lücke, Briefkasten, zwei Tannen
		for _, sx in { -1, 1 } do
			Props.PicketFence(decor, cf * CF(sx * (w / 4 + 1.5), 0, -(d / 2 + 7)), { Length = w / 2 - 3 })
			Props.PineTree(decor, cf * CF(sx * (w / 2 + 8), 0, 2), { Height = rng:NextNumber(16, 22), Tiers = 3 })
		end
		Props.Mailbox(decor, cf * CF(w / 2 - 1, 0, -(d / 2 + 9.5)))
		table.insert(houseSpots, pos)
	end
	for _, bearing in { 45, 90, 135, 180, 225, 270, 315 } do
		addHouse(bearing, 252)
	end
	for _, bearing in { 45, 135, 225, 315 } do
		addHouse(bearing, 345)
	end
	-- Ein paar Fahrzeuge vor den Häusern
	Props.Van(decor, Parts.FaceTowards(polar(84, 226), c) * CFrame.Angles(0, math.pi / 2, 0), { Color = Palette.White, StripeColor = Palette.Red })
	Props.Bicycle(decor, Parts.FaceTowards(polar(186, 232), c) * CFrame.Angles(0, 1.2, 0), { Color = Palette.Red, Lean = 0.15 })
	Props.Bicycle(decor, Parts.FaceTowards(polar(174, 232), c) * CFrame.Angles(0, 1.6, 0), { Color = Palette.ElectricBlue, Lean = -0.15 })

	-- Laternen an den Ecken der Ringstraße (außer Norden: dort ist die Road)
	for k = 1, 7 do
		local pos = polar(k * 45, RING_APOTHEM / math.cos(math.rad(22.5)) + 10)
		Props.Streetlamp(decor, Parts.FaceTowards(pos, c), { Height = 14 })
	end

	-- Baumgürtel am Rand des Suburbs (nicht in Plots, nicht auf der Road, nicht an Häusern)
	local suburb = AreaConfig.Get("Suburb")
	assert(suburb, "AreaConfig: Suburb fehlt")
	local hx, hz = suburb.Size.X / 2 - 7, suburb.Size.Z / 2 - 7
	local roadClear = WorldConfig.RoadWidth / 2 + 12
	local function tryTree(x: number, z: number)
		local pos = V3(suburb.Center.X + x, WorldConfig.GroundY, suburb.Center.Z + z)
		if Hub.InsidePlot(pos, 6) then
			return
		end
		if z < 0 and math.abs(x) < roadClear then
			return
		end
		for _, h in houseSpots do
			if (h - pos).Magnitude < 24 then
				return
			end
		end
		local jitter = V3(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		Props.PineTree(decor, CF(pos + jitter) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), {
			Height = rng:NextNumber(22, 32),
			Tiers = 2,
			Color = if rng:NextNumber() < 0.5 then Palette.Leaf else Palette.LeafDark,
		})
	end
	local step = 24
	local x = -hx
	while x <= hx do
		tryTree(x, -hz)
		tryTree(x, hz)
		x += step
	end
	local z = -hz + step
	while z <= hz - step do
		tryTree(-hx, z)
		tryTree(hx, z)
		z += step
	end

	-- Arcade-Ecke östlich der Plaza (Gegenstück zur Fishing-Station im Westen)
	local arcadePos = V3(c.X + 86, WorldConfig.GroundY, c.Z)
	local acf = Parts.FaceTowards(arcadePos, c)
	for i = -1, 1 do
		Props.ArcadeCabinet(decor, acf * CF(i * 3.4, 0, 1.5), {
			Title = ({ "ROLL RAIDERS", "VOID RUN", "RIFT KONG" })[i + 2],
			Color = ({ Palette.Magenta, Palette.Cyan, Palette.Yellow })[i + 2],
		})
	end
	for _, sx in { -1, 1 } do
		Parts.Box(decor, acf * CF(sx * 7, 4.5, -1.5), V3(0.6, 9, 0.6), Palette.MetalDark, Mat.Metal, "CanopyPost")
	end
	Parts.Box(decor, acf * CF(0, 9.2, 0.5), V3(16, 0.5, 7), Palette.Navy, Mat.Slate, "Canopy")
	local arcadeSign = Parts.Neon(decor, acf * CF(0, 10.4, -2.8), V3(9, 1.8, 0.3), Palette.Magenta, "ArcadeSign")
	Parts.SurfaceLabel(arcadeSign, Enum.NormalId.Front, "ARCADE", nil, { TitleColor = Palette.Night })

	-- Wegweiser an der Signal Road
	local forest = AreaConfig.Get("DarkForest")
	local signPos = V3(c.X - WorldConfig.RoadWidth / 2 - 8, WorldConfig.GroundY, c.Z - WorldConfig.PlazaRadius - 20)
	local scf = CF(signPos) * CFrame.Angles(0, math.pi, 0) -- schaut nach Süden (zur Plaza)
	for _, sx in { -4, 4 } do
		Parts.Box(decor, scf * CF(sx, 3.5, 0.2), V3(0.6, 7, 0.6), Palette.Metal, Mat.Metal, "SignPost")
	end
	local roadSign = Parts.Box(decor, scf * CF(0, 6, 0), V3(10, 3.4, 0.3), Color3.fromRGB(30, 110, 70), Mat.SmoothPlastic, "RoadSign")
	Parts.SurfaceLabel(roadSign, Enum.NormalId.Front, "SIGNAL ROAD", (if forest then forest.DisplayName else "DARK FOREST") .. "  ^", {
		Name = "RoadSignGui",
		TitleColor = Palette.White,
		Font = Enum.Font.Michroma,
	})
end

-------------------------------------------------------------------------------
-- Build
-------------------------------------------------------------------------------

export type HubResult = {
	Model: Model,
	Stations: { [string]: Model },
	Leaderboards: { [string]: BasePart },
	SpawnLocation: SpawnLocation,
	PlazaDie: Model,
}

function Hub.Build(parent: Instance, rng: Random): HubResult
	local hub = Parts.Model(nil, "Hub")
	hub:SetAttribute("AreaId", "Suburb")
	local decor = Parts.Folder(hub, "Decor")
	local stationsFolder = Parts.Folder(hub, "Stations")

	-- Boden über das gesamte Suburb-Gebiet (Oberkante knapp unter y = 0, damit
	-- Plaza, Straßen und Plots darüber nicht flackern)
	local suburb = AreaConfig.Get("Suburb")
	assert(suburb, "AreaConfig: Suburb fehlt")
	Parts.Part({
		Parent = hub,
		Name = "Ground",
		CFrame = CF(suburb.Center.X, WorldConfig.GroundY - 0.1 - 2, suburb.Center.Z),
		Size = V3(suburb.Size.X, 4, suburb.Size.Z),
		Color = suburb.GroundColor,
		Material = suburb.GroundMaterial,
	})

	buildPlaza(hub, decor)
	local plazaDie = hub:FindFirstChild("PlazaDie") :: Model

	-- SpawnLocation (Oberkante knapp über der Plaza)
	local c = WorldConfig.HubCenter
	local so = WorldConfig.SpawnOffset
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = V3(10, 1, 10)
	spawn.CFrame = CF(c.X + so.X, WorldConfig.GroundY + 0.18 - 0.5, c.Z + so.Z)
	spawn.Color = Palette.Purple
	spawn.Material = Mat.Neon
	spawn.Transparency = 0.35
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.AllowTeamChangeOnTouch = false
	spawn.Parent = hub
	Parts.Stats.Parts += 1

	-- Stationen
	local stations: { [string]: Model } = {}
	for stationId, modelName in Hub.StationModelNames do
		local pos = (WorldConfig.Stations :: any)[stationId] :: Vector3
		local m = Parts.Model(stationsFolder, modelName)
		m:SetAttribute("StationId", stationId)
		local cf = Parts.FaceTowards(V3(pos.X, WorldConfig.GroundY, pos.Z), c)
		STATION_BUILDERS[stationId](m, cf)
		stations[modelName] = m
	end

	local lbPos = WorldConfig.Stations.Leaderboards
	local _, boards = buildLeaderboards(hub, V3(lbPos.X, WorldConfig.GroundY, lbPos.Z))

	buildRingStreet(decor)
	buildSuburbDecor(decor, rng)

	hub.Parent = parent
	return {
		Model = hub,
		Stations = stations,
		Leaderboards = boards,
		SpawnLocation = spawn,
		PlazaDie = plazaDie,
	}
end

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Parts</string>
            <string name="Source"><![CDATA[--!strict
-- Parts (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > Parts
--
-- Kleiner Baukasten für die prozedurale Map. Alle Builder (Props, Hub, Plot,
-- Areas, Road) erzeugen ihre Teile ausschließlich über diese Helfer, damit
--   * Defaults (Anchored, Smooth Surfaces, CanTouch aus ...) überall gleich sind,
--   * die Farbpalette zentral bleibt,
--   * Lichter global gedeckelt werden (Performance auf Mobile).
--
-- Konvention für CFrames: "Front" eines Teils = LookVector (lokal -Z).
-- Zylinder liegen in Roblox entlang der lokalen X-Achse; für stehende
-- Zylinder gibt es VCyl/Disc.

local Parts = {}

export type Opts = { [string]: any }

-------------------------------------------------------------------------------
-- Palette (80s Mystery: Navy, Lila, Elektrisch-Blau, warmes Orange, Rot)
-------------------------------------------------------------------------------
Parts.Palette = {
	Navy = Color3.fromRGB(20, 22, 48),
	NavyLight = Color3.fromRGB(38, 42, 82),
	Night = Color3.fromRGB(12, 12, 26),
	Asphalt = Color3.fromRGB(38, 38, 50),
	AsphaltDark = Color3.fromRGB(26, 26, 36),
	Concrete = Color3.fromRGB(98, 100, 112),
	ConcreteDark = Color3.fromRGB(64, 66, 78),
	Wood = Color3.fromRGB(116, 78, 50),
	WoodDark = Color3.fromRGB(72, 48, 34),
	WoodLight = Color3.fromRGB(170, 128, 86),
	Metal = Color3.fromRGB(86, 90, 104),
	MetalDark = Color3.fromRGB(42, 44, 56),
	Black = Color3.fromRGB(14, 12, 20),
	White = Color3.fromRGB(232, 230, 238),
	Beige = Color3.fromRGB(198, 186, 158),
	Paper = Color3.fromRGB(238, 228, 198),
	Cork = Color3.fromRGB(176, 130, 82),
	Bark = Color3.fromRGB(64, 46, 36),
	BarkGrey = Color3.fromRGB(78, 74, 72),
	Leaf = Color3.fromRGB(30, 62, 44),
	LeafDark = Color3.fromRGB(20, 42, 32),
	Rock = Color3.fromRGB(72, 70, 84),
	Purple = Color3.fromRGB(150, 70, 255),
	PurpleDeep = Color3.fromRGB(70, 30, 140),
	ElectricBlue = Color3.fromRGB(60, 140, 255),
	Cyan = Color3.fromRGB(70, 230, 255),
	Orange = Color3.fromRGB(255, 150, 60),
	Amber = Color3.fromRGB(255, 196, 90),
	Red = Color3.fromRGB(236, 40, 52),
	Yellow = Color3.fromRGB(255, 212, 70),
	Green = Color3.fromRGB(70, 224, 110),
	Magenta = Color3.fromRGB(255, 70, 190),
	Teal = Color3.fromRGB(40, 230, 190),
	Screen = Color3.fromRGB(90, 255, 150),
}

-- Farben der Lichterketten ("Communication Lights")
Parts.BulbColors = {
	Color3.fromRGB(255, 60, 60),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(60, 160, 255),
	Color3.fromRGB(80, 230, 110),
	Color3.fromRGB(255, 120, 40),
	Color3.fromRGB(230, 90, 255),
}

-- Hausfarben (80er Holzverkleidung, leicht entsättigt)
Parts.HouseColors = {
	Color3.fromRGB(150, 120, 96),
	Color3.fromRGB(96, 116, 140),
	Color3.fromRGB(140, 140, 112),
	Color3.fromRGB(122, 96, 112),
	Color3.fromRGB(104, 128, 108),
	Color3.fromRGB(170, 150, 120),
}

-------------------------------------------------------------------------------
-- Statistik / Limits
-------------------------------------------------------------------------------
Parts.MaxLights = 60
Parts.Stats = { Parts = 0, Lights = 0, SkippedLights = 0 }

function Parts.ResetStats()
	Parts.Stats.Parts = 0
	Parts.Stats.Lights = 0
	Parts.Stats.SkippedLights = 0
end

-------------------------------------------------------------------------------
-- Grundbausteine
-------------------------------------------------------------------------------

-- Universeller Part-Konstruktor. Felder in props:
--   Class, Name, Parent, CFrame, Size, Color, Material, Transparency,
--   Reflectance, Shape, CanCollide, CanQuery, CastShadow, Attributes
function Parts.Part(props: Opts): BasePart
	local part = Instance.new(props.Class or "Part") :: any
	part.Name = props.Name or "Part"
	part.Anchored = true
	if props.Shape ~= nil then
		part.Shape = props.Shape
	end
	part.Size = props.Size or Vector3.new(4, 1, 4)
	part.CFrame = props.CFrame or CFrame.new()
	part.Color = props.Color or Parts.Palette.Concrete
	local material = props.Material or Enum.Material.SmoothPlastic
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanTouch = false -- niemand nutzt Touched auf Map-Teilen
	local canCollide = if props.CanCollide == nil then true else props.CanCollide
	part.CanCollide = canCollide
	part.CanQuery = if props.CanQuery == nil then canCollide else props.CanQuery
	if props.CastShadow ~= nil then
		part.CastShadow = props.CastShadow
	elseif material == Enum.Material.Neon or not canCollide then
		part.CastShadow = false
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Reflectance then
		part.Reflectance = props.Reflectance
	end
	if props.Attributes then
		for key, value in props.Attributes do
			part:SetAttribute(key, value)
		end
	end
	part.Parent = props.Parent
	Parts.Stats.Parts += 1
	return part
end

function Parts.Box(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Parts.Part({ Parent = parent, CFrame = cf, Size = size, Color = color, Material = material, Name = name })
end

-- Leuchtendes Deko-Teil (ohne Kollision, ohne Schatten)
function Parts.Neon(parent: Instance, cf: CFrame, size: Vector3, color: Color3, name: string?, transparency: number?): BasePart
	return Parts.Part({
		Parent = parent,
		CFrame = cf,
		Size = size,
		Color = color,
		Material = Enum.Material.Neon,
		Name = name or "Neon",
		CanCollide = false,
		Transparency = transparency,
	})
end

function Parts.Glass(parent: Instance, cf: CFrame, size: Vector3, color: Color3, transparency: number?, name: string?): BasePart
	return Parts.Part({
		Parent = parent,
		CFrame = cf,
		Size = size,
		Color = color,
		Material = Enum.Material.Glass,
		Transparency = transparency or 0.5,
		Name = name or "Glass",
	})
end

-- Deko ohne Kollision (Kabel, Papiere, Schnüre ...)
function Parts.Detail(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Parts.Part({
		Parent = parent,
		CFrame = cf,
		Size = size,
		Color = color,
		Material = material,
		Name = name or "Detail",
		CanCollide = false,
	})
end

-- Unsichtbares Hilfsteil (PromptPart, SpawnPoint, ArrivalPoint, Grenzen)
function Parts.Invisible(parent: Instance, cf: CFrame, size: Vector3, name: string, canCollide: boolean?): BasePart
	return Parts.Part({
		Parent = parent,
		CFrame = cf,
		Size = size,
		Name = name,
		Transparency = 1,
		CanCollide = canCollide == true,
		CanQuery = canCollide == true,
		CastShadow = false,
		Color = Parts.Palette.White,
	})
end

-- Zylinder entlang der lokalen X-Achse von cf
function Parts.Cyl(parent: Instance, cf: CFrame, length: number, diameter: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Parts.Part({
		Parent = parent,
		CFrame = cf,
		Size = Vector3.new(length, diameter, diameter),
		Color = color,
		Material = material,
		Shape = Enum.PartType.Cylinder,
		Name = name or "Cylinder",
	})
end

-- Stehender Zylinder; cf = Mittelpunkt
function Parts.VCyl(parent: Instance, cf: CFrame, height: number, diameter: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Parts.Cyl(parent, cf * CFrame.Angles(0, 0, math.pi / 2), height, diameter, color, material, name)
end

-- Kugel (Shape Ball -> Größe immer gleichmäßig)
function Parts.Ball(parent: Instance, cf: CFrame, diameter: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	return Parts.Part({
		Parent = parent,
		CFrame = cf,
		Size = Vector3.new(diameter, diameter, diameter),
		Color = color,
		Material = material,
		Shape = Enum.PartType.Ball,
		Name = name or "Ball",
		CanCollide = false,
	})
end

-- CFrame, dessen LookVector entlang dir zeigt (robust auch bei senkrechtem dir;
-- CFrame.lookAt ist bei parallelem Up-Vektor undefiniert und im Lune-Emulator
-- fehlerhaft, deshalb fromMatrix).
function Parts.LookAlong(pos: Vector3, dir: Vector3): CFrame
	local look = dir.Unit
	local upRef = if math.abs(look.Y) > 0.98 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
	local right = look:Cross(upRef).Unit
	local up = right:Cross(look).Unit
	return CFrame.fromMatrix(pos, right, up, -look)
end

-- Quader von p0 nach p1 (Schnüre, Kabel, Streben, Rohre)
function Parts.Beam(parent: Instance, p0: Vector3, p1: Vector3, thickness: number, color: Color3, material: Enum.Material?, name: string?, collide: boolean?): BasePart
	local delta = p1 - p0
	local len = math.max(delta.Magnitude, 0.05)
	return Parts.Part({
		Parent = parent,
		CFrame = Parts.LookAlong((p0 + p1) / 2, if delta.Magnitude > 0.001 then delta else Vector3.new(0, 0, -1)),
		Size = Vector3.new(thickness, thickness, len),
		Color = color,
		Material = material,
		Name = name or "Beam",
		CanCollide = collide == true,
	})
end

-- Ring aus Quader-Segmenten in der lokalen XY-Ebene von cf (Normale = lokale Z).
function Parts.Ring(parent: Instance, cf: CFrame, radius: number, segments: number, thickness: number, depth: number, color: Color3, material: Enum.Material?, name: string?): { BasePart }
	local out = {}
	local segLen = 2 * radius * math.tan(math.pi / segments) + thickness * math.tan(math.pi / segments) + 0.05
	for i = 0, segments - 1 do
		local a = (i / segments) * math.pi * 2
		local segCf = cf * CFrame.Angles(0, 0, a) * CFrame.new(0, radius, 0)
		local p = Parts.Part({
			Parent = parent,
			CFrame = segCf,
			Size = Vector3.new(segLen, thickness, depth),
			Color = color,
			Material = material or Enum.Material.Neon,
			Name = name or "RingSegment",
			CanCollide = false,
		})
		table.insert(out, p)
	end
	return out
end

function Parts.Model(parent: Instance?, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Parts.Folder(parent: Instance?, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-------------------------------------------------------------------------------
-- Lichter (global gedeckelt)
-------------------------------------------------------------------------------

-- kind: "Point" (Default), "Spot", "Surface"
function Parts.Light(part: BasePart, color: Color3, range: number, brightness: number?, kind: string?, face: Enum.NormalId?): Light?
	if Parts.Stats.Lights >= Parts.MaxLights then
		Parts.Stats.SkippedLights += 1
		return nil
	end
	local light: any
	if kind == "Spot" then
		light = Instance.new("SpotLight")
		light.Face = face or Enum.NormalId.Bottom
		light.Angle = 100
	elseif kind == "Surface" then
		light = Instance.new("SurfaceLight")
		light.Face = face or Enum.NormalId.Front
		light.Angle = 120
	else
		light = Instance.new("PointLight")
	end
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1.5
	light.Shadows = false
	light.Parent = part
	Parts.Stats.Lights += 1
	return light
end

-------------------------------------------------------------------------------
-- Text (SurfaceGui / BillboardGui)
-------------------------------------------------------------------------------

local function makeLabel(parent: Instance, name: string, text: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font, stroke: Color3?)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Font = font
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	if stroke then
		label.TextStrokeColor3 = stroke
		label.TextStrokeTransparency = 0.35
	else
		label.TextStrokeTransparency = 1
	end
	label.Parent = parent
	return label
end

-- Schild auf einer Fläche: TextLabels "Title" (+ optional "Subtitle") direkt
-- unter dem SurfaceGui. opts: Name, Font, SubFont, TitleColor, SubtitleColor,
-- Background (Color3), PixelsPerStud, Stroke (Color3)
function Parts.SurfaceLabel(part: BasePart, face: Enum.NormalId, title: string, subtitle: string?, opts: Opts?): SurfaceGui
	local o = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = o.Name or "LabelGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.PixelsPerStud or 20
	gui.LightInfluence = 0
	gui.MaxDistance = o.MaxDistance or 400
	if o.Background then
		local bg = Instance.new("Frame")
		bg.Name = "Background"
		bg.BorderSizePixel = 0
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = o.Background
		bg.BackgroundTransparency = o.BackgroundTransparency or 0
		bg.ZIndex = 0
		bg.Parent = gui
	end
	local font = o.Font or Enum.Font.Arcade
	local titleColor = o.TitleColor or Parts.Palette.White
	if subtitle then
		makeLabel(gui, "Title", title, UDim2.fromScale(0.04, 0.06), UDim2.fromScale(0.92, 0.56), titleColor, font, o.Stroke)
		makeLabel(gui, "Subtitle", subtitle, UDim2.fromScale(0.06, 0.64), UDim2.fromScale(0.88, 0.3), o.SubtitleColor or titleColor, o.SubFont or font, o.Stroke)
	else
		makeLabel(gui, "Title", title, UDim2.fromScale(0.04, 0.08), UDim2.fromScale(0.92, 0.84), titleColor, font, o.Stroke)
	end
	gui.Parent = part
	return gui
end

-- Schwebender Titel über einem Teil. opts: Name, Width, Height (Studs),
-- Offset (Vector3), MaxDistance, TitleColor, SubtitleColor, Font
function Parts.Billboard(part: BasePart, title: string, subtitle: string?, opts: Opts?): BillboardGui
	local o = opts or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = o.Name or "TitleGui"
	gui.Size = UDim2.fromScale(o.Width or 16, o.Height or 4.5)
	gui.StudsOffset = o.Offset or Vector3.new(0, 6, 0)
	gui.MaxDistance = o.MaxDistance or 160
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	local font = o.Font or Enum.Font.Arcade
	local titleColor = o.TitleColor or Parts.Palette.White
	local stroke = o.Stroke or Parts.Palette.Night
	if subtitle then
		makeLabel(gui, "Title", title, UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.62), titleColor, font, stroke)
		makeLabel(gui, "Subtitle", subtitle, UDim2.fromScale(0.1, 0.64), UDim2.fromScale(0.8, 0.34), o.SubtitleColor or titleColor, font, stroke)
	else
		makeLabel(gui, "Title", title, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), titleColor, font, stroke)
	end
	gui.Parent = part
	return gui
end

-------------------------------------------------------------------------------
-- Partikel (Sporen, Nebel, Funken)
-------------------------------------------------------------------------------

-- opts: Color (Color3), Rate, Size, Lifetime, Speed, LightEmission, Transparency
function Parts.Particles(part: BasePart, opts: Opts?): ParticleEmitter
	local o = opts or {}
	local pe = Instance.new("ParticleEmitter")
	pe.Name = o.Name or "Particles"
	pe.Color = ColorSequence.new(o.Color or Parts.Palette.Purple)
	pe.Rate = o.Rate or 6
	pe.Lifetime = NumberRange.new(o.Lifetime or 5, (o.Lifetime or 5) * 1.6)
	pe.Speed = NumberRange.new(o.Speed or 0.6, (o.Speed or 0.6) * 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, o.Size or 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, o.Transparency or 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.LightEmission = o.LightEmission or 1
	pe.Acceleration = o.Acceleration or Vector3.new(0, 0.4, 0)
	pe.Parent = part
	return pe
end

-------------------------------------------------------------------------------
-- Geometrie-Hilfen
-------------------------------------------------------------------------------

-- Teile (BasePart) unter einer Instanz zählen
function Parts.CountParts(root: Instance): number
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

-- Flache CFrame an Position, die zu target "schaut" (nur Y-Rotation).
-- Über CFrame.Angles statt CFrame.lookAt (lookAt ist im Lune-Emulator fehlerhaft).
function Parts.FaceTowards(pos: Vector3, target: Vector3): CFrame
	local dx, dz = target.X - pos.X, target.Z - pos.Z
	if dx * dx + dz * dz < 1e-6 then
		return CFrame.new(pos)
	end
	-- Angles(0, a, 0) dreht (0,0,-1) auf (-sin a, 0, -cos a)
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dx, -dz), 0)
end

return Parts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Plot</string>
            <string name="Source"><![CDATA[--!strict
-- Plot (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > Plot
--
-- Baut eine Spieler-Base ("Plot1".."Plot8").
--
-- Plot-Koordinaten: X = rechts, Z = nach hinten (weg vom Hub), Ursprung =
-- Plot-Mitte auf Bodenhöhe. -Z (LookVector der Plot-CFrame) zeigt zum Hub;
-- dort ist auch der Eingang. Alles steht auf der Ebene y = 0 (Oberkante Floor).
--
-- Vertrag mit den Services (Namen nicht ändern!):
--   Plot<i>                 Model, Attribut PlotIndex, ModelStreamingMode Persistent
--     Floor                 PrimaryPart (96x1x96, Oberkante y = 0)
--     Slots/Slot1..25       Pad (Attribut SlotIndex), Kind-Part "Rim" (Neon, Farbe per Code)
--                           Charakter-CFrame = SlotN.CFrame * CFrame.new(0, SlotN.Size.Y/2, 0)
--     PondWater             Leuchtendes Wasser des Rift Pond
--     FishingSeats/Seat1..4 LookVector zeigt zur Teichmitte (Attribut SeatIndex)
--     Collector             Cash-Pad (Attribut IsCollector = true), BillboardGui "CollectorGui"
--     SpawnPoint            unsichtbar, schaut in die Base hinein
--     SignBoard             SurfaceGui "SignGui" mit TextLabels "Title" + "Subtitle"
--     Lights                Birnen der Lichterketten (Attribut Bulb = true)
--     Characters, Fishers   leer, werden von Services gefüllt
--     Decor                 alles andere

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local WorldConfig = require(ConfigFolder:WaitForChild("WorldConfig"))

local Parts = require(script.Parent:WaitForChild("Parts"))
local Props = require(script.Parent:WaitForChild("Props"))

local Palette = Parts.Palette
local V3 = Vector3.new
local CF = CFrame.new
local Mat = Enum.Material

local Plot = {}

local FLOOR_COLOR = Color3.fromRGB(46, 44, 70)
local PAD_COLOR = Color3.fromRGB(24, 22, 38)
local RIM_COLOR = Color3.fromRGB(110, 70, 220)
local ACCENT = Palette.Purple
local ENTRANCE_WIDTH = 20

-- Blickrichtungen in Plot-Koordinaten
local FACE_HUB = CFrame.new()
local FACE_BACK = CFrame.Angles(0, math.pi, 0)
local FACE_RIGHT = CFrame.Angles(0, -math.pi / 2, 0)
local FACE_LEFT = CFrame.Angles(0, math.pi / 2, 0)

-- Plot-lokale Blickrichtung von a nach b (nur Y-Rotation)
local function faceLocal(a: Vector3, b: Vector3): CFrame
	return Parts.FaceTowards(a, b) - a
end

function Plot.Build(index: number, cframe: CFrame, parent: Instance): Model
	local rng = Random.new(1000 + index)
	local model = Parts.Model(nil, "Plot" .. index)
	model:SetAttribute("PlotIndex", index)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	local decor = Parts.Folder(model, "Decor")
	local slotsFolder = Parts.Folder(model, "Slots")
	local seatsFolder = Parts.Folder(model, "FishingSeats")
	local lightsFolder = Parts.Folder(model, "Lights")
	Parts.Folder(model, "Characters")
	Parts.Folder(model, "Fishers")

	-- Lokale CFrame -> Welt
	local function L(x: number, y: number, z: number, rot: CFrame?): CFrame
		return cframe * CF(x, y, z) * (rot or FACE_HUB)
	end
	local function W(x: number, y: number, z: number): Vector3
		return cframe * V3(x, y, z)
	end

	local size = WorldConfig.PlotSize
	local hx, hz = size.X / 2, size.Z / 2

	---------------------------------------------------------------------------
	-- Boden, Weg, Kantenleuchten
	---------------------------------------------------------------------------
	local floor = Parts.Part({
		Parent = model,
		Name = "Floor",
		CFrame = L(0, -size.Y / 2, 0),
		Size = size,
		Color = FLOOR_COLOR,
		Material = Mat.Concrete,
	})
	model.PrimaryPart = floor

	Parts.Box(decor, L(0, 0.05 - 0.5, -hz + 17), V3(10, 1, 34), Palette.AsphaltDark, Mat.Pavement, "Walkway")
	for _, e in { { 0, -hz + 2, size.X - 4, 0.6 }, { 0, hz - 2, size.X - 4, 0.6 } } do
		Parts.Neon(decor, L(e[1], 0.03, e[2]), V3(e[3], 0.08, e[4]), ACCENT, "EdgeGlow")
	end
	for _, x in { -hx + 2, hx - 2 } do
		Parts.Neon(decor, L(x, 0.03, 0), V3(0.6, 0.08, size.Z - 4), ACCENT, "EdgeGlow")
	end

	---------------------------------------------------------------------------
	-- Zaun mit Eingang vorne (Richtung Hub)
	---------------------------------------------------------------------------
	local fenceColor = Palette.Navy
	local function fencePanel(cx: number, cz: number, len: number, h: number, alongX: boolean)
		local sx, sz = if alongX then len else 0.8, if alongX then 0.8 else len
		Parts.Box(decor, L(cx, h / 2, cz), V3(sx, h, sz), fenceColor, Mat.WoodPlanks, "Fence")
		Parts.Neon(decor, L(cx, h + 0.15, cz), V3(sx + 0.05, 0.3, sz + 0.05), ACCENT, "FenceTrim")
	end
	local frontLen = hx - ENTRANCE_WIDTH / 2
	fencePanel(-hx + frontLen / 2, -hz + 0.4, frontLen, 3.5, true)
	fencePanel(hx - frontLen / 2, -hz + 0.4, frontLen, 3.5, true)
	fencePanel(-hx + 0.4, 0, size.Z, 3.5, false)
	fencePanel(hx - 0.4, 0, size.Z, 3.5, false)
	fencePanel(0, hz - 0.4, size.X, 6, true)

	-- Pfosten (hinten dienen sie als Aufhängung für die Lichterketten)
	local backPostX = { -hx + 0.4, -16, 16, hx - 0.4 }
	for _, x in backPostX do
		Parts.Box(decor, L(x, 4.5, hz - 0.4), V3(1.2, 9, 1.2), Palette.WoodDark, Mat.Wood, "Post")
	end
	for _, x in { -hx + 0.4, hx - 0.4 } do
		Parts.Box(decor, L(x, 2.5, -hz + 0.4), V3(1.2, 5, 1.2), Palette.WoodDark, Mat.Wood, "Post")
	end
	-- Eingangstor mit Querbalken
	local gx = ENTRANCE_WIDTH / 2 + 0.6
	for _, x in { -gx, gx } do
		Parts.Box(decor, L(x, 4, -hz + 0.4), V3(1.4, 8, 1.4), Palette.WoodDark, Mat.Wood, "GatePost")
		Parts.Ball(decor, L(x, 8.4, -hz + 0.4), 1.2, ACCENT, Mat.Neon, "GateCap")
	end
	Parts.Box(decor, L(0, 7.6, -hz + 0.4), V3(gx * 2, 1.2, 1.2), Palette.WoodDark, Mat.Wood, "GateBeam")
	Parts.Neon(decor, L(0, 6.9, -hz + 0.4), V3(gx * 2 - 1.4, 0.25, 0.5), ACCENT, "GateGlow")

	---------------------------------------------------------------------------
	-- Slots (5x5 Raster)
	---------------------------------------------------------------------------
	local padSize = WorldConfig.SlotPadSize
	local padTop = 0.3
	for i = 1, WorldConfig.SlotColumns * WorldConfig.SlotRows do
		local p = WorldConfig.SlotLocalPosition(i)
		local pad = Parts.Part({
			Parent = slotsFolder,
			Name = "Slot" .. i,
			CFrame = L(p.X, padTop - padSize.Y / 2, p.Z),
			Size = padSize,
			Color = PAD_COLOR,
			Material = Mat.SmoothPlastic,
			Attributes = { SlotIndex = i },
		})
		local rim = Parts.Part({
			Parent = pad,
			Name = "Rim",
			CFrame = L(p.X, padTop - 0.05 - (padSize.Y - 0.1) / 2, p.Z),
			Size = V3(padSize.X + 0.8, padSize.Y - 0.1, padSize.Z + 0.8),
			Color = RIM_COLOR,
			Material = Mat.Neon,
			CanCollide = false,
		})
		rim.CastShadow = false
	end

	---------------------------------------------------------------------------
	-- Rift Pond mit Angelplätzen
	---------------------------------------------------------------------------
	local pc = WorldConfig.PondCenter
	local pr = WorldConfig.PondRadius
	local water = Parts.Part({
		Parent = model,
		Name = "PondWater",
		Shape = Enum.PartType.Cylinder,
		CFrame = L(pc.X, 0.1, pc.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Size = V3(0.6, pr * 2, pr * 2),
		Color = Color3.fromRGB(110, 80, 255),
		Material = Mat.Neon,
		Transparency = 0.25,
		CanCollide = false,
	})
	Parts.Light(water, Color3.fromRGB(140, 100, 255), 22, 1.4)
	Parts.Part({
		Parent = decor,
		Name = "PondSwirl",
		Shape = Enum.PartType.Cylinder,
		CFrame = L(pc.X, 0.12, pc.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Size = V3(0.62, pr * 0.8, pr * 0.8),
		Color = Palette.Cyan,
		Material = Mat.Neon,
		Transparency = 0.45,
		CanCollide = false,
	})
	-- Steinkranz (Lücken an den Stegen)
	for k = 0, 15 do
		local deg = k * 22.5
		if deg % 90 ~= 45 then
			local a = math.rad(deg)
			local pos = V3(pc.X + math.cos(a) * (pr + 0.9), 0, pc.Z + math.sin(a) * (pr + 0.9))
			Props.Rock(decor, L(pos.X, 0, pos.Z), { Rng = rng, Size = rng:NextNumber(2.4, 3.4), Parts = 1, Color = Color3.fromRGB(60, 56, 78) })
		end
	end
	-- Angelplätze: Steg + Hocker + Köderdose, Blick zur Teichmitte
	for i = 1, WorldConfig.MaxFishingSeats do
		local a = math.rad(45 + (i - 1) * (360 / WorldConfig.MaxFishingSeats))
		local dir = V3(math.cos(a), 0, math.sin(a))
		local seatPos = V3(pc.X, 0, pc.Z) + dir * (pr + 2.2)
		local look = faceLocal(seatPos, V3(pc.X, 0, pc.Z))
		local plankPos = seatPos - dir * 1.6
		Parts.Box(decor, cframe * CF(plankPos.X, 0.25, plankPos.Z) * look, V3(2.8, 0.5, 6.2), Palette.Wood, Mat.WoodPlanks, "Dock")
		Parts.Part({
			Parent = seatsFolder,
			Name = "Seat" .. i,
			CFrame = cframe * CF(seatPos.X, 1.1, seatPos.Z) * look,
			Size = V3(2.2, 1.2, 2.2),
			Color = Palette.WoodLight,
			Material = Mat.WoodPlanks,
			Attributes = { SeatIndex = i },
		})
		local side = look.RightVector
		local bucket = seatPos + side * 1.9
		Parts.VCyl(decor, cframe * CF(bucket.X, 0.9, bucket.Z), 0.8, 0.9, Palette.Red, Mat.Metal, "BaitBucket")
	end

	---------------------------------------------------------------------------
	-- Collector (Cash-Pad) + Maschine
	---------------------------------------------------------------------------
	local co = WorldConfig.CollectorOffset
	Parts.Box(decor, L(co.X, -0.2, co.Z), V3(9.4, 1, 9.4), Palette.MetalDark, Mat.DiamondPlate, "CollectorFrame")
	local collector = Parts.Part({
		Parent = model,
		Name = "Collector",
		CFrame = L(co.X, 0.3, co.Z),
		Size = V3(8, 0.4, 8),
		Color = Color3.fromRGB(60, 255, 150),
		Material = Mat.Neon,
		Attributes = { IsCollector = true },
	})
	collector.CanTouch = true
	Parts.Light(collector, Color3.fromRGB(60, 255, 150), 14, 1.2)
	Parts.Billboard(collector, "$0", "STEP ON TO COLLECT", {
		Name = "CollectorGui",
		Offset = V3(0, 6, 0),
		Width = 12,
		Height = 4,
		TitleColor = Color3.fromRGB(120, 255, 170),
		MaxDistance = 90,
	})
	local mx = co.X + 9
	Parts.Box(decor, L(mx, 3, co.Z, FACE_LEFT), V3(5, 6, 3.5), Palette.Navy, Mat.Metal, "Machine")
	local screen = Parts.Neon(decor, L(mx - 1.8, 3.8, co.Z, FACE_LEFT), V3(3.4, 2, 0.1), Color3.fromRGB(60, 255, 150), "MachineScreen")
	Parts.SurfaceLabel(screen, Enum.NormalId.Front, "CASH", nil, { TitleColor = Palette.Night, PixelsPerStud = 30 })
	Parts.Beam(decor, W(mx - 1.75, 1, co.Z + 1), W(co.X + 4.2, 0.3, co.Z + 1), 0.6, Palette.Metal, Mat.Metal, "Pipe")
	Parts.Ball(decor, L(mx, 6.6, co.Z), 1.2, Palette.Green, Mat.Neon, "Beacon")

	---------------------------------------------------------------------------
	-- SpawnPoint + Schild
	---------------------------------------------------------------------------
	local sp = WorldConfig.PlotSpawnOffset
	Parts.Invisible(model, L(sp.X, sp.Y, sp.Z, FACE_BACK), V3(4, 1, 4), "SpawnPoint", false)

	local so = WorldConfig.SignOffset
	for _, x in { -7.6, 7.6 } do
		Parts.Box(decor, L(so.X + x, 4.5, so.Z + 0.3), V3(0.8, 9, 0.8), Palette.WoodDark, Mat.Wood, "SignPost")
	end
	Parts.Neon(decor, L(so.X, 6.25, so.Z + 0.45), V3(16.8, 6.3, 0.3), ACCENT, "SignGlow")
	local sign = Parts.Part({
		Parent = model,
		Name = "SignBoard",
		CFrame = L(so.X, 6.25, so.Z),
		Size = V3(16, 5.5, 0.6),
		Color = Palette.Navy,
		Material = Mat.SmoothPlastic,
	})
	Parts.SurfaceLabel(sign, Enum.NormalId.Front, "EMPTY BASE", "Claim on join", {
		Name = "SignGui",
		Background = Palette.Night,
		TitleColor = Palette.Amber,
		SubtitleColor = Palette.Cyan,
		PixelsPerStud = 24,
	})

	---------------------------------------------------------------------------
	-- Investigation Station (hinten rechts)
	---------------------------------------------------------------------------
	local st = WorldConfig.StationOffset -- (30, 0, 40)
	local deskZ = st.Z + 3.5
	Props.Desk(decor, L(st.X - 2, 0, deskZ), { Width = 12, Depth = 3.5, Height = 3 })
	Props.CRT(decor, L(st.X - 6, 3, deskZ), { Text = "SIGNAL\nDETECTED" })
	Props.CRT(decor, L(st.X - 2.4, 3, deskZ) * CFrame.Angles(0, -0.15, 0), { ScreenColor = Palette.Cyan, Text = "FREQ 7.83" })
	Props.Radio(decor, L(st.X + 1.6, 3, deskZ))
	Props.Crate(decor, L(st.X + 6.5, 0, deskZ + 0.5), { Size = 3 })
	Props.CRT(decor, L(st.X + 6.5, 3, deskZ + 0.5) * CFrame.Angles(0, 0.2, 0), { ScreenColor = Palette.Orange, Text = "???" })
	Props.Chair(decor, L(st.X - 2.4, 0, deskZ - 4, FACE_BACK))
	Props.Corkboard(decor, L(st.X + 12, 0, st.Z + 5))
	Props.MapTable(decor, L(st.X + 8, 0, st.Z - 7))
	local mastPos = V3(hx - 3.5, 0, st.Z - 3)
	Props.AntennaMast(decor, L(mastPos.X, 0, mastPos.Z), { Height = 22, GuySpread = 2.6 })
	Props.WalkieStand(decor, L(st.X - 11, 0, deskZ))
	Props.Cables(decor, L(st.X + 2, 0, deskZ - 1.5), { To = W(mastPos.X - 1.5, 0, mastPos.Z), Count = 2, Rng = rng })
	Props.Cables(decor, L(st.X - 7, 0, deskZ - 1.5), { To = W(st.X - 11, 0, deskZ - 1), Count = 2, Rng = rng })

	---------------------------------------------------------------------------
	-- Lichterketten (alle Birnen in "Lights")
	---------------------------------------------------------------------------
	local hangY = 8.6
	for i = 1, #backPostX - 1 do
		Props.StringLights(decor, L(backPostX[i], hangY, hz - 0.4), {
			To = W(backPostX[i + 1], hangY, hz - 0.4),
			Count = 10,
			Sag = 2.2,
			BulbParent = lightsFolder,
		})
	end
	Props.StringLights(decor, L(mastPos.X, 12, mastPos.Z), {
		To = W(16, hangY, hz - 0.4),
		Count = 10,
		Sag = 2.6,
		BulbParent = lightsFolder,
	})

	---------------------------------------------------------------------------
	-- Deko: Laternen, Van, Bäume, Fahrrad, Fässer, Arcade, Briefkasten
	---------------------------------------------------------------------------
	for _, c in { { -hx + 4, -hz + 4 }, { hx - 4, -hz + 4 }, { -hx + 4, hz - 4 } } do
		local pos = V3(c[1], 0, c[2])
		Props.Streetlamp(decor, cframe * CF(pos) * faceLocal(pos, V3(0, 0, 0)), { Height = 12 })
	end
	Props.Van(decor, L(-34, 0, -30, FACE_RIGHT), { Color = Parts.HouseColors[(index % #Parts.HouseColors) + 1] })
	Props.PineTree(decor, L(-18, 0, -40), { Height = 13, Tiers = 3 })
	Props.PineTree(decor, L(43, 0, -12), { Height = 12, Tiers = 3 })
	Props.Bush(decor, L(-43, 0, -19), { Size = 4 })
	Props.Bicycle(decor, L(-17, 0, -24, FACE_RIGHT), { Color = Parts.BulbColors[(index % #Parts.BulbColors) + 1], Lean = 0.12 })
	Props.Barrels(decor, L(17, 0, -42), { Count = 3 })
	Props.ArcadeCabinet(decor, L(44, 0, -2, FACE_LEFT), { Title = "BASE " .. index })
	Props.Mailbox(decor, L(13, 0, -45))

	model.Parent = parent
	return model
end

return Plot
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Props (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > Props
--
-- Wiederverwendbare 80s-Mystery-Requisiten. Jede Funktion hat die Form
--   Props.X(parent, cframe, opts?) -> Model
-- cframe = Fußpunkt auf dem Boden (y = Bodenhöhe), Front = LookVector (-Z).
-- Alle Maße in Studs, Charaktere sind ~5 Studs groß.
--
-- Zufall (Steine, Trümmer ...) kommt immer aus opts.Rng, damit die Map mit
-- festem Seed jedes Mal gleich aussieht.

local Parts = require(script.Parent:WaitForChild("Parts"))

type Opts = Parts.Opts

local Palette = Parts.Palette
local V3 = Vector3.new
local CF = CFrame.new
local Mat = Enum.Material

local Props = {}

-------------------------------------------------------------------------------
-- Lokale Kurzformen: Teile relativ zu einer Basis-CFrame
-------------------------------------------------------------------------------

local function B(m: Instance, base: CFrame, x: number, y: number, z: number, sx: number, sy: number, sz: number, color: Color3, mat: Enum.Material?, name: string?): BasePart
	return Parts.Box(m, base * CF(x, y, z), V3(sx, sy, sz), color, mat, name)
end

local function N(m: Instance, base: CFrame, x: number, y: number, z: number, sx: number, sy: number, sz: number, color: Color3, name: string?): BasePart
	return Parts.Neon(m, base * CF(x, y, z), V3(sx, sy, sz), color, name)
end

local function D(m: Instance, base: CFrame, x: number, y: number, z: number, sx: number, sy: number, sz: number, color: Color3, mat: Enum.Material?, name: string?): BasePart
	return Parts.Detail(m, base * CF(x, y, z), V3(sx, sy, sz), color, mat, name)
end

local function rngOf(o: Opts): any
	return o.Rng or Random.new(7)
end

-------------------------------------------------------------------------------
-- Technik: CRT, Radio, Walkie-Talkies, Antenne, Server-Rack
-------------------------------------------------------------------------------

-- Röhrenmonitor mit leuchtendem Bildschirm. opts: ScreenColor, Text, Body
function Props.CRT(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "CRT")
	local body = o.Body or Palette.Beige
	B(m, cf, 0, 1.3, 0.2, 3, 2.6, 2.4, body, Mat.SmoothPlastic, "Body")
	B(m, cf, 0, 1.25, 1.8, 2.2, 2, 1.2, body, Mat.SmoothPlastic, "Back")
	local screen = N(m, cf, 0, 1.4, -1.02, 2.3, 1.8, 0.1, o.ScreenColor or Palette.Screen, "Screen")
	if o.Text then
		Parts.SurfaceLabel(screen, Enum.NormalId.Front, o.Text, nil, {
			Name = "ScreenGui",
			Font = Enum.Font.Code,
			TitleColor = Palette.Night,
			PixelsPerStud = 30,
		})
	end
	return m
end

function Props.Radio(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "Radio")
	B(m, cf, 0, 0.7, 0, 2.4, 1.4, 1, o.Color or Palette.MetalDark, Mat.Metal, "Body")
	D(m, cf, -0.55, 0.7, -0.52, 0.9, 0.9, 0.08, Palette.Black, Mat.DiamondPlate, "Speaker")
	N(m, cf, 0.55, 0.95, -0.52, 0.8, 0.3, 0.08, Palette.Orange, "Dial")
	D(m, cf, 0, 1.5, 0, 1.6, 0.2, 0.2, Palette.Black, nil, "Handle")
	Parts.Beam(m, cf * V3(0.9, 1.4, 0.2), cf * V3(1.5, 3.6, 0.4), 0.1, Palette.Metal, Mat.Metal, "Antenna")
	return m
end

-- Ladestation mit zwei Walkie-Talkies (Kanal-Schild)
function Props.WalkieStand(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "WalkieStand")
	B(m, cf, 0, 1.5, 0, 0.4, 3, 0.4, Palette.Metal, Mat.Metal, "Post")
	B(m, cf, 0, 0.1, 0, 1.6, 0.2, 1.6, Palette.MetalDark, Mat.Metal, "Foot")
	local tray = B(m, cf, 0, 3.15, 0, 3, 0.3, 1.4, Palette.Wood, Mat.Wood, "Tray")
	for i, x in { -0.7, 0.7 } do
		B(m, cf, x, 4, 0, 0.6, 1.4, 0.35, if i == 1 then Palette.Black else Palette.MetalDark, Mat.SmoothPlastic, "Walkie")
		D(m, cf, x + 0.15, 5.1, 0, 0.12, 0.9, 0.12, Palette.Black, nil, "Antenna")
		N(m, cf, x - 0.15, 4.55, -0.19, 0.15, 0.15, 0.05, if i == 1 then Palette.Red else Palette.Green, "Led")
	end
	Parts.SurfaceLabel(tray, Enum.NormalId.Front, o.Text or "CH 14", nil, { TitleColor = Palette.Amber, PixelsPerStud = 30 })
	return m
end

-- Funkmast mit Querstreben, Schüssel, roter Spitze und Abspannseilen
function Props.AntennaMast(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local h = o.Height or 24
	local m = Parts.Model(parent, "AntennaMast")
	B(m, cf, 0, 0.5, 0, 3, 1, 3, Palette.ConcreteDark, Mat.Concrete, "Base")
	B(m, cf, 0, h / 2, 0, 0.6, h, 0.6, Palette.Metal, Mat.Metal, "Pole")
	for i = 1, 3 do
		local y = h * (0.35 + i * 0.17)
		local w = 3.6 - i * 0.7
		D(m, cf * CFrame.Angles(0, i * 0.6, 0), 0, y, 0, w, 0.2, 0.2, Palette.Metal, Mat.Metal, "Crossbar")
	end
	Parts.Cyl(m, cf * CF(0.6, h * 0.62, -0.6) * CFrame.Angles(0, math.rad(60), math.rad(-20)), 0.3, 3.2, Palette.White, Mat.SmoothPlastic, "Dish")
	Parts.Ball(m, cf * CF(0, h + 0.4, 0), 0.9, Palette.Red, Mat.Neon, "Beacon")
	local spread = o.GuySpread or 3
	for i = 0, 2 do
		local a = i * (math.pi * 2 / 3) + 0.3
		Parts.Beam(m, cf * V3(0, h * 0.8, 0), cf * V3(math.cos(a) * spread, 0.1, math.sin(a) * spread), 0.08, Palette.MetalDark, Mat.Metal, "GuyWire")
	end
	return m
end

function Props.ServerRack(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "ServerRack")
	B(m, cf, 0, 3.5, 0, 3, 7, 2.4, Palette.MetalDark, Mat.Metal, "Body")
	D(m, cf, 0, 3.6, -1.22, 2.6, 6.4, 0.08, Palette.Black, Mat.DiamondPlate, "Panel")
	local colors = o.Colors or { Palette.Green, Palette.Cyan, Palette.Red }
	for i, c in colors do
		N(m, cf, (i - 2) * 0.7, 2 + i * 1.4, -1.28, 0.25, 1.2, 0.06, c, "Led")
	end
	return m
end

-------------------------------------------------------------------------------
-- Lichterkette ("Communication Lights")
-------------------------------------------------------------------------------

-- Kette von cf.Position nach opts.To (Vector3, Weltkoordinaten), durchhängend.
-- opts: To, Count, Sag, Colors, BulbParent (Folder für die Birnen), BulbSize
-- Jede Birne: Neon-Kugel "Bulb" mit Attribut Bulb = true und BulbIndex.
function Props.StringLights(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "StringLights")
	local a = cf.Position
	local b: Vector3 = o.To or (cf * V3(0, 0, -10))
	local count = o.Count or 10
	local sag = o.Sag or 2
	local colors = o.Colors or Parts.BulbColors
	local bulbParent = o.BulbParent or m
	local bulbSize = o.BulbSize or 0.75

	local function at(t: number): Vector3
		return a:Lerp(b, t) - V3(0, sag * 4 * t * (1 - t), 0)
	end

	local segments = math.max(2, math.ceil(count / 3))
	for i = 1, segments do
		Parts.Beam(m, at((i - 1) / segments), at(i / segments), 0.1, Palette.Black, Mat.SmoothPlastic, "Wire")
	end
	for i = 1, count do
		local t = (i - 0.5) / count
		local bulb = Parts.Ball(bulbParent, CFrame.new(at(t) - V3(0, 0.45, 0)), bulbSize, colors[(i - 1) % #colors + 1], Mat.Neon, "Bulb")
		bulb.CastShadow = false
		bulb:SetAttribute("Bulb", true)
		bulb:SetAttribute("BulbIndex", i)
	end
	return m
end

-------------------------------------------------------------------------------
-- Mystery Board, Kartentisch, Kabel, Schreibtisch, Stuhl
-------------------------------------------------------------------------------

-- Pinnwand mit Zetteln, Fotos, Nadeln und roten Fäden. opts: Width, Height
function Props.Corkboard(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local w = o.Width or 7
	local h = o.Height or 4.5
	local bottom = 2
	local m = Parts.Model(parent, "Corkboard")
	for _, x in { -w / 2 + 0.6, w / 2 - 0.6 } do
		B(m, cf, x, (bottom + h) / 2, 0.35, 0.35, bottom + h, 0.35, Palette.WoodDark, Mat.Wood, "Leg")
	end
	B(m, cf, 0, bottom + h / 2, 0.1, w + 0.4, h + 0.4, 0.3, Palette.WoodDark, Mat.Wood, "Frame")
	B(m, cf, 0, bottom + h / 2, -0.1, w, h, 0.12, Palette.Cork, Mat.Fabric, "Cork")
	-- Zettel (relative Position auf der Pinnwand, -1..1)
	local notes = {
		{ -0.7, 0.45, Palette.Paper },
		{ -0.15, 0.55, Palette.Black },
		{ 0.55, 0.4, Palette.Paper },
		{ -0.45, -0.4, Palette.Paper },
		{ 0.35, -0.35, Color3.fromRGB(250, 236, 140) },
	}
	local pins = {}
	for _, n in notes do
		local x = n[1] * (w / 2 - 0.8)
		local y = bottom + h / 2 + n[2] * (h / 2 - 0.8)
		D(m, cf, x, y, -0.19, 1.1, 1.3, 0.04, n[3], Mat.SmoothPlastic, "Note")
		local pin = cf * V3(x, y + 0.5, -0.24)
		Parts.Ball(m, CFrame.new(pin), 0.25, Palette.Red, Mat.Neon, "Pin")
		table.insert(pins, pin)
	end
	-- Rote Fäden zwischen den Nadeln
	for _, pair in { { 1, 2 }, { 2, 3 }, { 1, 4 }, { 4, 5 }, { 2, 5 } } do
		Parts.Beam(m, pins[pair[1]], pins[pair[2]], 0.06, Palette.Red, Mat.Neon, "String")
	end
	return m
end

function Props.MapTable(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "MapTable")
	B(m, cf, 0, 2.85, 0, 6, 0.3, 4, Palette.Wood, Mat.Wood, "Top")
	for _, x in { -2.5, 2.5 } do
		B(m, cf, x, 1.35, 0, 0.4, 2.7, 3.4, Palette.WoodDark, Mat.Wood, "Leg")
	end
	local map = D(m, cf * CFrame.Angles(0, 0.08, 0), 0, 3.03, 0, 5, 0.05, 3.4, Color3.fromRGB(196, 210, 170), Mat.SmoothPlastic, "Map")
	Parts.SurfaceLabel(map, Enum.NormalId.Top, o.Text or "MILBROOK COUNTY", nil, {
		TitleColor = Color3.fromRGB(60, 70, 60),
		Font = Enum.Font.SpecialElite,
		PixelsPerStud = 24,
	})
	Parts.Beam(m, cf * V3(-1.8, 3.08, 1), cf * V3(1.2, 3.08, -0.8), 0.1, Palette.Red, Mat.Neon, "Route")
	Parts.VCyl(m, cf * CF(1.3, 3.3, -0.9), 0.5, 0.3, Palette.Red, Mat.Neon, "Marker")
	Parts.VCyl(m, cf * CF(-1.9, 3.3, 1.1), 0.5, 0.3, Palette.Cyan, Mat.Neon, "Marker")
	return m
end

-- Kabel auf dem Boden von cf.Position nach opts.To. opts: To, Count, Rng
function Props.Cables(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local rng = rngOf(o)
	local m = Parts.Model(parent, "Cables")
	local a = cf.Position
	local b: Vector3 = o.To or (cf * V3(0, 0, -12))
	local side = (b - a)
	local perp = V3(-side.Z, 0, side.X)
	perp = if perp.Magnitude > 0 then perp.Unit else V3(1, 0, 0)
	local colors = { Palette.Black, Color3.fromRGB(40, 40, 60), Color3.fromRGB(80, 30, 30) }
	for i = 1, (o.Count or 3) do
		local off = perp * ((i - 2) * 0.35)
		local mid = a:Lerp(b, 0.5) + perp * rng:NextNumber(-1.2, 1.2) + off
		local y = V3(0, 0.12, 0)
		Parts.Beam(m, a + off + y, mid + y, 0.22, colors[(i - 1) % #colors + 1], Mat.Rubber, "Cable")
		Parts.Beam(m, mid + y, b + off + y, 0.22, colors[(i - 1) % #colors + 1], Mat.Rubber, "Cable")
	end
	return m
end

-- Schreibtisch. opts: Width, Depth, Height (Oberkante)
function Props.Desk(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local w, d, h = o.Width or 8, o.Depth or 3.5, o.Height or 3
	local m = Parts.Model(parent, "Desk")
	B(m, cf, 0, h - 0.15, 0, w, 0.3, d, o.Color or Palette.Wood, Mat.Wood, "Top")
	B(m, cf, -w / 2 + 0.2, (h - 0.3) / 2, 0, 0.4, h - 0.3, d - 0.2, Palette.WoodDark, Mat.Wood, "Side")
	B(m, cf, w / 2 - 1.1, (h - 0.3) / 2, 0, 2.2, h - 0.3, d - 0.2, Palette.WoodDark, Mat.Wood, "Drawers")
	D(m, cf, w / 2 - 1.1, h * 0.55, -d / 2 + 0.05, 0.8, 0.15, 0.1, Palette.Amber, Mat.Metal, "Handle")
	return m
end

function Props.Chair(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "Chair")
	local c = o.Color or Color3.fromRGB(110, 40, 40)
	B(m, cf, 0, 0.1, 0, 1.6, 0.2, 1.6, Palette.MetalDark, Mat.Metal, "Foot")
	B(m, cf, 0, 0.95, 0, 0.3, 1.5, 0.3, Palette.Metal, Mat.Metal, "Post")
	B(m, cf, 0, 1.8, 0, 1.9, 0.35, 1.8, c, Mat.Fabric, "Seat")
	B(m, cf, 0, 2.9, 0.85, 1.9, 2, 0.3, c, Mat.Fabric, "Back")
	return m
end

function Props.Bench(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local w = o.Width or 6
	local m = Parts.Model(parent, "Bench")
	B(m, cf, 0, 1.6, 0, w, 0.35, 1.8, Palette.Wood, Mat.Wood, "Seat")
	B(m, cf, 0, 2.6, 0.8, w, 1.3, 0.25, Palette.Wood, Mat.Wood, "Back")
	for _, x in { -w / 2 + 0.5, w / 2 - 0.5 } do
		B(m, cf, x, 0.75, 0.1, 0.35, 1.5, 1.6, Palette.MetalDark, Mat.Metal, "Leg")
	end
	return m
end

function Props.Crate(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local s = o.Size or 3
	local m = Parts.Model(parent, "Crate")
	B(m, cf, 0, s / 2, 0, s, s, s, o.Color or Palette.WoodLight, Mat.WoodPlanks, "Box")
	return m
end

-------------------------------------------------------------------------------
-- Straße & Vorstadt: Laterne, Briefkasten, Zaun, Haus, Van, Fahrrad, Arcade
-------------------------------------------------------------------------------

-- Straßenlaterne; Arm zeigt nach vorne (LookVector). opts: Height, Color, Light
function Props.Streetlamp(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local h = o.Height or 14
	local color = o.Color or Palette.Orange
	local m = Parts.Model(parent, "Streetlamp")
	B(m, cf, 0, 0.5, 0, 1.4, 1, 1.4, Palette.MetalDark, Mat.Metal, "Base")
	Parts.VCyl(m, cf * CF(0, h / 2, 0), h, 0.6, o.PoleColor or Palette.MetalDark, Mat.Metal, "Pole")
	B(m, cf, 0, h - 0.2, -1.6, 0.4, 0.4, 3.4, o.PoleColor or Palette.MetalDark, Mat.Metal, "Arm")
	B(m, cf, 0, h - 0.4, -3.4, 1.6, 0.6, 2.2, Palette.Black, Mat.Metal, "Head")
	local bulb = N(m, cf, 0, h - 0.8, -3.4, 1.2, 0.2, 1.6, color, "Bulb")
	if o.Light then
		Parts.Light(bulb, color, o.Range or 28, o.Brightness or 1.6, "Spot", Enum.NormalId.Bottom)
	end
	return m
end

function Props.Mailbox(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "Mailbox")
	B(m, cf, 0, 1.5, 0, 0.4, 3, 0.4, Palette.Wood, Mat.Wood, "Post")
	B(m, cf, 0, 3.5, 0, 1.2, 1.1, 2, o.Color or Color3.fromRGB(60, 80, 160), Mat.Metal, "Box")
	D(m, cf, 0.65, 3.9, 0.4, 0.1, 0.8, 0.3, Palette.Red, Mat.SmoothPlastic, "Flag")
	return m
end

-- Lattenzaun entlang der lokalen X-Achse (Mitte = cf). opts: Length, Spacing, Height, Color
function Props.PicketFence(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local len = o.Length or 12
	local spacing = o.Spacing or 2.2
	local h = o.Height or 3.4
	local color = o.Color or Palette.White
	local m = Parts.Model(parent, "PicketFence")
	B(m, cf, 0, h * 0.35, 0.15, len, 0.3, 0.15, color, Mat.Wood, "Rail")
	B(m, cf, 0, h * 0.75, 0.15, len, 0.3, 0.15, color, Mat.Wood, "Rail")
	local n = math.max(2, math.floor(len / spacing) + 1)
	for i = 0, n - 1 do
		local x = -len / 2 + 0.3 + (len - 0.6) * i / (n - 1)
		B(m, cf, x, h / 2, 0, 0.55, h, 0.15, color, Mat.Wood, "Picket")
	end
	return m
end

-- Maschendrahtzaun (Labor) entlang lokaler X-Achse. opts: Length, Height
function Props.ChainFence(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local len = o.Length or 24
	local h = o.Height or 9
	local m = Parts.Model(parent, "ChainFence")
	Parts.Part({
		Parent = m,
		Name = "Mesh",
		CFrame = cf * CF(0, h / 2, 0),
		Size = V3(len, h, 0.2),
		Color = Palette.Metal,
		Material = Mat.DiamondPlate,
		Transparency = 0.55,
	})
	local posts = math.max(2, math.floor(len / 12) + 1)
	for i = 0, posts - 1 do
		local x = -len / 2 + len * i / (posts - 1)
		B(m, cf, x, h / 2 + 0.5, 0, 0.5, h + 1, 0.5, Palette.MetalDark, Mat.Metal, "Post")
	end
	D(m, cf, 0, h + 0.8, 0, len, 0.25, 0.25, Palette.MetalDark, Mat.Metal, "Barbs")
	return m
end

-- 80er Vorstadthaus mit Satteldach. Front (Tür) zeigt nach LookVector.
-- opts: Width, Depth, Height, Color, RoofColor, Garage (bool), Lit (bool),
--       WindowColor
function Props.House(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local w, d, h = o.Width or 22, o.Depth or 16, o.Height or 10
	local color = o.Color or Parts.HouseColors[1]
	local roof = o.RoofColor or Color3.fromRGB(56, 44, 52)
	local lit = if o.Lit == nil then true else o.Lit
	local windowColor = o.WindowColor or (if lit then Palette.Amber else Palette.NavyLight)
	local m = Parts.Model(parent, "House")
	local top = 1 + h
	B(m, cf, 0, 0.5, 0, w + 1, 1, d + 1, Palette.ConcreteDark, Mat.Concrete, "Foundation")
	B(m, cf, 0, 1 + h / 2, 0, w, h, d, color, Mat.WoodPlanks, "Body")
	-- Giebel: um 45° gedrehter Quader, untere Hälfte steckt im Körper
	local s = d / math.sqrt(2)
	B(m, cf * CF(0, top, 0) * CFrame.Angles(math.rad(45), 0, 0), 0, 0, 0, w - 0.2, s, s, color, Mat.WoodPlanks, "Gable")
	-- Dachflächen
	local slopeLen = d / 2 * math.sqrt(2) + 1.6
	for _, side in { -1, 1 } do
		local peak = cf * V3(0, top + d / 2, 0)
		local eave = cf * V3(0, top, side * d / 2)
		local dir = eave - peak
		local mid = (peak + eave) / 2
		local slab = Parts.LookAlong(mid, dir) * CF(0, 0.45, -0.7)
		Parts.Box(m, slab, V3(w + 1.6, 0.8, slopeLen), roof, Mat.Slate, "Roof")
	end
	B(m, cf, w / 3, top + d / 2 - 1, d / 6, 2, 5, 2, Color3.fromRGB(120, 60, 50), Mat.Brick, "Chimney")
	-- Front: Tür, Stufe, Lampe, Fenster
	local front = -d / 2
	local doorX = if o.Garage then -w / 4 else 0
	B(m, cf, doorX, 3.6, front - 0.1, 3.2, 5.6, 0.3, Palette.WoodDark, Mat.Wood, "Door")
	B(m, cf, doorX, 0.4, front - 1.3, 5, 0.8, 2.6, Palette.Concrete, Mat.Concrete, "Step")
	N(m, cf, doorX + 2.2, 5.4, front - 0.2, 0.5, 0.7, 0.3, Palette.Amber, "PorchLight")
	local windows = if o.Garage then { -w / 4 - 3.8, -w / 4 + 3.8 } else { -w / 4 - 1, w / 4 + 1 }
	for _, x in windows do
		Parts.Part({
			Parent = m,
			Name = "Window",
			CFrame = cf * CF(x, 1 + h * 0.6, front - 0.1),
			Size = V3(2.8, 2.8, 0.2),
			Color = windowColor,
			Material = if lit then Mat.Neon else Mat.Glass,
			CanCollide = false,
		})
	end
	if o.Garage then
		B(m, cf, w / 4 + 0.5, 3.75, front - 0.1, 8, 5.5, 0.3, Palette.White, Mat.CorrodedMetal, "GarageDoor")
	end
	-- Fenster im seitlichen Giebeldreieck
	Parts.Part({
		Parent = m,
		Name = "Window",
		CFrame = cf * CF(w / 2, top + 2, 0),
		Size = V3(0.2, 2, 2.4),
		Color = windowColor,
		Material = if lit then Mat.Neon else Mat.Glass,
		CanCollide = false,
	})
	return m
end

function Props.ArcadeCabinet(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local accent = o.Color or Palette.Magenta
	local m = Parts.Model(parent, "ArcadeCabinet")
	B(m, cf, 0, 3, 0, 2.6, 6, 2.4, o.BodyColor or Palette.Navy, Mat.SmoothPlastic, "Body")
	N(m, cf * CFrame.Angles(math.rad(-12), 0, 0), 0, 4.2, -1.0, 2, 1.6, 0.1, o.ScreenColor or Palette.Cyan, "Screen")
	local marquee = N(m, cf, 0, 5.65, -1.15, 2.6, 0.8, 0.3, accent, "Marquee")
	Parts.SurfaceLabel(marquee, Enum.NormalId.Front, o.Title or "ROLL RAIDERS", nil, { TitleColor = Palette.Night, PixelsPerStud = 30 })
	B(m, cf * CFrame.Angles(math.rad(15), 0, 0), 0, 3.1, -1.45, 2.6, 0.35, 1, Palette.Black, Mat.SmoothPlastic, "Controls")
	N(m, cf, 1.32, 3, 0, 0.06, 5.6, 0.25, accent, "Stripe")
	return m
end

-- Lieferwagen, Front = LookVector. opts: Color, StripeColor
function Props.Van(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local color = o.Color or Palette.White
	local m = Parts.Model(parent, "Van")
	B(m, cf, 0, 3.6, 1.2, 7, 5.4, 12.5, color, Mat.SmoothPlastic, "Body")
	B(m, cf, 0, 2.5, -6.6, 7, 3.2, 3.2, color, Mat.SmoothPlastic, "Hood")
	Parts.Glass(m, cf * CF(0, 4.9, -5.15) * CFrame.Angles(math.rad(-25), 0, 0), V3(6.4, 2.4, 0.2), Palette.Night, 0.2, "Windshield")
	D(m, cf, 0, 3.2, 1.2, 7.1, 0.7, 12.6, o.StripeColor or Palette.Orange, Mat.SmoothPlastic, "Stripe")
	for _, x in { -3.56, 3.56 } do
		D(m, cf, x, 4.9, -2.5, 0.1, 1.6, 3.6, Palette.Night, Mat.Glass, "SideWindow")
	end
	for _, z in { -5.4, 5.2 } do
		for _, x in { -3.1, 3.1 } do
			Parts.Cyl(m, cf * CF(x, 1.4, z), 1.1, 2.8, Palette.Black, Mat.Rubber, "Wheel")
		end
	end
	B(m, cf, 0, 1.4, -8.3, 7.2, 0.7, 0.5, Palette.Metal, Mat.Metal, "Bumper")
	N(m, cf, -2.6, 2.7, -8.25, 1, 0.6, 0.1, Palette.Amber, "Headlight")
	N(m, cf, 2.6, 2.7, -8.25, 1, 0.6, 0.1, Palette.Amber, "Headlight")
	return m
end

-- Fahrrad, fährt Richtung LookVector. opts: Color, Lean (rad, kippt um Z)
function Props.Bicycle(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local base = cf * CFrame.Angles(0, 0, o.Lean or 0)
	local color = o.Color or Palette.Red
	local m = Parts.Model(parent, "Bicycle")
	for _, z in { -1.7, 1.7 } do
		Parts.Part({
			Parent = m,
			Name = "Wheel",
			Shape = Enum.PartType.Cylinder,
			CFrame = base * CF(0, 1.2, z),
			Size = V3(0.25, 2.4, 2.4),
			Color = Palette.Black,
			Material = Mat.Rubber,
			CanCollide = false,
		})
	end
	local rear, front = base * V3(0, 1.2, 1.7), base * V3(0, 1.2, -1.7)
	local seat, bar, crank = base * V3(0, 2.7, 0.6), base * V3(0, 2.9, -1.3), base * V3(0, 1.2, 0)
	Parts.Beam(m, seat, bar, 0.2, color, Mat.Metal, "Frame")
	Parts.Beam(m, crank, bar, 0.2, color, Mat.Metal, "Frame")
	Parts.Beam(m, rear, seat, 0.18, color, Mat.Metal, "Frame")
	Parts.Beam(m, front, bar, 0.18, Palette.Metal, Mat.Metal, "Fork")
	D(m, base, 0, 3.15, -1.35, 1.7, 0.15, 0.15, Palette.Black, Mat.Metal, "Handlebar")
	D(m, base, 0, 2.85, 0.65, 0.45, 0.2, 0.9, Palette.Black, Mat.Fabric, "Saddle")
	return m
end

-------------------------------------------------------------------------------
-- Natur: Bäume, Steine, Kristalle, Pilze, Büsche
-------------------------------------------------------------------------------

-- Stilisierte Tanne aus gestapelten Scheiben. opts: Height, Color, Tiers
function Props.PineTree(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local h = o.Height or 18
	local tiers = o.Tiers or 3
	local color = o.Color or Palette.Leaf
	local m = Parts.Model(parent, "PineTree")
	local trunkH = h * 0.3
	B(m, cf, 0, trunkH / 2, 0, h * 0.08, trunkH, h * 0.08, o.TrunkColor or Palette.Bark, Mat.Wood, "Trunk")
	local crownH = h - trunkH
	local tierH = crownH / tiers
	for i = 0, tiers - 1 do
		local dia = h * 0.55 * (1 - i / (tiers + 0.6))
		local y = trunkH + tierH * (i + 0.5)
		Parts.VCyl(m, cf * CF(0, y, 0) * CFrame.Angles(0, i * 0.7, 0), tierH * 1.15, dia, color, Mat.Grass, "Crown")
	end
	return m
end

function Props.DeadTree(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local h = o.Height or 14
	local color = o.Color or Palette.BarkGrey
	local m = Parts.Model(parent, "DeadTree")
	B(m, cf * CFrame.Angles(0, 0, 0.05), 0, h / 2, 0, 1.1, h, 1.1, color, Mat.Wood, "Trunk")
	local branches = {
		{ 0.55, 1, 0.6 },
		{ 0.7, -1, 2.4 },
		{ 0.85, 1, 4.2 },
	}
	for _, br in branches do
		local start = cf * V3(0, h * br[1], 0)
		local dir = (cf * CFrame.Angles(0, br[3], 0)).RightVector * br[2]
		Parts.Beam(m, start, start + dir * h * 0.3 + V3(0, h * 0.18, 0), 0.5, color, Mat.Wood, "Branch")
	end
	return m
end

-- Felsbrocken. opts: Size, Color, Rng, Parts (1 oder 2)
function Props.Rock(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local rng = rngOf(o)
	local s = o.Size or 4
	local color = o.Color or Palette.Rock
	local m = Parts.Model(parent, "Rock")
	local rot = CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3))
	Parts.Box(m, cf * CF(0, s * 0.25, 0) * rot, V3(s, s * 0.7, s * 0.85), color, o.Material or Mat.Slate, "Rock")
	if (o.Parts or 2) >= 2 then
		local rot2 = CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, math.pi), rng:NextNumber(-0.5, 0.5))
		Parts.Box(m, cf * CF(s * 0.45, s * 0.15, s * 0.2) * rot2, V3(s * 0.5, s * 0.45, s * 0.5), color, o.Material or Mat.Slate, "Rock")
	end
	return m
end

-- Kristallgruppe. opts: Height, Color, Color2, Rng
function Props.Crystal(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local rng = rngOf(o)
	local h = o.Height or 8
	local color = o.Color or Palette.Purple
	local m = Parts.Model(parent, "Crystal")
	local main = cf * CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, math.pi), rng:NextNumber(-0.15, 0.15))
	Parts.Part({
		Parent = m,
		Name = "Shard",
		CFrame = main * CF(0, h / 2 - 0.5, 0) * CFrame.Angles(0, math.rad(45), 0),
		Size = V3(h * 0.22, h, h * 0.22),
		Color = color,
		Material = Mat.Glass,
		Transparency = 0.15,
	})
	for i, side in { -1, 1 } do
		local tilt = main * CFrame.Angles(0, i * 2.1, side * 0.45)
		Parts.Neon(m, tilt * CF(side * h * 0.12, h * 0.25, 0), V3(h * 0.13, h * 0.55, h * 0.13), o.Color2 or color, "Shard")
	end
	return m
end

-- Leuchtpilz. opts: Height, Color
function Props.Mushroom(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local h = o.Height or 2
	local m = Parts.Model(parent, "Mushroom")
	Parts.VCyl(m, cf * CF(0, h / 2, 0), h, h * 0.25, Palette.Paper, Mat.SmoothPlastic, "Stem")
	local cap = Parts.Part({
		Parent = m,
		Name = "Cap",
		CFrame = cf * CF(0, h, 0),
		Size = V3(h * 1.1, h * 0.45, h * 1.1),
		Color = o.Color or Palette.Green,
		Material = Mat.Neon,
		CanCollide = false,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = cap
	return m
end

function Props.Bush(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local s = o.Size or 4
	local m = Parts.Model(parent, "Bush")
	Parts.Part({
		Parent = m,
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		CFrame = cf * CF(0, s * 0.35, 0),
		Size = V3(s, s, s),
		Color = o.Color or Palette.Leaf,
		Material = Mat.Grass,
	})
	return m
end

-------------------------------------------------------------------------------
-- Rift / Anomalie: Riss, Trümmer, schwebende Brocken
-------------------------------------------------------------------------------

-- Zickzack-Riss aus Neon. Liegt flach auf dem Boden (oder senkrecht mit
-- opts.Vertical = true als "Rift Tear"). opts: Length, Width, Color, Rng
function Props.RiftCrack(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local rng = rngOf(o)
	local len = o.Length or 14
	local width = o.Width or 1.2
	local color = o.Color or Palette.Purple
	local m = Parts.Model(parent, "RiftCrack")
	local base = if o.Vertical then cf * CF(0, len / 2 + 0.5, 0) * CFrame.Angles(math.rad(90), 0, 0) else cf * CF(0, 0.08, 0)
	B(m, base, 0, -0.05, 0, width * 2.4, 0.12, len * 1.02, Palette.Black, Mat.Slate, "Lip")
	local segs = 3
	local x0 = 0
	for i = 1, segs do
		local z0 = -len / 2 + len * (i - 1) / segs
		local z1 = -len / 2 + len * i / segs
		local x1 = if i == segs then 0 else rng:NextNumber(-width, width)
		local p0 = base * V3(x0, 0.05, z0)
		local p1 = base * V3(x1, 0.05, z1)
		local seg = Parts.Beam(m, p0, p1, 1, color, Mat.Neon, "Crack")
		seg.Size = V3(width * (1.1 - i * 0.2), 0.12, seg.Size.Z + 0.4)
		x0 = x1
	end
	return m
end

-- Schwebende Trümmerbrocken. opts: Count, Size, Color, Rng, Material
function Props.FloatingDebris(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local rng = rngOf(o)
	local m = Parts.Model(parent, "FloatingDebris")
	local s = o.Size or 2.5
	for _ = 1, (o.Count or 3) do
		local off = V3(rng:NextNumber(-3, 3), rng:NextNumber(-2, 2), rng:NextNumber(-3, 3))
		local rot = CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28))
		Parts.Part({
			Parent = m,
			Name = "Chunk",
			CFrame = cf * CF(off) * rot,
			Size = V3(s * rng:NextNumber(0.5, 1.4), s * rng:NextNumber(0.3, 0.8), s * rng:NextNumber(0.5, 1.4)),
			Color = o.Color or Palette.Rock,
			Material = o.Material or Mat.Slate,
			CanCollide = false,
		})
	end
	return m
end

-- Schwebende Erdscholle (oben flach, unten Felsspitze). opts: Size, Color, TopColor, Rng
function Props.FloatingIsland(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local s = o.Size or 12
	local m = Parts.Model(parent, "FloatingIsland")
	B(m, cf, 0, 0, 0, s, 1.6, s * 0.8, o.TopColor or Palette.Rock, o.Material or Mat.Slate, "Top")
	B(m, cf * CFrame.Angles(math.rad(45), 0.3, 0), 0, -s * 0.2, 0, s * 0.7, s * 0.4, s * 0.4, o.Color or Palette.Rock, Mat.Slate, "Underside")
	B(m, cf * CFrame.Angles(0.2, 1.2, math.rad(45)), 0, -s * 0.35, 0, s * 0.3, s * 0.3, s * 0.3, o.Color or Palette.Rock, Mat.Slate, "Spike")
	return m
end

-------------------------------------------------------------------------------
-- Labor: Tank, Warnschild, Fässer, Warnlicht
-------------------------------------------------------------------------------

-- Glastank mit leuchtender Flüssigkeit und Schatten darin. opts: Height, Diameter, LiquidColor
function Props.LabTank(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local h = o.Height or 10
	local dia = o.Diameter or 5
	local liquid = o.LiquidColor or Palette.Cyan
	local m = Parts.Model(parent, "LabTank")
	Parts.VCyl(m, cf * CF(0, 0.6, 0), 1.2, dia + 1.2, Palette.MetalDark, Mat.Metal, "Base")
	Parts.Part({
		Parent = m,
		Name = "Liquid",
		Shape = Enum.PartType.Cylinder,
		CFrame = cf * CF(0, 1.2 + (h - 3) / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Size = V3(h - 3.2, dia - 0.8, dia - 0.8),
		Color = liquid,
		Material = Mat.Neon,
		Transparency = 0.35,
		CanCollide = false,
	})
	D(m, cf, 0, 1.2 + (h - 3) / 2, 0, 1.1, 2.6, 0.7, Palette.Black, Mat.SmoothPlastic, "Specimen")
	Parts.Part({
		Parent = m,
		Name = "Glass",
		Shape = Enum.PartType.Cylinder,
		CFrame = cf * CF(0, 1.2 + (h - 2.4) / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Size = V3(h - 2.4, dia, dia),
		Color = Color3.fromRGB(180, 220, 255),
		Material = Mat.Glass,
		Transparency = 0.6,
	})
	Parts.VCyl(m, cf * CF(0, h - 0.6, 0), 1.2, dia + 0.8, Palette.MetalDark, Mat.Metal, "Cap")
	Parts.Beam(m, cf * V3(0, h - 0.3, 0), cf * V3(0, h - 0.3, dia + 1), 0.6, Palette.Metal, Mat.Metal, "Pipe")
	return m
end

-- Warnschild. opts: Text, Color
function Props.WarningSign(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "WarningSign")
	B(m, cf, 0, 2.2, 0.1, 0.3, 4.4, 0.3, Palette.Metal, Mat.Metal, "Post")
	local plate = B(m, cf, 0, 4.6, -0.1, 3.4, 2.6, 0.2, o.Color or Palette.Yellow, Mat.SmoothPlastic, "Plate")
	Parts.SurfaceLabel(plate, Enum.NormalId.Front, o.Text or "DANGER", o.Subtext or "KEEP OUT", {
		TitleColor = Palette.Black,
		PixelsPerStud = 30,
	})
	return m
end

-- Fässer-Gruppe. opts: Count, Color, Toxic (Neon-Deckel)
function Props.Barrels(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "Barrels")
	local spots = { V3(0, 0, 0), V3(2.4, 0, 0.6), V3(1, 0, 2.3), V3(-1.6, 0, 1.8) }
	for i = 1, math.min(o.Count or 3, #spots) do
		local p = spots[i]
		Parts.VCyl(m, cf * CF(p.X, 1.5, p.Z), 3, 2.2, o.Color or Color3.fromRGB(150, 120, 40), Mat.CorrodedMetal, "Barrel")
		if o.Toxic then
			Parts.VCyl(m, cf * CF(p.X, 3.05, p.Z), 0.12, 1.8, Palette.Green, Mat.Neon, "Glow")
		end
	end
	return m
end

-- Drehlicht auf Sockel. opts: Color
function Props.WarningLight(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local m = Parts.Model(parent, "WarningLight")
	B(m, cf, 0, (o.Height or 0) + 0.3, 0, 1.2, 0.6, 1.2, Palette.MetalDark, Mat.Metal, "Base")
	Parts.Ball(m, cf * CF(0, (o.Height or 0) + 1, 0), 1.1, o.Color or Palette.Red, Mat.Neon, "Lamp")
	return m
end

-------------------------------------------------------------------------------
-- Würfel (Plaza-Statue, Dice-Altäre)
-------------------------------------------------------------------------------

-- Augen pro Seite (u, v in -1..1)
local PIPS = {
	[1] = { { 0, 0 } },
	[2] = { { -1, -1 }, { 1, 1 } },
	[3] = { { -1, -1 }, { 0, 0 }, { 1, 1 } },
	[4] = { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } },
	[5] = { { -1, -1 }, { 1, -1 }, { 0, 0 }, { -1, 1 }, { 1, 1 } },
	[6] = { { -1, -1 }, { -1, 0 }, { -1, 1 }, { 1, -1 }, { 1, 0 }, { 1, 1 } },
}

-- Seiten-Rotationen: dreht die Front-Fläche (-Z) auf die jeweilige Seite.
-- Gegenüberliegende Seiten ergeben zusammen 7.
local FACES = {
	{ value = 1, rot = CFrame.new() },
	{ value = 6, rot = CFrame.Angles(0, math.pi, 0) },
	{ value = 3, rot = CFrame.Angles(0, -math.pi / 2, 0) },
	{ value = 4, rot = CFrame.Angles(0, math.pi / 2, 0) },
	{ value = 2, rot = CFrame.Angles(math.pi / 2, 0, 0) },
	{ value = 5, rot = CFrame.Angles(-math.pi / 2, 0, 0) },
}

-- Würfel mit Neon-Augen. cf = MITTELPUNKT des Würfels (nicht Fußpunkt).
-- opts: Size, Color, PipColor, Name, Material, Glow (Neon-Kanten-Hülle)
-- Ergebnis: Model mit PrimaryPart "Core".
function Props.Die(parent: Instance, cf: CFrame, opts: Opts?): Model
	local o = opts or {}
	local s = o.Size or 6
	local m = Parts.Model(parent, o.Name or "Die")
	local core = Parts.Part({
		Parent = m,
		Name = "Core",
		CFrame = cf,
		Size = V3(s, s, s),
		Color = o.Color or Palette.White,
		Material = o.Material or Mat.SmoothPlastic,
		CanCollide = false,
	})
	m.PrimaryPart = core
	local pipColor = o.PipColor or Palette.Purple
	local spacing = s * 0.27
	for _, face in FACES do
		for _, uv in PIPS[face.value] do
			local pipCf = cf * face.rot * CF(uv[1] * spacing, uv[2] * spacing, -s / 2) * CFrame.Angles(0, math.pi / 2, 0)
			Parts.Part({
				Parent = m,
				Name = "Pip",
				Shape = Enum.PartType.Cylinder,
				CFrame = pipCf,
				Size = V3(s * 0.07, s * 0.18, s * 0.18),
				Color = pipColor,
				Material = Mat.Neon,
				CanCollide = false,
			})
		end
	end
	return m
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Road</string>
            <string name="Source"><![CDATA[--!strict
-- Road (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > Road
--
-- Die "Signal Road": vom Nordrand der Plaza schnurgerade nach Norden durch alle
-- Gebiete. Zwischen zwei Gebieten liegt jeweils eine Brücke über dem Nichts
-- (mit Geländer und unsichtbaren Wänden, damit niemand herunterfällt).
-- Innerhalb eines Gebiets bekommt die Straße den Look des Gebiets (Farben aus
-- AreaConfig). Die Gebiete selbst halten den Straßenkorridor frei.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local WorldConfig = require(ConfigFolder:WaitForChild("WorldConfig"))
local AreaConfig = require(ConfigFolder:WaitForChild("AreaConfig"))

local Parts = require(script.Parent:WaitForChild("Parts"))
local Props = require(script.Parent:WaitForChild("Props"))

local Palette = Parts.Palette
local V3 = Vector3.new
local CF = CFrame.new
local Mat = Enum.Material

local Road = {}

local ROAD_TOP = 0.05 -- Oberkante der Straße (Gebietsböden liegen bei -0.1)
local BOUND_HEIGHT = 80

-- Straßenstil je Gebiet
local STYLES: { [string]: { Surface: Color3, Material: Enum.Material, Edge: Color3, Center: Color3, CenterNeon: boolean, Lamp: Color3 } } = {
	Suburb = { Surface = Palette.Asphalt, Material = Mat.Asphalt, Edge = Palette.White, Center = Palette.Yellow, CenterNeon = false, Lamp = Palette.Orange },
	DarkForest = { Surface = Color3.fromRGB(62, 50, 40), Material = Mat.Ground, Edge = Color3.fromRGB(90, 110, 80), Center = Color3.fromRGB(80, 200, 110), CenterNeon = true, Lamp = Color3.fromRGB(150, 255, 170) },
	SecretLab = { Surface = Color3.fromRGB(60, 62, 70), Material = Mat.Concrete, Edge = Palette.Yellow, Center = Color3.fromRGB(60, 200, 255), CenterNeon = true, Lamp = Color3.fromRGB(220, 240, 255) },
	RiftZone = { Surface = Color3.fromRGB(34, 26, 52), Material = Mat.Slate, Edge = Palette.Cyan, Center = Palette.Purple, CenterNeon = true, Lamp = Palette.Purple },
	Otherworld = { Surface = Color3.fromRGB(16, 44, 48), Material = Mat.Basalt, Edge = Palette.Magenta, Center = Palette.Teal, CenterNeon = true, Lamp = Palette.Magenta },
	Void = { Surface = Color3.fromRGB(10, 6, 18), Material = Mat.Glass, Edge = Palette.Purple, Center = Color3.fromRGB(130, 50, 255), CenterNeon = true, Lamp = Color3.fromRGB(130, 50, 255) },
}

local function sortedAreas(): { AreaConfig.AreaDef }
	local list = table.clone(AreaConfig.List)
	table.sort(list, function(a, b)
		return a.Order < b.Order
	end)
	return list
end
Road.SortedAreas = sortedAreas

-- Straßenstück von zStart (Süden, größeres Z) bis zEnd (Norden)
local function strip(model: Model, x: number, zStart: number, zEnd: number, style: any, dashed: boolean)
	local len = zStart - zEnd
	local midZ = (zStart + zEnd) / 2
	local rw = WorldConfig.RoadWidth
	Parts.Box(model, CF(x, ROAD_TOP - 0.5, midZ), V3(rw, 1, len), style.Surface, style.Material, "RoadSurface")
	for _, sx in { -1, 1 } do
		Parts.Detail(model, CF(x + sx * (rw / 2 - 1.4), ROAD_TOP + 0.02, midZ), V3(0.5, 0.06, len - 1), style.Edge, Mat.SmoothPlastic, "EdgeLine")
	end
	if dashed then
		local z = zStart - 6
		while z - 6 > zEnd do
			Parts.Detail(model, CF(x, ROAD_TOP + 0.02, z - 3), V3(0.6, 0.06, 6), style.Center, Mat.SmoothPlastic, "LaneDash")
			z -= 16
		end
	else
		Parts.Part({
			Parent = model,
			Name = "CenterLine",
			CFrame = CF(x, ROAD_TOP + 0.02, midZ),
			Size = V3(0.6, 0.06, len - 4),
			Color = style.Center,
			Material = if style.CenterNeon then Mat.Neon else Mat.SmoothPlastic,
			CanCollide = false,
		})
	end
end

local function lampPair(model: Model, x: number, z: number, color: Color3, height: number?)
	for _, sx in { -1, 1 } do
		local pos = V3(x + sx * (WorldConfig.RoadWidth / 2 + 2.5), WorldConfig.GroundY, z)
		Props.Streetlamp(model, Parts.FaceTowards(pos, V3(x, pos.Y, z)), { Height = height or 15, Color = color })
	end
end

-- Brücke zwischen zwei Gebieten (zSouth > zNorth)
local function bridge(model: Model, bounds: Folder, x: number, zSouth: number, zNorth: number, color: Color3)
	local rw = WorldConfig.RoadWidth
	local len = zSouth - zNorth + 4 -- je 2 Studs Überlappung in die Gebiete
	local midZ = (zSouth + zNorth) / 2
	Parts.Box(model, CF(x, ROAD_TOP - 1.5, midZ), V3(rw + 4, 3, len), Palette.ConcreteDark, Mat.Concrete, "BridgeDeck")
	Parts.Detail(model, CF(x, ROAD_TOP + 0.02, midZ), V3(0.6, 0.06, len - 6), Palette.Yellow, Mat.SmoothPlastic, "CenterLine")
	for _, sx in { -1, 1 } do
		local rx = x + sx * (rw / 2 + 1.2)
		Parts.Box(model, CF(rx, ROAD_TOP + 1.5, midZ), V3(1.6, 3, len), Palette.Metal, Mat.Metal, "Railing")
		Parts.Neon(model, CF(rx, ROAD_TOP + 3.1, midZ), V3(1.7, 0.25, len), color, "RailGlow")
		Parts.Invisible(bounds, CF(x + sx * (rw / 2 + 2), BOUND_HEIGHT / 2, midZ), V3(2, BOUND_HEIGHT, len), "BridgeWall", true)
		Parts.Box(model, CF(x + sx * (rw / 2 - 2), -32, midZ), V3(4, 60, 6), Palette.ConcreteDark, Mat.Concrete, "Pillar")
	end
end

-- Baut die komplette Straße. Unsichtbare Brücken-Wände landen in bounds.
function Road.Build(parent: Instance, bounds: Folder): Model
	local model = Parts.Model(nil, "SignalRoad")
	local x = WorldConfig.HubCenter.X
	local areas = sortedAreas()

	-- 1) Suburb: vom Plaza-Rand bis zum Nordrand des Suburbs
	local suburb = areas[1]
	local zSuburbNorth = suburb.Center.Z - suburb.Size.Z / 2
	local zPlaza = WorldConfig.HubCenter.Z - WorldConfig.PlazaRadius + 2
	strip(model, x, zPlaza, zSuburbNorth, STYLES.Suburb, true)
	local z = zPlaza - 26
	while z > zSuburbNorth + 10 do
		lampPair(model, x, z, STYLES.Suburb.Lamp)
		z -= 48
	end

	-- 2) Gebiete + Brücken
	for i = 2, #areas do
		local prev = areas[i - 1]
		local area = areas[i]
		local style = STYLES[area.Id] or STYLES.Suburb
		local zPrevNorth = prev.Center.Z - prev.Size.Z / 2
		local zSouth = area.Center.Z + area.Size.Z / 2
		local zNorth = area.Center.Z - area.Size.Z / 2
		bridge(model, bounds, x, zPrevNorth, zSouth, area.PrimaryColor)
		lampPair(model, x, (zPrevNorth + zSouth) / 2, area.PrimaryColor, 12)

		local isLast = i == #areas
		local zEnd = if isLast then zNorth + 40 else zNorth
		strip(model, x, zSouth, zEnd, style, false)
		-- Laternen im Gebiet (Gebiete halten diese Positionen frei)
		for _, t in { 0.3, 0.7 } do
			lampPair(model, x, zSouth - (zSouth - zEnd) * t, style.Lamp, 15)
		end
	end
	model.Parent = parent
	return model
end

return Road
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- WorldBuilder (ModuleScript)
-- Ort: ServerScriptService > VoidDiceServer > World > WorldBuilder
--
-- Baut die komplette Map prozedural unter `parent` (im Spiel: workspace).
-- Fester Seed -> die Map sieht bei jedem Serverstart identisch aus.
--
-- Struktur:
--   VoidDiceWorld (Folder, Name aus WorldConfig.WorldFolderName)
--     Hub          Model (Plaza, PlazaDie, SpawnLocation, Stations/*, LeaderboardWall)
--     Plots        Folder mit Plot1..Plot8
--     Areas        Folder mit DarkForest, SecretLab, RiftZone, Otherworld, Void
--     SignalRoad   Model (Straße, Brücken, Laternen)
--     Bounds       Folder mit unsichtbaren Wänden (Weltgrenze)
--
-- Rückgabe von Build: siehe Typ World unten.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local WorldConfig = require(ConfigFolder:WaitForChild("WorldConfig"))
local AreaConfig = require(ConfigFolder:WaitForChild("AreaConfig"))

local Parts = require(script.Parent:WaitForChild("Parts"))
local Hub = require(script.Parent:WaitForChild("Hub"))
local Plot = require(script.Parent:WaitForChild("Plot"))
local Areas = require(script.Parent:WaitForChild("Areas"))
local Road = require(script.Parent:WaitForChild("Road"))

local V3 = Vector3.new
local CF = CFrame.new

local WorldBuilder = {}

WorldBuilder.Seed = 1985
WorldBuilder.BoundHeight = 100

export type World = {
	Root: Folder,
	Hub: Model,
	Plots: { [number]: Model },
	Areas: { [string]: Model },
	Stations: { [string]: Model },
	Leaderboards: { [string]: BasePart },
	SpawnLocation: SpawnLocation,
	PlazaDie: Model,
	Road: Model,
	PartCount: number,
	LightCount: number,
}

-- Unsichtbare Wand als achsenparalleles Rechteck (x0..x1, z0..z1)
local function wall(bounds: Folder, x0: number, x1: number, z0: number, z1: number)
	local sx = math.max(math.abs(x1 - x0), 2)
	local sz = math.max(math.abs(z1 - z0), 2)
	local h = WorldBuilder.BoundHeight
	Parts.Invisible(bounds, CF((x0 + x1) / 2, WorldConfig.GroundY + h / 2 - 10, (z0 + z1) / 2), V3(sx, h, sz), "Boundary", true)
end

-- Grenzen um jedes Gebiet. Öffnungen nur dort, wo Straße/Brücke/Tor liegen.
local function buildBounds(bounds: Folder)
	local areas = Road.SortedAreas()
	local roadX = WorldConfig.HubCenter.X
	local roadHalf = WorldConfig.RoadWidth / 2 + 1 -- trifft die Brückenwände
	local gateHalf = WorldConfig.GateWidth / 2
	for i, def in areas do
		local c, hx, hz = def.Center, def.Size.X / 2, def.Size.Z / 2
		local w, e, s, n = c.X - hx, c.X + hx, c.Z + hz, c.Z - hz
		wall(bounds, w - 1, w + 1, s, n)
		wall(bounds, e - 1, e + 1, s, n)
		-- Süden: Suburb geschlossen, sonst Öffnung für das Tor
		if i == 1 then
			wall(bounds, w, e, s - 1, s + 1)
		else
			wall(bounds, w, roadX - gateHalf, s - 1, s + 1)
			wall(bounds, roadX + gateHalf, e, s - 1, s + 1)
		end
		-- Norden: letztes Gebiet geschlossen, sonst Öffnung für die Brücke
		if i == #areas then
			wall(bounds, w, e, n - 1, n + 1)
		else
			wall(bounds, w, roadX - roadHalf, n - 1, n + 1)
			wall(bounds, roadX + roadHalf, e, n - 1, n + 1)
		end
	end
end

function WorldBuilder.Build(parent: Instance): World
	Parts.ResetStats()
	local seed = WorldBuilder.Seed

	local root = Instance.new("Folder")
	root.Name = WorldConfig.WorldFolderName

	local bounds = Parts.Folder(root, "Bounds")

	local hub = Hub.Build(root, Random.new(seed + 1))

	local plotsFolder = Parts.Folder(root, "Plots")
	local plots: { [number]: Model } = {}
	for i = 1, WorldConfig.PlotCount do
		plots[i] = Plot.Build(i, WorldConfig.PlotCFrame(i), plotsFolder)
	end

	local areasFolder = Parts.Folder(root, "Areas")
	local areas: { [string]: Model } = {}
	for _, def in Road.SortedAreas() do
		if def.Id ~= AreaConfig.StartArea then
			areas[def.Id] = Areas.Build(def, areasFolder, Random.new(seed + 100 + def.Order))
		end
	end

	local road = Road.Build(root, bounds)
	buildBounds(bounds)

	if Parts.Stats.SkippedLights > 0 then
		warn(string.format("[WorldBuilder] %d Lichter wegen Limit (%d) ausgelassen", Parts.Stats.SkippedLights, Parts.MaxLights))
	end

	root.Parent = parent
	return {
		Root = root,
		Hub = hub.Model,
		Plots = plots,
		Areas = areas,
		Stations = hub.Stations,
		Leaderboards = hub.Leaderboards,
		SpawnLocation = hub.SpawnLocation,
		PlazaDie = hub.PlazaDie,
		Road = road,
		PartCount = Parts.CountParts(root),
		LightCount = Parts.Stats.Lights,
	}
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="89">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="90">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="91">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="92">
        <Properties>
          <string name="Name">VoidDiceClient</string>
          <string name="Source"><![CDATA[-- VoidDiceClient (LocalScript)
-- Ort: StarterPlayer > StarterPlayerScripts > VoidDiceClient
--
-- Startet die Client-Seite. Der Client zeigt nur an und schickt Wünsche
-- (Actions) – entschieden wird alles auf dem Server.
--
--   State           Spiegel des Profils (Sync vom Server)
--   UI/             Bausteine (Components, Viewport, Root)
--   Controllers/    HUD, Reveal, Fenster, Base-Animation, Gebiete, Sound …

local Controllers = script:WaitForChild("Controllers")

local State = require(script:WaitForChild("State"))
local Root = require(script:WaitForChild("UI"):WaitForChild("Root"))

State.start()
Root.init()

local Sound = require(Controllers:WaitForChild("SoundController"))
Sound.preload()

local ORDER = {
	"WindowManager",
	"HUD",
	"RevealController",
	"Notifications",
	"BaseAnimator",
	"BaseInteraction",
	"AreaController",
	"AmbienceController",
	"TutorialController",
	"InputController",
}

for _, name in ORDER do
	local ok, err = pcall(function()
		local controller = require(Controllers:WaitForChild(name)) :: any
		controller.init()
	end)
	if not ok then
		warn("[VoidDiceClient] " .. name .. " konnte nicht starten:", err)
	end
end

-- SFX-Einstellung live übernehmen
State.Changed:Connect(function(key)
	if key == "Settings" and State.data.Settings then
		Sound.enabled = State.data.Settings.SFX ~= false
	end
end)

-- Falls der erste Sync schon vor dem Start der Controller ankam: alles einmal
-- neu zeichnen lassen.
if State.ready then
	for key in State.data do
		State.Changed:Fire(key)
	end
	State.Changed:Fire("Derived")
	State.Changed:Fire("Session")
end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[--!strict
-- Actions (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Actions
--
-- Der einzige Weg, wie der Client etwas vom Server will. Der Server prüft
-- und entscheidet; das Ergebnis kommt per Sync/Event zurück.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Net"))

local Actions = {}

local remote: RemoteEvent? = nil

function Actions.send(name: string, ...: any)
	assert(Net.Actions[name], "Unbekannte Action: " .. name)
	if not remote then
		remote = Net.get("Action")
	end
	(remote :: RemoteEvent):FireServer(name, ...)
end

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="94">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">AmbienceController</string>
              <string name="Source"><![CDATA[--!strict
-- AmbienceController (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > AmbienceController
--
-- Spielt pro Gebiet einen Ambience-/Musik-Loop (SoundConfig.Ambience) und
-- blendet beim Gebietswechsel über. Leere Ids = Stille (bis eigene/
-- lizenzierte Tracks eingetragen sind). Respektiert Settings.Music.

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local SoundConfig = require(Config:WaitForChild("SoundConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local AreaController = require(script.Parent:WaitForChild("AreaController"))

local AmbienceController = {}

local current: Sound? = nil
local currentKey: string? = nil

local function musicEnabled(): boolean
	local settings = State.data.Settings
	return settings == nil or settings.Music ~= false
end

local function play(key: string?)
	if key == currentKey then
		return
	end
	currentKey = key
	local old = current
	if old then
		UI.tween(old, 1.5, { Volume = 0 })
		task.delay(1.6, function()
			old:Destroy()
		end)
	end
	current = nil
	local def = key and SoundConfig.Ambience[key]
	if not def or def.Id == "" or not musicEnabled() then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Ambience_" .. key
	sound.SoundId = def.Id
	sound.Looped = true
	sound.Volume = 0
	sound.Parent = SoundService
	sound:Play()
	UI.tween(sound, 2, { Volume = def.Volume })
	current = sound
end

function AmbienceController.init()
	AreaController.AreaChanged:Connect(function(areaId)
		local def = AreaConfig.Get(areaId)
		play(def and def.Ambience or nil)
	end)
	State.Changed:Connect(function(key)
		if key == "Settings" then
			if not musicEnabled() then
				play(nil)
			elseif AreaController.current then
				local def = AreaConfig.Get(AreaController.current)
				currentKey = nil
				play(def and def.Ambience or nil)
			end
		end
	end)
end

return AmbienceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">AreaController</string>
              <string name="Source"><![CDATA[--!strict
-- AreaController (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > AreaController
--
-- * Erkennt, in welchem Gebiet der Spieler ist, und blendet Licht/Nebel/
--   Atmosphäre weich über (AreaConfig.Lighting).
-- * Zeigt beim Betreten den Gebietsnamen.
-- * Tore: freigeschaltete Gebiete werden LOKAL geöffnet (CanCollide aus,
--   unsichtbar). Gesperrte bleiben eine Energiebarriere. Der Server prüft
--   Teleports/Fishing trotzdem selbst.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local WorldConfig = require(Config:WaitForChild("WorldConfig"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))
local Signal = require(Client:WaitForChild("Signal"))

local AreaController = {}

AreaController.current = nil :: string?
AreaController.AreaChanged = Signal.new()

local atmosphere: Atmosphere
local colorCorrection: ColorCorrectionEffect
local titleLabel: TextLabel
local subtitleLabel: TextLabel

local function applyLighting(def: AreaConfig.AreaDef)
	local l = def.Lighting
	UI.tween(Lighting, 2, {
		Ambient = l.Ambient,
		OutdoorAmbient = l.OutdoorAmbient,
		FogColor = l.FogColor,
		FogStart = l.FogStart,
		FogEnd = l.FogEnd,
		ClockTime = l.ClockTime,
		Brightness = l.Brightness,
		ColorShift_Top = l.ColorShift,
	})
	UI.tween(atmosphere, 2, {
		Color = l.FogColor,
		Decay = l.FogColor:Lerp(Color3.new(0, 0, 0), 0.4),
		Density = math.clamp(120 / l.FogEnd, 0.15, 0.55),
	})
	UI.tween(colorCorrection, 2, { TintColor = Color3.new(1, 1, 1):Lerp(def.PrimaryColor, 0.08) })
end

local function showTitle(def: AreaConfig.AreaDef)
	titleLabel.Text = def.DisplayName
	titleLabel.TextColor3 = def.PrimaryColor
	subtitleLabel.Text = def.Tagline
	titleLabel.TextTransparency = 1
	subtitleLabel.TextTransparency = 1
	titleLabel.Visible = true
	subtitleLabel.Visible = true
	UI.tween(titleLabel, 0.6, { TextTransparency = 0 })
	UI.tween(subtitleLabel, 0.6, { TextTransparency = 0.1 })
	task.delay(3, function()
		UI.tween(titleLabel, 0.8, { TextTransparency = 1 })
		UI.tween(subtitleLabel, 0.8, { TextTransparency = 1 })
	end)
end

local function areaAt(position: Vector3): string
	local best = AreaConfig.StartArea
	for _, def in AreaConfig.List do
		if def.Id ~= AreaConfig.StartArea and AreaConfig.Contains(def, position) then
			best = def.Id
		end
	end
	return best
end

-- Tore lokal öffnen/schließen
local function updateGates()
	local world = workspace:FindFirstChild(WorldConfig.WorldFolderName)
	if not world then
		return
	end
	for _, inst in world:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name == "Gate" then
			local areaId = inst:GetAttribute("AreaId") :: string?
			local open = areaId ~= nil and State.data.Areas ~= nil and State.data.Areas[areaId] == true
			inst.CanCollide = not open
			inst.LocalTransparencyModifier = if open then 1 else 0
			for _, child in inst:GetChildren() do
				if child:IsA("SurfaceGui") or child:IsA("BillboardGui") then
					child.Enabled = not open
				elseif child:IsA("ParticleEmitter") then
					child.Enabled = not open
				end
			end
		end
	end
end

function AreaController.init()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "VoidDiceTint"
	colorCorrection.Saturation = 0.05
	colorCorrection.Contrast = 0.08
	colorCorrection.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	titleLabel = UI.label({
		Font = UI.Fonts.Title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(700, 70),
		MaxTextSize = 64,
		Visible = false,
		Parent = Root.Layers.Toasts,
	})
	UI.stroke(titleLabel, Color3.new(0, 0, 0), 2).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	subtitleLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 48),
		Size = UDim2.fromOffset(600, 26),
		TextColor3 = UI.Colors.SubText,
		MaxTextSize = 24,
		Visible = false,
		Parent = Root.Layers.Toasts,
	})

	local start = AreaConfig.Get(AreaConfig.StartArea)
	if start then
		applyLighting(start)
	end

	State.Changed:Connect(function(key)
		if key == "Areas" then
			updateGates()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(WorldConfig.AreaCheckInterval)
			local character = Players.LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local id = areaAt(root.Position)
				if id ~= AreaController.current then
					AreaController.current = id
					local def = AreaConfig.Get(id)
					if def then
						applyLighting(def)
						showTitle(def)
					end
					AreaController.AreaChanged:Fire(id)
				end
			end
		end
	end)
	-- Tore auch nach Streaming nachziehen
	task.spawn(function()
		while true do
			updateGates()
			task.wait(5)
		end
	end)
end

return AreaController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">BaseAnimator</string>
              <string name="Source"><![CDATA[--!strict
-- BaseAnimator (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > BaseAnimator
--
-- Lässt die Characters in allen Bases leben, NUR lokal auf dem Client:
-- Walkie-Talkie benutzen, Taschenlampe schwenken, umsehen, schweben,
-- Psychic-Hover, Flügel schlagen, Orbits drehen, Fishing inkl. Fang-Ruck.
--
-- Technik: Die Models sind verankert. Pro Model werden die Teile einmal
-- relativ zur Ruhepose gecacht (Gruppen Head/ArmL/ArmR/WingL/WingR/Tail/
-- Orbit/Core mit "Joint" als Drehpunkt, siehe ModelFactory). Pro Frame wird
-- dann per workspace:BulkMoveTo bewegt (schnell, keine Physik).
--
-- Performance: nur Models innerhalb UIConfig.AnimateDistance, höchstens
-- UIConfig.MaxAnimatedModels, ~30 Updates/s. Weit entfernte Models schalten
-- ihre Partikel/Lichter lokal ab (LOD).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("UIConfig"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))

local BaseAnimator = {}

local TAG = "VoidDiceCharacter"
local GROUPS = { Head = true, ArmL = true, ArmR = true, WingL = true, WingR = true, Tail = true, Orbit = true, Core = true }
local UPDATE_INTERVAL = 1 / 30
local EFFECT_LOD_DISTANCE = 170

local FISHING_SET = { Bob = 0.03, BobSpeed = 1.2, HeadTurn = 12, ArmSwing = 2, ArmRaise = 45 }

type Group = { jointRel: CFrame, parts: { BasePart }, rel: { CFrame } }
type Entry = {
	model: Model,
	root: BasePart,
	base: CFrame,
	bodyParts: { BasePart },
	bodyRel: { CFrame },
	groups: { [string]: Group },
	allParts: { BasePart },
	restCFrames: { CFrame },
	set: { [string]: any },
	phase: number,
	dirty: boolean,
	effects: { Instance },
	effectsOn: boolean,
	jerkUntil: number,
	connections: { RBXScriptConnection },
}

local entries: { [Model]: Entry } = {}

local function groupOf(model: Model, part: BasePart): Model?
	local node: Instance? = part.Parent
	while node and node ~= model do
		if node:IsA("Model") and GROUPS[node.Name] then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function restore(entry: Entry)
	if #entry.allParts > 0 then
		workspace:BulkMoveTo(entry.allParts, entry.restCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function cache(entry: Entry)
	local model = entry.model
	local root = entry.root
	entry.base = root.CFrame
	entry.bodyParts, entry.bodyRel = {}, {}
	entry.groups = {}
	entry.allParts, entry.restCFrames = {}, {}
	entry.effects = {}
	local inverseBase = entry.base:Inverse()
	for _, inst in model:GetDescendants() do
		if inst:IsA("BasePart") and inst ~= root then
			table.insert(entry.allParts, inst)
			table.insert(entry.restCFrames, inst.CFrame)
			local group = groupOf(model, inst)
			if group and group.PrimaryPart then
				local g = entry.groups[group.Name]
				if not g then
					g = { jointRel = inverseBase * group.PrimaryPart.CFrame, parts = {}, rel = {} }
					entry.groups[group.Name] = g
				end
				table.insert(g.parts, inst)
				table.insert(g.rel, group.PrimaryPart.CFrame:Inverse() * inst.CFrame)
			else
				table.insert(entry.bodyParts, inst)
				table.insert(entry.bodyRel, inverseBase * inst.CFrame)
			end
		elseif inst:IsA("ParticleEmitter") or inst:IsA("Light") or inst:IsA("Beam") then
			table.insert(entry.effects, inst)
		end
	end
	local setName = model:GetAttribute("AnimationSet") :: string?
	if model:GetAttribute("Fishing") then
		entry.set = FISHING_SET
	else
		entry.set = UIConfig.AnimationSets[setName or "Default"] or UIConfig.AnimationSets.Default
	end
	entry.dirty = false
end

local function register(model: Instance)
	if not model:IsA("Model") or entries[model] then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	if not root or not root:IsA("BasePart") then
		-- Streaming: Root kommt evtl. später
		task.delay(1, function()
			if model.Parent and CollectionService:HasTag(model, TAG) then
				register(model)
			end
		end)
		return
	end
	local entry: Entry = {
		model = model,
		root = root,
		base = root.CFrame,
		bodyParts = {},
		bodyRel = {},
		groups = {},
		allParts = {},
		restCFrames = {},
		set = UIConfig.AnimationSets.Default,
		phase = math.random() * 10,
		dirty = true,
		effects = {},
		effectsOn = true,
		jerkUntil = 0,
		connections = {},
	}
	entries[model] = entry
	table.insert(entry.connections, model.DescendantAdded:Connect(function(inst)
		if inst:IsA("BasePart") or inst:IsA("ParticleEmitter") or inst:IsA("Light") then
			entry.dirty = true
		end
	end))
	table.insert(entry.connections, root:GetPropertyChangedSignal("CFrame"):Connect(function()
		entry.dirty = true
	end))
	table.insert(entry.connections, model:GetAttributeChangedSignal("AnimationSet"):Connect(function()
		entry.dirty = true
	end))
end

local function unregister(model: Instance)
	local entry = entries[model :: Model]
	if entry then
		for _, c in entry.connections do
			c:Disconnect()
		end
		entries[model :: Model] = nil
	end
end

local function setEffects(entry: Entry, on: boolean)
	if entry.effectsOn == on then
		return
	end
	entry.effectsOn = on
	for _, effect in entry.effects do
		if effect.Parent then
			if on then
				local was = effect:GetAttribute("VD_WasEnabled")
				if was ~= nil then
					(effect :: any).Enabled = was
				end
			else
				effect:SetAttribute("VD_WasEnabled", (effect :: any).Enabled)
				;(effect :: any).Enabled = false
			end
		end
	end
end

local partsBuffer: { BasePart } = {}
local cfBuffer: { CFrame } = {}

local function animate(entry: Entry, t: number)
	local set = entry.set
	local tt = t + entry.phase
	local bobSpeed = set.BobSpeed or 1.5
	local bob = (set.Bob or 0) * math.sin(tt * bobSpeed * 2)
	local hover = set.Hover or 0
	local yaw = 0
	if set.Spin then
		yaw = math.rad(set.Spin) * tt
	elseif set.Sway then
		yaw = math.rad(set.Sway) * math.sin(tt * 0.8)
	end
	local jitter = Vector3.zero
	if set.Jitter and math.random() < 0.3 then
		jitter = Vector3.new((math.random() - 0.5) * set.Jitter, 0, (math.random() - 0.5) * set.Jitter)
	end
	local sitDrop = if set.Sit then -0.5 else 0
	local modelCF = entry.base * CFrame.new(jitter.X, hover + bob + sitDrop, jitter.Z) * CFrame.Angles(0, yaw, 0)

	local n = 0
	for i, part in entry.bodyParts do
		n += 1
		partsBuffer[n] = part
		cfBuffer[n] = modelCF * entry.bodyRel[i]
	end

	local swing = math.rad(set.ArmSwing or 0) * math.sin(tt * bobSpeed * 2)
	local raise = math.rad(set.ArmRaise or 0)
	local jerk = if os.clock() < entry.jerkUntil then math.rad(40) else 0
	for name, g in entry.groups do
		local rot: CFrame
		if name == "Head" then
			local turn = math.rad(set.HeadTurn or 0) * math.sin(tt * 0.7)
			local tilt = math.rad(set.HeadTilt or 0) * math.sin(tt * 0.5)
			if set.Talk then
				tilt += math.rad(6) * math.sin(tt * 9)
			end
			rot = CFrame.Angles(tilt, turn, 0)
		elseif name == "ArmR" then
			local sweep = math.rad(set.Sweep or 0) * math.sin(tt * 0.9)
			rot = CFrame.Angles(raise + swing + jerk, sweep, 0)
		elseif name == "ArmL" then
			local leftRaise = if set.BothArms then raise else 0
			rot = CFrame.Angles(leftRaise - swing, 0, 0)
		elseif name == "WingL" then
			rot = CFrame.Angles(0, 0, math.rad(set.WingFlap or 25) * math.sin(tt * 8))
		elseif name == "WingR" then
			rot = CFrame.Angles(0, 0, -math.rad(set.WingFlap or 25) * math.sin(tt * 8))
		elseif name == "Tail" then
			rot = CFrame.Angles(0, math.rad(20) * math.sin(tt * 1.6), 0)
		elseif name == "Orbit" then
			rot = CFrame.Angles(0, tt * 1.2, 0)
		elseif name == "Core" then
			rot = CFrame.new(0, 0.15 * math.sin(tt * 2.2), 0) * CFrame.Angles(0, tt * 0.6, 0)
		else
			rot = CFrame.identity
		end
		local joint = modelCF * g.jointRel * rot
		for i, part in g.parts do
			n += 1
			partsBuffer[n] = part
			cfBuffer[n] = joint * g.rel[i]
		end
	end
	for i = #partsBuffer, n + 1, -1 do
		partsBuffer[i] = nil
		cfBuffer[i] = nil
	end
	if n > 0 then
		workspace:BulkMoveTo(partsBuffer, cfBuffer, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function splash(position: Vector3, color: Color3)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.2, 1, 1)
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	local TweenService = game:GetService("TweenService")
	TweenService:Create(ring, TweenInfo.new(0.6), { Size = Vector3.new(0.2, 6, 6), Transparency = 1 }):Play()
	task.delay(0.7, function()
		ring:Destroy()
	end)
end

function BaseAnimator.init()
	for _, model in CollectionService:GetTagged(TAG) do
		register(model)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(register)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(unregister)

	-- Fang-Animation am eigenen Pond
	State.on("Catch", function(data)
		for model, entry in entries do
			if model.Name == data.Uid and model:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId then
				entry.jerkUntil = os.clock() + 0.45
				local bobber = model:FindFirstChild("Bobber")
				if bobber and bobber:IsA("BasePart") then
					splash(bobber.Position, Color3.fromRGB(140, 120, 255))
				end
			end
		end
	end)

	local accumulator = 0
	local candidates: { { entry: Entry, distance: number } } = {}
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < UPDATE_INTERVAL then
			return
		end
		accumulator = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		table.clear(candidates)
		for model, entry in entries do
			if not model.Parent then
				continue
			end
			if entry.dirty then
				restore(entry)
				cache(entry)
			end
			local distance = (entry.base.Position - camPos).Magnitude
			setEffects(entry, distance < EFFECT_LOD_DISTANCE)
			if distance < UIConfig.AnimateDistance then
				table.insert(candidates, { entry = entry, distance = distance })
			end
		end
		table.sort(candidates, function(a, b)
			return a.distance < b.distance
		end)
		local t = os.clock()
		local reduced = State.data.Settings and State.data.Settings.ReducedEffects
		local limit = if reduced then math.floor(UIConfig.MaxAnimatedModels / 2) else UIConfig.MaxAnimatedModels
		for i = 1, math.min(#candidates, limit) do
			animate(candidates[i].entry, t)
		end
	end)
end

return BaseAnimator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">BaseInteraction</string>
              <string name="Source"><![CDATA[--!strict
-- BaseInteraction (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > BaseInteraction
--
-- ProximityPrompts, die nur dieser Client sieht:
--   * eigene Base: auf jedem belegten Pad "Manage" (öffnet Character-Fenster
--     mit Level, $/s, Power, Fishing Power, Gear, UPGRADE), auf leeren Pads
--     "Place Best"
--   * fremde Bases: am Schild "Inspect Base" (Social Flex)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local CharacterConfig = require(Shared:WaitForChild("Config"):WaitForChild("CharacterConfig"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local WindowManager = require(script.Parent:WaitForChild("WindowManager"))

local BaseInteraction = {}

local prompts: { ProximityPrompt } = {}
local signPrompts: { [Model]: ProximityPrompt } = {}

local function clearPrompts()
	for _, p in prompts do
		p:Destroy()
	end
	table.clear(prompts)
end

local function makePrompt(parent: Instance, action: string, object: string, onTrigger: () -> ()): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = parent
	prompt.Triggered:Connect(onTrigger)
	return prompt
end

local function world(): Instance?
	return workspace:FindFirstChild(WorldConfig.WorldFolderName)
end

local function findPlot(index: number): Model?
	local w = world()
	if not w then
		return nil
	end
	local plot = w:FindFirstChild("Plot" .. index, true)
	return if plot and plot:IsA("Model") then plot else nil
end

local function refreshOwnBase()
	clearPrompts()
	local plotIndex = State.session.Plot
	local plot = plotIndex and findPlot(plotIndex)
	local slots = plot and plot:FindFirstChild("Slots")
	if not slots then
		return
	end
	local bySlot = {}
	for uid, char in State.data.Characters or {} do
		if char.Slot then
			bySlot[char.Slot] = uid
		end
	end
	for _, pad in slots:GetChildren() do
		if pad:IsA("BasePart") then
			local index = (pad:GetAttribute("SlotIndex") :: number?) or tonumber(pad.Name:match("%d+")) or 0
			local uid = bySlot[index]
			if uid then
				local char = State.data.Characters[uid]
				local def = CharacterConfig.ById[char.Id]
				table.insert(prompts, makePrompt(pad, "Manage", def and def.DisplayName or "Character", function()
					WindowManager.open("Character", { Uid = uid })
				end))
			elseif index <= (State.derived.BaseSlots or 0) then
				table.insert(prompts, makePrompt(pad, "Place Best", "Empty Slot", function()
					Actions.send("PlaceBest")
				end))
			end
		end
	end
	local pond = plot and plot:FindFirstChild("PondWater", true)
	if pond then
		table.insert(prompts, makePrompt(pond, "Rift Fishing", "Rift Pond", function()
			WindowManager.open("Fishing")
		end))
	end
end

local function refreshSigns()
	local w = world()
	if not w then
		return
	end
	for i = 1, WorldConfig.PlotCount do
		local plot = findPlot(i)
		local sign = plot and plot:FindFirstChild("SignBoard", true)
		if plot and sign and not signPrompts[plot] and i ~= State.session.Plot then
			signPrompts[plot] = makePrompt(sign, "Inspect Base", "Base " .. i, function()
				Actions.send("InspectBase", i)
			end)
		elseif plot and signPrompts[plot] and i == State.session.Plot then
			signPrompts[plot]:Destroy()
			signPrompts[plot] = nil
		end
	end
end

function BaseInteraction.init()
	local pending = false
	local function schedule()
		if pending then
			return
		end
		pending = true
		task.delay(0.3, function()
			pending = false
			refreshOwnBase()
			refreshSigns()
		end)
	end
	State.Changed:Connect(function(key)
		if key == "Characters" or key == "Session" or key == "Derived" then
			schedule()
		end
	end)
	-- Plots können durch Streaming später ankommen
	task.spawn(function()
		while true do
			task.wait(10)
			refreshSigns()
		end
	end)
	schedule()
end

return BaseInteraction
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- HUD (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > HUD
--
-- Haupt-HUD:
--   oben Mitte   Cash, $/s, COLLECT (Vault)
--   oben links   Luck (mit exakter Aufschlüsselung), Rebirth-Fortschritt, Boosts
--   links        Menü (Inventory, Index, Shop, Quests, Fishing, Items, Map, Settings)
--   unten Mitte  großer ROLL-Button, AUTO, Dice
--   rechts       Mini-Quest-Tracker
--
-- Alle Zahlen kommen vom Server (State). Der HUD rechnet nichts selbst aus.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local QuestConfig = require(Config:WaitForChild("QuestConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))
local WindowManager = require(script.Parent:WaitForChild("WindowManager"))

local C = UI.Colors
local F = UI.Fonts
local new = UI.new

local HUD = {}

HUD.RollButton = nil :: TextButton?
HUD.AutoButton = nil :: TextButton?
HUD.CollectButton = nil :: TextButton?
HUD.MenuButtons = {} :: { [string]: TextButton }

local rollCooldownEnd = 0
local rollCooldownLength = 1

local MENU = {
	{ Name = "Inventory", Icon = "🎒", Key = "I" },
	{ Name = "Index", Icon = "📖", Key = "X" },
	{ Name = "Shop", Icon = "🛒", Key = "B" },
	{ Name = "Quests", Icon = "📜", Key = "Q" },
	{ Name = "Fishing", Icon = "🎣", Key = "F" },
	{ Name = "Items", Icon = "🧪", Key = "G" },
	{ Name = "Map", Icon = "🗺", Key = "M" },
	{ Name = "Settings", Icon = "⚙", Key = "" },
}

function HUD.roll()
	if os.clock() < rollCooldownEnd - 0.05 then
		return
	end
	Actions.send("Roll")
	-- lokale Vorhersage, damit der Button sofort reagiert (Server entscheidet)
	rollCooldownEnd = os.clock() + (State.derived.RollCooldown or 1)
	rollCooldownLength = State.derived.RollCooldown or 1
end

function HUD.toggleAuto()
	Actions.send("SetAutoRoll", not State.session.AutoRoll)
end

local function buildTop(gui: ScreenGui)
	-- Cash ---------------------------------------------------------------------------
	local cashPanel = UI.panel({
		Name = "Cash",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(300, 64),
		Parent = gui,
	})
	UI.gradient(cashPanel, C.PanelLight, C.Panel, 90)
	local cashLabel = UI.label({
		Name = "Amount",
		Text = "$0",
		Font = F.Title,
		TextColor3 = C.Cash,
		Size = UDim2.new(1, -16, 0, 38),
		Position = UDim2.fromOffset(8, 2),
		MaxTextSize = 36,
		Parent = cashPanel,
	})
	local incomeLabel = UI.label({
		Name = "Income",
		Text = "+$0/s",
		TextColor3 = C.SubText,
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 40),
		MaxTextSize = 18,
		Parent = cashPanel,
	})

	local collect = UI.button({
		Name = "Collect",
		Text = "COLLECT $0",
		Icon = "💰",
		Color = C.Green,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 76),
		Size = UDim2.fromOffset(240, 46),
		TextSize = 22,
		Visible = false,
		Parent = gui,
		OnClick = function()
			Actions.send("Collect")
		end,
	})
	HUD.CollectButton = collect

	local displayed = 0
	RunService.RenderStepped:Connect(function(dt)
		local target = State.data.Cash or 0
		-- weich hochzählen
		displayed = if math.abs(target - displayed) < 1 then target else displayed + (target - displayed) * math.min(1, dt * 10)
		cashLabel.Text = Format.cash(displayed)
	end)

	local function refreshCash()
		local d = State.derived
		incomeLabel.Text = "+" .. Format.perSecond(d.IncomePerSecond or 0) .. (if (d.CashMultiplier or 1) > 1 then "  (" .. Format.multiplier(d.CashMultiplier) .. ")" else "")
		local vault = State.data.Vault or 0
		collect.Visible = not d.AutoCollect and vault > 0
		collect.Text = "💰  COLLECT " .. Format.cash(vault)
		if d.VaultCapacity and vault >= d.VaultCapacity * 0.999 then
			collect.Text ..= " (FULL)"
		end
	end
	State.Changed:Connect(function(key)
		if key == "Derived" or key == "Vault" then
			refreshCash()
		end
	end)

	-- Luck + Rebirth (oben links, unter der Roblox-Leiste) ---------------------------
	local stack = new("Frame", {
		Name = "Stats",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.fromOffset(210, 200),
		Parent = gui,
	})
	UI.list(stack, 6)

	local luckButton = UI.button({
		Name = "Luck",
		Text = "LUCK x1",
		Icon = "🍀",
		Color = Color3.fromRGB(20, 70, 90),
		TextColor = C.Luck,
		Size = UDim2.fromOffset(200, 40),
		TextSize = 20,
		LayoutOrder = 1,
		Parent = stack,
	})
	local breakdown = UI.panel({
		Name = "LuckBreakdown",
		Visible = false,
		Position = UDim2.fromOffset(220, 8),
		Size = UDim2.fromOffset(250, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = gui,
	})
	UI.padding(breakdown, 8)
	UI.list(breakdown, 2)
	luckButton.Activated:Connect(function()
		breakdown.Visible = not breakdown.Visible
	end)

	local rebirthButton = UI.button({
		Name = "Rebirth",
		Text = "REBIRTH 0",
		Icon = "♻",
		Color = Color3.fromRGB(70, 30, 110),
		Size = UDim2.fromOffset(200, 40),
		TextSize = 20,
		LayoutOrder = 2,
		Parent = stack,
		OnClick = function()
			WindowManager.open("Rebirth")
		end,
	})
	local _, setRebirthBar = UI.progress({
		Size = UDim2.fromOffset(200, 14),
		Color = C.Purple,
		LayoutOrder = 3,
		Parent = stack,
	})

	local boosts = new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(210, 34),
		LayoutOrder = 4,
		Parent = stack,
	})
	UI.list(boosts, 4, true)

	local function refreshLuck()
		local d = State.derived
		luckButton.Text = "🍀  LUCK " .. Format.multiplier(d.Luck or 1)
		for _, child in breakdown:GetChildren() do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		UI.label({ Text = "YOUR LUCK: " .. Format.multiplier(d.Luck or 1), Font = F.Title, TextColor3 = C.Luck, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, Parent = breakdown })
		for i, entry in d.LuckBreakdown or {} do
			local text = if entry.Kind == "x" then string.format("%s  x%g", entry.Label, entry.Value) else string.format("%s  +%g%%", entry.Label, math.floor(entry.Value * 10 + 0.5) / 10)
			UI.label({ Text = text, TextColor3 = C.SubText, Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i, Parent = breakdown })
		end
		UI.label({ Text = "Luck multiplies every rare chance exactly.", TextColor3 = C.SubText, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 99, Parent = breakdown })

		local rebirths = State.data.Rebirths or 0
		rebirthButton.Text = "♻  REBIRTH " .. rebirths
		local cost = d.RebirthCost or 1
		local cash = State.data.Cash or 0
		setRebirthBar(cash / cost, if cash >= cost then "REBIRTH READY!" else Format.cash(cash) .. " / " .. Format.cash(cost))
		rebirthButton.BackgroundColor3 = if cash >= cost then C.Red else Color3.fromRGB(70, 30, 110)
	end

	local function refreshBoosts()
		for _, child in boosts:GetChildren() do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		for id, remaining in State.data.Boosts or {} do
			local def = PotionConfig.Get(id)
			if def then
				local tag = UI.tag({
					Text = "🧪 " .. Format.duration(remaining),
					Color = def.Color:Lerp(Color3.new(0, 0, 0), 0.45),
					Size = UDim2.fromOffset(66, 26),
					Parent = boosts,
				})
				tag.Name = id
			end
		end
	end

	State.Changed:Connect(function(key)
		if key == "Derived" or key == "Cash" or key == "Rebirths" then
			refreshLuck()
		elseif key == "Boosts" then
			refreshBoosts()
		end
	end)
end

local function buildMenu(gui: ScreenGui)
	local menu = new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.55, 0),
		Size = UDim2.fromOffset(150, 420),
		Parent = gui,
	})
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(70, 62),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	for i, entry in MENU do
		local button = UI.button({
			Name = entry.Name,
			Text = entry.Icon .. "\n" .. string.upper(entry.Name),
			Color = C.Panel,
			StrokeColor = C.Stroke,
			LayoutOrder = i,
			TextSize = 18,
			Parent = menu,
			OnClick = function()
				WindowManager.toggle(entry.Name)
			end,
		})
		button.Font = F.Body
		HUD.MenuButtons[entry.Name] = button
		local badge = UI.tag({
			Text = "!",
			Color = C.Red,
			Size = UDim2.fromOffset(20, 20),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 4, 0, -4),
			ZIndex = 6,
			Parent = button,
		})
		badge.Name = "Badge"
		badge.Visible = false
	end

	local function refreshBadges()
		local claimable = false
		for _, q in (State.data.Quests and State.data.Quests.List) or {} do
			local def = QuestConfig.ById[q.Id]
			if def and q.Progress >= def.Target and not q.Claimed then
				claimable = true
			end
		end
		HUD.MenuButtons.Quests.Badge.Visible = claimable
		local fishers = 0
		for _, char in State.data.Characters or {} do
			if char.Fishing then
				fishers += 1
			end
		end
		HUD.MenuButtons.Fishing.Badge.Visible = (State.derived.FishingUnlocked == true) and fishers < (State.derived.FishingSlots or 1)
		local potions = 0
		for _, n in State.data.Potions or {} do
			potions += n
		end
		HUD.MenuButtons.Items.Badge.Visible = potions > 0
		HUD.MenuButtons.Items.Badge.Text = if potions > 9 then "9+" else tostring(potions)
	end
	State.Changed:Connect(function(key)
		if key == "Quests" or key == "Derived" or key == "Potions" or key == "Characters" then
			refreshBadges()
		end
	end)
end

local function buildRoll(gui: ScreenGui)
	local holder = new("Frame", {
		Name = "RollArea",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(440, 150),
		Parent = gui,
	})

	local roll = UI.button({
		Name = "Roll",
		Text = "ROLL",
		Color = C.Purple,
		StrokeColor = C.Blue,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(190, 120),
		TextSize = 54,
		Radius = 28,
		Parent = holder,
		OnClick = HUD.roll,
	})
	UI.gradient(roll, Color3.fromRGB(200, 120, 255), Color3.fromRGB(70, 30, 200), 90)
	HUD.RollButton = roll
	local fill = new("Frame", {
		Name = "Cooldown",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.75,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(0, 0.08),
		ZIndex = 3,
		Parent = roll,
	})
	UI.corner(fill, 4)

	local auto = UI.button({
		Name = "Auto",
		Text = "AUTO\nOFF",
		Color = C.PanelLight,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 105, 1, 0),
		Size = UDim2.fromOffset(100, 74),
		TextSize = 22,
		Parent = holder,
		OnClick = HUD.toggleAuto,
	})
	HUD.AutoButton = auto

	local dice = UI.button({
		Name = "Dice",
		Text = "🎲 BASIC\nx1 LUCK",
		Color = C.PanelLight,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, -105, 1, 0),
		Size = UDim2.fromOffset(100, 74),
		TextSize = 18,
		Parent = holder,
		OnClick = function()
			WindowManager.open("Shop", { Tab = "Dice" })
		end,
	})

	local function refresh()
		local on = State.session.AutoRoll == true
		auto.Text = if on then "AUTO\nON" else "AUTO\nOFF"
		auto.BackgroundColor3 = if on then C.Green else C.PanelLight
		local equipped = State.data.Dice and DiceConfig.Get(State.data.Dice.Equipped)
		if equipped then
			dice.Text = "🎲 " .. equipped.DisplayName:gsub(" DICE", "") .. "\nx" .. equipped.Luck .. " LUCK"
			dice.BackgroundColor3 = equipped.Color2
		end
	end
	State.Changed:Connect(function(key)
		if key == "Session" or key == "Dice" then
			refresh()
		end
	end)
	State.on("Roll", function(data)
		rollCooldownLength = data.Cooldown or rollCooldownLength
		rollCooldownEnd = os.clock() + rollCooldownLength
	end)
	RunService.RenderStepped:Connect(function()
		local left = rollCooldownEnd - os.clock()
		if left > 0 then
			fill.Size = UDim2.fromScale(1 - left / math.max(0.05, rollCooldownLength), 0.08)
		else
			fill.Size = UDim2.fromScale(1, 0.08)
		end
	end)
end

local function buildQuestTracker(gui: ScreenGui)
	local tracker = UI.panel({
		Name = "QuestTracker",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.45, 0),
		Size = UDim2.fromOffset(220, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.25,
		Parent = gui,
	})
	UI.padding(tracker, 8)
	UI.list(tracker, 4)
	local function refresh()
		for _, child in tracker:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		UI.label({ Text = "📜 DAILY QUESTS", Font = F.Title, TextColor3 = C.Gold, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Parent = tracker })
		local shown = 0
		for i, q in (State.data.Quests and State.data.Quests.List) or {} do
			local def = QuestConfig.ById[q.Id]
			if def and not q.Claimed and shown < 3 then
				shown += 1
				local done = q.Progress >= def.Target
				UI.label({
					Text = (if done then "✅ " else "") .. def.Text,
					TextColor3 = if done then C.Green else C.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.new(1, 0, 0, 16),
					LayoutOrder = i * 2,
					MaxTextSize = 15,
					Parent = tracker,
				})
				local _, setProgress = UI.progress({
					Size = UDim2.new(1, 0, 0, 10),
					Color = if done then C.Green else C.Blue,
					LayoutOrder = i * 2 + 1,
					Parent = tracker,
				})
				setProgress(q.Progress / def.Target)
			end
		end
		tracker.Visible = shown > 0 and not Root.IsSmall
	end
	State.Changed:Connect(function(key)
		if key == "Quests" then
			refresh()
		end
	end)
	tracker.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			WindowManager.open("Quests")
		end
	end)
end

function HUD.init()
	local gui = Root.Layers.HUD
	buildTop(gui)
	buildMenu(gui)
	buildRoll(gui)
	buildQuestTracker(gui)
	-- Fenster blenden das Menü auf kleinen Bildschirmen aus
	WindowManager.Opened:Connect(function()
		if Root.IsSmall then
			gui.Enabled = false
		end
	end)
	WindowManager.Closed:Connect(function()
		gui.Enabled = true
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
-- InputController (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > InputController
--
-- Tastatur-Shortcuts und Controller-Support.
--
--   Tastatur:   R Roll · T Auto · C Collect · I Inventory · X Index · B Shop
--               Q Quests · F Fishing · G Items · M Map · Esc schließt Fenster
--   Controller: R2 Roll · L2 Auto · X Collect · Y Inventory · R1/L1 nächstes/
--               voriges Menü · B schließt Fenster · Steuerkreuz navigiert UI
--               (Roblox-Gamepad-Navigation, alle Buttons sind Selectable)

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Client = script.Parent.Parent
local Actions = require(Client:WaitForChild("Actions"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local WindowManager = require(script.Parent:WaitForChild("WindowManager"))

local InputController = {}

local KEYS: { [Enum.KeyCode]: () -> () } = {
	[Enum.KeyCode.R] = HUD.roll,
	[Enum.KeyCode.T] = HUD.toggleAuto,
	[Enum.KeyCode.C] = function()
		Actions.send("Collect")
	end,
	[Enum.KeyCode.I] = function()
		WindowManager.toggle("Inventory")
	end,
	[Enum.KeyCode.X] = function()
		WindowManager.toggle("Index")
	end,
	[Enum.KeyCode.B] = function()
		WindowManager.toggle("Shop")
	end,
	[Enum.KeyCode.Q] = function()
		WindowManager.toggle("Quests")
	end,
	[Enum.KeyCode.F] = function()
		WindowManager.toggle("Fishing")
	end,
	[Enum.KeyCode.G] = function()
		WindowManager.toggle("Items")
	end,
	[Enum.KeyCode.M] = function()
		WindowManager.toggle("Map")
	end,
	[Enum.KeyCode.Escape] = function()
		WindowManager.close()
	end,
}

local CYCLE = { "Inventory", "Index", "Shop", "Quests", "Fishing", "Items", "Map", "Settings" }

local function cycle(direction: number)
	local current = WindowManager.current
	local index = if current then (table.find(CYCLE, current) or 0) else 0
	index = (index + direction - 1) % #CYCLE + 1
	WindowManager.open(CYCLE[index])
end

local GAMEPAD: { [Enum.KeyCode]: () -> () } = {
	[Enum.KeyCode.ButtonR2] = HUD.roll,
	[Enum.KeyCode.ButtonL2] = HUD.toggleAuto,
	[Enum.KeyCode.ButtonX] = function()
		if not WindowManager.current then
			Actions.send("Collect")
		end
	end,
	[Enum.KeyCode.ButtonY] = function()
		WindowManager.toggle("Inventory")
	end,
	[Enum.KeyCode.ButtonR1] = function()
		cycle(1)
	end,
	[Enum.KeyCode.ButtonL1] = function()
		cycle(-1)
	end,
	[Enum.KeyCode.ButtonB] = function()
		if WindowManager.current then
			WindowManager.close()
		end
	end,
}

function InputController.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		local gamepadFn = GAMEPAD[input.KeyCode]
		if gamepadFn and input.UserInputType.Name:find("Gamepad") then
			-- R2/L2/R1/L1 immer, Rest nur wenn nicht von der UI verarbeitet
			if not processed or input.KeyCode == Enum.KeyCode.ButtonB then
				gamepadFn()
			end
			return
		end
		if processed then
			return
		end
		local fn = KEYS[input.KeyCode]
		if fn then
			fn()
		end
	end)
	GuiService.AutoSelectGuiEnabled = true
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!strict
-- Notifications (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Notifications
--
-- Toasts (rechts unten, gestapelt) und Server-Ansagen (Banner oben):
--   "PlayerName rolled THE ENDLESS!  1 in 2,500,000"
-- Reagiert auf die Server-Events aus Logic/Services.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))
local Sound = require(script.Parent:WaitForChild("SoundController"))

local C = UI.Colors
local F = UI.Fonts

local Notifications = {}

local toastHolder: Frame
local bannerHolder: Frame
local MAX_TOASTS = 5
local toastCounter = 0

local KIND_COLORS = {
	info = C.Blue,
	success = C.Green,
	error = C.Red,
	reward = C.Gold,
	rare = C.Purple,
}

function Notifications.toast(text: string, kind: string?, color: Color3?)
	local accent = color or KIND_COLORS[kind or "info"] or C.Blue
	toastCounter += 1
	local toast = UI.panel({
		Size = UDim2.fromOffset(300, 44),
		BackgroundTransparency = 0.1,
		StrokeColor = accent,
		LayoutOrder = toastCounter,
		Parent = toastHolder,
	})
	UI.label({
		Text = text,
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = toast,
	})
	local bar = UI.new("Frame", { BackgroundColor3 = accent, BorderSizePixel = 0, Size = UDim2.new(0, 4, 1, 0), Parent = toast })
	UI.corner(bar, 2)
	local children = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(children, child)
		end
	end
	if #children > MAX_TOASTS then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end
	if kind == "error" then
		Sound.play("UIError")
	end
	task.delay(3.5, function()
		if toast.Parent then
			UI.tween(toast, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

-- Großes Banner oben (Server-Ansagen)
function Notifications.banner(text: string, color: Color3, subtext: string?, big: boolean?)
	local banner = UI.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(if big then 620 else 520, if big then 74 else 56),
		BackgroundColor3 = Color3.fromRGB(10, 6, 24),
		StrokeColor = color,
		StrokeThickness = if big then 4 else 2,
		Parent = bannerHolder,
	})
	UI.gradient(banner, color:Lerp(Color3.new(0, 0, 0), 0.6), Color3.fromRGB(10, 6, 24), 0)
	UI.label({
		Text = text,
		Font = F.Title,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.3),
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, if subtext then 0.6 else 1, -6),
		MaxTextSize = if big then 34 else 26,
		Parent = banner,
	})
	if subtext then
		UI.label({
			Text = subtext,
			TextColor3 = C.SubText,
			Position = UDim2.new(0, 12, 0.6, 0),
			Size = UDim2.new(1, -24, 0.4, -4),
			MaxTextSize = 18,
			Parent = banner,
		})
	end
	Sound.play("Announcement")
	local scale = UI.new("UIScale", { Scale = 0.6, Parent = banner })
	UI.tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(if big then 7 else 5, function()
		if banner.Parent then
			UI.tween(scale, 0.2, { Scale = 0.01 })
			task.wait(0.2)
			banner:Destroy()
		end
	end)
end

local function lootName(kind: string, id: string?): string
	if kind == "Cash" then
		return "Cash"
	elseif kind == "Potion" then
		local def = id and PotionConfig.Get(id)
		return def and def.DisplayName or (id or "?")
	elseif kind == "Gear" then
		local def = id and GearConfig.Get(id)
		return def and def.DisplayName or (id or "?")
	elseif kind == "Relic" then
		local def = id and FishingConfig.RelicById[id]
		return def and def.DisplayName or (id or "?")
	elseif kind == "Cosmetic" then
		local def = id and CosmeticConfig.Get(id)
		return def and def.DisplayName or (id or "?")
	end
	return id or kind
end

local function grantedText(granted): string
	if type(granted) ~= "table" then
		return ""
	end
	local parts = {}
	if granted.Cash then
		table.insert(parts, "+" .. Format.cash(granted.Cash))
	end
	for id, n in granted.Potions or {} do
		local def = PotionConfig.Get(id)
		table.insert(parts, string.format("%dx %s", n, def and def.DisplayName or id))
	end
	if granted.Gear then
		table.insert(parts, lootName("Gear", granted.Gear))
	end
	if granted.Cosmetic then
		table.insert(parts, lootName("Cosmetic", granted.Cosmetic))
	end
	if granted.SeasonXp then
		table.insert(parts, "+" .. granted.SeasonXp .. " Season XP")
	end
	return table.concat(parts, ", ")
end

function Notifications.init()
	toastHolder = UI.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -170),
		Size = UDim2.fromOffset(300, 260),
		Parent = Root.Layers.Toasts,
	})
	local list = UI.list(toastHolder, 6, false, Enum.HorizontalAlignment.Right)
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom

	bannerHolder = UI.new("Frame", {
		Name = "Banners",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.fromOffset(640, 240),
		Parent = Root.Layers.Toasts,
	})
	local bannerList = UI.list(bannerHolder, 6, false, Enum.HorizontalAlignment.Center)
	bannerList.VerticalAlignment = Enum.VerticalAlignment.Top

	State.on("Toast", function(data)
		Notifications.toast(data.Text, data.Kind)
	end)
	State.on("Collected", function(data)
		Sound.play("Collect")
		Notifications.toast("💰 Collected " .. Format.cash(data.Amount), "success")
	end)
	State.on("Sold", function(data)
		Notifications.toast(string.format("Sold %d for %s", data.Count or 1, Format.cash(data.Amount or 0)), "success")
	end)
	State.on("Upgraded", function()
		Sound.play("Upgrade")
	end)
	State.on("QuestComplete", function(data)
		Sound.play("Quest")
		Notifications.toast("📜 Quest complete: " .. data.Text .. " – claim it!", "reward")
	end)
	State.on("QuestClaimed", function(data)
		Notifications.toast("Quest reward: " .. grantedText(data.Granted), "reward")
	end)
	State.on("Achievement", function(data)
		Sound.play("Achievement")
		Notifications.banner("🏆 ACHIEVEMENT: " .. data.Name, C.Gold, grantedText(data.Granted))
	end)
	State.on("Cosmetic", function(data)
		Notifications.toast("✨ New " .. string.lower(data.Kind) .. ": " .. data.Name, "reward")
	end)
	State.on("Rebirth", function(data)
		Sound.play("Rebirth")
		Notifications.banner("♻ REBIRTH " .. data.Rebirths .. "!", C.Purple, "Cash and levels reset – your collection stays. Bonuses are permanent.", true)
	end)
	State.on("DiceUnlocked", function(data)
		local def = DiceConfig.Get(data.Id)
		Sound.play("Purchase")
		Notifications.banner("🎲 " .. (def and def.DisplayName or data.Id) .. " UNLOCKED", def and def.Color or C.Blue, def and ("x" .. def.Luck .. " Luck – equipped!") or nil)
	end)
	State.on("AreaUnlocked", function(data)
		local def = AreaConfig.Get(data.Id)
		Sound.play("Purchase")
		Notifications.banner("🗺 " .. (def and def.DisplayName or data.Id) .. " UNLOCKED", def and def.PrimaryColor or C.Green, def and def.Tagline or nil)
	end)
	State.on("BoostEnded", function(data)
		local def = PotionConfig.Get(data.Id)
		Notifications.toast((def and def.DisplayName or data.Id) .. " ran out", "info")
	end)
	State.on("Catch", function(data)
		local rarity = RarityConfig.ById[data.Rarity]
		local name = lootName(data.Kind, data.Id)
		local text = "🎣 " .. name
		if data.Cash then
			text ..= " +" .. Format.cash(data.Cash)
		end
		local order = rarity and rarity.Order or 1
		Sound.play(if order >= 4 then "FishingBigCatch" else "FishingCatch")
		Notifications.toast(text, if order >= 3 then "rare" else "info", rarity and rarity.Color)
	end)
	State.on("ProductGranted", function()
		Sound.play("Purchase")
		Notifications.toast("Purchase complete. Thank you!", "success")
	end)
	State.on("SeasonClaimed", function(data)
		Notifications.toast("Season reward: " .. grantedText(data.Granted), "reward")
	end)
	State.on("TutorialDone", function()
		Notifications.banner("TUTORIAL COMPLETE", C.Green, "Here is a Luck Potion. Now go find the rarest entity.")
	end)

	-- Ansagen --------------------------------------------------------------------------
	State.on("Announcement", function(data)
		local isMe = data.UserId == Players.LocalPlayer.UserId
		local settings = State.data.Settings
		if not isMe and settings and settings.ShowOthersReveals == false then
			return
		end
		local rarity = RarityConfig.ById[data.Rarity or ""]
		local color = rarity and rarity.Color or C.Purple
		local prefix = if data.CrossServer then "🌐 " else ""
		if data.Kind == "Roll" then
			local mutation = MutationConfig.Get(data.Mutation)
			local mutText = if mutation.Id ~= MutationConfig.None then mutation.DisplayName .. " " else ""
			local title = string.format("%s%s rolled %s%s!", prefix, data.Player, mutText, string.upper(data.Name or "?"))
			if data.Double then
				title = "DOUBLE SECRET! " .. title
			end
			local def = CharacterConfig.ById[data.Id]
			local chance = if def then Format.oneIn(def.RollChance) else ""
			local big = rarity ~= nil and rarity.Order >= RarityConfig.Order("Secret")
			Notifications.banner(title, color, chance, big)
		elseif data.Kind == "Catch" then
			Notifications.banner(string.format("%s%s fished up %s!", prefix, data.Player, lootName(data.LootKind, data.Id)), color, data.Probability and Format.chance(data.Probability) or nil)
		elseif data.Kind == "MaxLevel" then
			Notifications.banner(string.format("%s maxed %s to LEVEL 15!", data.Player, data.Name), color, nil)
		end
	end)
	State.on("PlayerRebirth", function(data)
		if data.UserId ~= Players.LocalPlayer.UserId then
			Notifications.toast(string.format("♻ %s reached Rebirth %d", data.Player, data.Rebirths), "info")
		end
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">RevealController</string>
              <string name="Source"><![CDATA[--!strict
-- RevealController (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > RevealController
--
-- Zeigt Roll-Ergebnisse. Die Stärke hängt von RarityConfig.RevealTier ab
-- (Timings in UIConfig.Reveal):
--   0–2  kleine Karte über dem ROLL-Button (Common sehr schnell)
--   3+   Vollbild-Reveal: Flash, Spin, Zoom (FOV), Kamera-Shake
--   6+   Blackout,  7+ Glitch,  8 (Anomaly) Regenbogen
-- Antippen überspringt große Reveals. Bei Auto Roll werden alte kleine
-- Reveals verworfen, damit die Anzeige nie hinterherhinkt.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local UIConfig = require(Config:WaitForChild("UIConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Odds = require(Shared:WaitForChild("Util"):WaitForChild("Odds"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))
local Viewport = require(Client:WaitForChild("UI"):WaitForChild("Viewport"))
local Sound = require(script.Parent:WaitForChild("SoundController"))

local C = UI.Colors
local F = UI.Fonts
local new = UI.new

local RevealController = {}

local queue: { any } = {}
local busy = false
local skipRequested = false

-- "1 in X" wie im Index: Basis-Chance bzw. normalisiert bei Commons
local function baseChanceText(def): string
	local rarity = RarityConfig.Get(def.Rarity)
	if rarity.LuckAffected then
		return Format.oneIn(def.RollChance)
	end
	return Format.chance(Odds.characterProbability(def.Id, 1))
end

local function shake(intensity: number, duration: number)
	if intensity <= 0 or (State.data.Settings and State.data.Settings.ReducedEffects) then
		return
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - started
		if t > duration then
			humanoid.CameraOffset = Vector3.zero
			connection:Disconnect()
			return
		end
		local falloff = 1 - t / duration
		local r = intensity * falloff * 0.6
		humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * r, (math.random() - 0.5) * r, 0)
	end)
end

local function zoom(amount: number, duration: number)
	local camera = workspace.CurrentCamera
	if amount <= 0 or not camera or (State.data.Settings and State.data.Settings.ReducedEffects) then
		return
	end
	local base = 70
	camera.FieldOfView = base
	UI.tween(camera, duration * 0.3, { FieldOfView = base - amount }, Enum.EasingStyle.Quad)
	task.delay(duration * 0.75, function()
		UI.tween(camera, 0.4, { FieldOfView = base })
	end)
end

-- Kleine Karte ---------------------------------------------------------------------
local smallCard: Frame
local smallViewport: ViewportFrame
local smallLabels: { [string]: TextLabel } = {}
local smallGradient: UIGradient

local function buildSmall(gui: ScreenGui)
	smallCard = UI.panel({
		Name = "SmallReveal",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -178),
		Size = UDim2.fromOffset(360, 112),
		Visible = false,
		Parent = gui,
	})
	UI.new("UIScale", { Parent = smallCard })
	smallGradient = UI.gradient(smallCard, C.Panel, C.Panel, 90)
	smallViewport = Viewport.create({ Size = UDim2.fromOffset(104, 104), Position = UDim2.fromOffset(4, 4), Parent = smallCard })
	smallLabels.Name = UI.label({ Font = F.Title, Position = UDim2.fromOffset(112, 6), Size = UDim2.new(1, -120, 0, 32), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 30, Parent = smallCard })
	smallLabels.Rarity = UI.label({ Position = UDim2.fromOffset(112, 38), Size = UDim2.new(1, -120, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = smallCard })
	smallLabels.Info = UI.label({ Position = UDim2.fromOffset(112, 60), Size = UDim2.new(1, -120, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.SubText, MaxTextSize = 16, Parent = smallCard })
	smallLabels.Extra = UI.label({ Position = UDim2.fromOffset(112, 82), Size = UDim2.new(1, -120, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold, MaxTextSize = 16, Parent = smallCard })
	local newTag = UI.tag({ Text = "NEW!", Color = C.Red, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, -10), Size = UDim2.fromOffset(64, 24), Parent = smallCard })
	newTag.Name = "NewTag"
end

local function showSmall(data, def, tierInfo)
	local rarity = RarityConfig.Get(def.Rarity)
	local mutation = MutationConfig.Get(data.Mutation)
	Viewport.set(smallViewport, def.Id, data.Mutation)
	smallLabels.Name.Text = def.DisplayName
	smallLabels.Name.TextColor3 = rarity.Color
	smallLabels.Rarity.Text = rarity.DisplayName .. "  ·  " .. baseChanceText(def)
	smallLabels.Rarity.TextColor3 = rarity.Color
	smallLabels.Info.Text = Format.perSecond(def.BaseMoneyPerSecond * mutation.MoneyMultiplier) .. " base"
	local extra = ""
	if mutation.Id ~= MutationConfig.None then
		extra = mutation.DisplayName .. " MUTATION  "
		smallLabels.Extra.TextColor3 = mutation.Color
	else
		smallLabels.Extra.TextColor3 = C.Gold
	end
	if data.SoldFor then
		extra ..= (if data.SoldReason == "AutoDelete" then "AUTO-DELETED " else "INVENTORY FULL ") .. "+" .. Format.cash(data.SoldFor)
	elseif data.Placed then
		extra ..= "→ PLACED IN BASE"
	elseif data.ReplacedValue then
		extra ..= "INVENTORY FULL: sold weakest +" .. Format.cash(data.ReplacedValue)
	end
	smallLabels.Extra.Text = extra
	smallCard:FindFirstChild("NewTag").Visible = data.IsNew
	local stroke = smallCard:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = rarity.Color
		stroke.Thickness = 2 + tierInfo.Flash * 3
	end
	smallGradient.Color = ColorSequence.new(rarity.Color2:Lerp(C.Panel, 0.65), C.Panel)

	smallCard.Visible = true
	local scale = smallCard:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.7
	UI.tween(scale, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	Sound.play("Reveal" .. rarity.RevealTier)
	local token = {}
	smallCard:SetAttribute("Token", tostring(token))
	task.delay(tierInfo.Duration + 0.6, function()
		if smallCard:GetAttribute("Token") == tostring(token) then
			smallCard.Visible = false
		end
	end)
end

-- Großes Reveal -----------------------------------------------------------------------
local big: Frame
local bigParts: { [string]: any } = {}

local function buildBig(gui: ScreenGui)
	big = new("TextButton", {
		Name = "BigReveal",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = gui,
	})
	;(big :: any).Activated:Connect(function()
		skipRequested = true
	end)
	bigParts.Flash = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = big })
	bigParts.Rays = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(520, 520), Parent = big })
	for i = 1, 8 do
		local ray = new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.7,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 26, 1, 0),
			Rotation = i * 22.5,
			Parent = bigParts.Rays,
		})
		UI.gradient(ray, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 90).Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1),
		})
	end
	bigParts.Die = UI.label({
		Text = "?", Font = F.Title, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(180, 180), BackgroundTransparency = 0, BackgroundColor3 = C.Purple, MaxTextSize = 120, ZIndex = 5, Parent = big,
	})
	UI.corner(bigParts.Die, 30)
	UI.stroke(bigParts.Die, Color3.new(1, 1, 1), 5)
	bigParts.Viewport = Viewport.create({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(340, 340), ZIndex = 6, Parent = big })
	bigParts.Name = UI.label({ Font = F.Title, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.66), Size = UDim2.new(0.9, 0, 0, 64), MaxTextSize = 64, ZIndex = 8, Parent = big })
	bigParts.Rarity = UI.label({ Font = F.Title, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.66, 66), Size = UDim2.new(0.8, 0, 0, 36), MaxTextSize = 36, ZIndex = 8, Parent = big })
	bigParts.RarityGradient = UI.gradient(bigParts.Rarity, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 0)
	bigParts.Chance = UI.label({ Font = F.Title, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.66, 104), Size = UDim2.new(0.8, 0, 0, 30), TextColor3 = C.Text, MaxTextSize = 30, ZIndex = 8, Parent = big })
	bigParts.Info = UI.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.66, 136), Size = UDim2.new(0.8, 0, 0, 22), TextColor3 = C.SubText, MaxTextSize = 20, ZIndex = 8, Parent = big })
	bigParts.New = UI.tag({ Text = "NEW!", Color = C.Red, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 130, 0.66, 0), Size = UDim2.fromOffset(110, 40), ZIndex = 9, Parent = big })
	bigParts.Mutation = UI.tag({ Text = "", Color = C.Gold, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, -130, 0.66, 0), Size = UDim2.fromOffset(160, 40), ZIndex = 9, Parent = big })
	bigParts.Skip = UI.label({ Text = "TAP TO CONTINUE", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(300, 20), TextColor3 = C.SubText, MaxTextSize = 16, ZIndex = 8, Parent = big })
end

local function waitOrSkip(seconds: number)
	local started = os.clock()
	while os.clock() - started < seconds and not skipRequested do
		task.wait()
	end
end

local function showBig(data, def, tierInfo)
	local rarity = RarityConfig.Get(def.Rarity)
	local mutation = MutationConfig.Get(data.Mutation)
	local reduced = State.data.Settings and State.data.Settings.ReducedEffects
	skipRequested = false
	big.Visible = true
	big.BackgroundTransparency = if tierInfo.Blackout then 0.05 else 0.35
	bigParts.Viewport.Visible = false
	bigParts.Name.Visible = false
	bigParts.Rarity.Visible = false
	bigParts.Chance.Visible = false
	bigParts.Info.Visible = false
	bigParts.New.Visible = false
	bigParts.Mutation.Visible = false
	bigParts.Rays.Visible = false
	bigParts.Die.Visible = true
	bigParts.Die.BackgroundColor3 = rarity.Color2
	bigParts.Die.Rotation = 0
	bigParts.Die.Text = "?"

	-- 1) Spin
	Sound.play("RollTick")
	local spinEnd = os.clock() + tierInfo.Spin
	while os.clock() < spinEnd and not skipRequested do
		bigParts.Die.Rotation += 24
		bigParts.Die.BackgroundColor3 = if math.random() < 0.5 then rarity.Color else rarity.Color2
		if tierInfo.Glitch then
			bigParts.Die.Position = UDim2.new(0.5, math.random(-8, 8), 0.42, math.random(-8, 8))
		end
		task.wait(0.05)
	end
	bigParts.Die.Visible = false
	bigParts.Die.Position = UDim2.fromScale(0.5, 0.42)

	-- 2) Flash + Reveal
	if not reduced then
		bigParts.Flash.BackgroundTransparency = 1 - tierInfo.Flash
		UI.tween(bigParts.Flash, 0.5, { BackgroundTransparency = 1 })
	end
	Sound.play("Reveal" .. rarity.RevealTier)
	shake(tierInfo.Shake, 0.8)
	zoom(tierInfo.Zoom, tierInfo.Duration)

	Viewport.set(bigParts.Viewport, def.Id, data.Mutation)
	Viewport.spin(bigParts.Viewport, 0.8)
	bigParts.Viewport.Visible = true
	bigParts.Rays.Visible = true
	for _, ray in bigParts.Rays:GetChildren() do
		ray.BackgroundColor3 = rarity.Color
	end
	bigParts.Name.Text = def.DisplayName
	bigParts.Name.TextColor3 = rarity.Color
	bigParts.Name.Visible = true
	bigParts.Rarity.Text = rarity.DisplayName
	bigParts.Rarity.TextColor3 = Color3.new(1, 1, 1)
	bigParts.RarityGradient.Color = ColorSequence.new(rarity.Color, rarity.Color2:Lerp(Color3.new(1, 1, 1), 0.3))
	bigParts.Rarity.Visible = true
	bigParts.Chance.Text = baseChanceText(def)
	bigParts.Chance.Visible = true
	local yourOdds = if data.Probability and data.Probability > 0 then Format.chance(data.Probability) else "?"
	bigParts.Info.Text = string.format("%s  ·  your odds %s (luck %s)", Format.perSecond(def.BaseMoneyPerSecond * mutation.MoneyMultiplier), yourOdds, Format.multiplier(data.Luck or 1))
	bigParts.Info.Visible = true
	bigParts.New.Visible = data.IsNew
	if mutation.Id ~= MutationConfig.None then
		bigParts.Mutation.Text = mutation.DisplayName
		bigParts.Mutation.BackgroundColor3 = mutation.Color
		bigParts.Mutation.Visible = true
	end

	-- 3) Halten (mit Effekten)
	local holdEnd = os.clock() + math.max(0.6, tierInfo.Duration - tierInfo.Spin)
	local hue = 0
	while os.clock() < holdEnd and not skipRequested do
		local dt = task.wait()
		bigParts.Rays.Rotation += dt * 25
		if tierInfo.Rainbow then
			hue = (hue + dt * 0.5) % 1
			bigParts.Name.TextColor3 = Color3.fromHSV(hue, 0.7, 1)
			bigParts.RarityGradient.Color = ColorSequence.new(Color3.fromHSV(hue, 0.8, 1), Color3.fromHSV((hue + 0.5) % 1, 0.8, 1))
		end
		if tierInfo.Glitch and math.random() < 0.15 then
			bigParts.Name.Position = UDim2.new(0.5, math.random(-10, 10), 0.66, math.random(-4, 4))
		else
			bigParts.Name.Position = UDim2.fromScale(0.5, 0.66)
		end
	end
	if not skipRequested then
		waitOrSkip(0.4)
	end
	Viewport.stopSpin(bigParts.Viewport)
	big.Visible = false
	bigParts.Name.Position = UDim2.fromScale(0.5, 0.66)
end

local function process()
	if busy then
		return
	end
	busy = true
	while #queue > 0 do
		-- bei Rückstau alte kleine Reveals überspringen
		while #queue > 2 do
			local first = queue[1]
			local def = CharacterConfig.ById[first.Id]
			if def and RarityConfig.Get(def.Rarity).RevealTier <= 2 then
				table.remove(queue, 1)
			else
				break
			end
		end
		local data = table.remove(queue, 1)
		local def = data and CharacterConfig.ById[data.Id]
		if def then
			local rarity = RarityConfig.Get(def.Rarity)
			local tierInfo = UIConfig.Reveal[rarity.RevealTier] or UIConfig.Reveal[0]
			if rarity.RevealTier >= 3 then
				showBig(data, def, tierInfo)
			else
				showSmall(data, def, tierInfo)
				task.wait(math.min(tierInfo.Duration, 0.35))
			end
		end
	end
	busy = false
end

function RevealController.init()
	local gui = Root.Layers.Reveal
	buildSmall(gui)
	buildBig(gui)
	State.on("Roll", function(data)
		table.insert(queue, data)
		task.spawn(process)
	end)
end

return RevealController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
-- SoundController (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > SoundController
--
-- Spielt Sounds aus SoundConfig (inkl. Layer mit Verzögerung). Respektiert die
-- Einstellung SFX. Musik/Ambience macht der AmbienceController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local SoundConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("SoundConfig"))

local SoundController = {}

SoundController.enabled = true

local folder = Instance.new("Folder")
folder.Name = "VoidDiceSFX"
folder.Parent = SoundService

local templates: { [string]: Sound } = {}

local function template(id: string): Sound
	local existing = templates[id]
	if existing then
		return existing
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Parent = folder
	templates[id] = sound
	return sound
end

local function playOne(id: string, volume: number, pitch: number?)
	if id == "" then
		return
	end
	local sound = template(id):Clone()
	sound.Volume = volume
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = folder
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(8, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function SoundController.play(name: string)
	if not SoundController.enabled then
		return
	end
	local def = SoundConfig.Sounds[name]
	if not def then
		return
	end
	playOne(def.Id, def.Volume, def.Pitch)
	if def.Layers then
		for _, layer in def.Layers do
			if layer.Delay and layer.Delay > 0 then
				task.delay(layer.Delay, playOne, layer.Id, layer.Volume, layer.Pitch)
			else
				playOne(layer.Id, layer.Volume, layer.Pitch)
			end
		end
	end
end

-- Alle Templates vorladen (verhindert Verzögerung beim ersten Abspielen)
function SoundController.preload()
	for _, def in SoundConfig.Sounds do
		template(def.Id)
		for _, layer in def.Layers or {} do
			template(layer.Id)
		end
	end
	task.spawn(function()
		local list = {}
		for _, s in templates do
			table.insert(list, s)
		end
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(list)
		end)
	end)
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
-- TutorialController (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > TutorialController
--
-- Erster Join: 30–60 Sekunden, 6 Schritte (GameConfig.TutorialSteps):
--   Roll -> Reveal -> Place -> Collect -> Upgrade -> Fishing
-- Jeder Schritt zeigt einen Hinweis + pulsierenden Rahmen um das Ziel und
-- wird durch die echte Aktion abgeschlossen. "SKIP" beendet sofort.
-- Fortschritt liegt im Profil (Server), ein Rejoin macht dort weiter.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("GameConfig"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local WindowManager = require(script.Parent:WaitForChild("WindowManager"))

local C = UI.Colors

local TutorialController = {}

local panel: Frame
local textLabel: TextLabel
local stepLabel: TextLabel
local highlight: Frame
local target: GuiObject? = nil
local reported: { [string]: boolean } = {}

local function currentStep(): (number, any)
	local tutorial = State.data.Tutorial
	if not tutorial or tutorial.Done then
		return 0, nil
	end
	return tutorial.Step, GameConfig.TutorialSteps[tutorial.Step]
end

local function complete(stepId: string)
	local _, step = currentStep()
	if step and step.Id == stepId and not reported[stepId] then
		reported[stepId] = true
		Actions.send("TutorialStep", stepId)
	end
end

local function targetFor(stepId: string): GuiObject?
	if stepId == "Roll" then
		return HUD.RollButton
	elseif stepId == "Collect" then
		return if HUD.CollectButton and HUD.CollectButton.Visible then HUD.CollectButton else nil
	elseif stepId == "Upgrade" or stepId == "Place" then
		return HUD.MenuButtons.Inventory
	elseif stepId == "Fishing" then
		return HUD.MenuButtons.Fishing
	end
	return nil
end

local function refresh()
	local index, step = currentStep()
	if not step then
		panel.Visible = false
		highlight.Visible = false
		target = nil
		return
	end
	panel.Visible = true
	textLabel.Text = step.Text
	stepLabel.Text = string.format("TUTORIAL %d/%d", index, #GameConfig.TutorialSteps)
	target = targetFor(step.Id)
	highlight.Visible = target ~= nil

	-- Schritte, die automatisch weiterlaufen
	if step.Id == "Reveal" then
		task.delay(2.5, complete, "Reveal")
	elseif step.Id == "Place" then
		for _, char in State.data.Characters or {} do
			if char.Slot then
				task.delay(2.5, complete, "Place")
				break
			end
		end
	elseif step.Id == "Collect" and State.derived.AutoCollect then
		complete("Collect")
	elseif step.Id == "Fishing" then
		task.delay(5, complete, "Fishing")
	end
end

function TutorialController.init()
	local gui = Root.Layers.Tutorial
	panel = UI.panel({
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(460, 84),
		StrokeColor = C.Gold,
		Visible = false,
		Parent = gui,
	})
	stepLabel = UI.label({ Text = "", TextColor3 = C.Gold, Font = UI.Fonts.Title, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -110, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 16, Parent = panel })
	textLabel = UI.label({ Text = "", Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -110, 0, 50), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = panel })
	UI.button({
		Text = "SKIP",
		Color = C.PanelLight,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(84, 48),
		TextSize = 20,
		Parent = panel,
		OnClick = function()
			Actions.send("SkipTutorial")
		end,
	})

	highlight = UI.new("Frame", {
		Name = "Highlight",
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 100,
		Parent = gui,
	})
	local stroke = UI.stroke(highlight, C.Gold, 4)
	UI.corner(highlight, 16)
	RunService.RenderStepped:Connect(function()
		if target and target.Parent and highlight.Visible then
			local pos = target.AbsolutePosition / Root.Scale
			local size = target.AbsoluteSize / Root.Scale
			highlight.Position = UDim2.fromOffset(pos.X - 6, pos.Y - 6)
			highlight.Size = UDim2.fromOffset(size.X + 12, size.Y + 12)
			stroke.Transparency = 0.5 + 0.5 * math.sin(os.clock() * 6)
		end
	end)

	State.Changed:Connect(function(key)
		if key == "Tutorial" then
			-- Replay: bereits gemeldete Schritte ab dem aktuellen wieder freigeben
			local index = currentStep()
			for i, step in GameConfig.TutorialSteps do
				if i >= index then
					reported[step.Id] = nil
				end
			end
		end
		if key == "Tutorial" or key == "Characters" or key == "Vault" or key == "Derived" then
			refresh()
		end
	end)
	State.on("Roll", function()
		complete("Roll")
	end)
	State.on("Collected", function()
		complete("Collect")
	end)
	State.on("Upgraded", function()
		complete("Upgrade")
	end)
	WindowManager.Opened:Connect(function(name)
		if name == "Fishing" then
			complete("Fishing")
		end
	end)
	refresh()
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">WindowManager</string>
              <string name="Source"><![CDATA[--!strict
-- WindowManager (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > WindowManager
--
-- Verwaltet die Menü-Fenster (immer nur eines offen). Jedes Fenster ist ein
-- Modul in Controllers > Windows mit:
--   Window.Title  = "INVENTORY"
--   Window.Icon   = "🎒"
--   Window.Size   = Vector2 (Pixel bei UIScale 1, optional)
--   Window.build(content: Frame)       -- einmalig beim ersten Öffnen
--   Window.onOpen(args: table?)        -- bei jedem Öffnen
--   Window.onClose()                   -- optional
--
-- Server kann Fenster öffnen (Event "OpenUI", z. B. über Stationen im Hub).

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Signal = require(Client:WaitForChild("Signal"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))
local Sound = require(script.Parent:WaitForChild("SoundController"))

local UIConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("UIConfig"))

local C = UI.Colors
local F = UI.Fonts

local WindowManager = {}

WindowManager.Opened = Signal.new() -- (name)
WindowManager.Closed = Signal.new() -- (name)
WindowManager.current = nil :: string?

type WindowModule = {
	Title: string,
	Icon: string?,
	Size: Vector2?,
	build: (content: Frame) -> (),
	onOpen: ((args: any) -> ())?,
	onClose: (() -> ())?,
}

local modules: { [string]: WindowModule } = {}
local frames: { [string]: Frame } = {}
local built: { [string]: boolean } = {}

function WindowManager.register(name: string, module: WindowModule)
	modules[name] = module
end

local function createFrame(name: string, module: WindowModule): Frame
	local size = module.Size or Vector2.new(720, 470)
	local frame = UI.panel({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.94, 0, 0.86, 0),
		StrokeColor = C.Purple,
		StrokeThickness = 3,
		Visible = false,
		Parent = Root.Layers.Windows,
	})
	UI.new("UISizeConstraint", { MaxSize = size, MinSize = Vector2.new(300, 240), Parent = frame })
	UI.gradient(frame, C.Panel, C.Background, 90)

	local header = UI.new("Frame", {
		Name = "Header",
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 52),
		Parent = frame,
	})
	UI.corner(header)
	UI.gradient(header, Color3.fromRGB(70, 40, 160), Color3.fromRGB(20, 22, 60), 0)
	UI.label({
		Name = "Title",
		Text = (module.Icon and (module.Icon .. "  ") or "") .. module.Title,
		Font = F.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -90, 0, 36),
		MaxTextSize = 32,
		Parent = header,
	})
	UI.button({
		Name = "Close",
		Text = "✕",
		Color = C.Red,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(UIConfig.MinTouchSize, 40),
		TextSize = 24,
		Parent = header,
		OnClick = function()
			WindowManager.close()
		end,
	})
	UI.new("Frame", {
		Name = "Accent",
		BackgroundColor3 = C.Red,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 52),
		Size = UDim2.new(1, 0, 0, 2),
		Parent = frame,
	})
	UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 62),
		Size = UDim2.new(1, -20, 1, -72),
		ClipsDescendants = true,
		Parent = frame,
	})
	UI.scanlines(frame, 30, 0.95)
	return frame
end

function WindowManager.open(name: string, args: any?)
	local module = modules[name]
	if not module then
		warn("[WindowManager] Unbekanntes Fenster:", name)
		return
	end
	if WindowManager.current and WindowManager.current ~= name then
		WindowManager.close(true)
	end
	local frame = frames[name]
	if not frame then
		frame = createFrame(name, module)
		frames[name] = frame
	end
	assert(frame)
	if not built[name] then
		built[name] = true
		module.build(frame:FindFirstChild("Content") :: Frame)
	end
	if module.onOpen then
		module.onOpen(args)
	end
	if not frame.Visible then
		frame.Visible = true
		local scale = frame:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = frame })
		scale.Scale = 0.9
		UI.tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		Sound.play("UIOpen")
	end
	WindowManager.current = name
	WindowManager.Opened:Fire(name)
	if GuiService.SelectedObject == nil and game:GetService("UserInputService").GamepadEnabled then
		GuiService.SelectedObject = (frame:FindFirstChild("Close", true) :: any)
	end
end

function WindowManager.close(switching: boolean?)
	local name = WindowManager.current
	if not name then
		return
	end
	local frame = frames[name]
	local module = modules[name]
	if frame then
		frame.Visible = false
	end
	if module and module.onClose then
		module.onClose()
	end
	WindowManager.current = nil
	GuiService.SelectedObject = nil
	if not switching then
		WindowManager.Closed:Fire(name)
	end
end

function WindowManager.toggle(name: string, args: any?)
	if WindowManager.current == name then
		WindowManager.close()
	else
		WindowManager.open(name, args)
	end
end

function WindowManager.isOpen(name: string): boolean
	return WindowManager.current == name
end

-- Alle Module in Controllers > Windows registrieren
function WindowManager.init()
	local folder = script.Parent:WaitForChild("Windows")
	for _, child in folder:GetChildren() do
		if child:IsA("ModuleScript") then
			local ok, module = pcall(require, child)
			if ok then
				WindowManager.register(child.Name, module)
			else
				warn("[WindowManager] Fenster konnte nicht geladen werden:", child.Name, module)
			end
		end
	end
	State.on("OpenUI", function(data)
		if type(data) == "table" and type(data.Panel) == "string" then
			WindowManager.open(data.Panel, data)
		end
	end)
end

return WindowManager
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="106">
            <Properties>
              <string name="Name">Windows</string>
            </Properties>
            <Item class="ModuleScript" referent="107">
              <Properties>
                <string name="Name">Character</string>
                <string name="Source"><![CDATA[--!strict
-- Character (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Character
--
-- Detailansicht eines eigenen Characters (args.Uid): drehende Vorschau,
-- Werte, Upgrade, Base/Fishing, Lock, Verkaufen (mit Bestätigung) und Gear.
-- Alle Kosten/Werte nur zur Anzeige – der Server rechnet selbst.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local Util = Shared:WaitForChild("Util")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local Format = require(Util:WaitForChild("Format"))
local Stats = require(Util:WaitForChild("Stats"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))
local Viewport = require(Client:WaitForChild("UI"):WaitForChild("Viewport"))

local C = UI.Colors
local F = UI.Fonts

local Character = {}
Character.Title = "CHARACTER"
Character.Icon = "👤"
Character.Size = Vector2.new(860, 560)

local currentUid: string? = nil
local lastChar: any = nil
local vpKey = ""

local ui: { [string]: any } = {}
local watcher: Cards.Watcher

local function cash(): number
	return State.data.Cash or 0
end

-- Summe der nächsten n Upgrade-Stufen
local function multiCost(def: any, char: any, n: number): (number, number)
	local total, levels = 0, 0
	for i = 0, n - 1 do
		local cost = Stats.upgradeCost(def, char.Level + i, char.Mutation)
		if not cost then
			break
		end
		total += cost
		levels += 1
	end
	return total, levels
end

local function gearRow(parent: Instance, gearUid: string, item: any, order: number, equipped: boolean, canEquip: boolean)
	local def = GearConfig.Get(item.Id)
	if not def then
		return
	end
	local row = Cards.row(parent, 64, order, Cards.gearColor(def))
	Cards.rowText(row, def.DisplayName, Cards.gearStats(def), Cards.gearColor(def), 126)
	local button = UI.button({
		Text = if equipped then "UNEQUIP" else "EQUIP",
		Color = if equipped then C.Red else C.Blue,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(116, 48),
		TextSize = 18,
		Parent = row,
		OnClick = function()
			if equipped then
				Actions.send("UnequipGear", gearUid)
			elseif currentUid then
				Actions.send("EquipGear", gearUid, currentUid)
			end
		end,
	})
	if not equipped then
		UI.setButtonEnabled(button, canEquip, C.Blue)
	end
end

local function rebuildGear(char: any)
	Cards.clear(ui.gearList)
	local slots = State.derived.GearSlots or 2
	local gear = State.data.Gear or {}
	local order = 0
	for _, gearUid in char.Gear or {} do
		local item = gear[gearUid]
		if item then
			order += 1
			gearRow(ui.gearList, gearUid, item, order, true, false)
		end
	end
	if order == 0 then
		order += 1
		Cards.paragraph(ui.gearList, "No gear equipped. Gear drops from fishing, quests and the season pass.", order)
	end
	ui.gearHeader.Text = string.format("🧰 GEAR  %d / %d SLOTS", #(char.Gear or {}), slots)

	-- freie Gear-Items (beste zuerst)
	local free = {}
	for gearUid, item in gear do
		local def = GearConfig.Get(item.Id)
		if def and not item.On then
			table.insert(free, { uid = gearUid, item = item, order = Cards.gearOrder(def), name = def.DisplayName })
		end
	end
	table.sort(free, function(a, b)
		if a.order ~= b.order then
			return a.order > b.order
		end
		if a.name ~= b.name then
			return a.name < b.name
		end
		return a.uid < b.uid
	end)
	local canEquip = #(char.Gear or {}) < slots
	order += 1
	Cards.header(ui.gearList, "EQUIP GEAR", order, C.Blue)
	for i, entry in free do
		if i > 30 then
			break
		end
		order += 1
		gearRow(ui.gearList, entry.uid, entry.item, order, false, canEquip)
	end
	if #free == 0 then
		order += 1
		Cards.paragraph(ui.gearList, "No unequipped gear in your inventory.", order)
	end
end

local function refresh(changed: { [string]: boolean }?)
	local uid = currentUid
	local char = uid and State.character(uid)
	local def = char and CharacterConfig.ById[char.Id]
	if not uid or not char or not def then
		-- verkauft oder ungültig: zurück ins Inventar (verzögert, wir sind evtl. mitten in open())
		task.defer(function()
			if watcher.isVisible() then
				Cards.open("Inventory")
			end
		end)
		return
	end
	local charChanged = char ~= lastChar
	lastChar = char
	local rarity = RarityConfig.Get(def.Rarity)
	local mutation = MutationConfig.Get(char.Mutation)

	local key = char.Id .. "|" .. (char.Mutation or "")
	if key ~= vpKey then
		vpKey = key
		Viewport.set(ui.viewport, char.Id, char.Mutation)
	end
	ui.stroke.Color = rarity.Color
	ui.name.Text = def.DisplayName
	ui.name.TextColor3 = rarity.Color
	ui.rarity.Text = rarity.DisplayName .. " · Base chance " .. Cards.baseChanceText(def) .. " · " .. string.upper(def.Category or "")
	ui.rarity.TextColor3 = rarity.Color
	if char.Mutation and char.Mutation ~= MutationConfig.None then
		ui.mutation.Text = string.format("MUTATION: %s  (x%g cash, x%g power)", mutation.DisplayName, mutation.MoneyMultiplier, mutation.PowerMultiplier)
		ui.mutation.TextColor3 = mutation.Color
		ui.mutation.Visible = true
	else
		ui.mutation.Visible = false
	end
	ui.description.Text = def.Description or ""

	local maxLevel = def.MaxLevel
	ui.setLevel(char.Level / maxLevel, string.format("LEVEL %d / %d", char.Level, maxLevel))
	local nextLook = nil
	for _, lv in { 5, 10, 15 } do
		if char.Level < lv and lv <= maxLevel then
			nextLook = lv
			break
		end
	end
	ui.levelHint.Text = if nextLook then string.format("✨ New look at Lv %d (looks change at 5 / 10 / 15)", nextLook) else "✨ MAX LEVEL look unlocked!"

	local income = State.income(uid)
	ui.stats.Income.Text = "💰 " .. Format.perSecond(income) .. (if char.Slot then "" else "\n(only in base)")
	ui.stats.Power.Text = "⚔ POWER\n" .. Format.short(Stats.power(def, char.Level, char.Mutation))
	ui.stats.Fishing.Text = string.format("🎣 FISHING POWER\n%.1f", State.fishingPower(uid))
	local sellValue = Stats.sellValue(def, char.Level, char.Mutation)
	ui.stats.Sell.Text = "🏷 SELL VALUE\n" .. Format.cash(sellValue)

	-- Buttons
	local cost = State.upgradeCost(uid)
	if cost then
		ui.upgrade.Text = "⬆ UPGRADE\n" .. Format.cash(cost)
		UI.setButtonEnabled(ui.upgrade, cash() >= cost, C.Green)
		local total, levels = multiCost(def, char, 5)
		ui.upgrade5.Text = string.format("⬆ x%d\n%s", levels, Format.cash(total))
		UI.setButtonEnabled(ui.upgrade5, cash() >= cost, C.Green)
	else
		ui.upgrade.Text = "MAX LEVEL"
		UI.setButtonEnabled(ui.upgrade, false)
		ui.upgrade5.Text = "MAX LEVEL"
		UI.setButtonEnabled(ui.upgrade5, false)
	end
	ui.place.Text = if char.Slot then "REMOVE FROM BASE" else "🏠 PLACE IN BASE"
	ui.place.BackgroundColor3 = if char.Slot then C.PanelLight else C.Blue
	local fishingUnlocked = State.derived.FishingUnlocked == true
	ui.fish.Visible = fishingUnlocked
	ui.fish.Text = if char.Fishing then "RECALL FROM POND" else "🎣 SEND FISHING"
	ui.fish.BackgroundColor3 = if char.Fishing then C.PanelLight else Color3.fromRGB(30, 120, 140)
	ui.lock.Text = if char.Locked then "🔓 UNLOCK" else "🔒 LOCK"
	ui.lock.BackgroundColor3 = if char.Locked then C.Gold:Lerp(Color3.new(0, 0, 0), 0.4) else C.PanelLight
	ui.setSellText("SELL " .. Format.cash(sellValue))
	UI.setButtonEnabled(ui.sell, not char.Locked, C.Red)

	if changed == nil or charChanged or changed.Gear or changed.Derived then
		rebuildGear(char)
	end
end

local function statBox(parent: Instance, order: number): TextLabel
	local box = UI.label({
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Background,
		TextColor3 = C.Text,
		LayoutOrder = order,
		MaxTextSize = 17,
		Parent = parent,
	})
	UI.corner(box, 8)
	UI.padding(box, 4)
	return box
end

function Character.build(content: Frame)
	-- links: Vorschau + Zurück
	local left = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.38, -6, 1, 0), Parent = content })
	local preview = UI.panel({ BackgroundColor3 = C.Background, Size = UDim2.new(1, 0, 1, -56), Parent = left })
	ui.stroke = preview:FindFirstChildOfClass("UIStroke")
	ui.viewport = Viewport.create({ Parent = preview })
	Viewport.spin(ui.viewport, 0.7)
	UI.button({
		Text = "◀ BACK",
		Color = C.PanelLight,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 48),
		TextSize = 20,
		Parent = left,
		OnClick = function()
			Cards.open("Inventory")
		end,
	})

	-- rechts: Infos + Aktionen + Gear
	local holder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0.38, 4, 0, 0), Size = UDim2.new(0.62, -4, 1, 0), Parent = content })
	local scroll = UI.scrollList(holder, 6)
	ui.name = UI.label({ Font = F.Title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -16, 0, 32), MaxTextSize = 30, LayoutOrder = 1, Parent = scroll })
	ui.rarity = UI.label({ TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -16, 0, 20), MaxTextSize = 16, LayoutOrder = 2, Parent = scroll })
	ui.mutation = UI.label({ Font = F.Title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -16, 0, 20), MaxTextSize = 17, LayoutOrder = 3, Parent = scroll })
	ui.description = Cards.paragraph(scroll, "", 4)
	local levelBar, setLevel = UI.progress({ Size = UDim2.new(1, -16, 0, 22), Color = C.Purple, LayoutOrder = 5, Parent = scroll })
	ui.levelBar = levelBar
	ui.setLevel = setLevel
	ui.levelHint = UI.label({ TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -16, 0, 18), MaxTextSize = 15, LayoutOrder = 6, Parent = scroll })

	local statsGrid = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 7, Parent = scroll })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 46), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = statsGrid })
	ui.stats = {
		Income = statBox(statsGrid, 1),
		Power = statBox(statsGrid, 2),
		Fishing = statBox(statsGrid, 3),
		Sell = statBox(statsGrid, 4),
	}
	ui.stats.Income.TextColor3 = C.Cash

	local actions = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 8, Parent = scroll })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 54), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = actions })
	local function action(order: number, text: string, color: Color3, onClick: () -> ()): TextButton
		return UI.button({ Text = text, Color = color, TextSize = 18, LayoutOrder = order, Parent = actions, OnClick = onClick })
	end
	ui.upgrade = action(1, "UPGRADE", C.Green, function()
		if currentUid then
			Actions.send("UpgradeCharacter", currentUid, 1)
		end
	end)
	ui.upgrade5 = action(2, "UPGRADE x5", C.Green, function()
		if currentUid then
			Actions.send("UpgradeCharacter", currentUid, 5)
		end
	end)
	ui.place = action(3, "PLACE IN BASE", C.Blue, function()
		local char = currentUid and State.character(currentUid)
		if char and currentUid then
			Actions.send(if char.Slot then "RemoveCharacter" else "PlaceCharacter", currentUid)
		end
	end)
	ui.fish = action(4, "SEND FISHING", C.Blue, function()
		local char = currentUid and State.character(currentUid)
		if char and currentUid then
			Actions.send(if char.Fishing then "RecallFishing" else "SendFishing", currentUid)
		end
	end)
	ui.lock = action(5, "LOCK", C.PanelLight, function()
		local char = currentUid and State.character(currentUid)
		if char and currentUid then
			Actions.send("LockCharacter", currentUid, not char.Locked)
		end
	end)
	local sell, setSellText = Cards.confirmButton({
		Text = "SELL",
		ConfirmText = "TAP AGAIN TO SELL",
		Color = C.Red,
		TextSize = 18,
		LayoutOrder = 6,
		Parent = actions,
		OnConfirm = function()
			if currentUid then
				Actions.send("SellCharacter", currentUid)
			end
		end,
	})
	ui.sell = sell
	ui.setSellText = setSellText

	ui.gearHeader = Cards.header(scroll, "🧰 GEAR", 9, C.Blue)
	ui.gearList = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10, Parent = scroll })
	UI.list(ui.gearList, 6, false, Enum.HorizontalAlignment.Center)
	ui.scroll = scroll

	watcher = Cards.watch({
		Characters = function()
			return currentUid ~= nil and State.character(currentUid) ~= lastChar
		end,
		Cash = true,
		Gear = true,
		Derived = Cards.derivedChanged({ "GearSlots", "CashMultiplier", "FishingUnlocked" }),
	}, refresh, 0.1)
end

function Character.onOpen(args: any?)
	local uid = type(args) == "table" and args.Uid or nil
	if type(uid) == "string" then
		if uid ~= currentUid then
			ui.scroll.CanvasPosition = Vector2.zero
		end
		currentUid = uid
	end
	lastChar = nil
	watcher.open()
end

function Character.onClose()
	watcher.close()
end

return Character
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="108">
              <Properties>
                <string name="Name">Fishing</string>
                <string name="Source"><![CDATA[--!strict
-- Fishing (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Fishing
--
-- Rift Fishing. Gesperrt: Erklärung + Fortschritt (insgesamt verdientes Cash).
-- Offen: Tabs SPOTS (Angler + Kandidaten), WATERS (Gewässer wählen),
-- LOOT (echte Chancen über Odds/RollMath bei aktueller Fishing Luck) und
-- CATCHES (letzte Fänge, Event "Catch" – wird auch bei geschlossenem Fenster
-- gesammelt).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local Util = Shared:WaitForChild("Util")
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local Format = require(Util:WaitForChild("Format"))
local Odds = require(Util:WaitForChild("Odds"))
local RollMath = require(Util:WaitForChild("RollMath"))
local Stats = require(Util:WaitForChild("Stats"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))
local Viewport = require(Client:WaitForChild("UI"):WaitForChild("Viewport"))

local C = UI.Colors
local F = UI.Fonts

local Fishing = {}
Fishing.Title = "RIFT FISHING"
Fishing.Icon = "🎣"
Fishing.Size = Vector2.new(820, 540)

local TABS = { "Spots", "Waters", "Loot", "Catches" }
local MAX_CANDIDATES = 25

local recent: { any } = {}
local pages: { [string]: Frame } = {}
local scrolls: { [string]: ScrollingFrame } = {}
local currentTab = "Spots"
local selectTab: (string) -> ()
local ui: { [string]: any } = {}
local watcher: Cards.Watcher

local function lootName(kind: string, id: string?, cash: number?): string
	if kind == "Cash" then
		return if cash then "CASH " .. Format.cash(cash) else "CASH BAG"
	elseif kind == "Potion" and id then
		local def = PotionConfig.Get(id)
		return if def then def.DisplayName else id
	elseif kind == "Gear" and id then
		return Cards.gearName(id)
	elseif kind == "Relic" and id then
		local def = FishingConfig.RelicById[id]
		return if def then def.DisplayName else id
	elseif kind == "Cosmetic" and id then
		return Cards.cosmeticName(id)
	end
	return kind
end

local function rarityColor(id: string): Color3
	local r = RarityConfig.ById[id]
	return if r then r.Color else C.Text
end

local function interval(uid: string): number
	return Stats.catchInterval(State.fishingPower(uid), State.derived.FishingSpeed or 1)
end

-- Zeilen mit Character-Vorschau werden pro Key wiederverwendet (Auto-Roll
-- ändert die Characters jede Sekunde, Viewports sollen nicht neu gebaut werden)
type CharRow = { Frame: Frame, vp: ViewportFrame, title: TextLabel, sub: TextLabel, button: TextButton, vpKey: string, action: () -> () }
local charRows: { [string]: CharRow } = {}
local usedRows: { [string]: boolean } = {}

local function getRow(key: string): CharRow
	usedRows[key] = true
	local existing = charRows[key]
	if existing then
		return existing
	end
	local frame = Cards.row(scrolls.Spots, 72, 0)
	local vp = Viewport.create({ Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(60, 60), Parent = frame })
	local title, sub = Cards.rowText(frame, "", "", C.Text, 132, 74)
	local row: CharRow
	local button = UI.button({
		Text = "",
		Color = C.Blue,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(120, 50),
		TextSize = 19,
		Parent = frame,
		OnClick = function()
			row.action()
		end,
	})
	row = { Frame = frame, vp = vp, title = title, sub = sub, button = button, vpKey = "", action = function() end }
	charRows[key] = row
	return row
end

local function setCharRow(row: CharRow, order: number, entry: any, buttonText: string, color: Color3, enabled: boolean, action: () -> ())
	local uid = entry.uid
	local def = entry.def
	local rarity = RarityConfig.Get(def.Rarity)
	row.Frame.LayoutOrder = order
	row.vp.Visible = true
	local key = entry.char.Id .. "|" .. (entry.char.Mutation or "")
	if key ~= row.vpKey then
		row.vpKey = key
		Cards.setViewport(row.vp, entry.char.Id, entry.char.Mutation)
	end
	row.title.Text = def.DisplayName
	row.title.TextColor3 = rarity.Color
	row.sub.Text = string.format("%s · Lv %d · 🎣 %.1f power · 1 catch / %s", rarity.DisplayName, entry.char.Level, State.fishingPower(uid), Format.duration(interval(uid)))
	row.button.Visible = true
	row.button.Text = buttonText
	UI.setButtonEnabled(row.button, enabled, color)
	row.action = action
end

local function buildSpots()
	local scroll = scrolls.Spots
	table.clear(usedRows)
	local slots = State.derived.FishingSlots or GameConfig.StartFishingSlots
	local bySeat: { [number]: any } = {}
	local candidates = {}
	for _, entry in State.characterList("Rarity") do
		if entry.char.Fishing then
			bySeat[entry.char.Fishing] = entry
		elseif not entry.char.Slot then
			entry.power = State.fishingPower(entry.uid)
			table.insert(candidates, entry)
		end
	end
	local used = 0
	for _ in bySeat do
		used += 1
	end
	if not ui.spotsHeader then
		ui.spotsHeader = Cards.header(scroll, "", 0, C.Luck)
		ui.spotsInfo = Cards.paragraph(scroll, "", 1)
		Cards.header(scroll, "SEND A CHARACTER", 50, C.Blue)
		Cards.paragraph(scroll, "Characters that are not in your base, best fishers first. Base characters can be sent from their detail page.", 51)
		ui.noCandidates = Cards.paragraph(scroll, "No spare characters. Roll more, or remove one from your base.", 99)
	end
	ui.spotsHeader.Text = string.format("🎣 FISHING SPOTS %d / %d", used, slots)
	ui.spotsInfo.Text = string.format("Fishing Luck %s · Speed %s · Fishing characters earn no cash, but don't need a base slot.",
		Format.multiplier(State.derived.FishingLuck or 1), Format.multiplier(State.derived.FishingSpeed or 1))

	for seat = 1, slots do
		local entry = bySeat[seat]
		if entry then
			local uid = entry.uid
			setCharRow(getRow(uid), 10 + seat, entry, "RECALL", C.Red, true, function()
				Actions.send("RecallFishing", uid)
			end)
		else
			local row = getRow("seat" .. seat)
			row.Frame.LayoutOrder = 10 + seat
			row.vp.Visible = false
			row.button.Visible = false
			row.title.Text = "SPOT " .. seat .. " · EMPTY"
			row.title.TextColor3 = C.SubText
			row.sub.Text = "Send a character from the list below."
		end
	end

	table.sort(candidates, function(a, b)
		if a.power ~= b.power then
			return a.power > b.power
		end
		return a.uid < b.uid
	end)
	local free = used < slots
	for i, entry in candidates do
		if i > MAX_CANDIDATES then
			break
		end
		local uid = entry.uid
		setCharRow(getRow(uid), 100 + i, entry, "SEND", C.Blue, free, function()
			Actions.send("SendFishing", uid)
		end)
	end
	ui.noCandidates.Visible = #candidates == 0

	for key, row in charRows do
		if not usedRows[key] then
			row.Frame:Destroy()
			charRows[key] = nil
		end
	end
end

local function buildWaters()
	local scroll = scrolls.Waters
	Cards.clear(scroll)
	local areas = State.data.Areas or {}
	local currentWaters = State.data.FishingWaters or FishingConfig.DefaultWaters
	for i, waters in FishingConfig.Waters do
		local unlocked = areas[waters.Area] == true
		local area = AreaConfig.Get(waters.Area)
		local row = Cards.row(scroll, 96, i, waters.Color)
		local sub = waters.Description .. "\n" .. (if unlocked then "Area: " else "🔒 Unlock area: ") .. (if area then area.DisplayName else waters.Area)
		Cards.rowText(row, waters.DisplayName, sub, if unlocked then waters.Color else C.SubText, 250)
		local id = waters.Id
		local tune = UI.button({
			Text = if id == currentWaters then "✓ ACTIVE" elseif unlocked then "TUNE IN" else "🔒 LOCKED",
			Color = C.Green,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(118, 50),
			TextSize = 18,
			Parent = row,
			OnClick = function()
				Actions.send("SetWaters", id)
			end,
		})
		UI.setButtonEnabled(tune, unlocked and id ~= currentWaters, C.Green)
		UI.button({
			Text = "LOOT",
			Color = C.PanelLight,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -132, 0.5, 0),
			Size = UDim2.fromOffset(104, 50),
			TextSize = 18,
			Parent = row,
			OnClick = function()
				ui.lootPreview = id
				selectTab("Loot")
			end,
		})
	end
end

local function buildLoot()
	local scroll = scrolls.Loot
	Cards.clear(scroll)
	local watersId = ui.lootPreview or State.data.FishingWaters or FishingConfig.DefaultWaters
	local waters = FishingConfig.WatersById[watersId]
	local tbl = Odds.watersTable(watersId)
	if not waters or not tbl then
		return
	end
	local luck = State.derived.FishingLuck or 1
	local probs = RollMath.probabilities(tbl, luck)
	local active = watersId == (State.data.FishingWaters or FishingConfig.DefaultWaters)
	Cards.header(scroll, "🎁 LOOT · " .. waters.DisplayName .. (if active then " (ACTIVE)" else " (PREVIEW)"), 0, waters.Color)
	Cards.paragraph(scroll, string.format("Exact chances per catch at Fishing Luck %s. Gear on a character adds its own Fishing Luck on top. Luck boosts Rare and better.", Format.multiplier(luck)), 1)
	for i, entry in tbl.Entries do
		local loot = entry.Key
		local p = probs[i]
		local row = Cards.row(scroll, 48, 10 + i, rarityColor(loot.Rarity))
		local name = lootName(loot.Kind, loot.Id, nil)
		if loot.Kind == "Cash" and loot.Seconds then
			name = string.format("CASH (≈%s)", Format.cash(Cards.cashEstimate(loot.Seconds, 25)))
		end
		UI.label({
			Text = name .. "  ·  " .. string.upper(loot.Kind),
			Font = F.Title,
			TextColor3 = rarityColor(loot.Rarity),
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(16, 6),
			Size = UDim2.new(0.62, -16, 1, -12),
			MaxTextSize = 17,
			Parent = row,
		})
		UI.label({
			Text = Format.chance(p) .. "  (" .. Format.percent(p, if p < 0.01 then 3 else 1) .. ")",
			TextColor3 = C.Luck,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 6),
			Size = UDim2.new(0.38, -10, 1, -12),
			MaxTextSize = 16,
			Parent = row,
		})
	end
end

local function buildCatches()
	local scroll = scrolls.Catches
	Cards.clear(scroll)
	Cards.header(scroll, "🧾 RECENT CATCHES", 0, C.Gold)
	for i, catch in recent do
		local def = State.def(catch.Uid)
		local row = Cards.row(scroll, 56, i, rarityColor(catch.Rarity or "Common"))
		local sub = (if def then "Caught by " .. def.DisplayName else "Caught") .. (if catch.Probability then " · " .. Format.chance(catch.Probability) else "") .. (if catch.Duplicate then " · duplicate → cash" else "")
		Cards.rowText(row, lootName(catch.Kind, catch.Id, catch.Cash), sub, rarityColor(catch.Rarity or "Common"))
	end
	if #recent == 0 then
		Cards.paragraph(scroll, "Nothing caught yet this session.", 1)
	end
end

local BUILDERS: { [string]: () -> () } = { Spots = buildSpots, Waters = buildWaters, Loot = buildLoot, Catches = buildCatches }
local DEPENDS: { [string]: { [string]: boolean } } = {
	Spots = { Characters = true, Derived = true, Gear = true },
	Waters = { FishingWaters = true, Areas = true },
	Loot = { FishingWaters = true, Derived = true },
	Catches = { Catch = true },
}

local function refresh(changed: { [string]: boolean }?)
	local unlocked = State.derived.FishingUnlocked == true
	ui.locked.Visible = not unlocked
	ui.unlocked.Visible = unlocked
	if not unlocked then
		ui.wasUnlocked = false
		local earned = (State.data.Stats and State.data.Stats.TotalCashEarned) or 0
		local goal = GameConfig.FishingUnlockCashEarned
		ui.setUnlock(earned / goal, Format.cash(math.min(earned, goal)) .. " / " .. Format.cash(goal) .. " earned")
		return
	end
	if not ui.wasUnlocked then
		-- gerade freigeschaltet: alles neu aufbauen
		ui.wasUnlocked = true
		changed = nil
	end
	if changed then
		local relevant = false
		for key in changed do
			if DEPENDS[currentTab][key] then
				relevant = true
			end
		end
		if not relevant then
			return
		end
	end
	local scroll = scrolls[currentTab]
	local y = scroll.CanvasPosition
	BUILDERS[currentTab]()
	scroll.CanvasPosition = y
end

function Fishing.build(content: Frame)
	-- gesperrt
	local locked = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	UI.list(locked, 12, false, Enum.HorizontalAlignment.Center)
	UI.label({ Text = "🎣 RIFT FISHING IS LOCKED", Font = F.Title, TextColor3 = C.Luck, Size = UDim2.new(1, -20, 0, 36), MaxTextSize = 30, LayoutOrder = 1, Parent = locked })
	local text = Cards.paragraph(locked, string.format("Earn %s in total to unlock Rift Fishing. Characters that are not in your base can fish at your Rift Pond and pull up potions, gear, relics and rare cosmetics.", Format.cash(GameConfig.FishingUnlockCashEarned)), 2, C.Text)
	text.TextXAlignment = Enum.TextXAlignment.Center
	local _, setUnlock = UI.progress({ Size = UDim2.new(0.8, 0, 0, 28), Color = C.Luck, LayoutOrder = 3, Parent = locked })
	ui.locked = locked
	ui.setUnlock = setUnlock

	-- offen
	local unlocked = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	ui.unlocked = unlocked
	for _, tab in TABS do
		local page = Cards.page(unlocked, tab)
		pages[tab] = page
		scrolls[tab] = UI.scrollList(page, 6)
	end
	local _, select = UI.tabs(unlocked, TABS, function(name: string)
		if name ~= "Loot" then
			ui.lootPreview = nil
		end
		currentTab = name
		for tab, page in pages do
			page.Visible = tab == name
		end
		if watcher and watcher.isVisible() then
			refresh(nil)
		end
	end)
	selectTab = select

	watcher = Cards.watch({
		Characters = true,
		Gear = true,
		FishingWaters = true,
		Areas = true,
		Stats = function()
			return State.derived.FishingUnlocked ~= true
		end,
		Derived = Cards.derivedChanged({ "FishingUnlocked", "FishingSlots", "FishingLuck", "FishingSpeed" }),
	}, refresh, 0.3)
end

-- Fänge auch bei geschlossenem Fenster sammeln
State.on("Catch", function(data: any)
	if type(data) ~= "table" then
		return
	end
	table.insert(recent, 1, data)
	while #recent > FishingConfig.MaxRecentCatches do
		table.remove(recent)
	end
	if watcher then
		watcher.request("Catch")
	end
end)

function Fishing.onOpen(args: any?)
	local tab = currentTab
	if type(args) == "table" and type(args.Tab) == "string" then
		for _, name in TABS do
			if string.lower(name) == string.lower(args.Tab) then
				tab = name
			end
		end
	end
	selectTab(tab)
	watcher.open()
end

function Fishing.onClose()
	watcher.close()
end

return Fishing
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="109">
              <Properties>
                <string name="Name">Index</string>
                <string name="Source"><![CDATA[--!strict
-- Index (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Index
--
-- Alle Characters nach Rarity. Unentdeckte als schwarze Silhouette ("???").
-- Ehrliche Zahlen: Basis-Chance, DEINE Chance bei aktueller Luck (Odds) und
-- oben eine Tabelle "Your odds" pro Rarity. Klick auf eine entdeckte Karte
-- öffnet ein Detail-Popup.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local Util = Shared:WaitForChild("Util")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local Format = require(Util:WaitForChild("Format"))
local Odds = require(Util:WaitForChild("Odds"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))
local Viewport = require(Client:WaitForChild("UI"):WaitForChild("Viewport"))

local C = UI.Colors
local F = UI.Fonts

local Index = {}
Index.Title = "INDEX"
Index.Icon = "📖"
Index.Size = Vector2.new(900, 560)

local cards: { [string]: Cards.Card } = {}
local oddsCells: { [string]: TextLabel } = {}
local sectionCounts: { [string]: TextLabel } = {}
local ui: { [string]: any } = {}
local watcher: Cards.Watcher
local lastLuck = -1
local lastIndex: any = nil

local function luck(): number
	return State.derived.Luck or 1
end

local function chanceText(p: number): string
	if p <= 0 then
		return "—"
	end
	return Format.chance(p)
end

local function showDetail(def: any)
	local entry = (State.data.Index or {})[def.Id]
	if not entry then
		return
	end
	local rarity = RarityConfig.Get(def.Rarity)
	Viewport.set(ui.detailViewport, def.Id, nil)
	Cards.clear(ui.detailList)
	local order = 0
	local function line(text: string, color: Color3?)
		order += 1
		Cards.paragraph(ui.detailList, text, order, color or C.Text)
	end
	line(rarity.DisplayName .. " · " .. string.upper(def.Category or "?"), rarity.Color)
	line(def.Description or "", C.Text)
	line("Look: " .. (def.VisualTheme or "?"), C.SubText)
	line("Base chance: " .. Cards.baseChanceText(def), C.SubText)
	line("Your chance: " .. chanceText(Odds.characterProbability(def.Id, luck())) .. " (Luck " .. Format.multiplier(luck()) .. ")", C.Luck)
	line("Base income: " .. Format.perSecond(def.BaseMoneyPerSecond) .. " · Max level " .. def.MaxLevel, C.Cash)
	line("Times rolled: " .. Format.commas(entry.N or 0), C.SubText)
	local found = {}
	for _, m in MutationConfig.List do
		if (entry.M or {})[m.Id] then
			table.insert(found, m.DisplayName)
		end
	end
	line("Mutations found: " .. (if #found > 0 then table.concat(found, ", ") else "none"), C.Gold)
	ui.popup.show(def.DisplayName)
	ui.detailScroll.CanvasPosition = Vector2.zero
end

local function refresh(changed: { [string]: boolean }?)
	local index = State.data.Index or {}
	local l = luck()
	local indexChanged = changed == nil or changed.Index or index ~= lastIndex
	local luckChanged = math.abs(l - lastLuck) > 1e-6
	if not indexChanged and not luckChanged then
		return
	end
	lastIndex = index
	lastLuck = l

	local discovered = 0
	local perRarity: { [string]: number } = {}
	for _, def in CharacterConfig.List do
		local entry = index[def.Id]
		local rarity = RarityConfig.Get(def.Rarity)
		local card = cards[def.Id]
		if entry then
			discovered += 1
			perRarity[def.Rarity] = (perRarity[def.Rarity] or 0) + 1
		end
		if card then
			local yours = Odds.characterProbability(def.Id, l)
			if entry then
				local muts = 0
				for m in entry.M or {} do
					if m ~= MutationConfig.None then
						muts += 1
					end
				end
				card.set({
					Id = def.Id,
					Title = def.DisplayName,
					TitleColor = rarity.Color,
					Lines = {
						"Base " .. Cards.baseChanceText(def),
						"You " .. chanceText(yours),
						Format.perSecond(def.BaseMoneyPerSecond) .. " · x" .. Format.short(entry.N or 0) .. (if muts > 0 then " · " .. muts .. "🧬" else ""),
					},
					LineColors = { C.SubText, C.Luck, C.Cash },
					StrokeColor = rarity.Color,
				})
			else
				card.set({
					Id = def.Id,
					Silhouette = true,
					Title = "???",
					TitleColor = C.SubText,
					Lines = { rarity.DisplayName, "Base " .. Cards.baseChanceText(def), "You " .. chanceText(yours) },
					LineColors = { rarity.Color, C.SubText, C.Luck },
					StrokeColor = rarity.Color2,
				})
			end
		end
	end
	for id, label in sectionCounts do
		label.Text = string.format("%d / %d", perRarity[id] or 0, #(CharacterConfig.ByRarity[id] or {}))
	end

	local total = #CharacterConfig.List
	local bonus = math.min(50, discovered * EconomyConfig.IndexLuckPctPerDiscovery)
	ui.discovered.Text = string.format("📖 DISCOVERED %d / %d", discovered, total)
	ui.bonus.Text = string.format("Index bonus: +%g%% Luck (+%g%% per discovery)", bonus, EconomyConfig.IndexLuckPctPerDiscovery)

	local probs = Odds.rarityProbabilities(l)
	for id, cell in oddsCells do
		cell.Text = string.format("%s\n%s", RarityConfig.Get(id).DisplayName, chanceText(probs[id] or 0))
	end
	ui.oddsHeader.Text = "🎲 YOUR ODDS PER ROLL  (Luck " .. Format.multiplier(l) .. ")"
end

function Index.build(content: Frame)
	local top = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), Parent = content })
	ui.discovered = UI.label({ Font = F.Title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), MaxTextSize = 24, Parent = top })
	ui.bonus = UI.label({ TextColor3 = C.Luck, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 18), MaxTextSize = 15, Parent = top })

	local holder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50), Parent = content })
	local scroll = UI.scrollList(holder, 8)

	-- Odds-Tabelle
	ui.oddsHeader = Cards.header(scroll, "🎲 YOUR ODDS", 1, C.Luck)
	local odds = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(104, 46), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = odds })
	for _, rarity in RarityConfig.List do
		local cell = UI.label({
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Background,
			TextColor3 = rarity.Color,
			Font = F.Title,
			LayoutOrder = rarity.Order,
			MaxTextSize = 15,
			Parent = odds,
		})
		UI.corner(cell, 8)
		UI.stroke(cell, rarity.Color2, 1)
		UI.padding(cell, 3)
		oddsCells[rarity.Id] = cell
	end
	Cards.paragraph(scroll, "These are the exact odds the server uses. Luck multiplies every chance from Uncommon up; Commons get what is left.", 3)

	-- Abschnitte pro Rarity
	local order = 10
	for _, rarity in RarityConfig.List do
		local list = table.clone(CharacterConfig.ByRarity[rarity.Id] or {})
		if #list > 0 then
			table.sort(list, function(a, b)
				if a.RollChance ~= b.RollChance then
					return a.RollChance < b.RollChance
				end
				return a.Index < b.Index
			end)
			order += 1
			local header = Cards.header(scroll, rarity.DisplayName, order, rarity.Color)
			sectionCounts[rarity.Id] = UI.label({
				TextColor3 = C.SubText,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.new(0.4, 0, 1, 0),
				MaxTextSize = 16,
				Parent = header,
			})
			order += 1
			local gridFrame = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = scroll })
			UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(124, 162), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = gridFrame })
			for i, def in list do
				local card = Cards.characterCard(gridFrame, function()
					showDetail(def)
				end)
				card.Frame.LayoutOrder = i
				cards[def.Id] = card
			end
		end
	end

	-- Detail-Popup
	local popup = Cards.popup(content)
	ui.popup = popup
	local vpFrame = UI.panel({ BackgroundColor3 = C.Background, Size = UDim2.new(0.36, -6, 1, 0), Parent = popup.Body })
	ui.detailViewport = Viewport.create({ Parent = vpFrame })
	Viewport.spin(ui.detailViewport, 0.6)
	local listHolder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0.36, 4, 0, 0), Size = UDim2.new(0.64, -4, 1, 0), Parent = popup.Body })
	ui.detailScroll = UI.scrollList(listHolder, 6)
	ui.detailList = ui.detailScroll

	watcher = Cards.watch({
		Index = true,
		Derived = function()
			return math.abs((State.derived.Luck or 1) - lastLuck) > 1e-6
		end,
	}, refresh, 0.3)
end

function Index.onOpen(_args: any?)
	ui.popup.hide()
	watcher.open()
end

function Index.onClose()
	watcher.close()
end

return Index
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="110">
              <Properties>
                <string name="Name">Inspect</string>
                <string name="Source"><![CDATA[--!strict
-- Inspect (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Inspect
--
-- Base eines anderen Spielers ansehen (Event "InspectBase" vom Server,
-- ausgelöst durch die Action InspectBase(plotIndex)). Öffnet sich selbst,
-- sobald die Daten ankommen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local Util = Shared:WaitForChild("Util")
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local Format = require(Util:WaitForChild("Format"))
local Stats = require(Util:WaitForChild("Stats"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors
local F = UI.Fonts

local Inspect = {}
Inspect.Title = "BASE"
Inspect.Icon = "🔍"
Inspect.Size = Vector2.new(820, 540)

local ui: { [string]: any } = {}
local cards: { Cards.Card } = {}

local function stat(parent: Instance, order: number): TextLabel
	local label = UI.label({
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Background,
		LayoutOrder = order,
		MaxTextSize = 16,
		Parent = parent,
	})
	UI.corner(label, 8)
	UI.padding(label, 4)
	return label
end

local function render(data: { [string]: any })
	local title = data.Title and CosmeticConfig.Get(data.Title)
	ui.name.Text = "🏠 " .. tostring(data.Player or "???") .. "'S BASE"
	ui.title.Text = if title then (title.Text or title.DisplayName) else ""
	ui.title.TextColor3 = if title and title.Color then title.Color else C.SubText

	local best = RarityConfig.ById[data.BestRarity or ""]
	ui.stats.Rebirths.Text = "♻ REBIRTHS\n" .. tostring(data.Rebirths or 0)
	ui.stats.Value.Text = "⚔ BASE VALUE\n" .. Format.short(data.BaseValue or 0)
	ui.stats.Income.Text = "💰 INCOME\n" .. Format.perSecond(data.Income or 0)
	ui.stats.Discovered.Text = string.format("📖 DISCOVERED\n%d / %d", data.Discovered or 0, #CharacterConfig.List)
	ui.stats.Best.Text = "🏆 BEST\n" .. (if best then best.DisplayName else "—")
	ui.stats.Best.TextColor3 = if best then best.Color else C.Text
	ui.stats.Rolls.Text = "🎲 ROLLS\n" .. Format.short(data.TotalRolls or 0)

	local chars = table.clone(data.Characters or {})
	table.sort(chars, function(a, b)
		return (a.Slot or 0) < (b.Slot or 0)
	end)
	local shown = 0
	for _, char in chars do
		local def = CharacterConfig.ById[char.Id]
		if def then
			shown += 1
			local card = cards[shown]
			if not card then
				card = Cards.characterCard(ui.grid, nil)
				cards[shown] = card
			end
			local rarity = RarityConfig.Get(def.Rarity)
			local tagText, tagColor = Cards.mutationTag(char.Mutation)
			card.Frame.LayoutOrder = shown
			card.Frame.Visible = true
			card.set({
				Id = char.Id,
				Mutation = char.Mutation,
				Title = def.DisplayName,
				TitleColor = rarity.Color,
				Lines = {
					rarity.DisplayName .. " · Lv " .. tostring(char.Level) .. "/" .. def.MaxLevel,
					"⚔ " .. Format.short(Stats.power(def, char.Level or 1, char.Mutation)),
				},
				LineColors = { rarity.Color, C.SubText },
				Tag = tagText,
				TagColor = tagColor,
				StrokeColor = rarity.Color,
			})
		end
	end
	for i = shown + 1, #cards do
		cards[i].Frame.Visible = false
	end
	ui.empty.Visible = shown == 0
	ui.grid.CanvasPosition = Vector2.zero
end

function Inspect.build(content: Frame)
	ui.name = UI.label({ Font = F.Title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.65, 0, 0, 30), MaxTextSize = 26, Parent = content })
	ui.title = UI.label({ Font = F.Title, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.35, 0, 0, 30), MaxTextSize = 20, Parent = content })

	local statsFrame = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 44), Parent = content })
	UI.new("UIGridLayout", { CellSize = UDim2.new(1 / 6, -6, 1, 0), CellPadding = UDim2.fromOffset(6, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = statsFrame })
	ui.stats = {
		Rebirths = stat(statsFrame, 1),
		Value = stat(statsFrame, 2),
		Income = stat(statsFrame, 3),
		Discovered = stat(statsFrame, 4),
		Best = stat(statsFrame, 5),
		Rolls = stat(statsFrame, 6),
	}
	ui.stats.Income.TextColor3 = C.Cash

	local holder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 84), Size = UDim2.new(1, 0, 1, -84), Parent = content })
	ui.grid = UI.grid(holder, Vector2.new(120, 150), 8)
	ui.empty = UI.label({
		Text = "No characters placed in this base yet.",
		TextColor3 = C.SubText,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0.8, 0, 0, 28),
		MaxTextSize = 20,
		Visible = false,
		Parent = holder,
	})
end

function Inspect.onOpen(args: any?)
	if type(args) == "table" and args.Characters ~= nil then
		render(args)
	end
end

-- Server schickt die Daten -> Fenster öffnen
State.on("InspectBase", function(data: any)
	if type(data) == "table" then
		Cards.open("Inspect", data)
	end
end)

return Inspect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="111">
              <Properties>
                <string name="Name">Inventory</string>
                <string name="Source"><![CDATA[--!strict
-- Inventory (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Inventory
--
-- Raster aller eigenen Characters: Vorschau, Rarity, Level, Mutation, $/s,
-- Status-Icons (🏠 Base, 🎣 Fishing, 🔒 Locked). Sortierung, Rarity-Filter,
-- PLACE BEST. Karten werden pro uid wiederverwendet (Auto-Roll ändert die
-- Characters jede Sekunde), Viewports nur bei neuer Id/Mutation neu gesetzt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors
local F = UI.Fonts

local Inventory = {}
Inventory.Title = "INVENTORY"
Inventory.Icon = "🎒"
Inventory.Size = Vector2.new(880, 560)

local MAX_CARDS = 120
local SORTS = { "Rarity", "Income", "Level", "Newest" }

local sortIndex = 1
local filter: string? = nil
local cards: { [string]: Cards.Card } = {}
local chipButtons: { [string]: TextButton } = {}

local grid: ScrollingFrame
local countLabel: TextLabel
local slotsLabel: TextLabel
local sortButton: TextButton
local emptyLabel: TextLabel
local watcher: Cards.Watcher

local function openCharacter(uid: string)
	Cards.open("Character", { Uid = uid })
end

local function refresh(_changed: { [string]: boolean }?)
	local filterFn = nil
	if filter then
		local wanted = filter
		filterFn = function(_char: any, def: any): boolean
			return def.Rarity == wanted
		end
	end
	local list = State.characterList(SORTS[sortIndex], filterFn)
	local shown: { [string]: boolean } = {}
	for i, entry in list do
		if i > MAX_CARDS then
			break
		end
		local uid: string = entry.uid
		local card = cards[uid]
		if not card then
			card = Cards.characterCard(grid, function()
				openCharacter(uid)
			end)
			cards[uid] = card
		end
		card.Frame.LayoutOrder = i
		card.Frame.Visible = true
		card.set(Cards.ownedInfo(uid, entry.char, entry.def, entry.income))
		shown[uid] = true
	end
	-- nicht angezeigte Karten verstecken, verschwundene Characters entfernen
	local owned = State.data.Characters or {}
	for uid, card in cards do
		if not shown[uid] then
			if owned[uid] then
				card.Frame.Visible = false
			else
				card.Frame:Destroy()
				cards[uid] = nil
			end
		end
	end

	local total = 0
	local placed = 0
	for _, char in owned do
		total += 1
		if char.Slot then
			placed += 1
		end
	end
	local cap = GameConfig.InventorySoftCap
	countLabel.Text = string.format("📦 %d / %d", total, cap) .. (if #list > MAX_CARDS then string.format("  (top %d shown)", MAX_CARDS) else "")
	countLabel.TextColor3 = if total >= cap then C.Red elseif total >= cap * 0.9 then C.Gold else C.Text
	slotsLabel.Text = string.format("🏠 %d / %d in base", placed, State.derived.BaseSlots or GameConfig.StartBaseSlots)
	emptyLabel.Visible = #list == 0
	emptyLabel.Text = if total == 0 then "No characters yet. Press ROLL!" else "No characters of this rarity."
end

local function setFilter(rarityId: string?)
	filter = rarityId
	for id, button in chipButtons do
		local active = (id == "All" and rarityId == nil) or id == rarityId
		button.BackgroundColor3 = if active then C.Purple else C.PanelLight
	end
	refresh(nil)
end

function Inventory.build(content: Frame)
	local bar = UI.new("Frame", { Name = "Toolbar", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), Parent = content })
	countLabel = UI.label({
		Font = F.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.34, -6, 0, 26),
		MaxTextSize = 22,
		Parent = bar,
	})
	slotsLabel = UI.label({
		TextColor3 = C.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(0.34, -6, 0, 20),
		MaxTextSize = 16,
		Parent = bar,
	})
	sortButton = UI.button({
		Text = "SORT: RARITY",
		Color = C.PanelLight,
		Position = UDim2.fromScale(0.34, 0),
		Size = UDim2.new(0.33, -6, 1, 0),
		TextSize = 20,
		Parent = bar,
		OnClick = function()
			sortIndex = sortIndex % #SORTS + 1
			sortButton.Text = "SORT: " .. string.upper(SORTS[sortIndex])
			refresh(nil)
			grid.CanvasPosition = Vector2.zero
		end,
	})
	UI.button({
		Text = "PLACE BEST",
		Icon = "⭐",
		Color = C.Green,
		Position = UDim2.fromScale(0.67, 0),
		Size = UDim2.new(0.33, 0, 1, 0),
		TextSize = 20,
		Parent = bar,
		OnClick = function()
			Actions.send("PlaceBest")
		end,
	})

	-- Rarity-Filter (horizontal scrollbar)
	local chips = UI.new("ScrollingFrame", {
		Name = "Filter",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 56),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Purple,
		Selectable = false,
		Parent = content,
	})
	UI.list(chips, 6, true)
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), Parent = chips })
	chipButtons.All = UI.button({
		Text = "ALL",
		Color = C.Purple,
		Size = UDim2.fromOffset(80, 48),
		TextSize = 18,
		LayoutOrder = 0,
		Parent = chips,
		OnClick = function()
			setFilter(nil)
		end,
	})
	for _, rarity in RarityConfig.List do
		local button = UI.button({
			Text = rarity.DisplayName,
			Color = C.PanelLight,
			TextColor = rarity.Color,
			StrokeColor = rarity.Color2,
			Size = UDim2.fromOffset(math.max(96, #rarity.DisplayName * 11 + 24), 48),
			TextSize = 17,
			LayoutOrder = rarity.Order,
			Parent = chips,
			OnClick = function()
				setFilter(rarity.Id)
			end,
		})
		chipButtons[rarity.Id] = button
	end

	local holder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 116), Size = UDim2.new(1, 0, 1, -116), Parent = content })
	grid = UI.grid(holder, Vector2.new(120, 150), 8)
	emptyLabel = UI.label({
		Text = "",
		TextColor3 = C.SubText,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0.8, 0, 0, 30),
		MaxTextSize = 22,
		Visible = false,
		Parent = holder,
	})

	watcher = Cards.watch({
		Characters = true,
		Gear = true,
		Derived = Cards.derivedChanged({ "CashMultiplier", "BaseSlots" }),
	}, refresh, 0.25)
end

function Inventory.onOpen(_args: any?)
	watcher.open()
end

function Inventory.onClose()
	watcher.close()
end

return Inventory
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="112">
              <Properties>
                <string name="Name">Items</string>
                <string name="Source"><![CDATA[--!strict
-- Items (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Items
--
-- Tabs: POTIONS (benutzen, Restzeit), GEAR (Stats, ausgerüstet auf, EQUIP mit
-- Character-Auswahl, SELL), RELICS (verkaufen), COSMETICS (nach Art, EQUIP).
-- Nur der sichtbare Tab wird bei Änderungen neu aufgebaut.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors

local Items = {}
Items.Title = "ITEMS"
Items.Icon = "🧪"
Items.Size = Vector2.new(820, 540)

local TABS = { "Potions", "Gear", "Relics", "Cosmetics" }
local MAX_PICKER = 60

local pages: { [string]: Frame } = {}
local scrolls: { [string]: ScrollingFrame } = {}
local currentTab = "Potions"
local selectTab: (string) -> ()
local potionRows: { [string]: { status: TextLabel, button: TextButton } } = {}
local picker: Cards.Popup
local pickerScroll: ScrollingFrame
local pickerGear: string? = nil
local watcher: Cards.Watcher

local function rightButton(row: Frame, text: string, color: Color3, x: number, onClick: () -> ()): TextButton
	return UI.button({
		Text = text,
		Color = color,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -x, 0.5, 0),
		Size = UDim2.fromOffset(110, 50),
		TextSize = 18,
		Parent = row,
		OnClick = onClick,
	})
end

-- Potions --------------------------------------------------------------------------

local function buildPotionRows()
	local scroll = scrolls.Potions
	Cards.paragraph(scroll, "Potions stack their time (max " .. Format.duration(PotionConfig.MaxDuration) .. "). Time only runs while you are online.", 0)
	for i, def in PotionConfig.List do
		local row = Cards.row(scroll, 84, i, def.Color)
		local _, sub = Cards.rowText(row, "🧪 " .. def.DisplayName, def.Description, def.Color, 124)
		sub.Size = UDim2.new(1, -148, 0, 26)
		local status = UI.label({
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 16, 1, -26),
			Size = UDim2.new(1, -148, 0, 20),
			MaxTextSize = 15,
			Parent = row,
		})
		local id = def.Id
		local button = rightButton(row, "USE", C.Green, 10, function()
			Actions.send("UsePotion", id)
		end)
		potionRows[id] = { status = status, button = button }
	end
end

local function refreshPotions()
	local owned = State.data.Potions or {}
	local boosts = State.data.Boosts or {}
	for id, row in potionRows do
		local have = owned[id] or 0
		local left = boosts[id]
		row.status.Text = "Owned: " .. have .. (if left and left > 0 then "  ·  ACTIVE " .. Format.duration(left) else "")
		local maxed = left ~= nil and left >= PotionConfig.MaxDuration - 1
		row.button.Text = if maxed then "MAXED" else "USE"
		UI.setButtonEnabled(row.button, have > 0 and not maxed, C.Green)
	end
end

-- Gear -----------------------------------------------------------------------------

local function openPicker(gearUid: string)
	local item = State.data.Gear and State.data.Gear[gearUid]
	local def = item and GearConfig.Get(item.Id)
	if not def then
		return
	end
	pickerGear = gearUid
	Cards.clear(pickerScroll)
	Cards.paragraph(pickerScroll, Cards.gearStats(def), 0, Cards.gearColor(def))
	local slots = State.derived.GearSlots or GameConfig.StartGearSlots
	for i, entry in State.characterList("Rarity") do
		if i > MAX_PICKER then
			break
		end
		local uid = entry.uid
		local rarity = RarityConfig.Get(entry.def.Rarity)
		local gearCount = #(entry.char.Gear or {})
		local where = if entry.char.Slot then "🏠 In base" elseif entry.char.Fishing then "🎣 Fishing" else "Inventory"
		local row = Cards.row(pickerScroll, 64, i, rarity.Color)
		Cards.rowText(row, entry.def.DisplayName, string.format("%s · Lv %d · Gear %d/%d · %s", rarity.DisplayName, entry.char.Level, gearCount, slots, where), rarity.Color, 124)
		local here = item.On == uid
		local button = rightButton(row, if here then "EQUIPPED" else "EQUIP", C.Blue, 8, function()
			Actions.send("EquipGear", gearUid, uid)
			picker.hide()
		end)
		UI.setButtonEnabled(button, not here and gearCount < slots, C.Blue)
	end
	picker.show("EQUIP " .. def.DisplayName)
	pickerScroll.CanvasPosition = Vector2.zero
end

local function buildGear()
	local scroll = scrolls.Gear
	Cards.clear(scroll)
	local list = {}
	local count = 0
	for uid, item in State.data.Gear or {} do
		local def = GearConfig.Get(item.Id)
		count += 1
		if def then
			table.insert(list, { uid = uid, item = item, def = def, order = Cards.gearOrder(def) })
		end
	end
	table.sort(list, function(a, b)
		if a.order ~= b.order then
			return a.order > b.order
		end
		if a.def.DisplayName ~= b.def.DisplayName then
			return a.def.DisplayName < b.def.DisplayName
		end
		return a.uid < b.uid
	end)
	Cards.header(scroll, string.format("🧰 GEAR %d / %d", count, GameConfig.GearInventoryCap), 0)
	for i, entry in list do
		local def = entry.def
		local color = Cards.gearColor(def)
		local onDef = entry.item.On and State.def(entry.item.On)
		local row = Cards.row(scroll, 84, i, color)
		local _, sub = Cards.rowText(row, def.DisplayName .. "  ·  " .. string.upper(def.Rarity), Cards.gearStats(def) .. "\n" .. (if onDef then "Equipped on " .. onDef.DisplayName else "Not equipped"), color, 240)
		sub.TextColor3 = if onDef then C.Text else C.SubText
		local gearUid = entry.uid
		if entry.item.On then
			rightButton(row, "UNEQUIP", C.PanelLight, 128, function()
				Actions.send("UnequipGear", gearUid)
			end)
		else
			rightButton(row, "EQUIP", C.Blue, 128, function()
				openPicker(gearUid)
			end)
		end
		Cards.confirmButton({
			Text = "SELL",
			ConfirmText = "SURE?",
			Color = C.Red,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(110, 50),
			TextSize = 18,
			Parent = row,
			OnConfirm = function()
				Actions.send("SellGear", gearUid)
			end,
		})
	end
	if #list == 0 then
		Cards.paragraph(scroll, "No gear yet. Gear drops from fishing, quests and the season pass.", 1)
	end
end

-- Relics ---------------------------------------------------------------------------

local function buildRelics()
	local scroll = scrolls.Relics
	Cards.clear(scroll)
	local owned = State.data.Relics or {}
	local found = 0
	for _, def in FishingConfig.Relics do
		if (owned[def.Id] or 0) > 0 then
			found += 1
		end
	end
	Cards.header(scroll, string.format("🗝 RELICS %d / %d", found, #FishingConfig.Relics), 0)
	for i, def in FishingConfig.Relics do
		local have = owned[def.Id] or 0
		local color = RarityConfig.ById[def.Rarity] and RarityConfig.ById[def.Rarity].Color or C.Text
		local row = Cards.row(scroll, 76, i, color)
		local title = if have > 0 then string.format("%s  x%d", def.DisplayName, have) else "??? (" .. string.upper(def.Rarity) .. ")"
		local sub = if have > 0 then def.Description .. "\nSells for ≈" .. Format.cash(Cards.cashEstimate(def.SellSeconds, 100)) else "Not found yet. Keep fishing!"
		Cards.rowText(row, title, sub, if have > 0 then color else C.SubText, 124)
		local id = def.Id
		local button = rightButton(row, "SELL 1", C.Red, 10, function()
			Actions.send("SellRelic", id)
		end)
		UI.setButtonEnabled(button, have > 0, C.Red)
	end
end

-- Cosmetics ------------------------------------------------------------------------

local function buildCosmetics()
	local scroll = scrolls.Cosmetics
	Cards.clear(scroll)
	local cosmetics = State.data.Cosmetics or { Owned = {}, Equipped = {} }
	local order = 0
	for _, kind in CosmeticConfig.Kinds do
		local owned, missing = {}, 0
		for _, def in CosmeticConfig.List do
			if def.Kind == kind then
				if cosmetics.Owned[def.Id] then
					table.insert(owned, def)
				else
					missing += 1
				end
			end
		end
		order += 1
		Cards.header(scroll, string.upper(kind) .. (if missing > 0 then string.format("  (%d more to find)", missing) else ""), order, C.Purple)
		for _, def in owned do
			order += 1
			local equipped = cosmetics.Equipped[kind] == def.Id
			local color = def.Color or (def.Colors and def.Colors[1]) or C.Text
			local row = Cards.row(scroll, 64, order, color)
			Cards.rowText(row, def.DisplayName, "From: " .. def.Source, color, 124)
			local id = def.Id
			local button = rightButton(row, if equipped then "EQUIPPED" else "EQUIP", C.Blue, 10, function()
				Actions.send("EquipCosmetic", kind, id)
			end)
			UI.setButtonEnabled(button, not equipped, C.Blue)
		end
		if #owned == 0 then
			order += 1
			Cards.paragraph(scroll, "None yet.", order)
		end
	end
end

local BUILDERS: { [string]: () -> () } = { Potions = refreshPotions, Gear = buildGear, Relics = buildRelics, Cosmetics = buildCosmetics }
local DEPENDS: { [string]: { [string]: boolean } } = {
	Potions = { Potions = true, Boosts = true },
	Gear = { Gear = true, Derived = true },
	Relics = { Relics = true },
	Cosmetics = { Cosmetics = true },
}

local function refresh(changed: { [string]: boolean }?)
	if changed then
		local relevant = false
		for key in changed do
			if DEPENDS[currentTab][key] then
				relevant = true
			end
		end
		if not relevant then
			return
		end
	end
	local scroll = scrolls[currentTab]
	local y = scroll.CanvasPosition
	BUILDERS[currentTab]()
	scroll.CanvasPosition = y
	if picker.Frame.Visible and pickerGear and changed and changed.Gear then
		picker.hide()
	end
end

function Items.build(content: Frame)
	for _, tab in TABS do
		local page = Cards.page(content, tab)
		pages[tab] = page
		scrolls[tab] = UI.scrollList(page, 6)
	end
	local _, select = UI.tabs(content, TABS, function(name: string)
		currentTab = name
		for tab, page in pages do
			page.Visible = tab == name
		end
		if watcher and watcher.isVisible() then
			refresh(nil)
		end
	end)
	selectTab = select
	buildPotionRows()

	picker = Cards.popup(content)
	pickerScroll = UI.scrollList(picker.Body, 6)

	watcher = Cards.watch({
		Potions = true,
		Boosts = true,
		Gear = true,
		Relics = true,
		Cosmetics = true,
		Derived = Cards.derivedChanged({ "GearSlots" }),
	}, refresh, 0.2)
end

function Items.onOpen(args: any?)
	local tab = currentTab
	if type(args) == "table" and type(args.Tab) == "string" then
		for _, name in TABS do
			if string.lower(name) == string.lower(args.Tab) then
				tab = name
			end
		end
	end
	picker.hide()
	selectTab(tab)
	watcher.open()
end

function Items.onClose()
	picker.hide()
	watcher.close()
end

return Items
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="113">
              <Properties>
                <string name="Name">Map</string>
                <string name="Source"><![CDATA[--!strict
-- Map (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Map
--
-- Teleports (Base, Hub, freigeschaltete Gebiete) und Freischalten neuer
-- Gebiete (Rebirth-Voraussetzung + Cash, vorheriges Gebiet nötig). Zeigt pro
-- Gebiet die Tagline, die Dice und das Fishing-Gewässer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local FishingConfig = require(Config:WaitForChild("FishingConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors

local Map = {}
Map.Title = "MAP"
Map.Icon = "🗺"
Map.Size = Vector2.new(800, 540)

type AreaRow = { status: TextLabel, button: TextButton }
local areaRows: { [string]: AreaRow } = {}
local watcher: Cards.Watcher

local function teleport(target: string)
	Actions.send("Teleport", target)
	Cards.close() -- nach dem Teleport freie Sicht auf das Ziel
end

local function previousArea(def: any): any?
	for _, other in AreaConfig.List do
		if other.Order == def.Order - 1 then
			return other
		end
	end
	return nil
end

local function refresh(_changed: { [string]: boolean }?)
	local areas = State.data.Areas or {}
	local rebirths = State.data.Rebirths or 0
	local cash = State.data.Cash or 0
	for _, def in AreaConfig.List do
		local row = areaRows[def.Id]
		if row then
			local prev = previousArea(def)
			if areas[def.Id] then
				row.status.Text = "✓ Unlocked"
				row.status.TextColor3 = C.Green
				row.button.Text = "TELEPORT"
				UI.setButtonEnabled(row.button, true, C.Blue)
			else
				local needs = {}
				if prev and not areas[prev.Id] then
					table.insert(needs, "Unlock " .. prev.DisplayName .. " first")
				end
				table.insert(needs, (if rebirths >= def.RequiredRebirths then "✓ " else "") .. "Rebirth " .. def.RequiredRebirths)
				table.insert(needs, Format.cash(def.UnlockCost))
				row.status.Text = "🔒 " .. table.concat(needs, " · ")
				row.status.TextColor3 = C.Gold
				local ready = (not prev or areas[prev.Id] == true) and rebirths >= def.RequiredRebirths
				row.button.Text = if ready then "UNLOCK\n" .. Format.cash(def.UnlockCost) else "🔒 LOCKED"
				UI.setButtonEnabled(row.button, ready and cash >= def.UnlockCost, C.Green)
			end
		end
	end
end

local function simpleRow(scroll: ScrollingFrame, order: number, title: string, sub: string, target: string)
	local row = Cards.row(scroll, 64, order, C.Blue)
	Cards.rowText(row, title, sub, C.Text, 140)
	UI.button({
		Text = "TELEPORT",
		Color = C.Blue,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(128, 50),
		TextSize = 18,
		Parent = row,
		OnClick = function()
			teleport(target)
		end,
	})
end

function Map.build(content: Frame)
	local scroll = UI.scrollList(content, 8)
	simpleRow(scroll, 1, "🏠 MY BASE", "Your plot with your characters and Rift Pond.", "Base")
	simpleRow(scroll, 2, "🏙 TOWN HUB", "Shop, Rift Machine, Case Archive, Notice Board and Bait Shop.", "Hub")
	Cards.header(scroll, "AREAS", 3)

	for _, def in AreaConfig.List do
		local row = Cards.row(scroll, 112, 10 + def.Order, def.PrimaryColor)
		local dice = {}
		for _, d in DiceConfig.List do
			if d.Area == def.Id then
				table.insert(dice, "🎲 " .. d.DisplayName)
			end
		end
		local waters = FishingConfig.WatersByArea[def.Id]
		if waters then
			table.insert(dice, "🎣 " .. waters.DisplayName)
		end
		local _, sub = Cards.rowText(row, def.DisplayName, def.Tagline .. "\n" .. table.concat(dice, " · "), def.PrimaryColor, 150)
		sub.Size = UDim2.new(1, -174, 0, 48)
		local status = UI.label({
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 16, 1, -28),
			Size = UDim2.new(1, -174, 0, 22),
			MaxTextSize = 15,
			Parent = row,
		})
		local id = def.Id
		local button = UI.button({
			Text = "",
			Color = C.Blue,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(138, 56),
			TextSize = 18,
			Parent = row,
			OnClick = function()
				if State.data.Areas and State.data.Areas[id] then
					teleport(id)
				else
					Actions.send("UnlockArea", id)
				end
			end,
		})
		areaRows[id] = { status = status, button = button }
	end
	Cards.paragraph(scroll, "Unlocked areas stay unlocked forever (also after Rebirth).", 99)

	watcher = Cards.watch({ Areas = true, Rebirths = true, Cash = true }, refresh, 0.2)
end

function Map.onOpen(_args: any?)
	watcher.open()
end

function Map.onClose()
	watcher.close()
end

return Map
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="114">
              <Properties>
                <string name="Name">Quests</string>
                <string name="Source"><![CDATA[--!strict
-- Quests (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Quests
--
-- Tabs: DAILY (Fortschritt + CLAIM, Reset-Countdown bis UTC-Mitternacht),
-- ACHIEVEMENTS (alle, mit Status und Belohnung), SEASON (XP-Balken, Free- und
-- Premium-Track mit CLAIM; Premium nur mit Pass "SeasonPremium").

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local QuestConfig = require(Config:WaitForChild("QuestConfig"))
local AchievementConfig = require(Config:WaitForChild("AchievementConfig"))
local SeasonConfig = require(Config:WaitForChild("SeasonConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors
local F = UI.Fonts

local Quests = {}
Quests.Title = "QUESTS"
Quests.Icon = "📜"
Quests.Size = Vector2.new(820, 540)

local TABS = { "Daily", "Achievements", "Season" }

local pages: { [string]: Frame } = {}
local scrolls: { [string]: ScrollingFrame } = {}
local currentTab = "Daily"
local selectTab: (string) -> ()
local resetLabel: TextLabel
local watcher: Cards.Watcher
local timerToken = 0

local function secondsToReset(): number
	local now = os.time()
	return 86400 - (now % 86400)
end

local function claimButton(row: Frame, text: string, enabled: boolean, color: Color3, onClick: () -> ()): TextButton
	local button = UI.button({
		Text = text,
		Color = color,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(120, 50),
		TextSize = 20,
		Parent = row,
		OnClick = onClick,
	})
	UI.setButtonEnabled(button, enabled, color)
	return button
end

local function buildDaily()
	local scroll = scrolls.Daily
	Cards.clear(scroll)
	resetLabel = Cards.header(scroll, "", 0, C.SubText)
	resetLabel.Text = "⏰ New quests in " .. Format.duration(secondsToReset())
	local list = (State.data.Quests and State.data.Quests.List) or {}
	for i, q in list do
		local def = QuestConfig.ById[q.Id]
		if def then
			local done = q.Progress >= def.Target
			local row = Cards.row(scroll, 98, i, if q.Claimed then C.Disabled elseif done then C.Green else C.Blue)
			Cards.rowText(row, def.Text, nil, if q.Claimed then C.SubText else C.Text, 140)
			local _, setBar = UI.progress({
				Position = UDim2.fromOffset(16, 34),
				Size = UDim2.new(1, -164, 0, 20),
				Color = if done then C.Green else C.Blue,
				Parent = row,
			})
			setBar(q.Progress / def.Target, Format.commas(math.min(q.Progress, def.Target)) .. " / " .. Format.commas(def.Target))
			UI.label({
				Text = "🎁 " .. Cards.rewardText(def.Rewards),
				TextColor3 = C.Gold,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(16, 60),
				Size = UDim2.new(1, -164, 0, 32),
				MaxTextSize = 15,
				Parent = row,
			})
			local id = q.Id
			claimButton(row, if q.Claimed then "✓ DONE" else "CLAIM", done and not q.Claimed, C.Green, function()
				Actions.send("ClaimQuest", id)
			end)
		end
	end
	if #list == 0 then
		Cards.paragraph(scroll, "No quests today. Check back soon!", 1)
	end
end

local function buildAchievements()
	local scroll = scrolls.Achievements
	Cards.clear(scroll)
	local unlocked = State.data.Achievements or {}
	local count = 0
	for _, def in AchievementConfig.List do
		if unlocked[def.Id] then
			count += 1
		end
	end
	Cards.header(scroll, string.format("🏆 UNLOCKED %d / %d", count, #AchievementConfig.List), 0)
	for i, def in AchievementConfig.List do
		local done = unlocked[def.Id] ~= nil
		local row = Cards.row(scroll, 76, i, if done then C.Gold else C.Disabled)
		local _, sub = Cards.rowText(row, (if done then "🏆 " else "🔒 ") .. def.DisplayName, def.Description .. "\n🎁 " .. Cards.rewardText(def.Rewards), if done then C.Gold else C.Text, 110)
		sub.TextColor3 = if done then C.SubText else C.SubText:Lerp(C.Background, 0.2)
		UI.label({
			Text = if done then "✓ UNLOCKED" else "LOCKED",
			Font = F.Title,
			TextColor3 = if done then C.Green else C.SubText,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(100, 24),
			MaxTextSize = 17,
			Parent = row,
		})
	end
end

local function buildSeason()
	local scroll = scrolls.Season
	Cards.clear(scroll)
	local season = State.data.Season or { Xp = 0, Free = {}, Premium = {} }
	local premium = State.data.Passes and State.data.Passes.SeasonPremium == true
	local maxTier = #SeasonConfig.Tiers
	local tier = math.min(maxTier, math.floor(season.Xp / SeasonConfig.XpPerTier))

	Cards.header(scroll, "🎟 " .. SeasonConfig.DisplayName, 0, C.Red)
	local _, setXp = UI.progress({ Size = UDim2.new(1, -16, 0, 24), Color = C.Purple, LayoutOrder = 1, Parent = scroll })
	if tier >= maxTier then
		setXp(1, string.format("TIER %d / %d · MAX", tier, maxTier))
	else
		local into = season.Xp - tier * SeasonConfig.XpPerTier
		setXp(into / SeasonConfig.XpPerTier, string.format("TIER %d / %d · %d / %d XP", tier, maxTier, into, SeasonConfig.XpPerTier))
	end
	Cards.paragraph(scroll, "Earn Season XP from daily quests. Premium rewards are cosmetics, potions, gear and cash – never characters.", 2)
	if not premium then
		UI.button({
			Text = "UNLOCK PREMIUM TRACK",
			Icon = "⭐",
			Color = C.Gold:Lerp(Color3.new(0, 0, 0), 0.3),
			Size = UDim2.new(1, -16, 0, 50),
			LayoutOrder = 3,
			Parent = scroll,
			OnClick = function()
				Cards.open("Shop", { Tab = "Passes", Highlight = "SeasonPremium" })
			end,
		})
	end

	for i, rewards in SeasonConfig.Tiers do
		local reached = tier >= i
		local row = Cards.row(scroll, 92, 10 + i, if reached then C.Purple else C.Disabled)
		UI.label({
			Text = "TIER\n" .. i,
			Font = F.Title,
			TextColor3 = if reached then C.Text else C.SubText,
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.new(0, 50, 1, -16),
			MaxTextSize = 20,
			Parent = row,
		})
		for t, track in { "Free", "Premium" } do
			local half = UI.new("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.new((t - 1) * 0.5, if t == 1 then 66 else 36, 0, 6),
				Size = UDim2.new(0.5, if t == 1 then -72 else -42, 1, -12),
				Parent = row,
			})
			local reward = rewards[track]
			UI.label({
				Text = (if track == "Free" then "FREE: " else "⭐ PREMIUM: ") .. Cards.seasonRewardText(reward),
				TextColor3 = if track == "Free" then C.Text else C.Gold,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, 0, 0, 26),
				MaxTextSize = 15,
				Parent = half,
			})
			local claimed = (season[track] or {})[tostring(i)] == true
			local locked = track == "Premium" and not premium
			local text = if claimed then "✓ CLAIMED" elseif locked then "🔒 PREMIUM" elseif reached then "CLAIM" else "TIER " .. i
			local button = UI.button({
				Text = text,
				Color = C.Green,
				Position = UDim2.fromOffset(0, 28),
				Size = UDim2.new(1, 0, 0, 48),
				TextSize = 18,
				Parent = half,
				OnClick = function()
					Actions.send("ClaimSeason", track, i)
				end,
			})
			UI.setButtonEnabled(button, reached and not claimed and not locked, C.Green)
		end
	end
end

local BUILDERS: { [string]: () -> () } = {
	Daily = buildDaily,
	Achievements = buildAchievements,
	Season = buildSeason,
}

local DEPENDS: { [string]: { [string]: boolean } } = {
	Daily = { Quests = true },
	Achievements = { Achievements = true },
	Season = { Season = true, Passes = true },
}

local function refresh(changed: { [string]: boolean }?)
	if changed then
		local relevant = false
		for key in changed do
			if DEPENDS[currentTab][key] then
				relevant = true
			end
		end
		if not relevant then
			return
		end
	end
	local y = scrolls[currentTab].CanvasPosition
	BUILDERS[currentTab]()
	scrolls[currentTab].CanvasPosition = y
end

function Quests.build(content: Frame)
	for _, tab in TABS do
		local page = Cards.page(content, tab)
		pages[tab] = page
		scrolls[tab] = UI.scrollList(page, 8)
	end
	local _, select = UI.tabs(content, TABS, function(name: string)
		currentTab = name
		for tab, page in pages do
			page.Visible = tab == name
		end
		if watcher and watcher.isVisible() then
			refresh(nil)
		end
	end)
	selectTab = select
	watcher = Cards.watch({ Quests = true, Achievements = true, Season = true, Passes = true }, refresh, 0.2)
end

function Quests.onOpen(args: any?)
	local tab = currentTab
	if type(args) == "table" and type(args.Tab) == "string" then
		for _, name in TABS do
			if string.lower(name) == string.lower(args.Tab) then
				tab = name
			end
		end
	end
	selectTab(tab)
	watcher.open()
	-- Countdown jede Sekunde (nur solange offen)
	timerToken += 1
	local token = timerToken
	task.spawn(function()
		while token == timerToken and watcher.isVisible() do
			if resetLabel and resetLabel.Parent then
				resetLabel.Text = "⏰ New quests in " .. Format.duration(secondsToReset())
			end
			task.wait(1)
		end
	end)
end

function Quests.onClose()
	timerToken += 1
	watcher.close()
end

return Quests
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="115">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[--!strict
-- Rebirth (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Rebirth
--
-- Zeigt aktuellen Rebirth, Kosten vs. Cash, was zurückgesetzt wird und was
-- bleibt, die Belohnungen des nächsten Rebirths (inkl. neu freischaltbarer
-- Gebiete), die aktuellen Gesamt-Boni und eine Vorschau der nächsten 3 Stufen.
-- REBIRTH braucht einen zweiten Tap zur Bestätigung.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local RebirthConfig = require(Config:WaitForChild("RebirthConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors
local F = UI.Fonts

local Rebirth = {}
Rebirth.Title = "REBIRTH"
Rebirth.Icon = "♻"
Rebirth.Size = Vector2.new(780, 560)

local scroll: ScrollingFrame
local titleLabel: TextLabel
local setProgress: (number, string?) -> ()
local rebirthButton: TextButton
local setButtonText: (string) -> ()
local watcher: Cards.Watcher
local builtFor = -1

local function titleName(id: string): string
	local def = CosmeticConfig.Get(id)
	return if def then def.DisplayName else id
end

-- Belohnungen einer Stufe als Textzeilen
local function rewardLines(r: { [string]: any }): { string }
	local lines = {}
	if r.CashPct then
		table.insert(lines, string.format("💰 +%g%% Cash (permanent)", r.CashPct))
	end
	if r.LuckPct then
		table.insert(lines, string.format("🍀 +%g%% Luck (permanent)", r.LuckPct))
	end
	if r.BaseSlots then
		table.insert(lines, string.format("🏠 +%d Base Slots", r.BaseSlots))
	end
	if r.FishingSlots then
		table.insert(lines, string.format("🎣 +%d Fishing Spot", r.FishingSlots))
	end
	if r.GearSlots then
		table.insert(lines, string.format("🧰 +%d Gear Slot per character", r.GearSlots))
	end
	if r.AutoCollect then
		table.insert(lines, "🤖 Auto Collect (no more vault trips)")
	end
	if r.Title then
		table.insert(lines, "🏷 Title: " .. titleName(r.Title))
	end
	return lines
end

local function bulletList(lines: { string }, order: number, color: Color3?): number
	for _, text in lines do
		order += 1
		local label = Cards.paragraph(scroll, "  " .. text, order, color or C.Text)
		label.TextSize = 16
	end
	return order
end

local function rebuild()
	Cards.clear(scroll)
	local rebirths = State.data.Rebirths or 0
	local nextN = rebirths + 1
	local step = RebirthConfig.GetStep(nextN)
	local order = 0

	order += 1
	Cards.header(scroll, string.format("🎁 REBIRTH %d REWARDS", nextN), order, C.Green)
	order = bulletList(rewardLines(step.Rewards), order, C.Text)
	for _, area in AreaConfig.List do
		if area.RequiredRebirths == nextN then
			order += 1
			Cards.paragraph(scroll, string.format("  🗺 Unlocks access to %s (%s to open)", area.DisplayName, Format.cash(area.UnlockCost)), order, area.PrimaryColor)
		end
	end

	order += 1
	Cards.header(scroll, "⚠ RESETS", order, C.Red)
	order = bulletList({ "Cash and Vault → $0", "Character levels → Lv 1" }, order, C.Red:Lerp(Color3.new(1, 1, 1), 0.35))

	order += 1
	Cards.header(scroll, "✔ YOU KEEP", order, C.Green)
	order = bulletList({
		"All characters and their mutations",
		"Gear, potions and relics",
		"Dice and unlocked areas",
		"Index, cosmetics and titles",
		"All purchases and passes",
	}, order, C.SubText)

	local total = RebirthConfig.Accumulate(rebirths)
	order += 1
	Cards.header(scroll, string.format("📈 YOUR BONUSES NOW (REBIRTH %d)", rebirths), order, C.Luck)
	local now = {
		string.format("+%g%% Cash · +%g%% Luck", total.CashPct, total.LuckPct),
		string.format("+%d Base Slots · +%d Fishing Spots · +%d Gear Slots", total.BaseSlots, total.FishingSlots, total.GearSlots),
		"Auto Collect: " .. (if total.AutoCollect then "ON" else "not yet"),
	}
	if #total.Titles > 0 then
		local names = {}
		for _, id in total.Titles do
			table.insert(names, titleName(id))
		end
		table.insert(now, "Titles: " .. table.concat(names, ", "))
	end
	order = bulletList(now, order, C.Text)

	order += 1
	Cards.header(scroll, "🔮 COMING UP", order, C.Purple)
	for n = nextN + 1, nextN + 3 do
		local s = RebirthConfig.GetStep(n)
		local row = Cards.row(scroll, 64, order + n, C.Purple)
		Cards.rowText(row, string.format("REBIRTH %d · %s", n, Format.cash(s.Cost)), table.concat(rewardLines(s.Rewards), " · "), C.Text)
	end
	builtFor = rebirths
end

local function refresh(_changed: { [string]: boolean }?)
	local rebirths = State.data.Rebirths or 0
	if rebirths ~= builtFor then
		rebuild()
	end
	local cost = State.derived.RebirthCost or RebirthConfig.GetStep(rebirths + 1).Cost
	local cash = State.data.Cash or 0
	local ready = cash >= cost
	titleLabel.Text = string.format("♻ REBIRTH %d  →  %d", rebirths, rebirths + 1)
	setProgress(cash / math.max(1, cost), if ready then "READY! " .. Format.cash(cash) .. " / " .. Format.cash(cost) else Format.cash(cash) .. " / " .. Format.cash(cost))
	setButtonText(if ready then "♻ REBIRTH NOW" else "NEED " .. Format.cash(cost - cash) .. " MORE")
	UI.setButtonEnabled(rebirthButton, ready, C.Red)
end

function Rebirth.build(content: Frame)
	titleLabel = UI.label({ Font = F.Title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 28, Parent = content })
	local _, setter = UI.progress({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 24), Color = C.Purple, Parent = content })
	setProgress = setter

	local holder = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, 0, 1, -128), Parent = content })
	scroll = UI.scrollList(holder, 4)

	local button, setText = Cards.confirmButton({
		Text = "REBIRTH",
		ConfirmText = "TAP AGAIN: RESET CASH & LEVELS",
		Color = C.Red,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 0, 58),
		TextSize = 28,
		Parent = content,
		OnConfirm = function()
			Actions.send("Rebirth")
		end,
	})
	rebirthButton = button
	setButtonText = setText

	watcher = Cards.watch({ Rebirths = true, Cash = true, Derived = Cards.derivedChanged({ "RebirthCost" }) }, refresh, 0.15)
end

function Rebirth.onOpen(_args: any?)
	watcher.open()
end

function Rebirth.onClose()
	watcher.close()
end

return Rebirth
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="116">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--!strict
-- Settings (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Settings
--
-- Schalter (SetSetting), Auto Delete bis Epic (SetAutoDelete), Sell All pro
-- Rarity (SellRarity, mit Bestätigung), Tutorial und – nur in Studio – ein
-- Debug-Bereich (Action "Debug"). Hinweis, wenn Studio ohne DataStore läuft.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))

local C = UI.Colors

local Settings = {}
Settings.Title = "SETTINGS"
Settings.Icon = "⚙"
Settings.Size = Vector2.new(780, 540)

local TOGGLES = {
	{ Key = "AutoPlace", Name = "AUTO PLACE", Text = "New characters replace the weakest one in your base if they earn more." },
	{ Key = "Music", Name = "MUSIC", Text = "Background music and ambience." },
	{ Key = "SFX", Name = "SOUND EFFECTS", Text = "Rolls, reveals, buttons." },
	{ Key = "ReducedEffects", Name = "REDUCED EFFECTS", Text = "Less flashing, shaking and particles." },
	{ Key = "ShowOthersReveals", Name = "OTHERS' BIG REVEALS", Text = "Show big reveals of other players on the server." },
}
local AUTO_DELETE = { "Common", "Uncommon", "Rare", "Epic" }
local SELL_RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

local toggleButtons: { [string]: TextButton } = {}
local autoDeleteButtons: { [string]: TextButton } = {}
local sellButtons: { [string]: { button: TextButton, setText: (string) -> () } } = {}
local ui: { [string]: any } = {}
local watcher: Cards.Watcher

local function setToggle(button: TextButton, on: boolean, onText: string?, offText: string?)
	button.Text = if on then (onText or "ON") else (offText or "OFF")
	button.BackgroundColor3 = if on then C.Green else C.Disabled
end

local function toggleRow(scroll: ScrollingFrame, order: number, title: string, sub: string, color: Color3?, onClick: () -> ()): TextButton
	local row = Cards.row(scroll, 70, order, color)
	Cards.rowText(row, title, sub, color or C.Text, 120)
	return UI.button({
		Text = "",
		Color = C.Disabled,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(108, 50),
		TextSize = 20,
		Parent = row,
		OnClick = onClick,
	})
end

-- Wie viele Characters würde SellRarity verkaufen? (gleiche Regeln wie der Server)
local function sellableCount(rarityId: string): number
	local n = 0
	for _, char in State.data.Characters or {} do
		local def = CharacterConfig.ById[char.Id]
		if def and def.Rarity == rarityId and not char.Locked and not char.Slot and not char.Fishing and char.Mutation == MutationConfig.None then
			n += 1
		end
	end
	return n
end

local function refresh(_changed: { [string]: boolean }?)
	local settings = State.data.Settings or {}
	for key, button in toggleButtons do
		setToggle(button, settings[key] == true)
	end
	local autoDelete = settings.AutoDelete or {}
	for id, button in autoDeleteButtons do
		local on = autoDelete[id] == true
		setToggle(button, on, "DELETE", "KEEP")
		button.BackgroundColor3 = if on then C.Red else C.Disabled
	end
	for id, entry in sellButtons do
		local n = sellableCount(id)
		entry.setText(if n > 0 then "SELL " .. n else "NONE")
		UI.setButtonEnabled(entry.button, n > 0, C.Red)
	end
	local tutorial = State.data.Tutorial or {}
	UI.setButtonEnabled(ui.skip, tutorial.Done ~= true, C.PanelLight)
	ui.memory.Visible = State.session.MemoryMode == true
	ui.debugHeader.Visible = State.session.IsStudio == true
	ui.debugGrid.Visible = State.session.IsStudio == true
end

function Settings.build(content: Frame)
	local scroll = UI.scrollList(content, 8)
	ui.memory = Cards.paragraph(scroll, "⚠ STUDIO: data is NOT saved – enable API access (Game Settings > Security) to test saving.", 0, C.Red)
	ui.memory.Visible = false

	Cards.header(scroll, "GAMEPLAY & SOUND", 1)
	for i, t in TOGGLES do
		local key = t.Key
		toggleButtons[key] = toggleRow(scroll, 1 + i, t.Name, t.Text, nil, function()
			local settings = State.data.Settings or {}
			Actions.send("SetSetting", key, not (settings[key] == true))
		end)
	end

	Cards.header(scroll, "AUTO DELETE", 20, C.Red)
	Cards.paragraph(scroll, "Rolled characters of these rarities are sold instantly. New discoveries and mutated characters are ALWAYS kept. Only up to Epic.", 21, C.Gold)
	for i, id in AUTO_DELETE do
		local rarity = RarityConfig.Get(id)
		autoDeleteButtons[id] = toggleRow(scroll, 21 + i, rarity.DisplayName, "Auto delete new " .. rarity.DisplayName .. " rolls", rarity.Color, function()
			local auto = (State.data.Settings and State.data.Settings.AutoDelete) or {}
			Actions.send("SetAutoDelete", id, not (auto[id] == true))
		end)
	end

	Cards.header(scroll, "SELL ALL", 40, C.Red)
	Cards.paragraph(scroll, "Sells every character of a rarity. Locked, placed, fishing and mutated characters are kept.", 41)
	for i, id in SELL_RARITIES do
		local rarity = RarityConfig.Get(id)
		local row = Cards.row(scroll, 70, 41 + i, rarity.Color)
		Cards.rowText(row, "SELL ALL " .. rarity.DisplayName, "Tap twice to confirm.", rarity.Color, 150)
		local button, setText = Cards.confirmButton({
			Text = "SELL",
			ConfirmText = "CONFIRM?",
			Color = C.Red,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(138, 50),
			TextSize = 20,
			Parent = row,
			OnConfirm = function()
				Actions.send("SellRarity", id)
			end,
		})
		sellButtons[id] = { button = button, setText = setText }
	end

	Cards.header(scroll, "TUTORIAL", 60)
	local tutorialRow = Cards.row(scroll, 70, 61)
	Cards.rowText(tutorialRow, "TUTORIAL", "Replay the tips or skip them.", nil, 240)
	UI.button({
		Text = "REPLAY",
		Color = C.Blue,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -128, 0.5, 0),
		Size = UDim2.fromOffset(108, 50),
		TextSize = 18,
		Parent = tutorialRow,
		OnClick = function()
			-- lokal: der Tutorial-Controller zeigt die Tipps erneut
			Actions.send("ReplayTutorial")
			Cards.close()
		end,
	})
	ui.skip = UI.button({
		Text = "SKIP",
		Color = C.PanelLight,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(108, 50),
		TextSize = 18,
		Parent = tutorialRow,
		OnClick = function()
			Actions.send("SkipTutorial")
		end,
	})

	-- Debug (nur Studio)
	ui.debugHeader = Cards.header(scroll, "🛠 DEBUG (STUDIO ONLY)", 80, C.CRTGreen)
	local debugGrid = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 81, Parent = scroll })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 50), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = debugGrid })
	ui.debugGrid = debugGrid
	local commands = {
		{ "+$1M", "Cash", 1e6 },
		{ "+$1B", "Cash", 1e9 },
		{ "REBIRTH READY", "RebirthReady", nil },
		{ "+5 ALL POTIONS", "Potions", nil },
		{ "+ALL GEAR", "Gear", nil },
		{ "UNLOCK ALL", "UnlockAll", nil },
		{ "ROLL x1000", "Roll", 1000 },
	}
	for i, cmd in commands do
		UI.button({
			Text = cmd[1],
			Color = Color3.fromRGB(20, 90, 50),
			TextSize = 18,
			LayoutOrder = i,
			Parent = debugGrid,
			OnClick = function()
				Actions.send("Debug", cmd[2], cmd[3])
			end,
		})
	end
	Cards.confirmButton({
		Text = "RESET PROFILE",
		ConfirmText = "REALLY RESET?",
		Color = C.Red,
		TextSize = 18,
		LayoutOrder = 99,
		Parent = debugGrid,
		OnConfirm = function()
			Actions.send("Debug", "Reset", nil)
		end,
	})

	watcher = Cards.watch({ Settings = true, Session = true, Tutorial = true, Characters = true }, refresh, 0.3)
end

function Settings.onOpen(_args: any?)
	watcher.open()
end

function Settings.onClose()
	watcher.close()
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="117">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[--!strict
-- Shop (Fenster)
-- Ort: StarterPlayerScripts > VoidDiceClient > Controllers > Windows > Shop
--
-- Tabs: DICE (Cash), PASSES (Gamepasses), PRODUCTS (Developer Products).
-- Keine Zufallsinhalte für Robux – jede Zeile zeigt genau, was man bekommt.
-- Ids = 0: "COMING SOON", in Studio optional Testkauf über Action TestPurchase.
-- args: { Tab = "Dice" | "Passes" | "Products", Highlight = Id/Name }

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local AreaConfig = require(Config:WaitForChild("AreaConfig"))
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Client = script.Parent.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Actions = require(Client:WaitForChild("Actions"))
local UI = require(Client:WaitForChild("UI"):WaitForChild("Components"))
local Cards = require(Client:WaitForChild("UI"):WaitForChild("Cards"))
local Root = require(Client:WaitForChild("UI"):WaitForChild("Root"))

local C = UI.Colors

local Shop = {}
Shop.Title = "SHOP"
Shop.Icon = "🛒"
Shop.Size = Vector2.new(820, 540)

local TABS = { "Dice", "Passes", "Products" }
local HONEST_NOTE = "No random items for Robux. Every purchase shows exactly what you get."

local pages: { [string]: Frame } = {}
local scrolls: { [string]: ScrollingFrame } = {}
local rows: { [string]: { [string]: Frame } } = { Dice = {}, Passes = {}, Products = {} }
local diceButtons: { [string]: TextButton } = {}
local diceStatus: { [string]: TextLabel } = {}
local passButtons: { [string]: TextButton } = {}
local productButtons: { [string]: TextButton } = {}
local currentTab = "Dice"
local selectTab: (string) -> ()
local watcher: Cards.Watcher

local function sortedNames(map: { [string]: any }): { string }
	local names = {}
	for name in map do
		table.insert(names, name)
	end
	table.sort(names, function(a, b)
		if map[a].PriceHint ~= map[b].PriceHint then
			return map[a].PriceHint < map[b].PriceHint
		end
		return a < b
	end)
	return names
end

local function canTest(): boolean
	return State.session.IsStudio == true and MonetizationConfig.StudioTestPurchases == true
end

-- Robux-Button setzen (Pass oder Produkt)
local function setRobuxButton(button: TextButton, def: any, owned: boolean)
	if owned then
		button.Text = "✓ OWNED"
		UI.setButtonEnabled(button, false)
	elseif def.Id ~= 0 then
		button.Text = "R$ " .. def.PriceHint
		UI.setButtonEnabled(button, true, C.Green)
	elseif canTest() then
		button.Text = "TEST (STUDIO)"
		UI.setButtonEnabled(button, true, C.Gold:Lerp(Color3.new(0, 0, 0), 0.3))
	else
		button.Text = "COMING SOON"
		UI.setButtonEnabled(button, false)
	end
end

local function buy(kind: string, name: string, def: any)
	if kind == "Pass" and State.data.Passes and State.data.Passes[name] then
		return
	end
	if def.Id ~= 0 then
		if kind == "Pass" then
			MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, def.Id)
		else
			MarketplaceService:PromptProductPurchase(Players.LocalPlayer, def.Id)
		end
	elseif canTest() then
		Actions.send("TestPurchase", kind, name)
	end
end

local function refresh(_changed: { [string]: boolean }?)
	local dice = State.data.Dice or { Owned = {}, Equipped = DiceConfig.Default }
	local areas = State.data.Areas or {}
	local cash = State.data.Cash or 0
	for _, def in DiceConfig.List do
		local button = diceButtons[def.Id]
		local status = diceStatus[def.Id]
		local area = AreaConfig.Get(def.Area)
		local areaName = if area then area.DisplayName else def.Area
		if dice.Equipped == def.Id then
			button.Text = "EQUIPPED"
			UI.setButtonEnabled(button, false)
			status.Text = "✓ Owned"
		elseif dice.Owned[def.Id] then
			button.Text = "EQUIP"
			UI.setButtonEnabled(button, true, C.Blue)
			status.Text = "✓ Owned"
		elseif not areas[def.Area] then
			button.Text = "🔒 LOCKED"
			UI.setButtonEnabled(button, false)
			status.Text = "Unlock " .. areaName .. " first · " .. Format.cash(def.Cost)
		else
			button.Text = "BUY " .. Format.cash(def.Cost)
			UI.setButtonEnabled(button, cash >= def.Cost, C.Green)
			status.Text = "Found in " .. areaName
		end
	end
	local passes = State.data.Passes or {}
	for name, button in passButtons do
		setRobuxButton(button, MonetizationConfig.Gamepasses[name], passes[name] == true)
	end
	for name, button in productButtons do
		setRobuxButton(button, MonetizationConfig.Products[name], false)
	end
end

local function itemRow(parent: Instance, order: number, title: string, sub: string, color: Color3, onClick: () -> ()): (Frame, TextButton, TextLabel)
	local row = Cards.row(parent, 96, order, color)
	local _, subLabel = Cards.rowText(row, title, sub, color, 146)
	subLabel.Size = UDim2.new(1, -170, 0, 40)
	local status = UI.label({
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 16, 1, -24),
		Size = UDim2.new(1, -170, 0, 18),
		MaxTextSize = 15,
		Parent = row,
	})
	local button = UI.button({
		Text = "",
		Color = C.Green,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(136, 54),
		TextSize = 20,
		Parent = row,
		OnClick = onClick,
	})
	return row, button, status
end

function Shop.build(content: Frame)
	local _, select = UI.tabs(content, TABS, function(name: string)
		currentTab = name
		for tab, page in pages do
			page.Visible = tab == name
		end
	end)
	selectTab = select
	for _, tab in TABS do
		local page = Cards.page(content, tab)
		pages[tab] = page
		scrolls[tab] = UI.scrollList(page, 8)
	end

	-- Dice
	local diceScroll = scrolls.Dice
	Cards.paragraph(diceScroll, "Dice are permanent. Your equipped dice sets your base luck. Unlock areas to find better dice.", 0)
	for _, def in DiceConfig.List do
		local sub = string.format("x%g LUCK%s\n%s", def.Luck, if def.RollSpeed ~= 1 then string.format(" · x%g ROLL SPEED", def.RollSpeed) else "", def.Description)
		local id = def.Id
		local row, button, status = itemRow(diceScroll, def.Order, "🎲 " .. def.DisplayName, sub, def.Color, function()
			local dice = State.data.Dice
			if dice and dice.Owned[id] then
				Actions.send("EquipDice", id)
			else
				Actions.send("BuyDice", id)
			end
		end)
		rows.Dice[id] = row
		diceButtons[id] = button
		diceStatus[id] = status
	end

	-- Passes / Products
	for _, kind in { "Passes", "Products" } do
		local scroll = scrolls[kind]
		local map = if kind == "Passes" then MonetizationConfig.Gamepasses else MonetizationConfig.Products
		local note = Cards.paragraph(scroll, "✔ " .. HONEST_NOTE, 0, C.Green)
		note.Font = UI.Fonts.Title
		for i, name in sortedNames(map) do
			local def = map[name]
			local actionKind = if kind == "Passes" then "Pass" else "Product"
			local row, button, status = itemRow(scroll, i, def.DisplayName, def.Description, if kind == "Passes" then C.Purple else C.Blue, function()
				buy(actionKind, name, def)
			end)
			status.Text = "R$ " .. def.PriceHint .. (if kind == "Passes" then " · one-time, permanent" else " · fixed contents")
			rows[kind][name] = row
			if kind == "Passes" then
				passButtons[name] = button
			else
				productButtons[name] = button
			end
		end
	end

	watcher = Cards.watch({ Dice = true, Areas = true, Cash = true, Passes = true, Session = true }, refresh, 0.2)
end

local function normalizeTab(tab: any): string?
	if type(tab) ~= "string" then
		return nil
	end
	for _, name in TABS do
		if string.lower(name) == string.lower(tab) then
			return name
		end
	end
	return nil
end

-- Zur hervorgehobenen Zeile scrollen und kurz aufleuchten lassen
local function highlight(tab: string, key: string)
	local row = rows[tab][key]
	local scroll = scrolls[tab]
	if not row or not scroll then
		return
	end
	task.wait() -- Layout abwarten
	local offset = (row.AbsolutePosition.Y - scroll.AbsolutePosition.Y) / math.max(0.01, Root.Scale)
	scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.CanvasPosition.Y + offset - 8))
	local stroke = row:FindFirstChildOfClass("UIStroke")
	if stroke then
		local color, thickness = stroke.Color, stroke.Thickness
		for _ = 1, 3 do
			stroke.Color = C.Gold
			stroke.Thickness = 4
			task.wait(0.25)
			stroke.Color = color
			stroke.Thickness = thickness
			task.wait(0.2)
		end
	end
end

function Shop.onOpen(args: any?)
	local tab = if type(args) == "table" then normalizeTab(args.Tab) else nil
	local key = if type(args) == "table" and type(args.Highlight) == "string" then args.Highlight else nil
	if not tab and key then
		for _, name in TABS do
			if rows[name][key] then
				tab = name
			end
		end
	end
	selectTab(tab or currentTab)
	watcher.open()
	if key and tab then
		task.spawn(highlight, tab, key)
	end
end

function Shop.onClose()
	watcher.close()
end

return Shop
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Signal (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > Signal
--
-- Minimaler Signal-Typ für Client-Module (Connect / Fire / Once).

export type Connection = { Disconnect: (self: Connection) -> (), Connected: boolean }
export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	return (setmetatable({ _handlers = {} }, Signal) :: any) :: Signal
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local connection
	connection = {
		Connected = true,
		Disconnect = function(c)
			if not c.Connected then
				return
			end
			c.Connected = false
			local index = table.find(handlers, fn)
			if index then
				table.remove(handlers, index)
			end
		end,
	}
	table.insert(handlers, fn)
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, fn in table.clone(self._handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- State (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > State
--
-- Spiegel des eigenen Profils auf dem Client (nur Anzeige!). Der Server
-- schickt Patches über das Remote "Sync". Alle UI-Module lesen hier und
-- hören auf State.Changed(key).
--
-- Zusätzlich: Server-Events ("Roll", "Toast", ...) über State.on(kind, fn).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local Net = require(Shared:WaitForChild("Net"))
local CharacterConfig = require(Config:WaitForChild("CharacterConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))
local Signal = require(script.Parent:WaitForChild("Signal"))

local State = {}

State.data = {} :: { [string]: any }
State.derived = {} :: { [string]: any }
State.session = {} :: { [string]: any }
State.ready = false

State.Changed = Signal.new() -- (key)
State.Ready = Signal.new()

local eventSignals: { [string]: Signal.Signal } = {}

function State.on(kind: string, fn: (any) -> ()): Signal.Connection
	local signal = eventSignals[kind]
	if not signal then
		signal = Signal.new()
		eventSignals[kind] = signal
	end
	return signal:Connect(fn)
end

-- Lokale Events (z. B. UI -> UI), gleicher Kanal wie Server-Events
function State.emit(kind: string, data: any?)
	local signal = eventSignals[kind]
	if signal then
		signal:Fire(data)
	end
end

local function applyPatch(patch: { [string]: any })
	local data = State.data
	if patch.Full then
		data.Characters = {}
		data.Gear = {}
	end
	for key, value in patch do
		if key == "Full" then
			continue
		elseif key == "Derived" then
			State.derived = value
		elseif key == "Session" then
			State.session = value
		elseif (key == "Characters" or key == "Gear") and not patch.Full then
			local target = data[key] or {}
			data[key] = target
			for uid, entry in value do
				if entry == false then
					target[uid] = nil
				else
					target[uid] = entry
				end
			end
		else
			data[key] = value
		end
	end
	for key in patch do
		if key ~= "Full" then
			State.Changed:Fire(key)
		end
	end
	if patch.Full and not State.ready then
		State.ready = true
		State.Ready:Fire()
	end
end

function State.start()
	Net.get("Sync").OnClientEvent:Connect(applyPatch)
	Net.get("Event").OnClientEvent:Connect(function(kind: string, data: any)
		State.emit(kind, data)
	end)
end

function State.waitReady()
	if not State.ready then
		local done = false
		State.Ready:Once(function()
			done = true
		end)
		while not done do
			task.wait()
		end
	end
end

-- Helfer ---------------------------------------------------------------------------

function State.character(uid: string)
	return State.data.Characters and State.data.Characters[uid]
end

function State.def(uid: string)
	local char = State.character(uid)
	return char and CharacterConfig.ById[char.Id]
end

function State.gearCashPct(char): number
	local pct = 0
	for _, gearUid in char.Gear or {} do
		local item = State.data.Gear and State.data.Gear[gearUid]
		local def = item and GearConfig.Get(item.Id)
		if def and def.CashPct then
			pct += def.CashPct
		end
	end
	return math.min(pct, EconomyConfig.MaxGearCashPctPerCharacter)
end

-- Gleiche Formel wie Logic.Economy.characterIncome
function State.income(uid: string): number
	local char = State.character(uid)
	local def = char and CharacterConfig.ById[char.Id]
	if not def then
		return 0
	end
	return Stats.income(def, char.Level, char.Mutation) * (1 + State.gearCashPct(char) / 100) * (State.derived.CashMultiplier or 1)
end

function State.upgradeCost(uid: string): number?
	local char = State.character(uid)
	local def = char and CharacterConfig.ById[char.Id]
	return def and Stats.upgradeCost(def, char.Level, char.Mutation)
end

function State.fishingPower(uid: string): number
	local char = State.character(uid)
	local def = char and CharacterConfig.ById[char.Id]
	if not def then
		return 0
	end
	local power = Stats.fishingPower(def, char.Level)
	for _, gearUid in char.Gear or {} do
		local item = State.data.Gear and State.data.Gear[gearUid]
		local g = item and GearConfig.Get(item.Id)
		if g and g.FishingPower then
			power += g.FishingPower
		end
	end
	return power
end

-- Characters als sortierte Liste: { uid, char, def }
-- sort: "Rarity" (Standard), "Income", "Level", "Newest"
function State.characterList(sort: string?, filter: ((any, any) -> boolean)?)
	local list = {}
	for uid, char in State.data.Characters or {} do
		local def = CharacterConfig.ById[char.Id]
		if def and (not filter or filter(char, def)) then
			table.insert(list, { uid = uid, char = char, def = def, income = State.income(uid) })
		end
	end
	local mode = sort or "Rarity"
	table.sort(list, function(a, b)
		if mode == "Income" and a.income ~= b.income then
			return a.income > b.income
		elseif mode == "Level" and a.char.Level ~= b.char.Level then
			return a.char.Level > b.char.Level
		elseif mode == "Newest" and a.char.At ~= b.char.At then
			return (a.char.At or 0) > (b.char.At or 0)
		end
		local ra, rb = RarityConfig.Order(a.def.Rarity), RarityConfig.Order(b.def.Rarity)
		if ra ~= rb then
			return ra > rb
		end
		if a.income ~= b.income then
			return a.income > b.income
		end
		return a.uid < b.uid
	end)
	return list
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="120">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Cards</string>
              <string name="Source"><![CDATA[--!strict
-- Cards (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > UI > Cards
--
-- Gemeinsame Bausteine für die Menü-Fenster:
--   Cards.characterCard   Karte mit Viewport (Inventory, Index, Inspect)
--   Cards.ownedInfo       Karten-Info für einen eigenen Character
--   Cards.watch           Refresh nur wenn sichtbar (sonst "dirty" merken)
--   Cards.row / header / paragraph / popup / confirmButton
--   Cards.rewardText / seasonRewardText / gearStats / baseChanceText
--
-- Viewports werden über eine Warteschlange gesetzt (wenige pro Frame), damit
-- das Öffnen eines großen Fensters nicht ruckelt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local Config = Shared:WaitForChild("Config")
local Util = Shared:WaitForChild("Util")
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local GearConfig = require(Config:WaitForChild("GearConfig"))
local PotionConfig = require(Config:WaitForChild("PotionConfig"))
local CosmeticConfig = require(Config:WaitForChild("CosmeticConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local Format = require(Util:WaitForChild("Format"))
local Odds = require(Util:WaitForChild("Odds"))

local Client = script.Parent.Parent
local State = require(Client:WaitForChild("State"))
local Sound = require(Client:WaitForChild("Controllers"):WaitForChild("SoundController"))
local UI = require(script.Parent:WaitForChild("Components"))
local Viewport = require(script.Parent:WaitForChild("Viewport"))

local C = UI.Colors
local F = UI.Fonts

local Cards = {}

export type CardInfo = {
	Id: string?,
	Mutation: string?,
	Silhouette: boolean?,
	Title: string,
	TitleColor: Color3?,
	Lines: { string }?,
	LineColors: { Color3 }?,
	Badges: string?,
	Tag: string?,
	TagColor: Color3?,
	StrokeColor: Color3?,
}

export type Card = { Frame: TextButton, set: (CardInfo) -> () }

export type Watcher = {
	request: (key: string?) -> (),
	open: () -> (),
	close: () -> (),
	isVisible: () -> boolean,
}

export type Popup = { Frame: Frame, Body: Frame, show: (title: string) -> (), hide: () -> () }

-- Fenster öffnen ohne zirkuläres require (WindowManager lädt die Fenster)
function Cards.open(name: string, args: any?)
	local WindowManager = require(Client:WaitForChild("Controllers"):WaitForChild("WindowManager")) :: any
	WindowManager.open(name, args)
end

function Cards.close()
	local WindowManager = require(Client:WaitForChild("Controllers"):WaitForChild("WindowManager")) :: any
	WindowManager.close()
end

-- Viewport-Warteschlange ---------------------------------------------------------

local vpQueue: { ViewportFrame } = {}
local vpArgs: { [ViewportFrame]: { any } } = {}

function Cards.setViewport(frame: ViewportFrame, id: string?, mutation: string?, silhouette: boolean?)
	if not vpArgs[frame] then
		table.insert(vpQueue, frame)
	end
	vpArgs[frame] = { id, mutation, silhouette }
end

RunService.Heartbeat:Connect(function()
	local done = 0
	while done < 6 and #vpQueue > 0 do
		local frame = table.remove(vpQueue, 1) :: ViewportFrame
		local args = vpArgs[frame]
		vpArgs[frame] = nil
		if args and frame.Parent then
			Viewport.set(frame, args[1], args[2], args[3])
			done += 1
		end
	end
end)

-- Sichtbarkeits-Watcher ------------------------------------------------------------
-- keys: State-Keys -> true oder Prüf-Funktion (true = relevant).
-- refresh(changed) bekommt die gesammelten Keys (nil = alles neu, z. B. beim Öffnen).

function Cards.watch(keys: { [string]: any }, refresh: ({ [string]: boolean }?) -> (), delay: number?): Watcher
	local visible = false
	local scheduled = false
	local changed: { [string]: boolean } = {}
	local function run()
		scheduled = false
		if not visible then
			return
		end
		local batch = changed
		changed = {}
		refresh(batch)
	end
	local function request(key: string?)
		if key then
			changed[key] = true
		end
		if visible and not scheduled then
			scheduled = true
			task.delay(delay or 0.15, run)
		end
	end
	State.Changed:Connect(function(key: string)
		local check = keys[key]
		if check == true or (type(check) == "function" and (check :: any)()) then
			request(key)
		end
	end)
	return {
		request = request,
		open = function()
			visible = true
			changed = {}
			refresh(nil)
		end,
		close = function()
			visible = false
		end,
		isVisible = function()
			return visible
		end,
	}
end

-- true, wenn sich eines der Derived-Felder seit dem letzten Aufruf geändert hat
function Cards.derivedChanged(fields: { string }): () -> boolean
	local last: { [string]: any } = {}
	return function()
		local any = false
		for _, f in fields do
			local v = State.derived[f]
			if v ~= last[f] then
				last[f] = v
				any = true
			end
		end
		return any
	end
end

-- Character-Karte ------------------------------------------------------------------

function Cards.characterCard(parent: Instance, onClick: (() -> ())?): Card
	local button = UI.new("TextButton", {
		Name = "Card",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Selectable = onClick ~= nil,
		Parent = parent,
	})
	UI.corner(button, 10)
	local stroke = UI.stroke(button, C.Stroke, 2)
	local gradient = UI.gradient(button, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 90)
	local vp = Viewport.create({ Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0.55, -4), Parent = button })
	local badges = UI.label({ Position = UDim2.fromOffset(6, 4), Size = UDim2.new(0.6, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, MaxTextSize = 18, Parent = button })
	local tag = UI.tag({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4), Size = UDim2.fromOffset(62, 18), Parent = button })
	tag.Visible = false
	local title = UI.label({ Position = UDim2.new(0, 4, 0.55, 2), Size = UDim2.new(1, -8, 0, 20), Font = F.Title, MaxTextSize = 18, Parent = button })
	local lines: { TextLabel } = {}
	for i = 1, 3 do
		lines[i] = UI.label({ Position = UDim2.new(0, 4, 0.55, 22 + (i - 1) * 16), Size = UDim2.new(1, -8, 0, 15), TextColor3 = C.SubText, MaxTextSize = 14, Parent = button })
	end
	if onClick then
		button.Activated:Connect(function()
			Sound.play("UIClick")
			onClick()
		end)
		button.MouseEnter:Connect(function()
			stroke.Thickness = 3
		end)
		button.MouseLeave:Connect(function()
			stroke.Thickness = 2
		end)
	end

	local vpKey = ""
	local function set(info: CardInfo)
		title.Text = info.Title
		title.TextColor3 = info.TitleColor or C.Text
		for i, label in lines do
			local text = info.Lines and info.Lines[i]
			label.Text = text or ""
			label.Visible = text ~= nil
			label.TextColor3 = (info.LineColors and info.LineColors[i]) or C.SubText
		end
		badges.Text = info.Badges or ""
		if info.Tag then
			tag.Text = info.Tag
			tag.BackgroundColor3 = info.TagColor or C.Red
			tag.Visible = true
		else
			tag.Visible = false
		end
		local accent = info.StrokeColor or C.Stroke
		stroke.Color = accent
		gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), accent:Lerp(Color3.new(1, 1, 1), 0.55))
		local key = (info.Id or "") .. "|" .. (info.Mutation or "") .. "|" .. tostring(info.Silhouette)
		if key ~= vpKey then
			vpKey = key
			Cards.setViewport(vp, info.Id, info.Mutation, info.Silhouette)
		end
	end
	return { Frame = button, set = set }
end

function Cards.mutationTag(mutation: string?): (string?, Color3?)
	if not mutation or mutation == MutationConfig.None then
		return nil, nil
	end
	local m = MutationConfig.Get(mutation)
	return m.DisplayName, m.Color:Lerp(Color3.new(0, 0, 0), 0.25)
end

-- Karten-Info für einen eigenen Character (uid)
function Cards.ownedInfo(uid: string, char: any, def: any, income: number?): CardInfo
	local rarity = RarityConfig.Get(def.Rarity)
	local badges = ""
	if char.Slot then
		badges ..= "🏠"
	end
	if char.Fishing then
		badges ..= "🎣"
	end
	if char.Locked then
		badges ..= "🔒"
	end
	local tagText, tagColor = Cards.mutationTag(char.Mutation)
	local inc = income or State.income(uid)
	return {
		Id = char.Id,
		Mutation = char.Mutation,
		Title = def.DisplayName,
		TitleColor = rarity.Color,
		Lines = { rarity.DisplayName .. " · Lv " .. char.Level .. "/" .. def.MaxLevel, Format.perSecond(inc) },
		LineColors = { rarity.Color, if char.Slot then C.Cash else C.SubText },
		Badges = badges,
		Tag = tagText,
		TagColor = tagColor,
		StrokeColor = rarity.Color,
	}
end

-- Basis-Chance als Text. Commons: echte, normalisierte Chance (Luck 1).
function Cards.baseChanceText(def: any): string
	if not def.ReleaseEnabled then
		return "Not in rotation"
	end
	local rarity = RarityConfig.Get(def.Rarity)
	if rarity.LuckAffected then
		return Format.oneIn(def.RollChance)
	end
	return Format.chance(Odds.characterProbability(def.Id, 1))
end

-- Layout-Helfer --------------------------------------------------------------------

function Cards.clear(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function Cards.row(parent: Instance, height: number, order: number?, accent: Color3?): Frame
	local row = UI.panel({
		Name = "Row",
		BackgroundColor3 = C.PanelLight,
		Size = UDim2.new(1, -16, 0, height),
		LayoutOrder = order or 0,
		Parent = parent,
	})
	if accent then
		local bar = UI.new("Frame", { BackgroundColor3 = accent, BorderSizePixel = 0, Size = UDim2.new(0, 6, 1, -12), Position = UDim2.fromOffset(4, 6), Parent = row })
		UI.corner(bar, 3)
	end
	return row
end

-- Titel + Untertitel in einer Row. right/left = reservierte Pixel.
function Cards.rowText(row: Frame, title: string, sub: string?, titleColor: Color3?, right: number?, left: number?): (TextLabel, TextLabel)
	local l = left or 16
	local r = right or 0
	local titleLabel = UI.label({
		Text = title,
		Font = F.Title,
		TextColor3 = titleColor or C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(l, 6),
		Size = UDim2.new(1, -(l + r + 8), 0, 22),
		MaxTextSize = 20,
		Parent = row,
	})
	local subLabel = UI.label({
		Text = sub or "",
		TextColor3 = C.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(l, 30),
		Size = UDim2.new(1, -(l + r + 8), 1, -36),
		MaxTextSize = 15,
		Parent = row,
	})
	return titleLabel, subLabel
end

function Cards.header(parent: Instance, text: string, order: number?, color: Color3?): TextLabel
	return UI.label({
		Name = "Header",
		Text = text,
		Font = F.Title,
		TextColor3 = color or C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -16, 0, 28),
		LayoutOrder = order or 0,
		MaxTextSize = 22,
		Parent = parent,
	})
end

function Cards.paragraph(parent: Instance, text: string, order: number?, color: Color3?): TextLabel
	return UI.label({
		Text = text,
		TextScaled = false,
		TextSize = 15,
		TextColor3 = color or C.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -16, 0, 0),
		LayoutOrder = order or 0,
		Parent = parent,
	})
end

-- Seite unter einer Tab-Leiste
function Cards.page(parent: Instance, name: string, top: number?): Frame
	return UI.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, top or 56),
		Size = UDim2.new(1, 0, 1, -(top or 56)),
		Visible = false,
		Parent = parent,
	})
end

-- Button mit Bestätigung: erster Tap "scharf", zweiter innerhalb von 3 s führt aus.
-- Gibt Button und setText(normalText) zurück.
function Cards.confirmButton(props: { [string]: any }): (TextButton, (string) -> ())
	local normalText: string = props.Text or ""
	local armedUntil = 0
	local button: TextButton
	local onConfirm = props.OnConfirm
	props.OnClick = function()
		if os.clock() < armedUntil then
			armedUntil = 0
			button.Text = normalText
			onConfirm()
		else
			armedUntil = os.clock() + 3
			button.Text = props.ConfirmText or "TAP AGAIN TO CONFIRM"
			task.delay(3.05, function()
				if os.clock() >= armedUntil then
					button.Text = normalText
				end
			end)
		end
	end
	button = UI.button(props)
	local function setText(text: string)
		normalText = text
		if os.clock() >= armedUntil then
			button.Text = text
		end
	end
	return button, setText
end

-- Overlay-Popup im Fenster-Content (blockiert Klicks dahinter)
function Cards.popup(parent: Instance): Popup
	local overlay = UI.new("Frame", {
		Name = "Popup",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Active = true,
		Visible = false,
		Parent = parent,
	})
	local panel = UI.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -16, 1, -16),
		StrokeColor = C.Purple,
		Active = true,
		Parent = overlay,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(640, 440), Parent = panel })
	local title = UI.label({
		Font = F.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -80, 0, 32),
		MaxTextSize = 26,
		Parent = panel,
	})
	local body = UI.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 52),
		Size = UDim2.new(1, -20, 1, -60),
		Parent = panel,
	})
	local function hide()
		overlay.Visible = false
	end
	UI.button({
		Text = "✕",
		Color = C.Red,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 6),
		Size = UDim2.fromOffset(52, 40),
		Parent = panel,
		OnClick = hide,
	})
	return {
		Frame = overlay,
		Body = body,
		show = function(text: string)
			title.Text = text
			overlay.Visible = true
		end,
		hide = hide,
	}
end

-- Texte ------------------------------------------------------------------------------

-- Schätzung für "Sekunden Einkommen"-Belohnungen (gleiche Formel wie der Server)
function Cards.cashEstimate(seconds: number, minimum: number?): number
	local income = math.max(EconomyConfig.ScaledReward.MinIncomePerSecond, State.derived.IncomePerSecond or 0)
	return math.max(minimum or 0, math.floor(income * seconds))
end

local function potionName(id: string): string
	local def = PotionConfig.Get(id)
	return if def then def.DisplayName else id
end

function Cards.gearName(id: string): string
	local def = GearConfig.Get(id)
	return if def then def.DisplayName else id
end

function Cards.cosmeticName(id: string): string
	local def = CosmeticConfig.Get(id)
	return if def then def.DisplayName .. " (" .. string.upper(def.Kind) .. ")" else id
end

-- Quest-/Achievement-Belohnungen
function Cards.rewardText(r: { [string]: any }): string
	local parts = {}
	if r.CashSeconds and r.CashSeconds > 0 then
		table.insert(parts, "≈" .. Format.cash(Cards.cashEstimate(r.CashSeconds, 100)))
	end
	if r.Cash and r.Cash > 0 then
		table.insert(parts, Format.cash(r.Cash))
	end
	if r.Potions then
		local ids = {}
		for id in r.Potions do
			table.insert(ids, id)
		end
		table.sort(ids)
		for _, id in ids do
			table.insert(parts, tostring(r.Potions[id]) .. "x " .. potionName(id))
		end
	end
	if r.Gear then
		table.insert(parts, Cards.gearName(r.Gear))
	end
	if r.Cosmetic then
		table.insert(parts, Cards.cosmeticName(r.Cosmetic))
	end
	if r.SeasonXp and r.SeasonXp > 0 then
		table.insert(parts, "+" .. r.SeasonXp .. " Season XP")
	end
	return if #parts > 0 then table.concat(parts, " · ") else "—"
end

-- Season-Tier-Belohnung ({ Kind = ... })
function Cards.seasonRewardText(r: { [string]: any }): string
	if r.Kind == "Cash" then
		return "≈" .. Format.cash(Cards.cashEstimate(r.Seconds or 0, 100))
	elseif r.Kind == "Potion" then
		return (r.Amount or 1) .. "x " .. potionName(r.Id)
	elseif r.Kind == "Gear" then
		return Cards.gearName(r.Id)
	elseif r.Kind == "Cosmetic" then
		return Cards.cosmeticName(r.Id)
	end
	return "?"
end

function Cards.gearStats(def: any): string
	local parts = {}
	if def.CashPct then
		table.insert(parts, "+" .. def.CashPct .. "% Cash")
	end
	if def.LuckPct then
		table.insert(parts, "+" .. def.LuckPct .. "% Luck (in base)")
	end
	if def.FishingPower then
		table.insert(parts, "+" .. def.FishingPower .. " Fishing Power")
	end
	if def.FishingLuckPct then
		table.insert(parts, "+" .. def.FishingLuckPct .. "% Fishing Luck")
	end
	return table.concat(parts, " · ")
end

function Cards.gearColor(def: any): Color3
	local r = GearConfig.RarityById[def.Rarity]
	return if r then r.Color else C.Text
end

function Cards.gearOrder(def: any): number
	local r = GearConfig.RarityById[def.Rarity]
	return if r then r.Order else 0
end

return Cards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--!strict
-- Components (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > UI > Components
--
-- Bausteine für die gesamte UI: Panels, Buttons, Fenster, Tabs, Grids,
-- Fortschrittsbalken. Alles nutzt UIConfig (Farben/Schriften), damit der
-- Look an einer Stelle angepasst werden kann.
--
-- Mobile: Buttons haben Mindestgröße UIConfig.MinTouchSize, Grids nutzen
-- große Karten, Fenster passen sich per Scale an kleine Bildschirme an.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config")
local UIConfig = require(Config:WaitForChild("UIConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))

local Client = script.Parent.Parent
local Sound = require(Client:WaitForChild("Controllers"):WaitForChild("SoundController"))

local C = UIConfig.Colors
local F = UIConfig.Fonts

local Components = {}
Components.Colors = C
Components.Fonts = F

type Props = { [string]: any }

-- Instanz mit Properties und Kindern erzeugen
function Components.new(className: string, props: Props?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = Components.new

function Components.corner(parent: Instance, radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, radius or UIConfig.CornerRadius), Parent = parent })
end

function Components.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return new("UIStroke", {
		Color = color or C.Stroke,
		Thickness = thickness or UIConfig.StrokeThickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Components.padding(parent: Instance, px: number)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function Components.gradient(parent: Instance, c1: Color3, c2: Color3, rotation: number?): UIGradient
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90, Parent = parent })
end

function Components.list(parent: Instance, padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = parent,
	})
end

function Components.label(props: Props): TextLabel
	local defaults: Props = {
		BackgroundTransparency = 1,
		Font = F.Body,
		TextColor3 = C.Text,
		TextScaled = true,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 24),
		Text = "",
	}
	for k, v in props do
		if k ~= "MaxTextSize" then -- Helfer-Key, keine TextLabel-Property
			defaults[k] = v
		end
	end
	local label = new("TextLabel", defaults)
	if props.TextScaled ~= false then
		new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, MinTextSize = 8, Parent = label })
	end
	return label
end

function Components.panel(props: Props): Frame
	local defaults: Props = {
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
	}
	for k, v in props do
		if k ~= "StrokeColor" and k ~= "StrokeThickness" then -- Helfer-Keys, keine Frame-Properties
			defaults[k] = v
		end
	end
	local frame = new("Frame", defaults)
	Components.corner(frame)
	Components.stroke(frame, props.StrokeColor or C.Stroke, props.StrokeThickness)
	return frame
end

-- Button mit Hover/Press-Animation und Klick-Sound.
-- props: Text, Color, TextColor, Size, Position, AnchorPoint, OnClick, Parent,
--        TextSize (Max), Font, LayoutOrder, Name, Icon (Emoji/Text vor dem Text)
function Components.button(props: Props): TextButton
	local color: Color3 = props.Color or C.Purple
	local button = new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(160, UIConfig.MinTouchSize),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Text = if props.Icon then props.Icon .. "  " .. (props.Text or "") else (props.Text or ""),
		Font = props.Font or F.Title,
		TextColor3 = props.TextColor or C.Text,
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = if props.Visible == nil then true else props.Visible,
		Selectable = true,
		Parent = props.Parent,
	})
	Components.corner(button, props.Radius)
	Components.stroke(button, props.StrokeColor or color:Lerp(Color3.new(1, 1, 1), 0.35), 2)
	Components.gradient(button, Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 210), 90)
	new("UITextSizeConstraint", { MaxTextSize = props.TextSize or 26, MinTextSize = 8, Parent = button })
	Components.padding(button, 6)

	local scale = new("UIScale", { Parent = button })
	local info = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.05 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, info, { Scale = 0.94 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
	if props.OnClick then
		button.Activated:Connect(function()
			if button:GetAttribute("Disabled") then
				Sound.play("UIError")
				return
			end
			Sound.play("UIClick")
			props.OnClick()
		end)
	end
	return button
end

function Components.setButtonEnabled(button: TextButton, enabled: boolean, color: Color3?)
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundColor3 = if enabled then (color or button.BackgroundColor3) else C.Disabled
	button.TextTransparency = if enabled then 0 else 0.35
end

-- Scrollbares Raster. cell = Zellgröße in Pixeln.
function Components.grid(parent: Instance, cell: Vector2, padding: number?): ScrollingFrame
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Purple,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Selectable = false,
		Parent = parent,
	})
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = scroll,
	})
	Components.padding(scroll, 6)
	return scroll
end

function Components.scrollList(parent: Instance, padding: number?): ScrollingFrame
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Purple,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Selectable = false,
		Parent = parent,
	})
	Components.list(scroll, padding or 8, false, Enum.HorizontalAlignment.Center)
	Components.padding(scroll, 6)
	return scroll
end

-- Fortschrittsbalken: gibt Frame und Setter zurück
function Components.progress(props: Props): (Frame, (number, string?) -> ())
	local bar = new("Frame", {
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 16),
		Position = props.Position or UDim2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Components.corner(bar, 8)
	Components.stroke(bar, C.Stroke, 1)
	local fill = new("Frame", {
		BackgroundColor3 = props.Color or C.Blue,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	})
	Components.corner(fill, 8)
	local text = Components.label({ Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 3, Parent = bar, MaxTextSize = 16 })
	local function set(value: number, label: string?)
		fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
		text.Text = label or ""
	end
	return bar, set
end

-- Tab-Leiste: tabs = { "Dice", "Passes" }, onSelect(name)
function Components.tabs(parent: Instance, tabs: { string }, onSelect: (string) -> ()): (Frame, (string) -> ())
	local bar = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, UIConfig.MinTouchSize),
		Parent = parent,
	})
	Components.list(bar, 6, true, Enum.HorizontalAlignment.Center)
	local buttons = {}
	local function select(name: string)
		for tabName, b in buttons do
			b.BackgroundColor3 = if tabName == name then C.Purple else C.PanelLight
		end
		onSelect(name)
	end
	for i, name in tabs do
		buttons[name] = Components.button({
			Text = string.upper(name),
			Size = UDim2.new(1 / #tabs, -6, 1, 0),
			Color = C.PanelLight,
			LayoutOrder = i,
			TextSize = 20,
			Parent = bar,
			OnClick = function()
				select(name)
			end,
		})
	end
	return bar, select
end

function Components.rarityColor(rarityId: string): Color3
	local def = RarityConfig.ById[rarityId]
	return if def then def.Color else C.Text
end

-- Kleiner Tag ("NEW!", "GOLDEN", "LOCKED")
function Components.tag(props: Props): TextLabel
	local tag = Components.label({
		Text = props.Text,
		Size = props.Size or UDim2.fromOffset(60, 18),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 0,
		BackgroundColor3 = props.Color or C.Red,
		TextColor3 = props.TextColor or C.Text,
		Font = F.Title,
		ZIndex = props.ZIndex or 5,
		MaxTextSize = 16,
		Parent = props.Parent,
	})
	Components.corner(tag, 6)
	return tag
end

-- Leichter CRT-Effekt: horizontale Linien über einem Frame
function Components.scanlines(parent: Instance, lines: number?, transparency: number?)
	local holder = new("Frame", {
		Name = "Scanlines",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Active = false,
		Parent = parent,
	})
	local n = lines or 24
	for i = 0, n - 1 do
		new("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = transparency or 0.9,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromScale(0, i / n),
			ZIndex = 50,
			Parent = holder,
		})
	end
	return holder
end

function Components.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--!strict
-- Root (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > UI > Root
--
-- Legt die ScreenGuis an (Ebenen) und skaliert die UI passend zur
-- Bildschirmgröße (UIScale). Auf Touch-Geräten etwas größer, damit Buttons
-- gut treffbar bleiben.
--
--   HUD (1)  ->  Windows (5)  ->  Reveal (10)  ->  Toasts (15)  ->  Tutorial (20)

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIConfig = require(ReplicatedStorage:WaitForChild("VoidDice"):WaitForChild("Config"):WaitForChild("UIConfig"))

local Root = {}

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local scales: { UIScale } = {}

Root.Layers = {} :: { [string]: ScreenGui }
Root.Scale = 1
Root.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
Root.IsSmall = false

local function makeLayer(name: string, order: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidDice_" .. name
	gui.DisplayOrder = order
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = false
	gui.Parent = playerGui
	local scale = Instance.new("UIScale")
	scale.Parent = gui
	table.insert(scales, scale)
	Root.Layers[name] = gui
	return gui
end

local function updateScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	local ref = UIConfig.ReferenceResolution
	local s = math.min(size.X / ref.X, size.Y / ref.Y)
	local minScale = if Root.IsTouch then 0.7 else UIConfig.MinScale
	s = math.clamp(s, minScale, UIConfig.MaxScale)
	Root.Scale = s
	Root.IsSmall = size.Y < 500 or size.X < 900
	for _, scale in scales do
		scale.Scale = s
	end
end

-- Pixelgröße des Bildschirms in UI-Einheiten (nach UIScale)
function Root.screenSize(): Vector2
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	return size / Root.Scale
end

function Root.init()
	makeLayer("HUD", 1)
	makeLayer("Windows", 5)
	makeLayer("Reveal", 10)
	makeLayer("Toasts", 15)
	makeLayer("Tutorial", 20)
	updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		updateScale()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
	end)
end

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">Viewport</string>
              <string name="Source"><![CDATA[--!strict
-- Viewport (ModuleScript)
-- Ort: StarterPlayerScripts > VoidDiceClient > UI > Viewport
--
-- Character-Vorschau in der UI (Reveal, Index, Inventar-Karten).
-- Models werden einmal pro Character+Mutation in LowDetail gebaut (keine
-- Partikel/Lichter) und dann nur noch geklont. Begrenzter Cache.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("VoidDice")
local UIConfig = require(Shared:WaitForChild("Config"):WaitForChild("UIConfig"))
local ModelFactory = require(Shared:WaitForChild("Visual"):WaitForChild("ModelFactory"))

local Viewport = {}

local cache: { [string]: Model } = {}
local cacheOrder: { string } = {}
local spinning: { [ViewportFrame]: number } = {}

local function template(characterId: string, mutation: string?): Model?
	local key = characterId .. "|" .. (mutation or "Normal")
	local cached = cache[key]
	if cached then
		return cached
	end
	local ok, model = pcall(ModelFactory.Build, characterId, { LowDetail = true, Mutation = mutation, Level = 1 })
	if not ok or not model then
		warn("[Viewport] Model fehlt:", characterId, model)
		return nil
	end
	model:PivotTo(CFrame.new())
	cache[key] = model
	table.insert(cacheOrder, key)
	if #cacheOrder > UIConfig.ViewportCacheSize then
		local oldest = table.remove(cacheOrder, 1) :: string
		local old = cache[oldest]
		cache[oldest] = nil
		if old then
			old:Destroy()
		end
	end
	return model
end

-- Setzt den Inhalt eines ViewportFrames auf einen Character
function Viewport.set(frame: ViewportFrame, characterId: string?, mutation: string?, silhouette: boolean?)
	for _, child in frame:GetChildren() do
		if child:IsA("Model") or child:IsA("Camera") then
			child:Destroy()
		end
	end
	if not characterId then
		return
	end
	local source = template(characterId, mutation)
	if not source then
		return
	end
	local model = source:Clone()
	if silhouette then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.Color = Color3.fromRGB(10, 10, 20)
				part.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	model.Parent = frame

	local cf, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local maxDim = math.max(size.X, size.Y, size.Z)
	local distance = maxDim * 0.5 / math.tan(math.rad(camera.FieldOfView / 2)) + size.Z * 0.6
	local center = cf.Position
	camera.CFrame = CFrame.lookAt(center + Vector3.new(distance * 0.25, size.Y * 0.08, -distance), center)
	camera.Parent = frame
	frame.CurrentCamera = camera
	frame:SetAttribute("CharacterId", characterId)
end

function Viewport.create(props: { [string]: any }): ViewportFrame
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = props.Size or UDim2.fromScale(1, 1)
	frame.Position = props.Position or UDim2.new()
	frame.AnchorPoint = props.AnchorPoint or Vector2.zero
	frame.Ambient = Color3.fromRGB(170, 170, 200)
	frame.LightColor = Color3.fromRGB(255, 240, 230)
	frame.LightDirection = Vector3.new(-0.4, -1, 0.6)
	frame.ZIndex = props.ZIndex or 2
	frame.Parent = props.Parent
	if props.CharacterId then
		Viewport.set(frame, props.CharacterId, props.Mutation, props.Silhouette)
	end
	return frame
end

-- Langsames Drehen (Reveal, Detail-Ansicht)
function Viewport.spin(frame: ViewportFrame, speed: number?)
	spinning[frame] = speed or 0.6
	frame.Destroying:Once(function()
		spinning[frame] = nil
	end)
end

function Viewport.stopSpin(frame: ViewportFrame)
	spinning[frame] = nil
end

RunService.RenderStepped:Connect(function(dt)
	for frame, speed in spinning do
		local model = frame:FindFirstChildOfClass("Model")
		if model and frame.Visible then
			model:PivotTo(model:GetPivot() * CFrame.Angles(0, speed * dt, 0))
		end
	end
end)

return Viewport
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
